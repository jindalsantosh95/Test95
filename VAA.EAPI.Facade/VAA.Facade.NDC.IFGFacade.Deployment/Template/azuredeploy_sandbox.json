{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environment": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "appName": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "aseRg": {
      "type": "string"
    },
    "aseName": {
      "type": "string"
    },
    "KeyVaultUri": {
      "type": "string"
    },
    "keyVaultName": {
      "type": "string"
    },
    "tags": {
      "type": "object"
    },
    "appinsightname": {
      "type": "string"
    },
    "storageaccountName": {
      "type": "string"
    },
    "AzureWebJobsSecretStorageType": {
      "type": "string"
    },

    "Tags": {
      "type": "Object"
    },

    "WEBSITE_LOAD_USER_PROFILE": {
      "type": "string"
    },
    "WEBSITE_RUN_FROM_PACKAGE": {
      "type": "string"
    },
    "storageAccountName": {
      "type": "string"
    },
    "AppSetting:OpenApi__Description": {
      "type": "string"
    },
    "AppSetting:OpenApi__HostNames": {
      "type": "string"
    },
    "AppSetting:OpenApi__DocVersion": {
      "type": "string"
    },
    "AppSetting:OpenApi__Version": {
      "type": "string"
    },
    "AppSetting:OpenApi__ForceHttps": {
      "type": "string"
    },
    "AppSetting:OpenApi__ForceHttp": {
      "type": "string"
    },
    "AppSetting:OpenApi__Scope": {
      "type": "string"
    },
    "Appsetting:OpenApi__DocTitle": {
      "type": "string"
    },
    "AppSetting:OpenApi__TokenUrl": {
      "type": "string"
    },
    "Appsetting:AzureAd:ClientId": {
      "type": "string"
    },
    "Appsetting:AzureAd:Instance": {
      "type": "string"
    },
    "Appsetting:AzureAd:TenantId": {
      "type": "string"
    },
    "Appsetting:AzureAd:TokenV1Issuer": {
      "type": "string"
    },
    "Appsetting:AzureAdB2C:ClientId": {
      "type": "string"
    },
    "Appsetting:AzureAdB2C:Instance": {
      "type": "string"
    },
    "Appsetting:AzureAdB2C:SignUpSignInPolicyId": {
      "type": "string"
    },
    "Appsetting:AzureAdB2C:TenantId": {
      "type": "string"
    },
    "Appsetting:AzureAdB2C:TokenV1Issuer": {
      "type": "string"
    },
    "vaultName": {
      "type": "string"
    },
    "WEBSITE_DNS_SERVER_SANDBOX": {
      "type": "string"
    },
    "WEBSITE_DNS_ALT_SERVER_SANDBOX": {
      "type": "string"
    },
    "workspacename": {
      "type": "string"
    },
    "ReferenceMSSubscriptionKey": {
      "type": "string"
    },
    "ReferenceMSUrl": {
      "type": "string"
    },
    "PaymentMSSubscriptionKey": {
      "type": "string"
    },
    "PaymentMSUrl": {
      "type": "string"
    },
    "OrderDataMSSubscriptionKey": {
      "type": "string"
    },
    "OrderDataMSEndpoint": {
      "type": "string"
    }
  },
  "variables": {
    "ResourceLocation": "[resourceGroup().location]",
    "SiteResourceID": "[resourceId('Microsoft.Web/Sites', parameters('appName'))]",
    "azurewebjobstorage": "[concat('@Microsoft.KeyVault(SecretUri=https://',parameters('keyVaultName'),'.vault.azure.net/secrets/',parameters('storageaccountName'),'-connectionstring)')]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2021-06-01",
      "name": "[parameters('workspacename')]",
      "location": "[variables('ResourceLocation')]",
      "properties": {}
    },
    {
      "type": "Microsoft.Insights/components",
      "kind": "web",
      "apiVersion": "2020-02-02",
      "name": "[parameters('appinsightname')]",
      "location": "[Variables('ResourceLocation')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspacename'))]"
      ],
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2018-11-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "functionapp",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "enabled": true,
        "serverFarmId": "[resourceId(parameters('aseRg'), 'Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "hostingEnvironmentProfile": "[resourceId(parameters('aseRg'), 'Microsoft.Web/hostingEnvironments', parameters('aseName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "appSettings": [
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', parameters('storageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value)]"
            }
          ]
        },
        "scmSiteAlsoStopped": false,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNamesDisabled": false,
        "containerSize": 1536,
        "dailyMemoryTimeQuota": 0,
        "httpsOnly": true,
        "redundancyMode": "None"
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2018-11-01",
      "name": "[concat(parameters('appName'), '/web')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]"
      ],
      "properties": {
        "numberOfWorkers": 1,
        "defaultDocuments": [
          "Default.htm",
          "Default.html",
          "Default.asp",
          "index.htm",
          "index.html",
          "iisstart.htm",
          "default.aspx",
          "index.php"
        ],
        "netFrameworkVersion": "v10.0",
        "phpVersion": "5.6",
        "requestTracingEnabled": false,
        "remoteDebuggingEnabled": false,
        "httpLoggingEnabled": false,
        "logsDirectorySizeLimit": 35,
        "detailedErrorLoggingEnabled": false,
        "publishingUsername": "$[parameters('appName')]",
        "azureStorageAccounts": {},
        "scmType": "None",
        "use32BitWorkerProcess": true,
        "webSocketsEnabled": false,
        "alwaysOn": true,
        "managedPipelineMode": "Integrated",
        "virtualApplications": [
          {
            "virtualPath": "/",
            "physicalPath": "site\\wwwroot",
            "preloadEnabled": false
          }
        ],
        "loadBalancing": "LeastRequests",
        "experiments": {
          "rampUpRules": []
        },
        "autoHealEnabled": false,
        "cors": {
          "allowedOrigins": [
            "https://functions.azure.com",
            "https://functions-staging.azure.com",
            "https://functions-next.azure.com"
          ],
          "supportCredentials": false
        },
        "localMySqlEnabled": false,
        "ipSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictionsUseMain": false,
        "http20Enabled": false,
        "minTlsVersion": "1.2",
        "ftpsState": "FtpsOnly",
        "reservedInstanceCount": 0
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2021-03-01",
      "name": "[concat(parameters('appName'),'/','appsettings')]",
      "kind": "functionapp,workflowapp",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/accessPolicies', parameters('keyVaultName'),'add')]"
      ],
      "properties": {
        /*App Settings */
        "FUNCTIONS_EXTENSION_VERSION": "~4",
        "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
        "WEBSITE_CONTENTOVERVNET": "1",
        "WEBSITE_VNET_ROUTE_ALL": "1",
        "APPINSIGHTS_INSTRUMENTATIONKEY": "[reference(resourceId('Microsoft.Insights/components', parameters('appinsightname')), '2014-04-01').InstrumentationKey]",
        "APPLICATIONINSIGHTS_CONNECTION_STRING": "[reference(resourceId('Microsoft.Insights/components', parameters('appinsightname')), '2020-02-02').ConnectionString]",
        "AzureWebJobsStorage": "[variables('azurewebjobstorage')]",
        "WEBSITE_RUN_FROM_PACKAGE": "[parameters('WEBSITE_RUN_FROM_PACKAGE')]",
        "WEBSITE_LOAD_USER_PROFILE": "[parameters('WEBSITE_LOAD_USER_PROFILE')]",
        "AzureWebJobsSecretStorageType": "[parameters('AzureWebJobsSecretStorageType')]",
        "OpenApi__Description": "[parameters('AppSetting:OpenApi__Description')]",
        "OpenApi__HostNames": "[parameters('AppSetting:OpenApi__HostNames')]",
        "OpenApi__DocVersion": "[parameters('AppSetting:OpenApi__DocVersion')]",
        "OpenApi__Version": "[parameters('AppSetting:OpenApi__Version')]",
        "OpenApi__ForceHttps": "[parameters('AppSetting:OpenApi__ForceHttps')]",
        "OpenApi__ForceHttp": "[parameters('AppSetting:OpenApi__ForceHttp')]",
        "OpenApi__Scope": "[parameters('AppSetting:OpenApi__Scope')]",
        "OpenApi__TokenUrl": "[parameters('AppSetting:OpenApi__TokenUrl')]",
        "OpenApi__DocTitle": "[parameters('Appsetting:OpenApi__DocTitle')]",
        "WEBSITE_DNS_SERVER_SANDBOX": "[parameters('WEBSITE_DNS_SERVER_SANDBOX')]",
        "WEBSITE_DNS_ALT_SERVER_SANDBOX": "[parameters('WEBSITE_DNS_ALT_SERVER_SANDBOX')]",
        "KeyVaultUri": "[parameters('KeyVaultUri')]",
        "PaymentMSSubscriptionKey": "[parameters('PaymentMSSubscriptionKey')]",
        "PaymentMSUrl": "[parameters('PaymentMSUrl')]",
        "OrderDataMSSubscriptionKey": "[parameters('OrderDataMSSubscriptionKey')]",
        "OrderDataMSEndpoint": "[parameters('OrderDataMSEndpoint')]",
        "ReferenceMSSubscriptionKey": "[parameters('ReferenceMSSubscriptionKey')]",
        "ReferenceMSUrl": "[parameters('ReferenceMSUrl')]",
        "AzureAd:ClientId": "[parameters('Appsetting:AzureAd:ClientId')]",
        "AzureAdB2C:ClientId": "[parameters('Appsetting:AzureAdB2C:ClientId')]",
        "AzureAdB2C:Instance": "[parameters('Appsetting:AzureAdB2C:Instance')]",
        "AzureAdB2C:SignUpSignInPolicyId": "[parameters('Appsetting:AzureAdB2C:SignUpSignInPolicyId')]",
        "AzureAdB2C:TenantId": "[parameters('Appsetting:AzureAdB2C:TenantId')]",
        "AzureAdB2C:TokenV1Issuer": "[parameters('Appsetting:AzureAdB2C:TokenV1Issuer')]",
        "AzureAd:Instance": "[parameters('Appsetting:AzureAd:Instance')]",
        "AzureAd:TenantId": "[parameters('Appsetting:AzureAd:TenantId')]",
        "AzureAd:TokenV1Issuer": "[parameters('Appsetting:AzureAd:TokenV1Issuer')]"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "apiVersion": "2015-06-01",
      "name": "[concat(parameters('keyvaultName'),'/add')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]"

      ],
      "properties": {
        "accessPolicies": [
          {
            "objectId": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2019-08-01', 'full').identity.principalId]",
            "tenantId": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2019-08-01', 'full').identity.tenantId]",
            "permissions": {
              "secrets": [ "Get", "List", "Set" ]
            }
          }
        ]
      }
    },


    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2022-09-01",
      "name": "[parameters('storageaccountName')]",
      "location": "northeurope",
      "sku": {
        "name": "Standard_RAGRS",
        "tier": "Standard"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false

      }
    }
  ]
}