{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "APIMName": {
            "type": "string",
            "defaultValue": "avaxeunamcag001"            
        },
        "UserName": {
            "type": "string"
        },
        "FirstName": {
            "type": "string"
        },
        "LastName": {
            "type": "string"
        },
        "Email": {
            "type": "string"
        },
        "Provider": {
            "type": "string"
        }
    },
    "resources": [
        {
          "type": "Microsoft.ApiManagement/service/users",
          "apiVersion": "2021-12-01-preview",
          "name": "[concat(parameters('APIMName'), '/', parameters('UserName'))]",
          "properties": {
            "firstName": "[parameters('FirstName')]",
            "lastName": "[parameters('LastName')]",
            "email": "[parameters('Email')]",
            "state": "active",
            "identities": [
              {
                "provider": "[parameters('Provider')]", // Basic, Aad, Azure
                "id": "[parameters('Email')]"
              }
            ]
          }
        }             
    ]
}