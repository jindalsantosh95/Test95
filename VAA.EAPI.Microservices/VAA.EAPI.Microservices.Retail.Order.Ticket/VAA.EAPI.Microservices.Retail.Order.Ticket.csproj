		<ProjectReference Include="..\VAA.EAPI.Infrastructure\VAA.EAPI.Infrastructure.csproj" />
		<ProjectReference Include="..\VAA.EAPI.Domain\VAA.EAPI.Domain.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Application\Query\" />
	</ItemGroup>
</Project>
