meta {
  name: Validate Member Status
  type: http
  seq: 7
}

post {
  url: {{customer_base_url}}/ValidateMemberStatus
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "memberNumber": "{{customer_member_number}}",
    "emailAddress": "{{customer_email}}",
    "password": "{{customer_password}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
