          "noteId": 26520,
          "title": "Country - JM,Country - BS,Country - MX,City - MIA",
          "compulsory": true
        },
        {
          "no": 11,
          "code": "Accomodation Check in/out times",
          "description": "Accomodation Check in/out times",
          "note": "Hotel check-in times are usually between 2:00pm and 4:00pm, check-out times \nbetween 11:00am and 12 noon on the day of departure. Therefore, if your flight \narrives early in the morning, you may not be able to check in to your hotel until \nbetween 2:00pm\u20134:00pm. \nSimilarly, if your return flight is at night, you will normally be required to vacate \nyour room at 12 noon prior to leaving for the airport. Day rooms are subject to \navailability/cost and should be arranged locally with the accommodation \nmanagement.",
          "dateModified": "2025-05-30T15:50:10",
          "external": true,
          "internal": true,
          "priority": "H",
