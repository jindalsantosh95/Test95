                    "compulsory": true
                },
                {
                    "no": 10,
                    "code": "Barbados Tax Levy",
                    "description": "Barbados Tax Levy",
                    "note": "A Tourism fee will be charged per bedroom, per night and will be collected at check\nout. The rate is subject to change by the Government, and varies by hotel room.\nFees currently range from ​​​​8.75​ Barbadian dollar (approx £3.90​) to 35 Barbadian \ndollar​ (approx £16.00) per bedroom, per night.",
                    "dateModified": "2023-12-02T14:40:25",
                    "external": true,
