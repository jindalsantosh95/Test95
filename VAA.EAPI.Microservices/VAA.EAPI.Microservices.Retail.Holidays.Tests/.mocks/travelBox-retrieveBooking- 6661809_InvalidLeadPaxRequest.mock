          "no": 0,
          "type": "RESERVATION",
          "note": "LP called\nHas lost his job so may either cancel at LOD or move on date wise with a \u00A350 PP admin fee.\nWill call back b4 BDD",
          "displayName": "Norma Jolly",
          "dateModified": "2024-11-19T13:37:25",
          "systemGenerated": false,
