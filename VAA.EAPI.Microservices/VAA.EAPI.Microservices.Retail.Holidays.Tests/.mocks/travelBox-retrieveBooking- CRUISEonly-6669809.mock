      "advNotes": [
        {
          "no": 1,
          "code": "Cruise bookings - Zika",
          "description": "Cruise bookings - Zika",
          "note": "Public Health England and NaTHNaC regularly review the transmission of Zika\nvirus (ZIKV) in many countries around the world, and update guidance for \ntravellers if appropriate. Following recent reports of Zika cases in your chosen \nholiday destination, pregnant women or those who are planning on becoming \npregnant, are advised to avoid travelling to until after pregnancy. Please check \nthe travelhealthpro.org.uk and/ or \nhttps://www.gov.uk/foreign-travel-advice websites before making your booking.",
          "dateModified": "2019-09-12T14:05:54",
          "external": true,
          "internal": true,
          "priority": "H",
          "itemInfo": [
            "CRU 1"
          ],
          "rules": [],
          "advised": true,
          "advisedTime": "2024-03-12T15:46:01",
          "modified": false,
          "noteId": 18799,
          "title": "Company - VHC,Division - VHCMP",
          "compulsory": true
        },
        {
          "no": 2,
          "code": "vhols booking app",
          "description": "Package Travel Regulations 2018",
          "note": "The combination of travel services offered to you is a package within\n the mean of the Package Travel and Linked Arrangements Regulations. \nTherefore, you will benefit from all the EU rights applying to the package.\nVirgin Holidays will be fully responsible for the proper performance of the\npackage as a whole. \n\nAdditionally, as required by law, Virgin Holidays has protection in place to\n refund your payments and, where transport is included in the package, to \nensure your repatriation in the event that it becomes insolvent. \n\nUnder the new regulations, you have Key Rights. Information about these \ncan be found with our terms and conditions on our website at\nwww.virginholidays.co.uk/important/terms-and-conditions.\n\nCan I also check that no one travelling has any medical conditions, dietary needs\nor severe allergies that we need to be made aware of, or do any travellers\nrequire special assistance?",
          "dateModified": "2026-01-05T11:04:39",
          "external": false,
          "internal": true,
          "priority": "H",
          "itemInfo": [
            "CRU 1"
          ],
          "rules": [],
          "advised": true,
          "advisedTime": "2024-03-12T15:45:58",
          "modified": false,
          "noteId": 19737,
          "title": "Brand - Fltonly,Brand - FltStore,Brand - GPO,Brand - VHIP,Brand - KIOSK,Brand - RWAPK,Brand - RWATO,Brand - STFTVL,Brand - TCD,Brand - VAA,Brand - WW",
          "compulsory": true
        },
        {
          "no": 3,
          "code": "Credit Card Authorisations - World",
          "description": "Credit Card Authorisations - World",
          "note": "Many worldwide hotels and cruise lines will pre-authorise between $50 and $500\non your credit or debit card per room, per night for room charges (i.e room service).\n\nAt the end of your holiday,  the authorisation will be released but these funds may\nnot be available immediately.",
          "dateModified": "2023-06-27T15:53:16",
          "external": true,
          "internal": true,
          "priority": "H",
          "itemInfo": [
            "CRU 1"
          ],
          "rules": [],
          "advised": true,
          "advisedTime": "2024-03-12T15:46:03",
          "modified": false,
          "noteId": 19743,
          "title": "Brand - GPO,Brand - STFTVL,Brand - TCD,Brand - VAA,Brand - WW",
          "compulsory": true
        },
        {
          "no": 4,
          "code": "FCDO Advice 1st March 2023 onwards",
          "description": "FCDO Advice 1st March 2023 onwards",
          "note": "Please check the Foreign, Commonwealth and Development Office for the\n latest information on safety and security, local laws, latest travel information.\n Please also ensure you have familiarised yourself and made relevant \narrangements based on the information on passport, entry requirements and \nvisa requirements on the Gov.UK site.\n\nDo check regularly as the advice can change. As you\u2019d expect, due to COVID-19\nyour travel experience may be different to what you might be used to so \nplease familiarise yourself with the changes that may have been put in place \nfor your stay.",
          "dateModified": "2024-03-29T16:35:51",
          "external": true,
          "internal": true,
          "priority": "H",
          "itemInfo": [
            "CRU 1"
          ],
          "rules": [],
          "advised": true,
          "advisedTime": "2024-03-12T15:45:59",
          "modified": false,
          "noteId": 24187,
          "title": "Company - VHC,Company - VHOLS,Brand - Fltonly,Brand - FltStore,Brand - GPO,Brand - VHIP,Brand - KIOSK,Brand - RWAPK,Brand - RWATO,Brand - STFTVL,Brand - VAA,Brand - VAA",
          "compulsory": true
        },
        {
          "no": 5,
          "code": "Infants - cruise lines",
          "description": "Infants - cruise lines",
          "note": "Please note maritime law states that babies who are not toilet \ntrained can not use cruise ship pools as a result the more family\nfriendly cruise lines have created splash areas which are easier to \nkeep clean thus offering a great place for babies in swim nappies to play. \nPlease check your specific cruise line for more details",
          "dateModified": "2023-03-27T14:58:41",
          "external": true,
          "internal": true,
