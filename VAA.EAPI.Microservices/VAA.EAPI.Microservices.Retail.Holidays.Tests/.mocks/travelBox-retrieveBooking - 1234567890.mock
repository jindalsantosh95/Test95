        },
        {
          "no": 8,
          "code": "Barbados Tax Levy",
          "description": "Barbados Tax Levy",
          "note": "A Tourism fee will be charged per bedroom, per night and will be collected at check\nout. The rate is subject to change by the Government, and varies by hotel room.\nFees currently range from \u200B\u200B\u200B\u200B8.75\u200B Barbadian dollar (approx \u00A33.90\u200B) to 35 Barbadian \ndollar\u200B (approx \u00A316.00) per bedroom, per night.",
          "dateModified": "2023-12-02T14:40:25",
          "external": true,
          "internal": true,
