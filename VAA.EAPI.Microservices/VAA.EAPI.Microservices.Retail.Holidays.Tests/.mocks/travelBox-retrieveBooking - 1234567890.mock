        },
        {
          "no": 2,
          "code": "Delta Airlines - Delta Comfort Plus not Premium Economy",
          "description": "Delta Airlines - Delta Comfort Plus not Premium Economy",
          "note": "On all domestic / US flights within North America there is no premium cabin with \nDelta. Should your confirmation invoice state this, you will in fact be seated in \nDelta\u2019s Comfort Plus section and would have been charged accordingly for Delta \nComfort Plus, we appreciate this technical glitch may cause confusion and are \nworking hard to resolve this as soon as possible. Please note this does not impact\n long-haul international flights with Delta.",
          "dateModified": "2023-06-06T16:52:38",
          "external": true,
          "internal": true,
          "priority": "H",
          "itemInfo": [
            "FLT 1"
