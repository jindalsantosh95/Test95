          "compulsory": true
        },
        {
          "no": 7,
          "code": "Low Occupancy - all caribbean destinations",
          "description": "Low Occupancy - all caribbean destinations",
          "note": "\u200BPlease note that during travel periods of low occupancy, hotels will often reduce\n the \u200B\u200Bnumber of restaurants open on a daily basis. Instead, restaurants will be \navailable on a rotational basis to ensure passengers can still enjoy the resorts \nbreadth of cuisine options during their stay. \u200B\n\nSpecific restaurant details will be provided locally in resort upon arrival, subject to\nchange.",
          "dateModified": "2022-02-25T16:59:41",
          "external": true,
          "internal": true,
          "priority": "H",
          "itemInfo": [
            "GEN 1",
            "FLT 1",
