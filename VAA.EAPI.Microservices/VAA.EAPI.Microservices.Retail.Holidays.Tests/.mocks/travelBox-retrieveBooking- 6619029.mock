                    "noteId": 0
                },
                {
                    "no": 7,
                    "type": "RESERVATION",
                    "note": "ood evening Mrs TestLNameOne\n\nI hope you're well, I did try to call but appreciate you are busy\n\nI understand you were speaking with our Bluewater team this afternoon regarding your exciting trip to Disney! \n\nI have requoted this here for you and attached the live costing here, please let me know if you have any questions or if you wish to get this secured\n\n\nThank you,\n\n\n\nSophie Mannering",
                    "displayName": "Sophie Mannering",
                    "dateModified": "2024-01-15T18:00:39",
