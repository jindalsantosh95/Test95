meta {
  name: Search Trips
  type: http
  seq: 1
}

post {
  url: {{trip_base_url}}/trips/search
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "using": "PNR",
    "confirmationNum": "{{confirmation_number}}",
    "encryptedConfirmationNum": "",
    "ticketNum": "",
    "creditCardNum": "",
    "loyaltyNum": "",
    "givenNames": "{{given_names}}",
    "surname": "{{surname}}",
    "departureAirportCode": "{{departure_airport_code}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
