  <ItemGroup>
    <ProjectReference Include="..\VAA.EAPI.Domain.Virgin\VAA.EAPI.Domain.Virgin.csproj" />
    <ProjectReference Include="..\VAA.EAPI.Infrastructure.PSS\VAA.EAPI.Infrastructure.PSS.csproj" />
    <ProjectReference Include="..\VAA.EAPI.Infrastructure\VAA.EAPI.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Constants\ErrorCodes.cs">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Compile>
  </ItemGroup>
