meta {
  name: Validate Password Policies
  type: http
  seq: 6
}

post {
  url: {{identity_base_url}}/ValidatePasswordPolicies
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "password": "{{new_password}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
