meta {
  name: Submit New Password
  type: http
  seq: 6
}

post {
  url: {{identity_base_url}}/SubmitNewPassword
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "continuationToken": "{{continuation_token}}",
    "password": "{{new_password}}",
    "email": "{{identity_email}}"
  }
}

script:post-response {
  var body = res.getBody();
  
  if (body && body.accessToken) {
    bru.setVar("access_token", body.accessToken);
  }
  if (body && body.refreshToken) {
    bru.setVar("refresh_token", body.refreshToken);
  }
  if (body && body.idToken) {
    bru.setVar("id_token", body.idToken);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
