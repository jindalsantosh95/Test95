meta {
  name: Complete Sign Up
  type: http
  seq: 2
}

post {
  url: {{identity_base_url}}/CompleteSignUp
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "{{identity_first_name}}",
    "lastName": "{{identity_last_name}}",
    "gender": "{{identity_gender}}",
    "dateOfBirth": "{{identity_date_of_birth}}",
    "password": "{{identity_password}}",
    "fcNumber": "{{identity_member_number}}",
    "customerId": "{{identity_customer_id}}",
    "customerType": "Loyalty",
    "status": "ACTIVE",
    "contactDetails": {
      "emailDetails": [
        {
          "emailId": "{{identity_email}}",
          "preferredFlag": "Y"
        }
      ],
      "phoneDetails": [
        {
          "countryCode": "{{identity_phone_country_code}}",
          "phoneNumber": "{{identity_phone_number}}",
          "preferredFlag": "Y"
        }
      ]
    },
    "addressDetails": [
      {
        "addressLine1": "{{identity_address_line1}}",
        "city": "{{identity_city}}",
        "country": "{{identity_country_code}}",
        "postalCode": "{{identity_postal_code}}",
        "preferredFlag": "Y"
      }
    ],
    "loyaltyMember": {
      "memberType": "Individual",
      "enrollmentChannel": "{{identity_enrolment_channel}}",
      "termsAndConditionsAccepted": true,
      "flyingClubCardNumber": "{{identity_member_number}}"
    },
    "preferences": [
      {
        "preferenceType": "VaGroupMarketingPermissions",
        "preferenceValue": "Y"
      }
    ],
    "continuationToken": "{{continuation_token}}"
  }
}

script:post-response {
  var body = res.getBody();
  
  if (body && body.accessToken) {
    bru.setVar("access_token", body.accessToken);
  }
  if (body && body.refreshToken) {
    bru.setVar("refresh_token", body.refreshToken);
  }
  if (body && body.idToken) {
    bru.setVar("id_token", body.idToken);
  }
  if (body && body.continuationToken) {
    bru.setVar("continuation_token", body.continuationToken);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
