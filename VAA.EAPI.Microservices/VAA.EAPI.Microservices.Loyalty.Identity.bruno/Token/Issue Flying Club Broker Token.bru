meta {
  name: Issue Flying Club Broker Token
  type: http
  seq: 3
}

post {
  url: {{identity_base_url}}/application-token
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:json {
  {
    "flyingClubAccountNumber": "{{identity_member_number}}",
    "callerApplicationId": "graphql-application-id"
  }
}

script:post-response {
  var body = res.getBody();
  var token = body?.accessToken ?? body?.value?.accessToken;

  if (typeof token === "string" && token.length > 0) {
    bru.setVar("flying_club_broker_token", token);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
