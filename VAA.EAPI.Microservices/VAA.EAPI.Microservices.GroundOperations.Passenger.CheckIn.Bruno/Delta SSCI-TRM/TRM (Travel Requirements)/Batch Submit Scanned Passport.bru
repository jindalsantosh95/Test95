meta {
  name: Batch Submit Scanned Passport
  type: http
  seq: 2
}

patch {
  url: {{delta_trm}}/requirements/{{requirement_resource_id}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  transactionId: VS-DigitalFirst-123-{{$guid}}
  clientId: {{ping_client_id}}
  configOptions: [{'nativeTravelDocs':'true'}]
  X-TRRM_VSDigital_Test: {{X-TRRM_VSDigital_Test}}
  AppChannelName: {{AppChannelName}}
  AppId: {{AppID}}
}

body:json {
  {"requests":[ 
      {
        "passengerResourceId": "{{passenger_resource_id1}}",
        "using": "PASSPORT",
        "identityDocument": {
          "type": "PASSPORT",
          "givenNames": "{{passenger_givenNames1}}",
          "surname": "{{passenger_surname1}}",
          "birthDate": "{{passenger_dob1}}",
          "gender": {
              "code": "M"
          },
          "number": "{{passport_number}}",
          "expirationDate": "2030-05-01",
          "issuingCountry": {
              "code": "{{passport_country}}"
          },
          "nationality": {
              "code": "{{passport_country}}"
          },
          "countryOfResidence": {
              "code": "{{passport_country}}"
          },
          "dataSourceType": "MACHINE_READABLE_ZONE",
          "methodOfDataEntry": "S",
          "status": "NOT_FOUND",
          "result": "SUCCESS",
          "sourceFromType": "PNR"
      },
      "consent": true,
      "modified": true,
      "saveToProfile": false
  }]}
}

script:post-response {
  var body = res.getBody();
  bru.setEnvVar("travel_requirements_response", JSON.stringify(body));
  
  const travelRequirements = body.travelRequirements ?? body;
  const passenger = travelRequirements.passengers?.find(
    passenger => passenger.passengerResourceId === bru.getVar("passenger_resource_id1")
  ) ?? travelRequirements.passengers?.[0];
  const tripId = bru.getVar("trip_resource_id1") ?? travelRequirements.trips?.[0]?.id;
  const governmentForm = passenger?.advancePassengerInformation
    ?.flatMap(information => information.passengerTripHealthRequirements ?? [])
    ?.find(requirement => requirement.tripId === tripId)
    ?.requirementCategories
    ?.find(category => category.type === "GOVERNMENT_FORMS")
    ?.requirements
    ?.flatMap(requirement => requirement.links ?? [])
    ?.find(link => link.id && link.linkId && link.text && link.href);
  
  if (governmentForm) {
    bru.setVar("government_form_id", governmentForm.id);
    bru.setVar("government_form_link_id", governmentForm.linkId);
    bru.setVar("government_form_text", governmentForm.text);
    bru.setVar("government_form_href", governmentForm.href);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

