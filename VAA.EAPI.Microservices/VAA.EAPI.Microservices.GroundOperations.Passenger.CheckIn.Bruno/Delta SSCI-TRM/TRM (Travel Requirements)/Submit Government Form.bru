meta {
  name: Submit Government Form
  type: http
  seq: 8
}

patch {
  url: {{delta_trm}}/requirements/{{requirement_resource_id}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  transactionId: VS-DigitalFirst-123-{{$guid}}
  clientId: {{ping_client_id}}
  X-TRRM_VSDigital_Test: {{X-TRRM_VSDigital_Test}}
  AppChannelName: {{AppChannelName}}
  AppId: {{AppID}}
}

body:json {
  {
    "requests": [
      {
        "passengerResourceId": "{{passenger_resource_id1}}",
        "tripId": "{{trip_resource_id1}}",
        "using": "SELF_DECLARATION_FORM",
        "consent": true,
        "modified": false,
        "saveToProfile": false,
        "documentForm": {
          "digitalVerificationEligible": false,
          "link": {
            "id": "{{government_form_id}}",
            "linkId": "{{government_form_link_id}}",
            "text": "{{government_form_text}}",
            "href": "{{government_form_href}}"
          }
        }
      }
    ]
  }
}

script:post-response {
  var body = res.getBody();
  bru.setVar("travel_requirements_response", JSON.stringify(body));
}

settings {
  encodeUrl: true
  timeout: 0
}
