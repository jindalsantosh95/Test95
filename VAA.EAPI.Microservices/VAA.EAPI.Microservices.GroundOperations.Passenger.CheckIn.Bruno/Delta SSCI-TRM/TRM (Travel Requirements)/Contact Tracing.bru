meta {
  name: Contact Tracing
  type: http
  seq: 3
}

patch {
  url: {{delta_trm}}/requirements/{{requirement_resource_id}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  transactionId: VS-DigitalFirst-123-{{$guid}}
  clientId: {{ping_client_id}}
  X-TRRM_VSDigital_Test: {{X-TRRM_VSDigital_Test}}
  AppChannelName: {{AppChannelName}}
  AppId: {{AppID}}
}

body:json {
  {
      "requests": [
          {
              "passengerResourceId": "{{passenger_resource_id1}}",
              "tripId": "{{trip_resource_id1}}",
              "using": "CONTACT_TRACING",
              "contactInformation": [
                  {
                      "address": {
                          "streetAddress": "1293 Contact Tracing Blvd",
                          "countryCode": "USA",
                          "stateCode": "MN",
                          "cityCode": "ATL",
                          "zipCode": "55068"
                      },
                      "email": [
                          {
                              "value": "contacttracing@example.com"
                          }
                      ],
                      "phone": [
                          {
                              "type": "HOME",
                              "preference": "PRIMARY",
                              "countryCode": "1",
                              "phoneNumber": "2668228"
                          }
                      ]
                  }
              ]
          }
      ]
  }
}

script:post-response {
  var body = res.getBody();
  bru.setEnvVar("travel_requirements_response", JSON.stringify(body));
}

settings {
  encodeUrl: true
  timeout: 0
}
