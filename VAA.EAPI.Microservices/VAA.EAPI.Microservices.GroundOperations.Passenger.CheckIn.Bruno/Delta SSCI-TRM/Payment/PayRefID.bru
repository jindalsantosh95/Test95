script:post-response {
  var json = res.getBody();
  if (json.paymentReferenceId)
  {
    console.log("https://enterprisepaymentshpp-si.vs01.vs.air4.com:443/hpp?paymentReferenceId=" + json.paymentReferenceId + "&channelId=DFMOBILE&appId=D2&purchasePath=DFMOBILEOCI");
    console.log("Suggested cards: 5101081046006034 (GBP) or 5333308664112277 (USD)");
  }
  else {
    console.log('failed to generate paymentReferenceId')
  }
  
  bru.setVar("paymentReferenceId", json.paymentReferenceId)
}

settings {
  encodeUrl: true
  timeout: 0
}

