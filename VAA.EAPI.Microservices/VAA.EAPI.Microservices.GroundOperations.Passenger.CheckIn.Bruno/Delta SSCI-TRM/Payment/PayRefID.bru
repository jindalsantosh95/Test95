meta {
  name: PayRefID
  type: http
  seq: 4
}

post {
  url: https://stage-snsapigateway2.vs01.vs.air4.com/paymentManagement/v1/paymentReferenceId
  body: json
  auth: inherit
}

headers {
  channelId: DFMOBILE
  appID: D2
  Content-Type: application/json
  purchasePath: DFMOBILEOCI
  ~Content-Type: application/x-www-form-urlencoded
}

