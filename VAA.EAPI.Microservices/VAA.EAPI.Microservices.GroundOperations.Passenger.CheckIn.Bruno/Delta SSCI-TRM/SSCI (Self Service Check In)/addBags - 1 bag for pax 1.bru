meta {
  name: addBags - 1 bag for pax 1
  type: http
  seq: 10
}

post {
  url: {{delta_ssci}}/{{travelparty_id}}/addBags
  body: json
  auth: inherit
}

body:json {
  {
    "checkedBagsCount": [
      "1"
    ],
    "specialItemFlag": [
      "false"
    ],
    "totalOfferItemid": [
      "{{pax1_bag1_offerid}}"
    ],
    "totalMilesFee": [
      "0"
    ],
    "totalBagFee": [
      "{{pax1_bag1_price}}"
    ],
    "passengerNin": [
      "{{pax1_Nin}}"
    ]
  }
}

script:post-response {
  bru.setVar("pending_payment", bru.getVar("pax1_bag1_price") > 0);
  console.log(bru.getVar("pax1_bag1_price") > 0);
}

settings {
  encodeUrl: true
  timeout: 0
}
