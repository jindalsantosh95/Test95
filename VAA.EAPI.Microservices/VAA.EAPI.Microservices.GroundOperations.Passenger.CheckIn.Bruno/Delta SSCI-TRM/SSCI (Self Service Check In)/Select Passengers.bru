meta {
  name: Select Passengers
  type: http
  seq: 3
}

patch {
  url: {{delta_ssci}}/{{travelparty_id}}
  body: json
  auth: inherit
}

headers {
  appid: OCI
}

body:json {
  {
      "selectedPassenger": [
          {
              "id": "{{pax1_passengerid}}",
              "customerId": "{{pax1_customerid}}",
              "firstNIN": "{{pax1_firstnin}}",
              "lastNIN": "{{pax1_lastnin}}"
          }
      ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
