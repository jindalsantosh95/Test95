      "hotel": {
        "id": "H2307",
        "content": {
          "name": "Hilton Dubai The Walk",
          "virginView": "Across the road from the Hilton Dubai Jumeirah, Hilton Dubai The Walk is located on &#x2018;The Walk&#x2019; in the ever popular &#x2018;JBR&#x2019; beachfront avenue of boutiques, al fresco restaurants and modern day Arabic culture. Studios and apartments are very spacious making them a great choice for families. The hotel boasts its own swimming pool and four restaurants serving snacks, buffets and &#xe0; la carte specialities. Guests can also make use of all facilities of the Hilton Dubai Jumeirah including the private beach, spa and recreation facilities, kids' club and restaurants, including the award winning Vero Ristorante serving delicious Italian fare, Oceana for all-day buffet dining and themed evenings and Wavebreaker &#x2013; a relaxed beach bar and grill just steps from the beach. For signature cocktails and Latin music we recommend you head to Trader Vic&#x2019;s for a great evening experience.",
          "telephoneBookableOnly": false,
          "vRating": "4",
          "hotelDescription": "Across the road from the Hilton Dubai Jumeirah, Hilton Dubai The Walk is located on &#x2018;The Walk&#x2019; in the ever popular &#x2018;JBR&#x2019; beachfront avenue of boutiques, al fresco restaurants and modern day Arabic culture. Studios and apartments are very spacious making them a great choice for families.",
          "atAGlance": [
            "Convenient location",
            "An array of cuisine offered",
            "Contemporary studios and apartment accommodation",
            "Rooftop bar with panoramic views over the Arabian Peninsula",
            "Access to facilities at Hilton Dubai Jumeirah, including private beach"
          ],
