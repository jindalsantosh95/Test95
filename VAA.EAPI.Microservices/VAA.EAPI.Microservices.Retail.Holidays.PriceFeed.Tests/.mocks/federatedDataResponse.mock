    {
      "hotel": {
        "id": "JP06975X58047",
        "content": {
          "name": "Vida Dubai Marina & Yacht Club",
          "virginView": "Stays in Dubai marina give the perfect combination of a city and beach break in one, and here you couldn't be better positioned for both. Direct access to the marina promenade means you can stroll (or cycle with the complimentary bikes) around to your hearts content, enjoying a range of restaurants in the area as well as Dubai Marina Mall. But you're also just a short drive from Marina Beach where you can soak up the sun, dip your toes in the sea and find a host of entertainment from watersports to inflatable water slides. Back at the hotel your room offers stunning city and marina views, a modern feel, and our favourite - a stunning infinity pool. If you're travelling with kids, then there's plenty of recreational and creative activities going on for them at Qix Club too, so you can sneak off for a drink at Flo, or a workout in the fitness centre.",
          "telephoneBookableOnly": false,
          "vRating": "4",
          "hotelDescription": "",
          "atAGlance": [
            "Prime location in Dubai's marina",
            "Infinity pool with marina views",
            "Complimentary bicycle rental",
            "Kids club",
            "3 restaurants and bar"
          ],
