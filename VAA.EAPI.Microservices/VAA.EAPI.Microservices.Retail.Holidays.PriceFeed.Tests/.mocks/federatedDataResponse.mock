    {
      "hotel": {
        "id": "H2285",
        "content": {
          "name": "JA Ocean View Hotel Jumeirah Beach",
          "virginView": "JA Ocean View Hotel Jumeirah Beach proudly overlooks the Arabian Gulf with stunning views over Blue Water Island and Palm Jumeirah. Each guest room is furnished to the highest standard and gorgeous sea views and balconies. Head outdoors to the infinity swimming pool to cool off or laze beside in oversized loungers. There&#x2019;s a separate kids' pool with shade cover so children can play to their hearts content too. Fitness enthusiasts will love the state-of-the-art health club complete with Jacuzzi, steam room and sauna or pamper yourself at the spa, offering a plethora of tempting treatments to leave you feeling on top of the world! Shopping enthusiasts are in luck too as Beach Mall is directly opposite the hotel and Marina Mall is a short distance away. There are some superb restaurants in Dubai and none more so than at the Ocean View, offering a choice of 5 restaurants and bars.",
          "telephoneBookableOnly": false,
          "vRating": "4+",
          "hotelDescription": "The popular JA Ocean View proudly overlooks the Arabian Gulf and Palm Jumeirah. Located on \"The Walk\" Dubai's outdoor shopping mile with restaurants, cafes and shops. As well as being close to the Dubai Marina and only a few steps from a great public beach. This is the perfect location to be in the heart of the action.",
          "atAGlance": [
            "Infinity pool and separate kids' pool",
            "5 restaurants and bars",
            "Kids' Club from 4-12 years",
            "Complimentary access to private beach"
          ],
          "location": {
            "lat": 25.073547,
            "lon": 55.130157
          },
          "parentLocation": "Dubai Beach, Dubai",
