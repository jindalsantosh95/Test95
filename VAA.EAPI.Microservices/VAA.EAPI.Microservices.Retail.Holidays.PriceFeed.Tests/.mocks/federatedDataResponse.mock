    {
      "hotel": {
        "id": "H0361",
        "content": {
          "name": "Jumeirah Mina Al Salam",
          "virginView": "The Jumeirah Mina Al Salam, meaning 'harbour of peace', forms the gateway to Madinat Jumeirah - The Arabian Resort of Dubai. Designed as a tribute to Dubai's sea-faring past, it is a harbourside hotel from which waterways and walkways extend to all parts of the complex including nine restaurants and bars, the award-winning Talise Spa and a traditional-style Souk Madinat Jumeirah featuring 75 boutique shops, bars and caf&#xe9;s. Traditional Middle Eastern style and luxurious modernity create a haven of Arabian warmth, and the spacious guest rooms are beautifully furnished with private balconies overlooking the sea.",
          "telephoneBookableOnly": false,
          "vRating": "5",
          "hotelDescription": "",
          "atAGlance": [
            "Part of Madinat Jumeirah Resort",
            "Complimentary access to Wild Wadi Waterpark&#x212;",
            "Water taxi available to navigate around resort",
            "Award-winning Talise Spa"
          ],
          "location": {
            "lat": 25.135118,
            "lon": 55.18596
          },
          "parentLocation": "Dubai Beach, Dubai",
          "images": [
            {
              "RESULTS_CAROUSEL": {
                "url": "//d3hk78fplavsbl.cloudfront.net/assets/common-prod/hotel/205/17583/17583-1-results_carousel.jpg?version=2"
              },
