    {
      "hotel": {
        "id": "JP39072L124794",
        "content": {
          "name": "SO/ Ras Al Khaimah",
          "virginView": "Set on Al Marjan Island, SO/ Ras Al Khaimah Hotel &amp; Resort is a bold, design-led beachfront escape that brings fashion, art and all-inclusive living together in one striking setting. This newly opened resort blends avant-garde architecture with a relaxed beachside rhythm, where days move easily between infinity pools, curated dining experiences and a vibrant lifestyle scene by the sea. Every room and suite looks out over the Arabian Gulf, while the ultra all-inclusive concept elevates the experience with premium dining, stylish bars and a packed programme of entertainment, wellness and creative workshops. Whether you&#x2019;re here to switch off, socialise or soak up something a little different, this is Ras Al Khaimah with attitude - confident, contemporary and anything but ordinary.",
          "telephoneBookableOnly": false,
          "vRating": "5",
          "hotelDescription": "",
          "atAGlance": [
            "Newly opened Ultra All Inclusive lifestyle resort on Al Marjan Island",
            "Direct beachfront setting with uninterrupted Arabian Gulf sea views",
            "Two swimming pools",
            "Wellness club with spa, gym, and complimentary fitness classes",
            "Kids' and teens' programmes with creative and active experiences"
          ],
