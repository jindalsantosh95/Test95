      "hotel": {
        "id": "JP01928876841",
        "content": {
          "name": "Rixos The Palm Dubai Hotel and Suites",
          "virginView": "Located on the Eastern tip of the iconic Palm Jumeirah and ready to impress is Rixos The Palm Dubai, an Ultra All Inclusive resort boasting impeccable service, 11 bars and restaurants, and its own stretch of private beach. When you&#x2019;re not admiring the panoramic views of the Dubai skyline and Arabian Gulf, there are four heated pools to enjoy, as well as a range of beach and water activities and a classy spa. One of the most child-friendly hotels in Dubai, your little ones will adore Rixy Kids Club and its exciting calendar of events, and there&#x2019;s also a large pool for the whole family to enjoy.",
          "telephoneBookableOnly": false,
          "vRating": "5",
          "hotelDescription": "",
          "atAGlance": [
            "All Inclusive hotel on the iconic Palm Jumeirah",
            "Private beach with Arabian Gulf and Dubai skyline views",
            "10 restaurants and bars",
            "Family friendly",
            "Complimentary Access to the World's Largest Waterpark (until 31 December 2026)"
          ],
