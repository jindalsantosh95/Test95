    {
      "hotel": {
        "id": "JP02647T58047",
        "content": {
          "name": "Rixos Premium Dubai JBR",
          "virginView": "If you&#x2019;re going to do Dubai, do it properly. Rixos Premium Dubai JBR is where skyline views, swanky beach clubs and next-level service come together in one seriously glamorous spot. Sat right on Jumeirah Beach Residence, one of the city&#x2019;s hottest strips, this five-star stunner is the place to be (and be seen). You&#x2019;re steps from The Walk at JBR, close to the Marina, and just a quick hop from Dubai&#x2019;s biggest and best malls. But let&#x2019;s be honest you&#x2019;ll probably spend most of your time poolside at the legendary Azure Beach Club, or beachside on the hotel&#x2019;s private stretch of sand. There are nine (yes, nine) restaurants and bars to work your way through from beachy Greek eats at Ammos to ultra-slick cocktails at Lock, Stock &amp; Barrel. No chance you&#x2019;ll go hungry here. Whether you&#x2019;re here for the beach, the buzz, or the brunches, Rixos Premium Dubai JBR serves up Dubai&#x2019;s high-life energy with a side of proper pampering.",
          "telephoneBookableOnly": false,
          "vRating": "5",
          "hotelDescription": "",
          "atAGlance": [
            "Prime beachfront location",
            "Stylish rooms and suites",
            "Bold nightlife at Azure Beach",
            "Award-winning Naturelife Spa Premium"
          ],
          "location": {
            "lat": 25.08009,
            "lon": 55.135864
          },
          "parentLocation": "Dubai, United Arab Emirates",
          "images": [
            {
              "RESULTS_CAROUSEL": {
                "url": "//d3hk78fplavsbl.cloudfront.net/assets/common-prod/hotel/300/jp02647t58047/jp02647t58047-1-results_carousel.jpg?version=2"
              },
              "MOBILE_MAIN": {
                "url": "//d3hk78fplavsbl.cloudfront.net/assets/common-prod/hotel/205/jp02647t58047/jp02647t58047-1-mobile_main.jpg?version=2"
