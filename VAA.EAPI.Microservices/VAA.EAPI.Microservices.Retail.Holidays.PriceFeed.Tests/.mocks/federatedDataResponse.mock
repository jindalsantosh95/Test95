    {
      "hotel": {
        "id": "H0499",
        "content": {
          "name": "Rixos Al Mairid Ras Al Khaimah Resort",
          "virginView": "The Rixos Al Mairid Ras Al Khaimah sits on a private sandy beach just over an hour away from Dubai city centre, delivering the utmost in service, accommodation and amenities. With a spectacular private bay on the north tip of the Arabian Peninsula, you&#x2019;ll be overlooking the stunning, sandy beach and calm clear waters that are ideal for a splash about in. Perhaps you&#x2019;ll just grab a towel and relax by the zero-entry pool, while the kids enjoy the waterslide at their own pool and complimentary access to their own club with fantastic indoor and outdoor play areas. And to round out the day, you&#x2019;ll have a choice of restaurants to enjoy so no meal will be the same as the last. Perfect.",
          "telephoneBookableOnly": false,
          "vRating": "5",
          "hotelDescription": "The Hilton Ras Al Khaimah sits on a private sandy beach just over an hour away from Dubai city centre, delivering the utmost in service, accommodation and amenities. With a spectacular private bay on the north tip of the Arabian Peninsula, you&#x2019;ll be overlooking the stunning, sandy beach and calm clear waters that are ideal for a splash about in. Perhaps you&#x2019;ll just grab a towel and relax by the zero-entry pool, while the kids enjoy the waterslide at their own pool and complimentary access to their own club with fantastic indoor and outdoor play areas. And to round out the day, you&#x2019;ll have a choice of restaurants to enjoy so no meal will be the same as the last. Perfect.",
          "atAGlance": [
            "Located at the tip of the Arabian Peninsula",
            "9 restaurants and bars",
            "Beach club",
            "7 outdoor pools"
          ],
          "location": {
            "lat": 25.814316,
            "lon": 55.957737
          },
