meta {
  name: Search SVC Orders
  type: http
  seq: 1
}

post {
  url: {{order_data_base_url}}/svc/orders/search
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "pnr": "{{pnr}}",
    "firstName": "{{first_name}}",
    "lastName": "{{last_name}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
