meta {
  name: Trips Search Query
  type: graphql
  seq: 2
}

post {
  url: {{graphql_url}}
  body: graphql
  auth: inherit
}

body:graphql {
  query Booking {
    Booking(
      tripDetailsRequest: {
        using: PNR
        confirmationNum: "{{pnrLocator}}"
        encryptedConfirmationNum: null
        ticketNum: null
        creditCardNum: null
        loyaltyNum: null
        givenNames: "{{givenNames}}"
        surname: "{{surname}}"
        departureAirportCode: "{{originAirportCode}}"
        bookingReference: null
        dateOfBirth: null
      }
    ) {
      status
      id
      pos {
        countryCode
        cityCode
        currencyCode
      }
      tripSearchRequest {
        givenNames
        surname
        pnrLocator
