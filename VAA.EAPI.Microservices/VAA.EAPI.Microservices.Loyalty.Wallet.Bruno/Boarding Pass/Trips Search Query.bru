              countryCode
            }
            destination {
              terminalName
              code
              airportName
              cityName
              countryName
              countryCode
            }
            actionCode
            legs {
              id
              operating {
                flightNumber
                carrierCode
                carrierName
                operationalSuffix
              }
              marketing {
                flightNumber
                carrierCode
                carrierName
                operationalSuffix
              }
              scheduledDepartureLocalDateTime
              scheduledDepartureUtcDateTime
              scheduledArrivalLocalDateTime
              scheduledArrivalUtcDateTime
