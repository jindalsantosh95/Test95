}

tests {
  const body = res.getBody();
  
  // runtime var
  const originAirportCode = bru.getVar("originAirportCode");
  
  const destinationAirportCode = bru.getVar("destinationAirportCode");
  
  // response slices
  const slices = body.data.Booking.product?.[0]?.slices || [];
  
  // find matching slice
  const matchedSlice = slices.find(slice =>
    slice.origin?.code === originAirportCode && slice.destination?.code === destinationAirportCode
  );
  
   if (!matchedSlice || !matchedSlice.segments?.length) {
       throw new Error(`No segments found for slice ${originAirportCode}->${destinationAirportCode}.`);
     }
  
  bru.setVar("scheduledDepartureLocalDateTime", matchedSlice.segments[0].scheduledDepartureLocalDateTime.replace(".000Z", ""));
  bru.setVar( "scheduledArrivalLocalDateTime", matchedSlice.segments[0].scheduledArrivalLocalDateTime.replace(".000Z", ""));
  
  bru.setVar("ordinal", matchedSlice.segments[0].ordinal);
  
  bru.setVar("opCarrierCode", matchedSlice.segments[0].operatingCarrier.carrierCode);
  bru.setVar("opCarrierFlightNum", matchedSlice.segments[0].operatingCarrier.flightNumber);
  bru.setVar("opCarrierName", matchedSlice.segments[0].operatingCarrier.carrierName);
  
  bru.setVar("mkCarrierCode", matchedSlice.segments[0].marketingCarrier.carrierCode);
  bru.setVar("mkCarrierFlightNum", matchedSlice.segments[0].marketingCarrier.flightNumber);
  bru.setVar("mkCarrierName", matchedSlice.segments[0].marketingCarrier.carrierName);
  
  bru.setVar("segOriginCode", matchedSlice.segments[0].origin.code);
  bru.setVar("segOriginAirportName", matchedSlice.segments[0].origin.airportName);
  bru.setVar("segOriginCountryCode", matchedSlice.segments[0].origin.countryCode);
  bru.setVar("segOriginTerminalName", matchedSlice.segments[0].origin.terminalName);
  
  bru.setVar("segDestCode", matchedSlice.segments[0].destination.code);
  bru.setVar("segDestAirportName", matchedSlice.segments[0].destination.airportName);
  bru.setVar("segDestCountryCode", matchedSlice.segments[0].destination.countryCode);
  bru.setVar("segDestTerminalName", matchedSlice.segments[0].destination.terminalName);
  
  
  const passenger = body.data.Booking.passengers?.[0];
  
  if (!passenger) {
       throw new Error("No passenger found in Booking response.");
     }
  
  bru.setVar("firstName", passenger.firstName);
  bru.setVar("lastName", passenger.lastName);
  bru.setVar("firstNameNumber", passenger.firstNameNumber);
  bru.setVar("lastNameNumber", passenger.lastNameNumber);
  
}

settings {
  encodeUrl: true
  timeout: 0
}
