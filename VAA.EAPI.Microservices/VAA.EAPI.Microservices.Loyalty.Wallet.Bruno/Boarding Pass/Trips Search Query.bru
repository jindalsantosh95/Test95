            estimatedDepartureLocalDateTime
            estimatedDepartureUtcDateTime
            estimatedArrivalLocalDateTime
            estimatedArrivalUtcDateTime
            actualDepartureLocalDateTime
            actualDepartureUtcDateTime
            actualArrivalLocalDateTime
            actualArrivalUtcDateTime
            scheduledDepartureUtc
            scheduledArrivalUtc
            estimatedDepartureUtc
            estimatedArrivalUtc
            actualDepartureUtc
            actualArrivalUtc
            scheduledDepartureLocal
            scheduledArrivalLocal
            scheduledArrivalBasedOnDepartureLocal
            estimatedDepartureLocal
            estimatedArrivalLocal
            actualDepartureLocal
            actualArrivalLocal
            layoverDuration
            origin {
              terminalName
              code
              airportName
              cityName
              countryName
              countryCode
            }
            destination {
              terminalName
              code
              airportName
              cityName
              countryName
              countryCode
            }
            actionCode
            flightSegmentId
            operating {
              flightNumber
              carrierCode
              carriername
            }
            marketing {
              flightNumber
              carrierCode
              carriername
            }
            checkinStatus
            duration
            fareBasisCode
            seatEligible
            operationalStatus {
              type
              subType
              rebookEligible
            }
            checkedIn
            isLayoverDurationValid
          }
          checkinStatus
          duration
          checkInEligible
          checkInOpens
          scheduledDepartureLocal
          scheduledArrivalLocal
          scheduledArrivalBasedOnDepartureLocal
          estimatedDepartureLocal
          estimatedArrivalLocal
          actualDepartureLocal
          actualArrivalLocal
          checkInOpensLocal
          scheduledDepartureUtc
          scheduledArrivalUtc
          estimatedDepartureUtc
          estimatedArrivalUtc
          actualDepartureUtc
          actualArrivalUtc
        }
        leadPassenger
