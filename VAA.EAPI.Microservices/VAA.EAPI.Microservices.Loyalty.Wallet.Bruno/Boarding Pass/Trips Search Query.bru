          origin {
            terminalName
            code
            airportName
            cityName
            countryName
            countryCode
          }
          destination {
            terminalName
            code
            airportName
            cityName
            countryName
            countryCode
          }
          segments {
            id
            operationalStatus {
              type
              subType
              rebookEligible
            }
            ordinal
            operatingCarrier {
              flightNumber
              carrierCode
              carrierName
              operationalSuffix
            }
            marketingCarrier {
              flightNumber
              carrierCode
              carrierName
              operationalSuffix
            }
            scheduledDepartureLocalDateTime
            scheduledDepartureUtcDateTime
            scheduledArrivalLocalDateTime
            scheduledArrivalUtcDateTime
            scheduledArrivalBasedOnDepartureLocalDateTime
            estimatedDepartureLocalDateTime
            estimatedDepartureUtcDateTime
            estimatedArrivalLocalDateTime
            estimatedArrivalUtcDateTime
