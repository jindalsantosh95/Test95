              estimatedArrivalLocalDateTime
              estimatedArrivalUtcDateTime
              actualDepartureLocalDateTime
              actualDepartureUtcDateTime
              actualArrivalLocalDateTime
              actualArrivalUtcDateTime
              scheduledDepartureUtc
              scheduledArrivalUtc
