        }
        firstName
        slices {
          id
          distanceMiles
          ordinal
          scheduledDepartureLocalDateTime
          scheduledDepartureUtcDateTime
          scheduledArrivalLocalDateTime
          scheduledArrivalUtcDateTime
          scheduledArrivalBasedOnDepartureLocalDateTime
          estimatedDepartureLocalDateTime
          estimatedDepartureUtcDateTime
          estimatedArrivalLocalDateTime
          estimatedArrivalUtcDateTime
          actualDepartureLocalDateTime
          actualDepartureUtcDateTime
          actualArrivalLocalDateTime
          actualArrivalUtcDateTime
          origin {
            terminalName
            code
            airportName
            cityName
            countryName
            countryCode
          }
          segments {
            id
            ordinal
            operatingCarrier {
              flightNumber
              carrierCode
              carrierName
              operationalSuffix
            }
            marketingCarrier {
              flightNumber
              carrierCode
              carrierName
              operationalSuffix
            }
            scheduledDepartureLocalDateTime
            scheduledDepartureUtcDateTime
            scheduledArrivalLocalDateTime
            scheduledArrivalUtcDateTime
