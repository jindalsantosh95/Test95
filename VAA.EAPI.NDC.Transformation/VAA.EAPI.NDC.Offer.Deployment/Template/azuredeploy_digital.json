{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environment": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "functionappName": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "AppInsightsName": {
      "type": "string"
    },
    "aseRg": {
      "type": "string"
    },
    "aseName": {
      "type": "string"
    },
    "keyVaultName": {
      "type": "string"
    },
    "tags": {
      "type": "object"
    },
    "SlotName": {
      "type": "string"
    },
    "WEBSITE_DNS_SERVER": {
      "type": "string"
    },
    "WEBSITE_DNS_ALT_SERVER": {
      "type": "string"
    },
    "WEBSITE_LOAD_USER_PROFILE": {
      "type": "string"
    },
    "WEBSITE_RUN_FROM_PACKAGE": {
      "type": "string"
    },
    "Appsetting:OpenApi__Scope": {
      "type": "string"
    },
    "Appsetting:OpenApi__TokenUrl": {
      "type": "string"
    },
    "Appsetting:OpenApi__DocTitle": {
      "type": "string"
    },
    "Appsetting:OpenApi__Description": {
      "type": "string"
    },
    "Appsetting:OpenApi__DocVersion": {
      "type": "string"
    },
    "Appsetting:OpenApi__Version": {
      "type": "string"
    },
    "Appsetting:OpenApi__ForceHttps": {
      "type": "string"
    },
    "Appsetting:OpenApi__ForceHttp": {
      "type": "string"
    },
    "Appsetting:OpenApi__HostNames": {
      "type": "string"
    },
    "storageaccountName": {
      "type": "string"
    },
    "LAW_RESOURCE_GROUP_NAME": {
      "type": "string"
    },
    "WORKSPACE_NAME": {
      "type": "string"
    },
    "workspaceResourceId": {
      "type": "string"
    },
    "ValidationMSUrl": {
      "type": "string"
    },
    "ValidationMSSubscriptionKey": {
      "type": "string"
    },
    "AgentRegistrationEnvironment": {
      "type": "string"
    },
    "OfferSearchEndPoint": {
      "type": "string"
    },
    "OfferPriceMSEndpoint": {
      "type": "string"
    },
    "AirshoppingOfferEndpoint": {
      "type": "string"
    },
    "CalendarSearchEndpoint": {
      "type": "string"
    },
    "OfferMSSubscriptionKey": {
      "type": "string"
    },
    "AppChannelName": {
      "type": "string"
    },
    "DebugOptions": {
      "type": "string"
    },
    "HistoryOnFlag": {
      "type": "string"
    },
    "BrandMSUrl": {
      "type": "string"
    },
    "BrandMSSubscriptionKey": {
      "type": "string"
    },
    "ConfigurationMSBSPMarketCurrencyEndpoint": {
      "type": "string"
    },
    "ConfigurationMSBSPMarketPaymentEndpoint": {
      "type": "string"
    },
    "ConfigurationMSPccCurrencyEndpoint": {
      "type": "string"
    },
    "ConfigurationMSITAFareTypeCodeEndpoint": {
      "type": "string"
    },
    "ConfigurationMSTtlRulesEndpoint": {
      "type": "string"
    },
    "ConfigurationMSTtlEnabledCityEndpoint": {
      "type": "string"
    },
    "ConfigurationMSClidEndpoint": {
      "type": "string"
    },
    "SeatMSUrl": {
      "type": "string"
    },
    "SeatMSSubscriptionKey": {
      "type": "string"
    },
    "seatOfferIDMaxLength": {
      "type": "string"
    },
    "FlightServicesMSUrl": {
      "type": "string"
    },
    "FlightServicesMSSubscriptionKey": {
      "type": "string"
    },
    "OrderDataMSEndpoint": {
      "type": "string"
    },
    "OrderDataMSSubscriptionKey": {
      "type": "string"
    },
    "OrderReshopEndpoint": {
      "type": "string"
    },
    "OfferMSReshopNameCorrectionEndpoint": {
      "type": "string"
    },
    "ConfigurationMSPricingLocationEndpoint": {
      "type": "string"
    },
    "ConfigurationMSReshopFareFamilyEndpoint": {
      "type": "string"
    },
    "ConfigurationMSFareFamilyEndpoint": {
      "type": "string"
    },
    "ConfigurationMSPOSCurrencyEndpoint": {
      "type": "string"
    },
    "ConfigurationMSUpsellOffersEndpoint": {
      "type": "string"
    },
    "ConfigurationMSOcpKey": {
      "type": "string"
    },
    "CheckAgentTktAuthority": {
      "type": "bool"
    },
    "Analytics:ServiceBus:ConnectionString": {
      "type": "string"
    },
    "Air4OrderSearchMSUrl": {
      "type": "string"
    },
    "Air4OrderSearchMSSubscriptionKey": {
      "type": "string"
    },
    "OrderSearchMSUrl": {
      "type": "string"
    },
    "OrderSearchMSSubscriptionKey": {
      "type": "string"
    },
    "SkipGdsAgentValidation": {
      "type": "string"
    },
    "resourceurl": {
      "type": "string"
    },
    "resourceurlPost": {
      "type": "string"
    },
    "RedisCacheConnectionString": {
      "type": "string"
    },
    "ReferenceMSAirportDetailsEndpoint": {
      "type": "string"
    },
    "ReferenceMSOcpKey": {
      "type": "string"
    },
    "OrderQuoteEndpoint": {
      "type": "string"
    },
    "OfferMSReshopCancelEndpoint": {
      "type": "string"
    },
    "ReshopDisruptionTicketValidityWindowInDays": {
      "type": "string"
    },
    "ValidationMSHeartBeatUrl": {
      "type": "string"
    },
    "ConfigMSHeartBeatUrl": {
      "type": "string"
    },
    "OfferMSHeartBeatUrl": {
      "type": "string"
    },
    "BrandMSHeartBeatUrl": {
      "type": "string"
    },
    "SeatMSHeartBeatUrl": {
      "type": "string"
    },
    "FlightServicesMSHeartBeatUrl": {
      "type": "string"
    },
    "OrderDataMSHeartBeatUrl": {
      "type": "string"
    },
    "Air4OrderSearchMSHeartBeatUrl": {
      "type": "string"
    },
    "OrderSearchMSHeartBeatUrl": {
      "type": "string"
    },
    "ReferenceMSHeartBeatUrl": {
      "type": "string"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2021-09-01",
      "name": "[parameters('storageaccountName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "Standard_RAGRS",
        "tier": "Standard"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[parameters('AppInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[parameters('workspaceResourceId')]"
      },
      "dependsOn": []
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2018-11-01",
      "name": "[parameters('functionappName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "functionapp",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "enabled": true,
        "serverFarmId": "[resourceId(parameters('aseRg'), 'Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "hostingEnvironmentProfile": "[resourceId(parameters('aseRg'), 'Microsoft.Web/hostingEnvironments', parameters('aseName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "appSettings": [
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', parameters('storageaccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageaccountName')), '2019-06-01').keys[0].value)]"
            }
          ]
        },
        "scmSiteAlsoStopped": false,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNamesDisabled": false,
        "containerSize": 1536,
        "dailyMemoryTimeQuota": 0,
        "httpsOnly": true,
        "redundancyMode": "None"
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2018-11-01",
      "name": "[concat(parameters('functionappName'), '/web')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionappName'))]"
      ],
      "properties": {
        "numberOfWorkers": 1,
        "defaultDocuments": [
          "Default.htm",
          "Default.html",
          "Default.asp",
          "index.htm",
          "index.html",
          "iisstart.htm",
          "default.aspx",
          "index.php"
        ],
        "netFrameworkVersion": "v10.0",
        "phpVersion": "5.6",
        "requestTracingEnabled": false,
        "remoteDebuggingEnabled": false,
        "httpLoggingEnabled": false,
        "logsDirectorySizeLimit": 35,
        "detailedErrorLoggingEnabled": false,
        "publishingUsername": "[parameters('functionappName')]",
        "azureStorageAccounts": {},
        "scmType": "None",
        "use32BitWorkerProcess": false,
        "webSocketsEnabled": false,
        "alwaysOn": true,
        "managedPipelineMode": "Integrated",
        "virtualApplications": [
          {
            "virtualPath": "/",
            "physicalPath": "site\\wwwroot",
            "preloadEnabled": false
          }
        ],
        "loadBalancing": "LeastRequests",
        "experiments": {
          "rampUpRules": []
        },
        "autoHealEnabled": false,
        "cors": {
          "allowedOrigins": [
            "https://functions.azure.com",
            "https://functions-staging.azure.com",
            "https://functions-next.azure.com"
          ],
          "supportCredentials": false
        },
        "localMySqlEnabled": false,
        "ipSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictionsUseMain": false,
        "http20Enabled": false,
        "minTlsVersion": "1.2",
        "ftpsState": "FtpsOnly",
        "reservedInstanceCount": 0
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2021-03-01",
      "name": "[concat(parameters('functionappName'),'/','appsettings')]",
      "kind": "functionapp,workflowapp",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionappName'))]"
      ],
      "properties": {
        "FUNCTIONS_EXTENSION_VERSION": "~4",
        "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
        "WEBSITE_CONTENTOVERVNET": "1",
        "WEBSITE_VNET_ROUTE_ALL": "1",
        "APPINSIGHTS_INSTRUMENTATIONKEY": "[reference(resourceId('Microsoft.Insights/components', parameters('AppInsightsName')), '2014-04-01').InstrumentationKey]",
        "APPLICATIONINSIGHTS_CONNECTION_STRING": "[reference(resourceId('Microsoft.Insights/components', parameters('AppInsightsName')), '2020-02-02').ConnectionString]",
        "AzureWebJobsStorage": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageaccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageaccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]",
        "WEBSITE_DNS_SERVER": "[parameters('WEBSITE_DNS_SERVER')]",
        "WEBSITE_DNS_ALT_SERVER": "[parameters('WEBSITE_DNS_ALT_SERVER')]",
        "WEBSITE_RUN_FROM_PACKAGE": "[parameters('WEBSITE_RUN_FROM_PACKAGE')]",
        "WEBSITE_LOAD_USER_PROFILE": "[parameters('WEBSITE_LOAD_USER_PROFILE')]",
        "AzureWebJobsSecretStorageType": "Files",
        "OpenApi__Scope": "[parameters('Appsetting:OpenApi__Scope')]",
        "OpenApi__TokenUrl": "[parameters('Appsetting:OpenApi__TokenUrl')]",
        "OpenApi__DocTitle": "[parameters('Appsetting:OpenApi__DocTitle')]",
        "OpenApi__Description": "[parameters('Appsetting:OpenApi__Description')]",
        "OpenApi__DocVersion": "[parameters('Appsetting:OpenApi__DocVersion')]",
        "OpenApi__Version": "[parameters('Appsetting:OpenApi__Version')]",
        "OpenApi__ForceHttps": "[parameters('Appsetting:OpenApi__ForceHttps')]",
        "OpenApi__ForceHttp": "[parameters('Appsetting:OpenApi__ForceHttp')]",
        "OpenApi__HostNames": "[parameters('Appsetting:OpenApi__HostNames')]",
        "DebugOptions": "[parameters('DebugOptions')]",
        "HistoryOnFlag": "[parameters('HistoryOnFlag')]",
        "BrandMSUrl": "[parameters('BrandMSUrl')]",
        "BrandMSSubscriptionKey": "[parameters('BrandMSSubscriptionKey')]",
        "ConfigurationMSBSPMarketCurrencyEndpoint": "[parameters('ConfigurationMSBSPMarketCurrencyEndpoint')]",
        "ConfigurationMSBSPMarketPaymentEndpoint": "[parameters('ConfigurationMSBSPMarketPaymentEndpoint')]",
        "ConfigurationMSPccCurrencyEndpoint": "[parameters('ConfigurationMSPccCurrencyEndpoint')]",
        "SeatMSUrl": "[parameters('SeatMSUrl')]",
        "SeatMSSubscriptionKey": "[parameters('SeatMSSubscriptionKey')]",
        "seatOfferIDMaxLength": "[parameters('seatOfferIDMaxLength')]",
        "FlightServicesMSUrl": "[parameters('FlightServicesMSUrl')]",
        "FlightServicesMSSubscriptionKey": "[parameters('FlightServicesMSSubscriptionKey')]",
        "OrderDataMSEndpoint": "[parameters('OrderDataMSEndpoint')]",
        "OrderDataMSSubscriptionKey": "[parameters('OrderDataMSSubscriptionKey')]",
        "OrderReshopEndpoint": "[parameters('OrderReshopEndpoint')]",
        "OfferMSReshopNameCorrectionEndpoint": "[parameters('OfferMSReshopNameCorrectionEndpoint')]",
        "ConfigurationMSPricingLocationEndpoint": "[parameters('ConfigurationMSPricingLocationEndpoint')]",
        "ConfigurationMSReshopFareFamilyEndpoint": "[parameters('ConfigurationMSReshopFareFamilyEndpoint')]",
        "ConfigurationMSFareFamilyEndpoint": "[parameters('ConfigurationMSFareFamilyEndpoint')]",
        "ConfigurationMSPOSCurrencyEndpoint": "[parameters('ConfigurationMSPOSCurrencyEndpoint')]",
        "ConfigurationMSITAFareTypeCodeEndpoint": "[parameters('ConfigurationMSITAFareTypeCodeEndpoint')]",
        "ConfigurationMSTtlRulesEndpoint": "[parameters('ConfigurationMSTtlRulesEndpoint')]",
        "ConfigurationMSTtlEnabledCityEndpoint": "[parameters('ConfigurationMSTtlEnabledCityEndpoint')]",
        "ConfigurationMSClidEndpoint": "[parameters('ConfigurationMSClidEndpoint')]",
        "ConfigurationMSUpsellOffersEndpoint": "[parameters('ConfigurationMSUpsellOffersEndpoint')]",
        "ConfigurationMSOcpKey": "[parameters('ConfigurationMSOcpKey')]",
        "CheckAgentTktAuthority": "[parameters('CheckAgentTktAuthority')]",
        "Analytics:ServiceBus:ConnectionString": "[parameters('Analytics:ServiceBus:ConnectionString')]",
        "Air4OrderSearchMSUrl": "[parameters('Air4OrderSearchMSUrl')]",
        "Air4OrderSearchMSSubscriptionKey": "[parameters('Air4OrderSearchMSSubscriptionKey')]",
        "OrderSearchMSUrl": "[parameters('OrderSearchMSUrl')]",
        "OrderSearchMSSubscriptionKey": "[parameters('OrderSearchMSSubscriptionKey')]",
        "AgentRegistrationEnvironment": "[parameters('AgentRegistrationEnvironment')]",
        "AirshoppingOfferEndpoint": "[parameters('AirshoppingOfferEndpoint')]",
        "AppChannelName": "[parameters('AppChannelName')]",
        "CalendarSearchEndpoint": "[parameters('CalendarSearchEndpoint')]",
        "OfferMSSubscriptionKey": "[parameters('OfferMSSubscriptionKey')]",
        "OfferPriceMSEndpoint": "[parameters('OfferPriceMSEndpoint')]",
        "OfferSearchEndPoint": "[parameters('OfferSearchEndPoint')]",
        "SkipGdsAgentValidation": "[parameters('SkipGdsAgentValidation')]",
        "ValidationMSSubscriptionKey": "[parameters('ValidationMSSubscriptionKey')]",
        "ValidationMSUrl": "[parameters('ValidationMSUrl')]",
        "Cache:get:https://testresources.virginatlantic.com/UAT/ReferenceMicroservice/AirportDetail": "expiry=01:00:00:00&url=.*&isSliding=false",
        "[concat(parameters('resourceurl'), '/ConfigurationMicroservice/BSPMarketCurrency')]": "expiry=01:00:00:00&url=.*&rq_headers=CountryCode&isSliding=false",
        "[concat(parameters('resourceurl'), '/ConfigurationMicroservice/BSPMarketPayment')]": "expiry=01:00:00:00&url=.*&rq_headers=CountryCode,CurrencyCode&isSliding=false",
        "[concat(parameters('resourceurl'), '/ConfigurationMicroservice/PccCurrency')]": "expiry=01:00:00:00&url=.*&rq_headers=CurrencyCode&isSliding=false",
        "[concat(parameters('resourceurl'), '/ConfigurationMicroservice/FareFamily')]": "expiry=01:00:00:00&url=.*&isSliding=false",
        "[concat(parameters('resourceurl'), '/ConfigurationMicroservice/PosCurrency')]": "expiry=01:00:00:00&url=.*&isSliding=false",
        "[concat(parameters('resourceurl'), '/ConfigurationMicroservice/ITAPaxTypeCodes')]": "expiry=01:00:00:00&url=.*&rq_headers=FareTypeCode,FareSubTypeCode&isSliding=false",
        "[concat(parameters('resourceurl'), '/ConfigurationMicroservice/PricingLocation')]": "expiry=01:00:00:00&url=.*&isSliding=false",
        "[concat(parameters('resourceurl'), '/ConfigurationMicroservice/UpsellOffers')]": "expiry=01:00:00:00&url=.*&isSliding=false",
        "[concat(parameters('resourceurl'), '/ConfigurationMicroservice/Configurations/ReshopFareFamily')]": "expiry=01:00:00:00&url=.*&isSliding=false",
        "[concat(parameters('resourceurl'), '/ConfigurationMicroservice/CLID')]": "expiry=01:00:00:00&url=.*&rq_headers=CBA_CLID&isSliding=false",
        "[concat(parameters('resourceurl'), '/ConfigurationMicroservice/TtlRules')]": "expiry=01:00:00:00&url=.*&rq_headers=FareTypeCode,FareSubTypeCode&isSliding=false",
        "[concat(parameters('resourceurl'), '/ConfigurationMicroservice/TtlEnabledCity')]": "expiry=01:00:00:00&url=.*&rq_headers=AirportCode&isSliding=false",
        "resourceurlPost": "[parameters('resourceurlPost')]",
        "RedisCacheConnectionString": "[parameters('RedisCacheConnectionString')]",
        "ReferenceMSAirportDetailsEndpoint": "[parameters('ReferenceMSAirportDetailsEndpoint')]",
        "ReferenceMSOcpKey": "[parameters('ReferenceMSOcpKey')]",
        "OrderQuoteEndpoint": "[parameters('OrderQuoteEndpoint')]",
        "OfferMSReshopCancelEndpoint": "[parameters('OfferMSReshopCancelEndpoint')]",
        "ReshopDisruptionTicketValidityWindowInDays": "[parameters('ReshopDisruptionTicketValidityWindowInDays')]",
        "ValidationMSHeartBeatUrl": "[parameters('ValidationMSHeartBeatUrl')]",
        "ConfigMSHeartBeatUrl": "[parameters('ConfigMSHeartBeatUrl')]",
        "OfferMSHeartBeatUrl": "[parameters('OfferMSHeartBeatUrl')]",
        "BrandMSHeartBeatUrl": "[parameters('BrandMSHeartBeatUrl')]",
        "SeatMSHeartBeatUrl": "[parameters('SeatMSHeartBeatUrl')]",
        "FlightServicesMSHeartBeatUrl": "[parameters('FlightServicesMSHeartBeatUrl')]",
        "OrderDataMSHeartBeatUrl": "[parameters('OrderDataMSHeartBeatUrl')]",
        "Air4OrderSearchMSHeartBeatUrl": "[parameters('Air4OrderSearchMSHeartBeatUrl')]",
        "OrderSearchMSHeartBeatUrl": "[parameters('OrderSearchMSHeartBeatUrl')]",
        "ReferenceMSHeartBeatUrl": "[parameters('ReferenceMSHeartBeatUrl')]",
        "[concat(parameters('resourceurlPost'), '/BrandMicroservice/Brand')]": "expiry=00:00:30:00&url=.*&rq_content=$&isSliding=false"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "apiVersion": "2015-06-01",
      "name": "[concat(parameters('keyVaultName'),'/add')]", 
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionappName'))]"
      ],
      "properties": {
        "accessPolicies": [
          {
            "objectId": "[reference(resourceId('Microsoft.Web/sites', parameters('functionappName')), '2019-08-01', 'full').identity.principalId]",
            "tenantId": "[reference(resourceId('Microsoft.Web/sites', parameters('functionappName')), '2019-08-01', 'full').identity.tenantId]",
            "permissions": {
              "secrets": [ "Get", "List" ]
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2016-10-01",
      "name": "[format('{0}/{1}', parameters('keyVaultName'),concat('functionappkey-',parameters('environment')))]",
      "dependsOn": [
        "[parameters('functionappName')]"
      ],
      "properties": {
        "value": "[listkeys(concat(resourceId(resourceGroup().name, 'Microsoft.Web/sites', parameters('functionappName')), '/host/default'), '2018-11-01').functionKeys.default]"
      }
    }
  ]
}
