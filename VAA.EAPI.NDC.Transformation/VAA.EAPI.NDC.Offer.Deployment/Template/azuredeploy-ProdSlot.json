            },
            {
              "name": "SeatMSHeartBeatUrl",
              "value": "[parameters('SeatMSHeartBeatUrl')]"
            },
            {
              "name": "FlightServicesMSHeartBeatUrl",
              "value": "[parameters('FlightServicesMSHeartBeatUrl')]"
            },
            {
              "name": "OrderDataMSHeartBeatUrl",
              "value": "[parameters('OrderDataMSHeartBeatUrl')]"
            },
            {
              "name": "Air4OrderSearchMSHeartBeatUrl",
              "value": "[parameters('Air4OrderSearchMSHeartBeatUrl')]"
            },
            {
              "name": "OrderSearchMSHeartBeatUrl",
              "value": "[parameters('OrderSearchMSHeartBeatUrl')]"
            },
            {
              "name": "ReferenceMSHeartBeatUrl",
