meta {
  name: Account Invite Member Action
  type: graphql
  seq: 3
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AccountInviteMemberAction {
    accountInviteMemberAction(
      request: {
        inviterFcNumber: "{{account_member_number}}"
        inviteeFcNumber: "{{account_member_number}}"
        actionType: Accepted
      }
    )
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
