meta {
  name: Account Invite Member
  type: graphql
  seq: 2
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AccountInviteMember {
    accountInviteMember(
      inviteeFcNumber: "{{account_member_number}}"
      groupName: "{{account_household_group_name}}"
    )
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
