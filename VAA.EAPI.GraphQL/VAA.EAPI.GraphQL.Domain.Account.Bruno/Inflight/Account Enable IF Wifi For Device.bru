meta {
  name: Account Enable IF Wifi For Device
  type: graphql
  seq: 1
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AccountEnableIfWifiForDevice {
    accountEnableIFWifiForDevice(
      deviceId: "{{account_device_id}}"
      sandboxId: "{{account_sandbox_id}}"
    ) {
      status
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
