meta {
  name: Account Validate Password
  type: graphql
  seq: 5
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  query AccountValidatePassword {
    accountValidatePassword(
      password: {
        password: "{{account_new_password}}"
      }
    ) {
      policyId
      policyDescription
      isValid
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
