meta {
  name: Account Create Young Flyer
  type: graphql
  seq: 16
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AccountCreateYoungFlyer {
    accountCreateYoungFlyerAccount(
      request: {
        channelId: "{{account_channel_id}}"
        channelUserId: "{{account_channel_user_id}}"
        customerDetails: {
          firstName: "{{account_first_name}}"
          lastName: "{{account_last_name}}"
          gender: "{{account_gender}}"
          dateOfBirth: "{{account_date_of_birth}}"
          customerType: Loyalty
          enrolmentChannel: "{{account_enrolment_channel}}"
          loyaltyMember: {
            programName: VirginAtlanticFlyingClub
            memberType: "Individual"
            mediaCode: "{{account_media_code}}"
            enrollmentChannel: "{{account_enrolment_channel}}"
            termsAndConditionsAccepted: true
          }
        }
      }
    ) {
      customerId
      memberDetails {
        memberNumber
        status
      }
      errors {
        code
        message
        errorSource
      }
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
