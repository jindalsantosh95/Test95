meta {
  name: Account Update Marketing Preference
  type: graphql
  seq: 10
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AccountUpdateMarketingPreference {
    updateMarketingPreference(
      updateMarketingPreferenceRequest: {
        preferenceValue: true
        isVacMember: false
      }
    )
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
