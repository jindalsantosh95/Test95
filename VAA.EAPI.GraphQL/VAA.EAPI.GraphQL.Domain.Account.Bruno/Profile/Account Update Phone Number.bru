meta {
  name: Account Update Phone Number
  type: graphql
  seq: 13
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AccountUpdatePhoneNumber {
    updateMemberPhoneNumber(
      updatePhoneNumber: {
        phoneNumber: "{{account_phone_number}}"
        countryCode: "{{account_phone_country_code}}"
      }
    )
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
