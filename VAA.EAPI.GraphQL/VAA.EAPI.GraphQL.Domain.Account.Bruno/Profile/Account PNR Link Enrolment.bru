meta {
  name: Account PNR Link Enrolment
  type: graphql
  seq: 15
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AccountPnrLinkEnrolment {
    accountPnrLinkEnrolment(
      request: {
        customer: {
          customerId: "{{account_customer_id}}"
          firstName: "{{account_first_name}}"
          lastName: "{{account_last_name}}"
          gender: "{{account_gender}}"
          loyaltyNumber: "{{account_member_number}}"
          dateOfBirth: "{{account_date_of_birth}}T00:00:00Z"
          pnrName: "{{account_pnr}}"
        }
      }
    )
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
