meta {
  name: Account Update Email Address
  type: graphql
  seq: 9
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AccountUpdateEmailAddress {
    accountUpdateEmailAddress(
      newEmailAddress: {
        emailAddress: "{{account_email}}"
      }
    )
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
