meta {
  name: Account Resend Verification Email
  type: graphql
  seq: 11
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AccountResendVerificationEmail {
    accountResendVerificationEmail(
      request: {
        payLoad: {
          contactDetails: {
            emailDetails: [
              {
                usage: Personal
                emailId: "{{account_email}}"
                preferredFlag: "Y"
              }
            ]
          }
        }
      }
    )
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
