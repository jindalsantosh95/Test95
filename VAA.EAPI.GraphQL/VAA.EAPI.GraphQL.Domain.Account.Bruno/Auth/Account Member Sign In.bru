meta {
  name: Account Member Sign In
  type: graphql
  seq: 1
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AccountMemberSignIn {
    accountMemberSignIn(
      request: {
        flyingClubNumber: "{{account_member_number}}"
        email: "{{account_email}}"
        password: "{{account_password}}"
      }
    ) {
      tokenType
      scope
      expiresIn
      accessToken
      refreshToken
      idToken
      continuationToken
      requiresMFA
    }
  }
}


script:post-response {
  const body = typeof res.getBody === "function" ? res.getBody() : res.body;
  const token = body?.data?.accountMemberSignIn;
  
  if (token?.accessToken) bru.setVar("access_token", token.accessToken);
  if (token?.refreshToken) bru.setVar("refresh_token", token.refreshToken);
  if (token?.idToken) bru.setVar("id_token", token.idToken);
  if (token?.continuationToken) bru.setVar("continuation_token", token.continuationToken);
}

settings {
  encodeUrl: true
  timeout: 0
}
