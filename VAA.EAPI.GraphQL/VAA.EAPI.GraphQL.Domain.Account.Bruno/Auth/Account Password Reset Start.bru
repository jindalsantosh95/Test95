meta {
  name: Account Password Reset Start
  type: graphql
  seq: 3
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AccountPasswordResetStart {
    accountPasswordResetStart(
      request: {
        fcNumberOrEmail: "{{account_email}}"
      }
    ) {
      continuationToken
    }
  }
}

script:post-response {
  const body = typeof res.getBody === "function" ? res.getBody() : res.body;
  const continuationToken = body?.data?.accountPasswordResetStart?.continuationToken;
  
  if (continuationToken) bru.setVar("continuation_token", continuationToken);
}

settings {
  encodeUrl: true
  timeout: 0
}
