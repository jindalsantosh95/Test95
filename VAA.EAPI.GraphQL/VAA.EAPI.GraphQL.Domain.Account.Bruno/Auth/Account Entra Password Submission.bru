meta {
  name: Account Entra Password Submission
  type: graphql
  seq: 6
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AccountEntraPasswordSubmission {
    accountEntraPasswordSubmission(
      request: {
        email: "{{account_email}}"
        token: "{{continuation_token}}"
        newPassword: "{{account_new_password}}"
      }
    ) {
      tokenType
      scope
      expiresIn
      accessToken
      refreshToken
      idToken
      continuationToken
      requiresMFA
    }
  }
}

script:post-response {
  const body = typeof res.getBody === "function" ? res.getBody() : res.body;
  const token = body?.data?.accountEntraPasswordSubmission;
  
  if (token?.accessToken) bru.setVar("access_token", token.accessToken);
  if (token?.refreshToken) bru.setVar("refresh_token", token.refreshToken);
  if (token?.idToken) bru.setVar("id_token", token.idToken);
  if (token?.continuationToken) bru.setVar("continuation_token", token.continuationToken);
}

settings {
  encodeUrl: true
  timeout: 0
}
