meta {
  name: Account Refresh Token
  type: graphql
  seq: 2
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AccountRefreshToken {
    accountRefreshToken(
      request: {
        token: "{{refresh_token}}"
        scopes: ["openid", "offline_access"]
      }
    ) {
      tokenType
      scope
      expiresIn
      accessToken
      refreshToken
      idToken
      continuationToken
      requiresMFA
    }
  }
}

script:post-response {
  const body = typeof res.getBody === "function" ? res.getBody() : res.body;
  const token = body?.data?.accountRefreshToken;
  
  if (token?.accessToken) bru.setVar("access_token", token.accessToken);
  if (token?.refreshToken) bru.setVar("refresh_token", token.refreshToken);
  if (token?.idToken) bru.setVar("id_token", token.idToken);
  if (token?.continuationToken) bru.setVar("continuation_token", token.continuationToken);
}

settings {
  encodeUrl: true
  timeout: 0
}
