meta {
  name: Account Activity Details
  type: graphql
  seq: 3
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  query AccountActivityDetails {
    accountActivityDetails(page: 1, pageSize: 10) {
      activityDate
      transactionProcessedDate
      partnerName
      statement
      virginPoints
      tierPoints
      partnerCode
      transactionId
      transactionType
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
