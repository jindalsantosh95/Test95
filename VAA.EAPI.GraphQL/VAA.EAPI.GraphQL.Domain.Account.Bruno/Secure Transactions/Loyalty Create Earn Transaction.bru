meta {
  name: Loyalty Create Earn Transaction
  type: graphql
  seq: 2
}

post {
  url: {{graphql_secure}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation LoyaltyCreateEarnTransaction {
    loyaltyCreateEarnTransaction(
      transactionRequest: {
        points: {{transaction_points}}
        orderId: "{{transaction_order_id}}"
        activityDate: "{{transaction_activity_date}}"
        channel: "{{account_channel_id}}"
        comment: "{{transaction_earn_comment}}"
        memberNumber: "{{account_member_number}}"
      }
    ) {
      vaaTransactionId
      orderId
      errors {
        code
        message
        errorSource
      }
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
