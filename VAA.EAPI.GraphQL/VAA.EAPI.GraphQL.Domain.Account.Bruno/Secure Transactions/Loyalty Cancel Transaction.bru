meta {
  name: Loyalty Cancel Transaction
  type: graphql
  seq: 3
}

post {
  url: {{graphql_secure}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation LoyaltyCancelTransaction {
    loyaltyCancelTransaction(
      cancelRequest: {
        transactionId: "{{transaction_id}}"
        memberNumber: "{{account_member_number}}"
        activityDate: "{{transaction_activity_date}}"
        cancellationReason: "{{transaction_cancellation_reason}}"
        channel: "{{account_channel_id}}"
      }
    ) {
      message
      errors {
        code
        message
        errorSource
      }
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
