meta {
  name: Account Schema Introspection
  type: graphql
  seq: 1
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  query AccountSchemaIntrospection {
    __schema {
      queryType {
        fields {
          name
          description
          args {
            name
            type {
              kind
              name
              ofType {
                kind
                name
                ofType {
                  kind
                  name
                }
              }
            }
          }
        }
      }
      mutationType {
        fields {
          name
          description
          args {
            name
            type {
              kind
              name
              ofType {
                kind
                name
                ofType {
                  kind
                  name
                }
              }
            }
          }
        }
      }
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
