###Request
PATCH https://testresources.virginatlantic.com/DEV/digital/Trip/passengerDetails/Test-booking-Id HTTP/1.1

$[?(@.passengerInformation.bookingId == 'Test-booking-Id')]
$[?(@.passengerInformation.passengers[0].passengerResourceId == '5e9e1255-b51a-49a1-9cfa-ecd40b46a4b0')]
$[?(@.passengerInformation.passengers[0].actionType == 'ADD')]
$..trustedTravelerPrograms[?(@.program == 'KNOWN_TRAVELER_NUMBER' && @.number == '987654321')]
$..trustedTravelerPrograms[?(@.program == 'CANADA_TRAVELER_NUMBER' && @.number == 'CAN1234567890')]

