[
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/40th-birthday-savings-f-h\",\"_variation\":\"master\",\"title\":\"Birthday savings this weekend when you add a hotel to your flight\",\"bodyText\":{\"html\":\"<p>Flip flop your way over to flight + hotel to receive extra special birthday discounts this weekend only. Plus, you can spread the cost with direct debit, receive ATOL protection, and earn Virgin Points! <a href=\\\"https://travelplus.virginatlantic.com/\\\" target=\\\"_blank\\\">See our flight + hotel bundles.</a></p>\\n<p>Terms and conditions apply</p>\\n\",\"plaintext\":\"Flip flop your way over to flight + hotel to receive extra special birthday discounts this weekend only. Plus, you can spread the cost with direct debit, receive ATOL protection, and earn Virgin Points! See our flight + hotel bundles.\\n\\nTerms and conditions apply\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/tailfin.jpg\",\"imageAltText\":\"Virgin Atlantic aircraft tailfin\",\"originAirports\":[\"LHR\",\"MAN\"],\"destinationAirports\":[\"CPT\",\"JNB\",\"BGI\",\"LAS\",\"MBJ\",\"JFK\",\"PLS\",\"SFO\",\"DXB\",\"NAS\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":null,\"displayFrom\":\"2024-06-21\",\"displayUntil\":\"2024-06-25\",\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/april-2024---save-£70-on-mbj\",\"_variation\":\"master\",\"title\":\"Vibe in Jamaica\",\"bodyText\":{\"html\":\"<p>Use code JAM24 to save £70 on flights in Premium and £50 on flights in Economy on selected 2024 dates<b>*</b></p>\\n<p>We fly direct to Montego Bay on Wednesdays, Saturdays &amp; Sundays. Flights on other days will include a 1-hour touchdown.</p>\\n<p><b>*</b>Book by 30th April.&nbsp;<a href=\\\"https://flights.virginatlantic.com/en-gb/caribbean-flight-deals#jam24\\\" target=\\\"_blank\\\">See full terms and applicable dates.</a></p>\\n\",\"plaintext\":\"Use code JAM24 to save £70 on flights in Premium and £50 on flights in Economy on selected 2024 dates*\\n\\nWe fly direct to Montego Bay on Wednesdays, Saturdays & Sundays. Flights on other days will include a 1-hour touchdown.\\n\\n*Book by 30th April. See full terms and applicable dates.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/jamaica-fishing-boat.jpg\",\"imageAltText\":\"Fishing boat on the beach in Jamaica\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"MBJ\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":3,\"displayFrom\":null,\"displayUntil\":\"2024-04-30\",\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/april-2024---save-£70-on-nas\",\"_variation\":\"master\",\"title\":\"Be yourself in the Bahamas\",\"bodyText\":{\"html\":\"<p>Use code JAM24 to save £70 on flights in Premium and £50 on flights in Economy on selected 2024 dates<b>*</b></p>\\n<p>Fly direct with Virgin Atlantic, from London Heathrow twice a week. Flights depart Mondays and Fridays.</p>\\n<p><b>*</b>Book by 30th April.&nbsp;<a href=\\\"https://flights.virginatlantic.com/en-gb/caribbean-flight-deals#jam24\\\">See full terms and applicable dates.</a></p>\\n\",\"plaintext\":\"Use code JAM24 to save £70 on flights in Premium and £50 on flights in Economy on selected 2024 dates*\\n\\nFly direct with Virgin Atlantic, from London Heathrow twice a week. Flights depart Mondays and Fridays.\\n\\n*Book by 30th April. See full terms and applicable dates.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/bahamas-umbrella.jpg\",\"imageAltText\":\"Lady looks out to sea in the Bahamas\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"NAS\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":3,\"displayFrom\":null,\"displayUntil\":\"2024-04-30\",\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/april-2024---save-£70-on-pls\",\"_variation\":\"master\",\"title\":\"Dive in to Turks & Caicos\",\"bodyText\":{\"html\":\"<p>Use code JAM24 to save £70 on flights in Premium and £50 on flights in Economy on selected 2024 dates*<br>\\n</p>\\n<p>Fly direct with Virgin Atlantic from London Heathrow twice a week. Flights depart on Tuesdays and Thursdays.</p>\\n<p>*Book by 30th April.&nbsp;<a href=\\\"https://flights.virginatlantic.com/en-gb/caribbean-flight-deals#jam24\\\" target=\\\"_blank\\\">See full terms and applicable dates</a>.</p>\\n\",\"plaintext\":\"Use code JAM24 to save £70 on flights in Premium and £50 on flights in Economy on selected 2024 dates*\\n\\n\\nFly direct with Virgin Atlantic from London Heathrow twice a week. Flights depart on Tuesdays and Thursdays.\\n\\n*Book by 30th April. See full terms and applicable dates.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/turks-and-caicos-bf-banner.jpg\",\"imageAltText\":\"Girl jumps off boat into sea in Turks and Caicos\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"PLS\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":3,\"displayFrom\":null,\"displayUntil\":\"2024-04-30\",\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/april-2024--save-75-on-f-h-promo\",\"_variation\":\"master\",\"title\":\"Save £75 on Flight + Hotel\",\"bodyText\":{\"html\":\"<p>Create your dream duo with a flight + hotel bundle and save £75 today with promo code&nbsp;SAVE75</p>\\n<p><a href=\\\"https://travelplus.virginatlantic.com/?refurl=VA_NBF_travelplus_generic\\\" target=\\\"_blank\\\">Find out more</a></p>\\n<p>Minimum spend applies. Book by 30th April 2024. T&amp;Cs apply.</p>\\n\",\"plaintext\":\"Create your dream duo with a flight + hotel bundle and save £75 today with promo code SAVE75\\n\\nFind out more\\n\\nMinimum spend applies. Book by 30th April 2024. T&Cs apply.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/tailfin.jpg\",\"imageAltText\":\"Virgin Atlantic aircraft tailfin\",\"originAirports\":[\"LHR\",\"MAN\"],\"destinationAirports\":[\"DXB\",\"LOS\",\"CPT\",\"JNB\",\"MLE\",\"BGI\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":3,\"displayFrom\":null,\"displayUntil\":\"2024-04-23\",\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/atlanta-test\",\"_variation\":\"master\",\"title\":\"Fly with Virgin Atlantic to Atlanta\",\"bodyText\":{\"html\":\"<p>Lorem ipsum dolor sit amet. 33 corrupti natus sed voluptatem debitis quo commodi deleniti est dolore sint est quos repellendus.</p>\\n\",\"plaintext\":\"Lorem ipsum dolor sit amet. 33 corrupti natus sed voluptatem debitis quo commodi deleniti est dolore sint est quos repellendus.\"},\"image\":\"/content/dam/vaa-home/logo/article-placeholder.png\",\"imageAltText\":\"Virgin Atlantic aircraft tailfin\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"ATL\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"alert-success\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/default-sales-banner\",\"_variation\":\"master\",\"title\":\"Banner Title Two\",\"bodyText\":{\"html\":\"<p>Default Sales Banner Body Text</p>\\n\",\"plaintext\":\"Default Sales Banner Body Text\"},\"image\":null,\"imageAltText\":\"Default sales banner image alt text\",\"originAirports\":[\"AMS\"],\"destinationAirports\":[\"AMD\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":[\"flight-direction:one-way\"],\"displayLocation\":\"search-top\",\"ranking\":72,\"displayFrom\":\"2024-02-15\",\"displayUntil\":\"2024-02-16\",\"minAdults\":0,\"maxAdults\":9,\"minTeens\":0,\"maxTeens\":9,\"minChildren\":0,\"maxChildren\":9,\"minInfants\":0,\"maxInfants\":9,\"dayOfWeek\":[\"day-of-week:monday\",\"day-of-week:tuesday\"],\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/f-h-s-s-save-up-to-£150\",\"_variation\":\"master\",\"title\":\"Save up to £150 when you add a hotel to your flight\",\"bodyText\":{\"html\":\"<p>Book a 2024 flight + hotel package by 1st October and&nbsp;<b>save&nbsp;£150</b>&nbsp;when spending £3,000 or more. Or,&nbsp;<b>save £75&nbsp;</b>on 2025 bookings.&nbsp;<a href=\\\"https://travelplus.virginatlantic.com/\\\">Find out more.</a>.<br>\\n</p>\\n<p>*Terms and conditions apply.</p>\\n\",\"plaintext\":\"Book a 2024 flight + hotel package by 1st October and save £150 when spending £3,000 or more. Or, save £75 on 2025 bookings. Find out more..\\n\\n\\n*Terms and conditions apply.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/tailfin.jpg\",\"imageAltText\":\"Virgin Atlantic aircraft tailfin\",\"originAirports\":[\"LHR\",\"MAN\"],\"destinationAirports\":[\"CPT\",\"JNB\",\"BGI\",\"LAS\",\"MBJ\",\"JFK\",\"LAX\",\"LAS\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":2,\"displayFrom\":\"2024-09-27\",\"displayUntil\":\"2024-10-02\",\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/flight---car-only\",\"_variation\":\"master\",\"title\":\"Drive yourself to Walt Disney World\",\"bodyText\":{\"html\":\"<p>Orlando is just a 90-minute drive from Tampa. Add a car to your booking and you’ll be enjoying the magic before you know it.</p>\\n\",\"plaintext\":\"Orlando is just a 90-minute drive from Tampa. Add a car to your booking and you’ll be enjoying the magic before you know it.\"},\"image\":null,\"imageAltText\":null,\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"TPA\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-car\"],\"theme\":\"alert-warning\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/flight---hotel-only\",\"_variation\":\"master\",\"title\":\"Visit the big apple for less\",\"bodyText\":{\"html\":\"<p>Secure your dream New York hotel at the same time as your flights and save £75 per booking.</p>\\n\",\"plaintext\":\"Secure your dream New York hotel at the same time as your flights and save £75 per booking.\"},\"image\":null,\"imageAltText\":null,\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"JFK\",\"BOS\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-hotel\"],\"theme\":\"alert-promotional\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/flight-only\",\"_variation\":\"master\",\"title\":\"Looking to dive into the Maldives?\",\"bodyText\":{\"html\":\"<p>Fly direct from London Heathrow with Virgin Atlantic during our seasonal service. </p>\\n<ul>\\n<li>From 27th October 2024, Virgin Atlantic will operate daily flights to the Maldives.</li>\\n</ul>\\n<p>&nbsp;Book your flight today!</p>\\n\",\"plaintext\":\"Fly direct from London Heathrow with Virgin Atlantic during our seasonal service. \\n\\nFrom 27th October 2024, Virgin Atlantic will operate daily flights to the Maldives.\\n\\n Book your flight today!\"},\"image\":null,\"imageAltText\":null,\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"MLE\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\"],\"theme\":\"alert-info\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/holidays-only\",\"_variation\":\"master\",\"title\":\"Dubai Holidays: where the old meets the new\",\"bodyText\":{\"html\":\"<p>From its sun-kissed white beaches to an ultra-modern skyline, holidays in Dubai are where city trips and beach breaks come together.</p>\\n\",\"plaintext\":\"From its sun-kissed white beaches to an ultra-modern skyline, holidays in Dubai are where city trips and beach breaks come together.\"},\"image\":null,\"imageAltText\":null,\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"DXB\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"holidays\"],\"theme\":\"alert-success\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/india-codeshare-partner-indigo\",\"_variation\":\"master\",\"title\":\"Connect to cities across India with our codeshare partner IndiGo\",\"bodyText\":{\"html\":\"<p>We've teamed up with India's largest airline to make your onward connection from Delhi and Mumbai easier.</p>\\n<p><a href=\\\"https://flights.virginatlantic.com/en-gb/flights-to-india\\\"><b>Find out more</b></a></p>\\n\",\"plaintext\":\"We've teamed up with India's largest airline to make your onward connection from Delhi and Mumbai easier.\\n\\nFind out more\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/indigo-tailfin.jpg\",\"imageAltText\":\"IndiGo partner\",\"originAirports\":null,\"destinationAirports\":[\"BOM\",\"DEL\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/jfk-only\",\"_variation\":\"master\",\"title\":\"JFK only\",\"bodyText\":{\"html\":\"<p>Fly&nbsp;direct&nbsp;from&nbsp;JFK&nbsp;with&nbsp;Virgin&nbsp;Atlantic.&nbsp;</p>\\n\",\"plaintext\":\"Fly direct from JFK with Virgin Atlantic. \"},\"image\":null,\"imageAltText\":null,\"originAirports\":[\"JFK\"],\"destinationAirports\":null,\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"alert-success\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/june-2024--save-75-on-f-h-promo\",\"_variation\":\"master\",\"title\":\"Save £75 per booking when you add a hotel to your flight\",\"bodyText\":{\"html\":\"<p>Plus you can spread the cost with direct debit, receive ATOL protection, and earn Virgin Points.&nbsp;<a href=\\\"https://travelplus.virginatlantic.com/?refurl=VA_NBF_travelplus_generic\\\" target=\\\"_blank\\\">Find out more</a>.</p>\\n\",\"plaintext\":\"Plus you can spread the cost with direct debit, receive ATOL protection, and earn Virgin Points. Find out more.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/tailfin.jpg\",\"imageAltText\":\"Virgin Atlantic aircraft tailfin\",\"originAirports\":[\"LHR\",\"MAN\"],\"destinationAirports\":[\"CPT\",\"JNB\",\"BGI\",\"LAS\",\"MBJ\",\"JFK\",\"LAX\",\"LAS\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":2,\"displayFrom\":\"2024-10-02\",\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/lhr---hkt\",\"_variation\":\"master\",\"title\":\"New Route to Phuket\",\"bodyText\":{\"html\":\"<p>This is a Test Route.</p>\\n\",\"plaintext\":\"This is a Test Route.\"},\"image\":null,\"imageAltText\":null,\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"HKT\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"holidays\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/lhr-anu-flying-days-info\",\"_variation\":\"master\",\"title\":\"Up the ante in Antigua\",\"bodyText\":{\"html\":\"<p>Fly to Antigua with Virgin Atlantic from London Heathrow, during our seasonal service.​</p>\\n<p>Flights depart on<b> Thursdays</b> and will include a short touchdown in Barbados.</p>\\n<p>From the&nbsp;<b>28th October 2024</b>, Virgin Atlantic will fly <b>direct </b>on <b>Mondays, Tuesdays, and Thursdays.</b></p>\\n<p>From the <b>2<sup>nd</sup> November 2024,</b> Virgin Atlantic will operate one flight a week departing <b>Saturdays.</b></p>\\n<p>From the <b>25<sup>th</sup> November 2024 – 29<sup>th</sup> March 2025</b>, flights will depart on&nbsp;<b>Mondays, Tuesdays, Thursdays and Saturdays.</b></p>\\n<p>From the&nbsp;<b>30th March 2025 - 30th April 2025 </b>flights will depart on <b>Tuesday, Wednesdays, Fridays and Sundays.</b></p>\\n\",\"plaintext\":\"Fly to Antigua with Virgin Atlantic from London Heathrow, during our seasonal service.​\\n\\nFlights depart on Thursdays and will include a short touchdown in Barbados.\\n\\nFrom the 28th October 2024, Virgin Atlantic will fly direct on Mondays, Tuesdays, and Thursdays.\\n\\nFrom the 2nd November 2024, Virgin Atlantic will operate one flight a week departing Saturdays.\\n\\nFrom the 25th November 2024 – 29th March 2025, flights will depart on Mondays, Tuesdays, Thursdays and Saturdays.\\n\\nFrom the 30th March 2025 - 30th April 2025 flights will depart on Tuesday, Wednesdays, Fridays and Sundays.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/antigua-phone-box.jpg\",\"imageAltText\":\"Phone box on the beach in Antigua\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"ANU\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/lhr-dxb\",\"_variation\":\"master\",\"title\":\"Discover Dubai\",\"bodyText\":{\"html\":\"<p>Fly&nbsp;<b>direct</b>&nbsp;from London Heathrow with Virgin Atlantic during our seasonal service.<br>\\nFrom&nbsp;<b>26th October 2024</b>, Virgin Atlantic will operate&nbsp;<b>daily</b>&nbsp;flights to Dubai. Book yours today!</p>\\n\",\"plaintext\":\"Fly direct from London Heathrow with Virgin Atlantic during our seasonal service.\\nFrom 26th October 2024, Virgin Atlantic will operate daily flights to Dubai. Book yours today!\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/Dubai-hero-NBF.jpg\",\"imageAltText\":\"Dubai\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"DXB\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/lhr-dxb-flying-info\",\"_variation\":\"master\",\"title\":\"Go big in Dubai\",\"bodyText\":{\"html\":\"<p>Fly direct to Dubai with our seasonal service. <b>Daily</b>&nbsp;Virgin Atlantic flights take off from&nbsp;<b>26th October 2024</b>.</p>\\n\",\"plaintext\":\"Fly direct to Dubai with our seasonal service. Daily Virgin Atlantic flights take off from 26th October 2024.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/dubai-desert-ladies.jpg\",\"imageAltText\":\"Ladies in the desert in Dubai\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"DXB\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/lhr-gnd-flying-days-info\",\"_variation\":\"master\",\"title\":\"Spice it up in Grenada\",\"bodyText\":{\"html\":\"<p>Please note that all of our flights to Grenada include a touchdown*</p>\\n<ul>\\n<li>Flights depart&nbsp;<b>Tuesdays and Saturdays</b></li>\\n<li>Between  <b>29th October 2024 - 29th March 2025</b>, our service will include <b>three</b>&nbsp;flights per week. Flights depart&nbsp;<b>Tuesdays, Fridays and Saturdays​</b></li>\\n<li>Between&nbsp;<b>1st April 2025 - 25th October 2025</b>, flights will depart&nbsp;<b>Tuesdays and Thursdays</b></li>\\n</ul>\\n<p>* Passengers and luggage remain on the aircraft during 1-hour touchdown in Barbados</p>\\n\",\"plaintext\":\"Please note that all of our flights to Grenada include a touchdown*\\n\\nFlights depart Tuesdays and Saturdays\\n\\nBetween  29th October 2024 - 29th March 2025, our service will include three flights per week. Flights depart Tuesdays, Fridays and Saturdays​\\n\\nBetween 1st April 2025 - 25th October 2025, flights will depart Tuesdays and Thursdays\\n\\n* Passengers and luggage remain on the aircraft during 1-hour touchdown in Barbados\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/grenada-harbour.jpg\",\"imageAltText\":\"Fishing boat off the coast of Grenada\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"GND\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/lhr-las\",\"_variation\":\"master\",\"title\":\"Did you know?\",\"bodyText\":{\"html\":\"<p><b>We also fly direct from Manchester to Las Vegas!&nbsp;</b>Our seasonal service from Manchester takes off three times a week until October 25th 2024, and then resumes 29th April 2025.</p>\\n\",\"plaintext\":\"We also fly direct from Manchester to Las Vegas! Our seasonal service from Manchester takes off three times a week until October 25th 2024, and then resumes 29th April 2025.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/las-vegas-skyline-bf-image.jpg\",\"imageAltText\":\"Las Vegas\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"LAS\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/lhr-mbj-flying-days-info\",\"_variation\":\"master\",\"title\":\"Vibe in Jamaica\",\"bodyText\":{\"html\":\"<p>Fly to Montego Bay 7 days a week with Virgin Atlantic from London Heathrow.​<br>\\n</p>\\n<ul>\\n<li><p><b>Direct</b> <b>flights</b> to Montego Bay operate on <b>Wednesdays, Saturdays and Sundays. *<br>\\n </b>*28th October-29th November: Mondays and Fridays<br>\\n*2nd December-22nd February: Mondays and Saturdays<br>\\n*From the 24th February 2025, direct flights will operate on Mondays, Tuesdays, Thursdays, and Saturdays.​</p>\\n</li>\\n<li><li><b>Indirect flights</b>&nbsp;depart <b>Mondays, Tuesdays, Thursdays, and Fridays</b>  will include a short touchdown in Nassau or&nbsp;Turks &amp; Caicos.<br>\\n*5th November-20th February: Tuesdays, Thursdays and Sundays, flights will include a short touchdown in Nassau<br>\\n*30th October-30th November: Wednesdays and Saturdays<br>\\n*4th December-21st February: Wednesdays and Fridays, flights will include a short touchdown in Turks &amp; Caicos<br>\\n<b>Please Note:</b> Passengers and luggage will remain on the aircraft during 1-hour touchdown.</li>\\n</li>\\n</ul>\\n<p>&nbsp;</p>\\n\",\"plaintext\":\"Fly to Montego Bay 7 days a week with Virgin Atlantic from London Heathrow.​\\n\\n\\nDirect flights to Montego Bay operate on Wednesdays, Saturdays and Sundays. *\\n *28th October-29th November: Mondays and Fridays\\n*2nd December-22nd February: Mondays and Saturdays\\n*From the 24th February 2025, direct flights will operate on Mondays, Tuesdays, Thursdays, and Saturdays.​\\n\\n\\n\\nIndirect flights depart Mondays, Tuesdays, Thursdays, and Fridays  will include a short touchdown in Nassau or Turks & Caicos.\\n*5th November-20th February: Tuesdays, Thursdays and Sundays, flights will include a short touchdown in Nassau\\n*30th October-30th November: Wednesdays and Saturdays\\n*4th December-21st February: Wednesdays and Fridays, flights will include a short touchdown in Turks & Caicos\\nPlease Note: Passengers and luggage will remain on the aircraft during 1-hour touchdown.\\n\\n\\n\\n\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/jamaica-fishing-boat.jpg\",\"imageAltText\":\"Fishing boat off the coast of Jamaica\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"MBJ\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/lhr-mle\",\"_variation\":\"master\",\"title\":\"Looking for a hotel? \",\"bodyText\":{\"html\":\"<p>Don't search for your hotel separately, once you've chosen your flights, save time and simply proceed and browse our recommended hotels and add to checkout. Easy! All in one convenient package.<br>\\n</p>\\n\",\"plaintext\":\"Don't search for your hotel separately, once you've chosen your flights, save time and simply proceed and browse our recommended hotels and add to checkout. Easy! All in one convenient package.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/Maldives-NBF.jpg\",\"imageAltText\":\"Maldives\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"MLE\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":5,\"displayFrom\":\"2024-07-19\",\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/lhr-mle-flying-info\",\"_variation\":\"master\",\"title\":\"Make waves in the Maldives\",\"bodyText\":{\"html\":\"<p>Fly direct to the Maldives with Virgin Atlantic, with daily flights from 27th October 2024.<br>\\n</p>\\n\",\"plaintext\":\"Fly direct to the Maldives with Virgin Atlantic, with daily flights from 27th October 2024.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/maldives-red-skirt.jpg\",\"imageAltText\":\"Woman in red skirt walks to water villa \",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"MLE\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/lhr-nas-flying-days-info\",\"_variation\":\"master\",\"title\":\"Set you sights to the Bahamas\",\"bodyText\":{\"html\":\"<p>Take off to the Bahamas! Direct flights with Virgin Atlantic depart on <b>Mondays and Fridays.</b></p>\\n<p>From 29<sup>th</sup> October 2024, flights depart Tuesdays, Thursdays, and Sundays. This service ends&nbsp;<b>23rd February 2025</b>.</p>\\n<p>Don't miss out and book your flight today.</p>\\n\",\"plaintext\":\"Take off to the Bahamas! Direct flights with Virgin Atlantic depart on Mondays and Fridays.\\n\\nFrom 29th October 2024, flights depart Tuesdays, Thursdays, and Sundays. This service ends 23rd February 2025.\\n\\nDon't miss out and book your flight today.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/bahamas-umbrella.jpg\",\"imageAltText\":\"Lady with striped umbrella in the Bahamas\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"NAS\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":\"2025-02-28\",\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/lhr-pls-flying-days-info\",\"_variation\":\"master\",\"title\":\"Dive in to Turks & Caicos\",\"bodyText\":{\"html\":\"<p>Fly direct with Virgin Atlantic from London Heathrow twice a week.</p>\\n<ul>\\n<li>Flights depart on&nbsp;<b>Tuesdays and Thursdays.</b></li>\\n<li>From the&nbsp;<b>30<sup>th</sup> October to 30th November</b>, flights will depart <b>Wednesdays and Saturdays.</b></li>\\n<li>From the <b>4<sup>th </sup>December</b>, flights will depart <b>Wednesdays and Fridays.</b></li>\\n<li>This service ends <b>21<sup>st</sup> February 2025.</b></li>\\n</ul>\\n\",\"plaintext\":\"Fly direct with Virgin Atlantic from London Heathrow twice a week.\\n\\nFlights depart on Tuesdays and Thursdays.\\n\\nFrom the 30th October to 30th November, flights will depart Wednesdays and Saturdays.\\n\\nFrom the 4th December, flights will depart Wednesdays and Fridays.\\n\\nThis service ends 21st February 2025.\\n\\n\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/turks-and-caicos-bf-banner.jpg\",\"imageAltText\":\"Girl jumping off boat in Turks and Caicos\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"PLS\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/lhr-ruh-flying-info\",\"_variation\":\"master\",\"title\":\"Ahlan Riyadh!\",\"bodyText\":{\"html\":\"<p>Fly direct to Riyadh from London Heathrow, 7 days a week with Virgin Atlantic. Flights take off from <b>30th March 2025</b>.</p>\\n\",\"plaintext\":\"Fly direct to Riyadh from London Heathrow, 7 days a week with Virgin Atlantic. Flights take off from 30th March 2025.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/Riyadh-NBF.jpg\",\"imageAltText\":\"Riyadh\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/lhr-svd-flying-days-info\",\"_variation\":\"master\",\"title\":\"Dive into St Vincent & the Grenadines\",\"bodyText\":{\"html\":\"<p>Flights depart from London Heathrow <b>Mondays, Wednesdays and Sundays</b> with a short touchdown in Barbados.</p>\\n<p>Explore more of the Caribbean, with new routes available between Barbados &amp; Grenada, and Barbados &amp; St Vincent with our island-hopping service.</p>\\n\",\"plaintext\":\"Flights depart from London Heathrow Mondays, Wednesdays and Sundays with a short touchdown in Barbados.\\n\\nExplore more of the Caribbean, with new routes available between Barbados & Grenada, and Barbados & St Vincent with our island-hopping service.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/st-vincent.jpg\",\"imageAltText\":\"Boats on a pier in St Vincent\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"SVD\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/lhr-uvf-flying-days-info\",\"_variation\":\"master\",\"title\":\"Soak it all up in St Lucia\",\"bodyText\":{\"html\":\"<p>Fly direct to St Lucia with Virgin Atlantic with our seasonal service.​</p>\\n<p>Between 28th October and 28th November 2024, flights depart <b>Mondays and Thursdays</b> and will include a short stop in Barbados​.</p>\\n<p>From the 1st December 2024, our direct service will restart with three flights a week. Flights depart <b>Wednesdays, Fridays and Sundays.</b></p>\\n\",\"plaintext\":\"Fly direct to St Lucia with Virgin Atlantic with our seasonal service.​\\n\\nBetween 28th October and 28th November 2024, flights depart Mondays and Thursdays and will include a short stop in Barbados​.\\n\\nFrom the 1st December 2024, our direct service will restart with three flights a week. Flights depart Wednesdays, Fridays and Sundays.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/st-lucia-pitons.jpg\",\"imageAltText\":\"Lady swimming with backdrop of the Pitons in St Lucia\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"UVF\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/maldives-july-24-promo\",\"_variation\":\"master\",\"title\":\"Save £150pp on flights to the Maldives\",\"bodyText\":{\"html\":\"<p>Dive into the Maldives and save <b>£150 per person</b>. Valid on departures travelling in <b>November 2024</b>. Use code <b>MVSUN </b>when selecting your flights.</p>\\n<p><b>Hurry - Offer ends 18th July 2024.</b></p>\\n<p>*Terms apply.</p>\\n\",\"plaintext\":\"Dive into the Maldives and save £150 per person. Valid on departures travelling in November 2024. Use code MVSUN when selecting your flights.\\n\\nHurry - Offer ends 18th July 2024.\\n\\n*Terms apply.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/Maldives-NBF.jpg\",\"imageAltText\":\"Maldives\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"MLE\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":3,\"displayFrom\":\"2024-07-12\",\"displayUntil\":\"2024-07-18\",\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/man-bgi-flying-days-info\",\"_variation\":\"master\",\"title\":\"Find your rhythm in Barbados\",\"bodyText\":{\"html\":\"<p>Fly direct from Manchester to Barbados with Virgin Atlantic.</p>\\n<p>From the 28th October 2024, direct flights take off <b>four times</b> a week. Flights depart Mondays, Thursdays, Saturdays and Sundays.​</p>\\n<p>​Indirect flights via London Heathrow are available year round.</p>\\n\",\"plaintext\":\"Fly direct from Manchester to Barbados with Virgin Atlantic.\\n\\nFrom the 28th October 2024, direct flights take off four times a week. Flights depart Mondays, Thursdays, Saturdays and Sundays.​\\n\\n​Indirect flights via London Heathrow are available year round.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/barbados-snorkels.jpg\",\"imageAltText\":\"Man and son wearing snorkels and lying on sunbeds\",\"originAirports\":[\"MAN\"],\"destinationAirports\":[\"BGI\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":false}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/mle-flying-info\",\"_variation\":\"master\",\"title\":\"Make waves in the Maldives\",\"bodyText\":{\"html\":\"<p>Fly direct to the Maldives with Virgin Atlantic. Daily flights take off from 27th October 2024.</p>\\n\",\"plaintext\":\"Fly direct to the Maldives with Virgin Atlantic. Daily flights take off from 27th October 2024.\"},\"image\":\"/content/dam/bookflow-banner-images/maldives-bf-banner-square.jpg\",\"imageAltText\":\"Man paddleboarding in the Maldives\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"MLE\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/multiple\",\"_variation\":\"master\",\"title\":\"Let's go, Toronto\",\"bodyText\":{\"html\":\"<p>Fly direct from London Heathrow to Toronto with Virgin Atlantic.</p>\\n<p>&nbsp;Daily flights take off from 30th March 2025.</p>\\n\",\"plaintext\":\"Fly direct from London Heathrow to Toronto with Virgin Atlantic.\\n\\n Daily flights take off from 30th March 2025.\"},\"image\":\"/content/dam/vaa-home/hp/content-cards/Economy_Delight-1024x576.jpg\",\"imageAltText\":null,\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"YYZ\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"flight-hotel\",\"flight-car\",\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/no-destination-airport\",\"_variation\":\"master\",\"title\":\"LHR Only\",\"bodyText\":{\"html\":\"<p>Fly&nbsp;direct&nbsp;from&nbsp;London&nbsp;Heathrow&nbsp;with&nbsp;Virgin&nbsp;Atlantic&nbsp;during&nbsp;our&nbsp;seasonal&nbsp;service.&nbsp;</p>\\n\",\"plaintext\":\"Fly direct from London Heathrow with Virgin Atlantic during our seasonal service. \"},\"image\":null,\"imageAltText\":null,\"originAirports\":[\"LHR\"],\"destinationAirports\":null,\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"alert-info\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/nrs-holding-message\",\"_variation\":\"master\",\"title\":\"We’re making some changes to our new reward seat fares\",\"bodyText\":{\"html\":\"<p>Come back later today to take a look.</p>\\n\",\"plaintext\":\"Come back later today to take a look.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/tailfin.jpg\",\"imageAltText\":\"Virgin Atlantic aircraft tailfin\",\"originAirports\":null,\"destinationAirports\":[\"ACC\",\"ANU\",\"ATL\",\"BOM\",\"BOS\",\"CPT\",\"DEL\",\"DXB\",\"EDI\",\"GND\",\"IAD\",\"JNB\",\"LAX\",\"LHR\",\"LOS\",\"MAN\",\"MBJ\",\"MIA\",\"MLE\",\"NAS\",\"PLS\",\"SEA\",\"SFO\",\"SVD\",\"TLV\",\"TPA\",\"UVF\",\"YYZ\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":1,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/sales-banner-right-test\",\"_variation\":\"master\",\"title\":\"Sales banner right\",\"bodyText\":{\"html\":\"<p>This is a test sales banner to check if the sales banner is appearing on the right of the flight search page.&nbsp;</p>\\n<p>&nbsp;</p>\\n<ul>\\n<li>list item 1</li>\\n<li>list item 2</li>\\n<li>list item 3</li>\\n</ul>\\n<p>&nbsp;</p>\\n<ol>\\n<li>number list item 1</li>\\n<li>number list item 2</li>\\n<li>number list item 3</li>\\n</ol>\\n<p style=\\\"margin-left: 40px;\\\">indented item to the right</p>\\n<p style=\\\"margin-left: 160px;\\\">Indented items 3 times to the right and then once outdent</p>\\n<p>&nbsp;</p>\\n<p><b>This is a bit of bold text</b></p>\\n<p><i>This is a bit of italic text</i></p>\\n<p><u>This is a bit of underlined text</u></p>\\n<p style=\\\"text-align: right;\\\">This is some text that get's aligned to the right.</p>\\n<p style=\\\"text-align: center;\\\">This is some text that get's centre aligned</p>\\n<p style=\\\"text-align: left;\\\">This is some text that get's aligned to the left</p>\\n<p style=\\\"text-align: left;\\\"><a href=\\\"https://www.virginatlantic.com/experience/economy\\\">This is a link for economy experience</a></p>\\n<p style=\\\"text-align: left;\\\">Below is a asset inserted via the rich text editor&nbsp;</p>\\n<p style=\\\"text-align: left;\\\"><img src=\\\"/content/dam/vaa-home/app-page/content/flying-club/ways-to-earn-points-small.jpg\\\" data-assetref=\\\"ways-to-earn-points-small-1783495433312\\\"></p>\\n<p style=\\\"text-align: left;\\\">&nbsp;</p>\\n<p style=\\\"text-align: left;\\\">&lt;p&gt;this is html code added&lt;/p&gt;</p>\\n\",\"plaintext\":\"This is a test sales banner to check if the sales banner is appearing on the right of the flight search page. \\n\\n\\n\\nlist item 1\\n\\nlist item 2\\n\\nlist item 3\\n\\n\\n\\nnumber list item 1\\n\\nnumber list item 2\\n\\nnumber list item 3\\n\\nindented item to the right\\n\\nIndented items 3 times to the right and then once outdent\\n\\n\\n\\nThis is a bit of bold text\\n\\nThis is a bit of italic text\\n\\nThis is a bit of underlined text\\n\\nThis is some text that get's aligned to the right.\\n\\nThis is some text that get's centre aligned\\n\\nThis is some text that get's aligned to the left\\n\\nThis is a link for economy experience\\n\\nBelow is a asset inserted via the rich text editor \\n\\n\\n\\n\\n\\n<p>this is html code added</p>\"},\"image\":null,\"imageAltText\":null,\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"JFK\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-right\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/edi-mco\",\"_variation\":\"master\",\"title\":\"Fly with us direct to Orlando - EDI to MCO test Sales banner 22nd April\",\"bodyText\":{\"html\":\"<p>Flights between Edinburgh and Orlando will take off <b>twice a week</b> from April 1st to October 2025.</p>\\n<ul>\\n<li>Between 30th April and 18th October, both inbound and outbound flights will still depart on Wednesdays and Saturdays,.</li>\\n<li>Between 1st - 25th April, and 18th-24th October, outbound flights will still depart on Wednesday and Saturdays, and inbound flights will operate on Tuesdays and Fridays</li>\\n</ul>\\n<p><b>Test sales banner</b></p>\\n\",\"plaintext\":\"Flights between Edinburgh and Orlando will take off twice a week from April 1st to October 2025.\\n\\nBetween 30th April and 18th October, both inbound and outbound flights will still depart on Wednesdays and Saturdays,.\\n\\nBetween 1st - 25th April, and 18th-24th October, outbound flights will still depart on Wednesday and Saturdays, and inbound flights will operate on Tuesdays and Fridays\\n\\nTest sales banner\"},\"image\":null,\"imageAltText\":null,\"originAirports\":[\"EDI\"],\"destinationAirports\":[\"MCO\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":1,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"holidays\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---acc\",\"_variation\":\"master\",\"title\":\"Go Gaga over Accra\",\"bodyText\":{\"html\":\"<p>Fly <b>direct</b>&nbsp;to Accra from London Heathrow 7 days a week with Virgin Atlantic</p>\\n<ul>\\n<li>Flights commence <b>1st May 2025</b></li>\\n</ul>\\n<p>Book your flight today!</p>\\n\",\"plaintext\":\"Fly direct to Accra from London Heathrow 7 days a week with Virgin Atlantic\\n\\nFlights commence 1st May 2025\\n\\nBook your flight today!\"},\"image\":null,\"imageAltText\":null,\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"ACC\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"flight-hotel\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---bom\",\"_variation\":\"master\",\"title\":\"Great news...Additional flights to Mumbai added for autumn 2024! \",\"bodyText\":{\"html\":\"<p>Daily flights available with Virgin Atlantic from London Heathrow</p>\\n<ul>\\n<li>From 27th October 2024, our flights to Mumbai will increase to <b>two flights per day</b></li>\\n</ul>\\n\",\"plaintext\":\"Daily flights available with Virgin Atlantic from London Heathrow\\n\\nFrom 27th October 2024, our flights to Mumbai will increase to two flights per day\\n\\n\"},\"image\":null,\"imageAltText\":null,\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"BOM\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---cpt\",\"_variation\":\"master\",\"title\":\"Set your sights on South Africa's mother city, Cape Town\",\"bodyText\":{\"html\":\"<p>Fly <b>direct </b>from London Heathrow during our seasonal service.</p>\\n<ul>\\n<li>From <b>26th October 2024</b>, Virgin Atlantic will operate <b>daily </b>flights to Cape Town until 30th April 2025</li>\\n</ul>\\n<p>Book your flight today!</p>\\n\",\"plaintext\":\"Fly direct from London Heathrow during our seasonal service.\\n\\nFrom 26th October 2024, Virgin Atlantic will operate daily flights to Cape Town until 30th April 2025\\n\\nBook your flight today!\"},\"image\":null,\"imageAltText\":null,\"originAirports\":null,\"destinationAirports\":[\"CPT\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---dxb\",\"_variation\":\"master\",\"title\":\"Discover Dubai\",\"bodyText\":{\"html\":\"<p>Fly <b>direct </b>from London Heathrow during our seasonal service.</p>\\n<ul>\\n<li>From <b>26th October 2024</b>, Virgin Atlantic will operate <b>daily </b>flights to Dubai</li>\\n</ul>\\n<p>Book your flight today!</p>\\n\",\"plaintext\":\"Fly direct from London Heathrow during our seasonal service.\\n\\nFrom 26th October 2024, Virgin Atlantic will operate daily flights to Dubai\\n\\nBook your flight today!\"},\"image\":null,\"imageAltText\":null,\"originAirports\":null,\"destinationAirports\":[\"DXB\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---flights-to-antigua\",\"_variation\":\"master\",\"title\":\"Looking for flights to Antigua? \",\"bodyText\":{\"html\":\"<p>Fly to Antigua with Virgin Atlantic during our seasonal service.</p>\\n<ul>\\n<li>Flights currently depart on Thursdays and will include a short touchdown* in Barbados</li>\\n<li>From the <b>28th October 2024</b>, fly direct on Mondays, Tuesdays and Thursdays</li>\\n<li>From the <b>2nd November 2024</b>, fly direct on Saturdays</li>\\n<li>From the <b>25th November 2024 - 29th March 2025</b>, flights will depart Mondays, Tuesdays, Thursdays and Saturdays</li>\\n<li>From the <b>30th March 2025 - 30th April 2025</b>, flights will depart on Tuesdays, Wednesdays, Fridays and Sundays</li>\\n</ul>\\n<p>*During the short touchdown, passengers and luggage for Antigua will remain on the aircraft</p>\\n\",\"plaintext\":\"Fly to Antigua with Virgin Atlantic during our seasonal service.\\n\\nFlights currently depart on Thursdays and will include a short touchdown* in Barbados\\n\\nFrom the 28th October 2024, fly direct on Mondays, Tuesdays and Thursdays\\n\\nFrom the 2nd November 2024, fly direct on Saturdays\\n\\nFrom the 25th November 2024 - 29th March 2025, flights will depart Mondays, Tuesdays, Thursdays and Saturdays\\n\\nFrom the 30th March 2025 - 30th April 2025, flights will depart on Tuesdays, Wednesdays, Fridays and Sundays\\n\\n*During the short touchdown, passengers and luggage for Antigua will remain on the aircraft\"},\"image\":null,\"imageAltText\":null,\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"ANU\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---flights-to-pls\",\"_variation\":\"master\",\"title\":\"Looking to dive into Turks and Caicos?\",\"bodyText\":{\"html\":\"<p>Fly direct with Virgin Atlantic from London Heathrow twice a week</p>\\n<ul>\\n<li>Flights currently depart on Tuesdays and Thursdays</li>\\n<li>From the <b>30th October - 30th November</b>, flights will depart on Wednesdays and Saturdays</li>\\n<li>From the <b>4th December 2024</b>, flights will depart on Wednesdays and Fridays</li>\\n<li>This service ends <b>21st February 2025</b></li>\\n</ul>\\n\",\"plaintext\":\"Fly direct with Virgin Atlantic from London Heathrow twice a week\\n\\nFlights currently depart on Tuesdays and Thursdays\\n\\nFrom the 30th October - 30th November, flights will depart on Wednesdays and Saturdays\\n\\nFrom the 4th December 2024, flights will depart on Wednesdays and Fridays\\n\\nThis service ends 21st February 2025\\n\\n\"},\"image\":null,\"imageAltText\":null,\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"PLS\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---gnd\",\"_variation\":\"master\",\"title\":\"Looking for gorgeous Grenada?\",\"bodyText\":{\"html\":\"<p>Please note that all of our flights to Grenada include a touchdown*</p>\\n<ul>\\n<li>Flights depart <b>Tuesdays and Saturdays</b></li>\\n<li>Between <b>29th October 2024 - 29th March 2025</b>, our service will include <b>three </b>flights per week departing on <b>Tuesdays, Fridays and Saturdays</b></li>\\n<li>Between <b>1st April 2025 - 25th October 2025</b>, flights will depart <b>Tuesdays and Thursdays&nbsp;</b></li>\\n</ul>\\n<p>*Passengers and luggage remain on the aircraft during the 1-hour touchdown in Barbados</p>\\n\",\"plaintext\":\"Please note that all of our flights to Grenada include a touchdown*\\n\\nFlights depart Tuesdays and Saturdays\\n\\nBetween 29th October 2024 - 29th March 2025, our service will include three flights per week departing on Tuesdays, Fridays and Saturdays\\n\\nBetween 1st April 2025 - 25th October 2025, flights will depart Tuesdays and Thursdays \\n\\n*Passengers and luggage remain on the aircraft during the 1-hour touchdown in Barbados\"},\"image\":null,\"imageAltText\":null,\"originAirports\":null,\"destinationAirports\":[\"GND\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---lhr---mle\",\"_variation\":\"master\",\"title\":\"Search Panel Messaging - LHR - MLE\",\"bodyText\":{\"html\":\"<p><b>Testing Holiday Sales Banner Maldives</b></p>\\n\",\"plaintext\":\"Testing Holiday Sales Banner Maldives\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/Maldives-NBF.jpg\",\"imageAltText\":null,\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"MLE\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":1,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"holidays\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---maldives\",\"_variation\":\"master\",\"title\":\"Looking to dive into the Maldives?\",\"bodyText\":{\"html\":\"<p>Fly <b>direct</b>&nbsp;from London Heathrow with Virgin Atlantic during our seasonal service.</p>\\n<ul>\\n<li>From <b>27th October 2024</b>, Virgin Atlantic will operate <b>daily </b>flights to the Maldives</li>\\n</ul>\\n<p>Book your flight today!</p>\\n\",\"plaintext\":\"Fly direct from London Heathrow with Virgin Atlantic during our seasonal service.\\n\\nFrom 27th October 2024, Virgin Atlantic will operate daily flights to the Maldives\\n\\nBook your flight today!\"},\"image\":null,\"imageAltText\":null,\"originAirports\":null,\"destinationAirports\":[\"MLE\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---man-bgi\",\"_variation\":\"master\",\"title\":\"Caribbean calling?\",\"bodyText\":{\"html\":\"<p>Fly <b>direct </b>from Manchester to Barbados with Virgin Atlantic during our seasonal service.</p>\\n<ul>\\n<li>Between&nbsp;<b>27th October 2024 - 29th March 2025</b>&nbsp;our direct service restarts operating <b>four</b> <b>flights</b> a week. Flights depart Mondays, Thursdays, Saturdays and Sundays.</li>\\n<li>From <b>13th January - 2nd March 2025</b>&nbsp;our service will include five direct flights per week, departing on Mondays, Wednesdays, Thursdays, Saturdays and Sundays.</li>\\n</ul>\\n<p>Indirect flights from Manchester via London Heathrow are available all year round.</p>\\n\",\"plaintext\":\"Fly direct from Manchester to Barbados with Virgin Atlantic during our seasonal service.\\n\\nBetween 27th October 2024 - 29th March 2025 our direct service restarts operating four flights a week. Flights depart Mondays, Thursdays, Saturdays and Sundays.\\n\\nFrom 13th January - 2nd March 2025 our service will include five direct flights per week, departing on Mondays, Wednesdays, Thursdays, Saturdays and Sundays.\\n\\nIndirect flights from Manchester via London Heathrow are available all year round.\"},\"image\":null,\"imageAltText\":null,\"originAirports\":[\"MAN\"],\"destinationAirports\":[\"BGI\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---man-las\",\"_variation\":\"master\",\"title\":\"Ruffle some feathers in Las Vegas \",\"bodyText\":{\"html\":\"<p>Fly <b>direct </b>from Manchester to Las Vegas with our seasonal Virgin Atlantic service.</p>\\n<ul>\\n<li>Flights currently depart three times a week on <b>Wednesdays, Fridays and Sundays</b> until <b>October 25th 2024</b></li>\\n<li>Flights will resume <b>29th April 2025</b>, departing on <b>Tuesdays, Fridays and Sundays</b></li>\\n</ul>\\n<p>Daily indirect flights via London Heathrow are available year round.</p>\\n\",\"plaintext\":\"Fly direct from Manchester to Las Vegas with our seasonal Virgin Atlantic service.\\n\\nFlights currently depart three times a week on Wednesdays, Fridays and Sundays until October 25th 2024\\n\\nFlights will resume 29th April 2025, departing on Tuesdays, Fridays and Sundays\\n\\nDaily indirect flights via London Heathrow are available year round.\"},\"image\":null,\"imageAltText\":null,\"originAirports\":[\"MAN\"],\"destinationAirports\":[\"LAS\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---mbj\",\"_variation\":\"master\",\"title\":\"Looking for beautiful Jamaica?\",\"bodyText\":{\"html\":\"<p>Fly to Montego Bay 7 days a week with Virgin Atlantic from London Heathrow</p>\\n<ul>\\n<li><b>Direct flights</b>&nbsp;to Montego Bay operate on <b>Wednesdays, Saturdays and Sundays*</b></li>\\n</ul>\\n<p style=\\\"margin-left: 40px;\\\"><b>*</b>28th October - 29th November: Mondays and Fridays</p>\\n<p style=\\\"margin-left: 40px;\\\">*2nd December - 22nd February: Mondays and Saturdays</p>\\n<p style=\\\"margin-left: 40px;\\\">*From the 24th February 2025, direct flights will operate on Mondays, Tuesdays, Thursdays, and Saturdays</p>\\n<ul>\\n<li><b>Indirect flights </b>depart <b>Mondays, Tuesdays, Thursdays and Fridays*&nbsp;</b>and will include a short touchdown in either Nassau or Turks and Caicos</li>\\n</ul>\\n<p style=\\\"margin-left: 40px;\\\">*5th November - 20th February: Tuesdays, Thursdays and Sundays, flights will include a short touchdown in Nassau</p>\\n<p style=\\\"margin-left: 40px;\\\">*30th October - 30th November: Wednesdays and Saturdays</p>\\n<p style=\\\"margin-left: 40px;\\\">*4th December - 21st February: Wednesdays and Fridays, flights will include a short touchdown in Turks &amp; Caicos</p>\\n<p><b>Please note: </b>passengers and luggage will remain on the aicraft during 1-hour touchdown</p>\\n\",\"plaintext\":\"Fly to Montego Bay 7 days a week with Virgin Atlantic from London Heathrow\\n\\nDirect flights to Montego Bay operate on Wednesdays, Saturdays and Sundays*\\n\\n*28th October - 29th November: Mondays and Fridays\\n\\n*2nd December - 22nd February: Mondays and Saturdays\\n\\n*From the 24th February 2025, direct flights will operate on Mondays, Tuesdays, Thursdays, and Saturdays\\n\\nIndirect flights depart Mondays, Tuesdays, Thursdays and Fridays* and will include a short touchdown in either Nassau or Turks and Caicos\\n\\n*5th November - 20th February: Tuesdays, Thursdays and Sundays, flights will include a short touchdown in Nassau\\n\\n*30th October - 30th November: Wednesdays and Saturdays\\n\\n*4th December - 21st February: Wednesdays and Fridays, flights will include a short touchdown in Turks & Caicos\\n\\nPlease note: passengers and luggage will remain on the aicraft during 1-hour touchdown\"},\"image\":null,\"imageAltText\":null,\"originAirports\":null,\"destinationAirports\":[\"MBJ\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---pvg\",\"_variation\":\"master\",\"title\":\"Set your sights to Shanghai\",\"bodyText\":{\"html\":\"<p>Daily flights available, direct with Virgin Atlantic from London Heathrow</p>\\n<ul>\\n<li>This service ends<b> 25th October 2024</b></li>\\n</ul>\\n\",\"plaintext\":\"Daily flights available, direct with Virgin Atlantic from London Heathrow\\n\\nThis service ends 25th October 2024\\n\\n\"},\"image\":null,\"imageAltText\":null,\"originAirports\":null,\"destinationAirports\":[\"PVG\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"flight-hotel\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---ruh\",\"_variation\":\"master\",\"title\":\"Ahlan Riyadh!\",\"bodyText\":{\"html\":\"<p>Fly <b>direct</b>&nbsp;to Riyadh from London Heathrow 7 days a week with Virgin Atlantic</p>\\n<ul>\\n<li>Flights commence <b>30th March 2025</b></li>\\n</ul>\\n<p>Book your flight today!</p>\\n\",\"plaintext\":\"Fly direct to Riyadh from London Heathrow 7 days a week with Virgin Atlantic\\n\\nFlights commence 30th March 2025\\n\\nBook your flight today!\"},\"image\":null,\"imageAltText\":null,\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"RUH\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"flight-hotel\",\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---tlv\",\"_variation\":\"master\",\"title\":\"Looking for flights to Tel Aviv?\",\"bodyText\":{\"html\":\"<p>Due to the ongoing situation in Israel, we have taken the difficult decision to extend our pause on flights to and from Tel Aviv.</p>\\n\",\"plaintext\":\"Due to the ongoing situation in Israel, we have taken the difficult decision to extend our pause on flights to and from Tel Aviv.\"},\"image\":null,\"imageAltText\":null,\"originAirports\":null,\"destinationAirports\":[\"TLV\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---toronto\",\"_variation\":\"master\",\"title\":\"Let's go, Toronto Test Sales banner + HOLS\",\"bodyText\":{\"html\":\"<p>This is a test Sales banner - Direct Virgin Atlantic flights take off <b>daily </b>from 30th March 2025.</p>\\n\",\"plaintext\":\"This is a test Sales banner - Direct Virgin Atlantic flights take off daily from 30th March 2025.\"},\"image\":null,\"imageAltText\":null,\"originAirports\":null,\"destinationAirports\":[\"YYZ\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":1,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"holidays\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---uvf\",\"_variation\":\"master\",\"title\":\"Discover St Vincent and the Grenadines\",\"bodyText\":{\"html\":\"<p>Please note, our flights to St Vincent and the Grenadines include a touchdown*</p>\\n<ul>\\n<li>Flights currently depart <b>Mondays, Wednesdays and Sundays</b></li>\\n<li>From <b>27th October - 1st December 2024</b>,&nbsp;flights departs <b>Wednesdays and Sundays</b></li>\\n<li>From the <b>2nd December 2024</b>, our service will include three flights per week departing <b>Mondays, Wednesdays and Sundays</b></li>\\n</ul>\\n<p>*Passengers and luggage remain on the aircraft during the 1-hour touchdown in Barbados</p>\\n\",\"plaintext\":\"Please note, our flights to St Vincent and the Grenadines include a touchdown*\\n\\nFlights currently depart Mondays, Wednesdays and Sundays\\n\\nFrom 27th October - 1st December 2024, flights departs Wednesdays and Sundays\\n\\nFrom the 2nd December 2024, our service will include three flights per week departing Mondays, Wednesdays and Sundays\\n\\n*Passengers and luggage remain on the aircraft during the 1-hour touchdown in Barbados\"},\"image\":null,\"imageAltText\":null,\"originAirports\":null,\"destinationAirports\":[\"SVD\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging---uvf-1\",\"_variation\":\"master\",\"title\":\"Looking for lovely St Lucia?\",\"bodyText\":{\"html\":\"<p>Fly direct to St Lucia with Virgin Atlantic during our seasonal service</p>\\n<ul>\\n<li>Between <b>28th October -</b>&nbsp;<b>28th November 2024</b>, flights depart Mondays and Thursdays with a short touchdown in Barbados</li>\\n<li>Direct flights resume <b>1st December 2024</b>&nbsp;departing Wednesdays, Fridays and Sundays</li>\\n</ul>\\n\",\"plaintext\":\"Fly direct to St Lucia with Virgin Atlantic during our seasonal service\\n\\nBetween 28th October - 28th November 2024, flights depart Mondays and Thursdays with a short touchdown in Barbados\\n\\nDirect flights resume 1st December 2024 departing Wednesdays, Fridays and Sundays\\n\\n\"},\"image\":null,\"imageAltText\":null,\"originAirports\":null,\"destinationAirports\":[\"UVF\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/search-panel-messaging/search-panel-messaging-lgw-departures\",\"_variation\":\"master\",\"title\":\"Looking for London Gatwick?\",\"bodyText\":{\"html\":\"<p>Most of our flights currently operate to/from London Heathrow, with selected routes to/from Manchester, Edinburgh and Belfast.</p>\\n<p>You can also fly direct to/from other UK regions with our partner airlines.</p>\\n\",\"plaintext\":\"Most of our flights currently operate to/from London Heathrow, with selected routes to/from Manchester, Edinburgh and Belfast.\\n\\nYou can also fly direct to/from other UK regions with our partner airlines.\"},\"image\":null,\"imageAltText\":null,\"originAirports\":[\"LGW\"],\"destinationAirports\":null,\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\",\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/sept-2024-sale-generic\",\"_variation\":\"master\",\"title\":\"Sale now on*\",\"bodyText\":{\"html\":\"<p>It's a big deal.&nbsp;See more of the world, for less. Book by 1st October.</p>\\n<p>*Selected routes and dates only. <a href=\\\"https://flights.virginatlantic.com/en-gb/sale#terms\\\" target=\\\"_blank\\\">See full terms and conditions.</a></p>\\n\",\"plaintext\":\"It's a big deal. See more of the world, for less. Book by 1st October.\\n\\n*Selected routes and dates only. See full terms and conditions.\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/tailfin.jpg\",\"imageAltText\":null,\"originAirports\":[\"LHR\",\"MAN\"],\"destinationAirports\":[\"BGI\",\"MLE\",\"TPA\",\"LAX\",\"UVF\",\"ANU\",\"SVD\",\"GND\",\"MBJ\",\"YYZ\",\"NAS\",\"PLS\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":8,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":null,\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/test-flight-only\",\"_variation\":\"master\",\"title\":\"Test flight only\",\"bodyText\":{\"html\":\"<p>Test flight only</p>\\n\",\"plaintext\":\"Test flight only\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/tailfin.jpg\",\"imageAltText\":\"Aircraft tailfin\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"LOS\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":2,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"flight-only\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/test-reward-only\",\"_variation\":\"master\",\"title\":\"Test redemption only\",\"bodyText\":{\"html\":\"<p>Test redemption only</p>\\n\",\"plaintext\":\"Test redemption only\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/tailfin.jpg\",\"imageAltText\":\"Aircraft tailfin\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"ATL\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"search-top\",\"ranking\":2,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"reward-flights\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/test-sales-banner\",\"_variation\":\"master\",\"title\":\"Test Sales Banner\",\"bodyText\":{\"html\":\"<p>This is a test sales banner with a seasonal messaging position from MAN - MLE</p>\\n\",\"plaintext\":\"This is a test sales banner with a seasonal messaging position from MAN - MLE\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/Maldives-NBF.jpg\",\"imageAltText\":null,\"originAirports\":[\"LHR\",\"MAN\"],\"destinationAirports\":[\"MLE\",\"MCO \"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":null,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"holidays\"],\"theme\":\"sales-banner\",\"enabled\":true}",
    "{\"_path\":\"/content/dam/vaa-home/sales-banners/test-search-right\",\"_variation\":\"master\",\"title\":\"Testing Holidays Sales Banner\",\"bodyText\":{\"html\":\"<p><b>This is a Holiday Sales banner from London Heathrow to Maldives</b></p>\\n<p>This means that Holidays has been selected as the booking type and the sales banner displays on search panel</p>\\n<p><a href=\\\"https://www.virginatlantic.com/holidays\\\">Test Holidays sales banner link</a></p>\\n\",\"plaintext\":\"This is a Holiday Sales banner from London Heathrow to Maldives\\n\\nThis means that Holidays has been selected as the booking type and the sales banner displays on search panel\\n\\nTest Holidays sales banner link\"},\"image\":\"/content/dam/vaa-home/sales-banner-images/Maldives-NBF.jpg\",\"imageAltText\":\"Holidays Sales Banner Image\",\"originAirports\":[\"LHR\"],\"destinationAirports\":[\"MLE\"],\"earliestDepartureDate\":null,\"latestDepartureDate\":null,\"earliestReturnDate\":null,\"latestReturnDate\":null,\"flightDirection\":null,\"displayLocation\":\"seasonal-messaging\",\"ranking\":5,\"displayFrom\":null,\"displayUntil\":null,\"minAdults\":null,\"maxAdults\":null,\"minTeens\":null,\"maxTeens\":null,\"minChildren\":null,\"maxChildren\":null,\"minInfants\":null,\"maxInfants\":null,\"dayOfWeek\":null,\"bookingTypes\":[\"holidays\"],\"theme\":\"sales-banner\",\"enabled\":true}"
]