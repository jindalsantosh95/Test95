###Request
POST https://testresources.virginatlantic.com/dev/orderdata/scv/orders/by-flight-date HTTP/1.1

$[?(@.pnr == 'ABC123')]
$[?(@.firstName == 'Jane')]
$[?(@.lastName == 'Doe')]

$[?(@.flightDate == '31AUG25')]

