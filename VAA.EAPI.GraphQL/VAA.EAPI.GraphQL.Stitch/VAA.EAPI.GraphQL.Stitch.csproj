        <PackageReference Include="Microsoft.Azure.WebJobs.Extensions" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
        <PackageReference Include="Microsoft.OpenApi" />
        <PackageReference Include="Microsoft.Azure.WebJobs.Extensions.OpenApi.Core" />
        <PackageReference Include="Selenium.Support" />
        <PackageReference Include="Selenium.WebDriver" />
        <PackageReference Include="Selenium.WebDriver.ChromeDriver" Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>

    <ItemGroup>
        <None Update="host.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="local.settings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </None>
    </ItemGroup>

  <ItemGroup>
    <Compile Include="../NativeWebSockets/NativeSubscriptionRegistry.cs" Link="Core/WebSockets/NativeSubscriptionRegistry.cs" />
    <Compile Include="../NativeWebSockets/RedisSubscriptionSessionStore.cs" Link="FunctionHost/WebSockets/RedisSubscriptionSessionStore.cs" />
  </ItemGroup>
  <Import Project="../NativeWebSocketHost.targets" />
</Project>
