<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".mocks\NearbyStores.mock">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include=".mocks\StoreDetails.mock">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include=".mocks\StoreSlots.mock">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include=".mocks\StoreCalendarAvailability.mock">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include=".mocks\StoreManager*.mock">
