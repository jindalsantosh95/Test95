    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VAA.EAPI.GraphQL.Common\VAA.EAPI.GraphQL.Common.csproj" />
    <ProjectReference Include="..\VAA.EAPI.GraphQL.Core.Functions\VAA.EAPI.GraphQL.Core.Functions.csproj" />
    <ProjectReference Include="..\VAA.EAPI.GraphQL.Core.Xunit\VAA.EAPI.GraphQL.Core.Xunit.csproj" />
    <ProjectReference Include="..\VAA.EAPI.GraphQL.Domain.Holidays\VAA.EAPI.GraphQL.Domain.Holidays.csproj" />
    <ProjectReference Include="..\VAA.EAPI.GraphQL.Infrastructure\VAA.EAPI.GraphQL.Infrastructure.csproj" />
  </ItemGroup>

</Project>
