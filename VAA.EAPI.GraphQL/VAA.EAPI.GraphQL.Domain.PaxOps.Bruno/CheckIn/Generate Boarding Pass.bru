meta {
  name: Generate Boarding Pass
  type: graphql
  seq: 10
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation GenerateBoardingPass {
      GenerateBoardingPass(checkInId: "{{checkInId}}") {
          checkInStatus
          boardingPasses {
              pnrLocator
              givenNames
              surname
              passengerNIN
              seatNumber
              zone
              terminal
              operatingAirlineName
              marketingAirlineName
              operatingFlightNumber
              marketingFlightNumber
              destinationAirportCode
              originAirportCode
              departureDateTime
              departureLocal
              qrCodeData
              desktopBoardingPassBase64
              verificationStatusMessage
              templateCode
              cabinName
              gate
              boardingTime
              boardingTimeLocalTime
              showSkyPriority
              showTsaPre
              flightStatusCode
              infantName
              checkedIn
          }
      }
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}
