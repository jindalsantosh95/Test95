meta {
  name: Payment Eligibility Check
  type: graphql
  seq: 8
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation PaymentEligibilityCheck {
      PaymentEligibilityCheck(request: { checkInId: "{{checkInId}}", successRedirectUrl: "", failureRedirectUrl: "" }) {
          checkInId
          paymentPending
          paymentUrl
          hPPLink
          paymentReferenceId
          amount {
              currency
              totalAmount
          }
      }
  }
}

vars:post-response {
  checkInId: res("data.PaymentEligibilityCheck.checkInId")
  paymentUrl: res("data.PaymentEligibilityCheck.paymentUrl")
  hPPLink: res("data.PaymentEligibilityCheck.hPPLink")
}

script:post-response {
  var paymentReferenceId = res.body.data.PaymentEligibilityCheck.paymentReferenceId;
  bru.setEnvVar("paymentReferenceId", paymentReferenceId);
}

settings {
  encodeUrl: true
  timeout: 0
}
