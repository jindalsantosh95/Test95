      bru.setVar("pax3_givennames", checkIn.passengers[2].givenNames);
      bru.setVar("pax3_surname", checkIn.passengers[2].surname);
  }
  if (checkIn.passengers.length > 3)
  {
      bru.setVar("pax4_id", checkIn.passengers[3].passengerId);
      bru.setVar("pax4_givennames", checkIn.passengers[3].givenNames);
      bru.setVar("pax4_surname", checkIn.passengers[3].surname);
  }*/
}

settings {
  encodeUrl: true
  timeout: 0
}
