meta {
  name: MyAccount- SignIn Mutation
  type: graphql
  seq: 5
}

post {
  url: {{graphql_mobile}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation {
    accountMemberSignIn(
      request: {
        flyingClubNumber: "9999998843",
        email: null,
        password: "{{myAccountPassword}}"
      }
    ) {
      tokenType
      scope
      expiresIn
      accessToken
      refreshToken
      idToken
      continuationToken
      requiresMFA
    }
  }
}

script:post-response {
  var loginToken = res.body.data.accountMemberSignIn.idToken;
  
  bru.setVar('loginToken', loginToken);
}

settings {
  encodeUrl: true
  timeout: 0
}
