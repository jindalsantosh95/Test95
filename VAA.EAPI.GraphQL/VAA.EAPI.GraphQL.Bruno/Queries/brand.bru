meta {
  name: brand
  type: graphql
  seq: 14
}

post {
  url: {{graphql_url}}
  body: graphql
  auth: inherit
}

body:graphql {
  # Replace generated placeholder values with scenario data before execution.
  query brand($request: BrandServiceRequestInput!) {
    brand(request: $request) {
      __typename
    }
  }
}

body:graphql:vars {
  {
    "request": {}
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
