meta {
  name: CarbonIndex
  type: graphql
  seq: 16
}

post {
  url: {{graphql_url}}
  body: graphql
  auth: inherit
}

body:graphql {
  # Replace generated placeholder values with scenario data before execution.
  query CarbonIndex($request: CarbonIndexRequestInput!) {
    CarbonIndex(request: $request) {
      __typename
    }
  }
}

body:graphql:vars {
  {
    "request": {
      "offerId": "",
      "passengerCounts": ""
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
