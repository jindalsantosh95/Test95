meta {
  name: accountLogin
  type: graphql
  seq: 6
}

post {
  url: {{graphql_url}}
  body: graphql
  auth: inherit
}

body:graphql {
  # Replace generated placeholder values with scenario data before execution.
  query accountLogin($memberLoginRequest: FlyingClubLoginRequestInput) {
    accountLogin(memberLoginRequest: $memberLoginRequest)
  }
}

body:graphql:vars {
  {
    "memberLoginRequest": {}
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
