meta {
  name: accountValidatePassword
  type: graphql
  seq: 10
}

post {
  url: {{graphql_url}}
  body: graphql
  auth: inherit
}

body:graphql {
  # Replace generated placeholder values with scenario data before execution.
  query accountValidatePassword($password: PasswordValidatorRequestInput) {
    accountValidatePassword(password: $password) {
      __typename
    }
  }
}

body:graphql:vars {
  {
    "password": {}
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
