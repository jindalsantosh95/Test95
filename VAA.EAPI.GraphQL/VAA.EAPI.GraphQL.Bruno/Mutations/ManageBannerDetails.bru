}

body:graphql {
  # Replace generated placeholder values with scenario data before execution.
  mutation ManageBannerDetails($bannerCode: String) {
    ManageBannerDetails(bannerCode: $bannerCode)
  }
}

body:graphql:vars {
  {
    "bannerCode": ""
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
