  # Replace generated placeholder values with scenario data before execution.
  mutation SelectPassengers($checkInId: String, $passengerIds: [String]) {
    SelectPassengers(checkInId: $checkInId, passengerIds: $passengerIds) {
      __typename
    }
  }
}

