{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "AppSetting:RedisCacheConnectionString": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": { "description": "Existing Redis connection or Key Vault reference. Required for subscription services." }
    },
    "NativeWebSocketsConfiguration": {
      "type": "object",
      "defaultValue": {
        "redisPrefix": "",
        "startupHookPath": "",
        "existingStartupHooks": "",
        "workerProcessCount": "1",
        "path": "/api/v1/GraphQL/ws"
      },
      "metadata": {
        "description": "Native WebSocket settings grouped to keep the shared ARM template below the 256-parameter limit. Enable only after validating prerequisites."
      }
    },
    "NativeWebSocketsBridgeSecret": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": { "description": "Resolved bridge secret or Key Vault reference; at least 32 characters. Required when native WebSockets are enabled." }
    },
    "DataDog": {
      "type": "secureObject",
      "defaultValue": {
        "LoggingProvider": "AppInsights",
        "LogsEndpoint": "https://http-intake.logs.datadoghq.com/api/v2/logs",
        "ApiKey": "",
        "Site": "datadoghq.com",
        "Environment": "",
        "Source": "csharp",
        "Version": "",
        "TraceEnabled": true,
        "RuntimeMetricsEnabled": true,

        "Tags": "",
        "BaggageAllowList": "",
        "MinimumLogLevel": "Information",
        "QueueCapacity": 5000,
        "BatchSize": 100,
        "FlushIntervalMilliseconds": 2000
      }
    },
    "SlotName": {
      "type": "String"
    },
    "FunctionAppName": {
      "type": "String"
    },
    "EnvironmentName": {
      "type": "string"
    },
    "ServerFarmIdRg": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "AppInsightsName": {
      "type": "string"
    },
    "storageAccountName": {
      "type": "string"
    },
    "vaultName": {
      "type": "string"
    },
    "AppSetting:AppInsightsKey": {
      "type": "string"
    },
    "AppSetting:APPLICATIONINSIGHTS_CONNECTION_STRING": {
      "type": "string"
    },
    "ResourceGroupSubscriptionId": {
      "type": "string"
    },

    // Azure Function Settings
    "AppSetting:AzureWebJobsStorage": {
      "type": "string"
    },
    "AppSetting:AzureWebJobsSecretStorageType": {
      "type": "string"
    },
    /*"AppSetting:WEBSITE_CONTENTSHARE": {
      "type": "string"
    },*/
    "AppSetting:FUNCTIONS_EXTENSION_VERSION": {
      "type": "string"
    },
    "AppSetting:FUNCTIONS_WORKER_RUNTIME": {
      "type": "string"
    },

    "AppSetting:AllowIntrospection": {
      "type": "string"
    },
    "AppSetting:PersistedQueryStore": {
      "type": "string"
    },

    "Graphql": {
      "type": "object"
    },

    //Vnet Settings 
    "WEBSITE_DNS_ALT_SERVER": {
      "type": "string"
    },
    "WEBSITE_DNS_SERVER": {
      "type": "string"
    },
    "WEBSITE_VNET_ROUTE_ALL": {
      "type": "string"
    },

    "tags": {
      "type": "Object"
    }
  },
  "variables": {
    "AppInsightsName": "[parameters('AppInsightsName')]",
    "ResourceLocation": "[resourceGroup().location]",
    "SiteResourceID": "[resourceId('Microsoft.Web/Sites', parameters('FunctionAppName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[concat('subscription-slots-', uniqueString(resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))))]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]"
      ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "appName": {
            "value": "[parameters('FunctionAppName')]"
          },
          "existingSlotSettings": {
            "value": "[reference(resourceId('Microsoft.Web/sites/config', parameters('FunctionAppName'), 'slotConfigNames'), '2022-03-01')]"
          },
          "existingAppSettings": {
            "value": "[list(resourceId('Microsoft.Web/sites/config', parameters('FunctionAppName'), 'appsettings'), '2022-03-01').properties]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "appName": {
              "type": "string"
            },
            "existingSlotSettings": {
              "type": "object"
            },
            "existingAppSettings": {
              "type": "secureObject"
            }
          },
          "variables": {
            "emptyAppSettingNames": []
          },
          "resources": [
            {
              "type": "Microsoft.Web/sites/config",
              "apiVersion": "2022-03-01",
              "name": "[concat(parameters('appName'), '/slotConfigNames')]",
              "properties": "[union(parameters('existingSlotSettings'), createObject('appSettingNames', union(coalesce(tryGet(parameters('existingSlotSettings'), 'appSettingNames'), variables('emptyAppSettingNames')), createArray('NativeWebSocketsRedisPrefix'))))]"
            },
            {
              "condition": "[empty(coalesce(tryGet(parameters('existingAppSettings'), 'NativeWebSocketsRedisPrefix'), ''))]",
              "type": "Microsoft.Web/sites/config",
              "apiVersion": "2022-03-01",
              "name": "[concat(parameters('appName'), '/appsettings')]",
              "properties": "[union(parameters('existingAppSettings'), createObject('NativeWebSocketsRedisPrefix', parameters('appName')))]"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2021-09-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[variables('ResourceLocation')]",
      "tags": "[parameters('Tags')]",
      "sku": {
        "name": "Standard_RAGRS",
        "tier": "Standard"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "kind": "functionapp",
      "name": "[parameters('FunctionAppName')]",
      "apiVersion": "2018-11-01",
      "location": "[variables('ResourceLocation')]",
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]"
      },
      "tags": "[parameters('Tags')]"
    },
    {
      "type": "Microsoft.Web/sites/slots",
      "kind": "functionapp",
      "name": "[concat(parameters('FunctionAppName'), '/',parameters('SlotName'))]",
      "apiVersion": "2021-03-01",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [ "[variables('SiteResourceID')]" ],
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },
      "properties": {
        "enabled": true,
        "hostNameSslStates": [
          {
            "name": "[concat(parameters('FunctionAppName'), '-',parameters('SlotName'), '.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Standard"
          },
          {
            "name": "[concat(parameters('FunctionAppName'), '-',parameters('SlotName'), '.scm.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Repository"
          }
        ],

        "serverFarmId": "[resourceId('Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "alwaysOn": true,
          "appSettings": [
            {
              "name": "NativeWebSocketsRedisPrefix",
              "value": "[if(empty(if(contains(parameters('NativeWebSocketsConfiguration'), 'redisPrefix'), parameters('NativeWebSocketsConfiguration').redisPrefix, '')), concat(parameters('FunctionAppName'), '-', uniqueString(parameters('SlotName'))), parameters('NativeWebSocketsConfiguration').redisPrefix)]"
            },
            {
              "name": "RedisCacheConnectionString",
              "value": "[parameters('AppSetting:RedisCacheConnectionString')]"
            },
            {
              "name": "NativeWebSocketsPath",
              "value": "[parameters('NativeWebSocketsConfiguration').path]"
            },
            {
              "name": "FUNCTIONS_WORKER_PROCESS_COUNT",
              "value": "[parameters('NativeWebSocketsConfiguration').workerProcessCount]"
            },
            {
              "name": "DOTNET_STARTUP_HOOKS",
              "value": "[if(not(empty(parameters('NativeWebSocketsConfiguration').startupHookPath)), concat(parameters('NativeWebSocketsConfiguration').existingStartupHooks, if(empty(parameters('NativeWebSocketsConfiguration').existingStartupHooks), '', ';'), parameters('NativeWebSocketsConfiguration').startupHookPath), parameters('NativeWebSocketsConfiguration').existingStartupHooks)]"
            },
            {
              "name": "NativeWebSocketsBridgeSecret",
              "value": "[parameters('NativeWebSocketsBridgeSecret')]"
            },
            {
              "name": "LoggingProvider",
              "value": "[parameters('DataDog').LoggingProvider]"
            },
            {
              "name": "DatadogLogsEndpoint",
              "value": "[parameters('DataDog').LogsEndpoint]"
            },
            {
              "name": "DatadogApiKey",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_API_KEY",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_SITE",
              "value": "[parameters('DataDog').Site]"
            },
            {
              "name": "DD_SERVICE",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "DD_ENV",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DD_VERSION",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DD_TRACE_ENABLED",
              "value": "[string(parameters('DataDog').TraceEnabled)]"
            },
            {
              "name": "DD_RUNTIME_METRICS_ENABLED",
              "value": "[string(parameters('DataDog').RuntimeMetricsEnabled)]"
            },
            {
              "name": "DatadogService",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "environment",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DatadogSource",
              "value": "[parameters('DataDog').Source]"
            },
            {
              "name": "DatadogVersion",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DatadogTags",
              "value": "[concat(parameters('DataDog').Tags, if(empty(parameters('DataDog').Tags), '', ','), 'cloud_provider:azure,subscription_id:', subscription().subscriptionId, ',resource_group:', resourceGroup().name, ',name:', parameters('FunctionAppName'), ',type:microsoft.web/sites,resource_id:', resourceId('Microsoft.Web/sites', parameters('FunctionAppName')))]"
            },
            {
              "name": "DatadogBaggageAllowList",
              "value": "[parameters('DataDog').BaggageAllowList]"
            },
            {
              "name": "DatadogMinimumLogLevel",
              "value": "[parameters('DataDog').MinimumLogLevel]"
            },
            {
              "name": "DatadogQueueCapacity",
              "value": "[string(parameters('DataDog').QueueCapacity)]"
            },
            {
              "name": "DatadogBatchSize",
              "value": "[string(parameters('DataDog').BatchSize)]"
            },
            {
              "name": "DatadogFlushIntervalMilliseconds",
              "value": "[string(parameters('DataDog').FlushIntervalMilliseconds)]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "1"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "dotnet-isolated"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('AppInsightsName')), '2014-04-01').InstrumentationKey]"
            },
            {
              "name": "AzureWebJobsSecretStorageType",
              "value": "[parameters('AppSetting:AzureWebJobsSecretStorageType')]"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageAccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]"
            },
            {
              "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageAccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]"
            },
            /*{
              "name": "WEBSITE_CONTENTSHARE",
              "value": "[parameters('AppSetting:WEBSITE_CONTENTSHARE')]"
            },*/
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('AppInsightsName')), '2020-02-02').ConnectionString]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('AppInsightsName')), '2020-02-02').ConnectionString]"
            },
            {
              "name": "AllowIntrospection",
              "value": "[parameters('AppSetting:AllowIntrospection')]"
            },
            {
              "name": "PersistedQueryStore",
              "value": "[parameters('AppSetting:PersistedQueryStore')]"
            },
            {
              "name": "Graphql:Endpoints",
              "value": "[parameters('Graphql').Endpoints]"
            },
            {
              "name": "GraphqlTimeOutInSeconds",
              "value": "[string(parameters('Graphql').TimeOutInSeconds)]"
            },
            {
              "name": "Graphql:ResponseHeaders",
              "value": "[parameters('Graphql').ResponseHeaders]"
            },
            //Vnet settings
            {
              "name": "WEBSITE_DNS_ALT_SERVER",
              "value": "[parameters('WEBSITE_DNS_ALT_SERVER')]"
            },
            {
              "name": "WEBSITE_VNET_ROUTE_ALL",
              "value": "[parameters('WEBSITE_VNET_ROUTE_ALL')]"
            },
            {
              "name": "WEBSITE_DNS_SERVER",
              "value": "[parameters('WEBSITE_DNS_SERVER')]"
            }
          ]
        },
        "scmSiteAlsoStopped": false,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNamesDisabled": false,
        "containerSize": 1536,
        "dailyMemoryTimeQuota": 0,
        "httpsOnly": true,
        "redundancyMode": "None"
        //"virtualNetworkSubnetId": "[concat('/subscriptions/', parameters('ResourceGroupSubscriptionId'), '/resourceGroups/', parameters('vNetResourceGroupName'), '/providers/Microsoft.Network/virtualNetworks/', parameters('vNetName'), '/subnets/', parameters('vNetSubnetName'))]"
      },
      "tags": "[parameters('Tags')]"
    },
    {
      "type": "Microsoft.Web/sites/slots/config",
      "apiVersion": "2021-03-01",
      "name": "[concat(parameters('FunctionAppName'), '/',parameters('SlotName'),'/web')]",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName'))]",
        "[variables('SiteResourceID')]"
      ],
      "properties": {
        "numberOfWorkers": 1,
        "defaultDocuments": [
          "Default.htm",
          "Default.html",
          "Default.asp",
          "index.htm",
          "index.html",
          "iisstart.htm",
          "default.aspx",
          "index.php"
        ],
        "netFrameworkVersion": "v10.0",
        "phpVersion": "5.6",
        "requestTracingEnabled": false,
        "remoteDebuggingEnabled": false,
        "httpLoggingEnabled": false,
        "logsDirectorySizeLimit": 35,
        "detailedErrorLoggingEnabled": false,
        "publishingUsername": "$[parameters('FunctionAppName')]__[parameters('SlotName')]",
        "azureStorageAccounts": {},
        "scmType": "None",
        "use32BitWorkerProcess": false,
        "webSocketsEnabled": true,
        "alwaysOn": true,
        "managedPipelineMode": "Integrated",
        "virtualApplications": [
          {
            "virtualPath": "/",
            "physicalPath": "site\\wwwroot",
            "preloadEnabled": true
          }
        ],
        "loadBalancing": "LeastRequests",
        "experiments": {
          "rampUpRules": []
        },
        "autoHealEnabled": false,
        "cors": {
          "allowedOrigins": [
            "https://functions.azure.com",
            "https://functions-staging.azure.com",
            "https://functions-next.azure.com"
          ],
          "supportCredentials": false
        },
        "localMySqlEnabled": false,
        "ipSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictionsUseMain": false,
        "http20Enabled": false,
        "minTlsVersion": "1.2",
        "ftpsState": "AllAllowed",
        "PreWarmedInstanceCount": 0
      }
    },
    {
      "type": "Microsoft.Web/sites/slots/hostNameBindings",
      "apiVersion": "2022-03-01",
      "name": "[concat(parameters('FunctionAppName'), '/', parameters('SlotName'),'/', parameters('FunctionAppName'), '-',parameters('SlotName'),'.azurewebsites.net')]",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName'))]",
        "[variables('SiteResourceID')]"
      ],
      "properties": {
        "siteName": "[concat(parameters('FunctionAppName'),'(',parameters('SlotName'),')')]",
        "hostNameType": "Verified"
      }
    },
    {
      "type": "microsoft.insights/components",
      "kind": "web",
      "name": "[parameters('AppInsightsName')]",
      "apiVersion": "2015-05-01",
      "location": "[Variables('ResourceLocation')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "applicationId": "[variables('SiteResourceID')]",
        "Application_Type": "web"
      },
      "dependsOn": [ "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]" ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "name": "[concat(parameters('vaultName'), '/add')]",
      "apiVersion": "2019-09-01",
      "properties": {
        "accessPolicies": [
          {
            "tenantId": "[reference(concat('Microsoft.Web/sites/', parameters('FunctionAppName')), '2018-02-01','Full').identity.tenantId]",
            "objectId": "[reference(concat('Microsoft.Web/sites/', parameters('FunctionAppName')), '2018-02-01','Full').identity.principalId]",
            "permissions": {
              "keys": [ "Get", "List" ],
              "secrets": [ "Get", "List" ],
              "certificates": [ "Get", "List" ],
              "storage": [ "all" ]
            }
          }
        ]
      }
    }

  ]
}
