lass=\"validation-tooltip top\">\n                                <div class=\"row\">\n                                    <div class=\"col-2\">\n                                        <span class=\"iconErr\" data-font-icon=\"?\"></span>\n                                    </div>\n                                    <div class=\"col-10\"> Select Yes or No\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                </span>\n                <div class=\"insurance-consent\">\n                    <input class=\"customRadioBox ng-untouched ng-pristine ng-invalid\" formcontrolname=\"selectTripInsurance\" id=\"protectTrip\" name=\"selectTripInsurance\" type=\"radio\" value=\"Yes\">\n                    <input class=\"customRadioBox ng-untouched ng-pristine ng-invalid\" formcontrolname=\"selectTripInsurance\" id=\"noProtectTrip\" name=\"selectTripInsurance\" type=\"radio\" value=\"No\">\n                </div>\n                <div class=\"allianz-insuranceAvailable\">\n                    <div class=\"col-12 customRadioPnl d-flex justify-content-start\">\n<label class=\"fontBold ng-untouched allianz-yesDefault\" for=\"protectTrip\">\n<span class=\"sr-only\">Trip Protection</span>\nYes, protect my trip to <b>New York</b>.\n</label>\n<label class=\"fontBold ng-untouched allianz-yesSelected\" for=\"protectTrip\">\n<span class=\"sr-only\">Trip Protection</span>\n<span class=\"allianz-vaPurple\"><b>Your trip to New York is protected.</b></span>\n</label>\n</div>\n                    <div class=\"col-12 customRadioPnl with-validation mt-2 allianz-noOptionBox\">\n<label class=\"ng-untouched\" for=\"noProtectTrip\">\nNo, don't add insurance for my £795.52 trip.\n</label>\n</div>\n                </div>\n            </div>\n            <div class=\"arrow-up decline-tooltip\">\n<div class=\"box allianz-declineTooltipBox\">\n<div class=\"row\">\n<div class=\"col-lg-2 col-md-