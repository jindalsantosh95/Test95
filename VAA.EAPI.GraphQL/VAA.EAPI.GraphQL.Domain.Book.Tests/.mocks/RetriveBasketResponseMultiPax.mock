							"compiledMessage": "<div class=\"col-12 pl-0 insuranceSummaryTxt allianz-globalHeader\">\n<img src=\"https://gateway.americas.allianz-assistance.com/images/Allianz_Assistance_Full.png\" alt=\"\" height=\"18\" width=\"153\" />\n<h3><span>Get cover for your trip for £29.67 total</span></h3>\n</div>"
						},
						{
							"messageTag": "BODY",
							"compiledMessage": "<p>\n\t<span><strong>Peace of mind is only a click away</strong></span>\n</p>\n<ul class=\"allianz-noBulletList pl-1\">\n\t<li>\n\t\t<img src=\"https://gateway.americas.allianz-assistance.com/images/virgin_check_icon_purple.png\" alt=\"\" width=\"15\" height=\"12\">\n\t\t<div>Up to £15m medical assistance cover in the event of illness or an accident while away</div>\n\t</li>\n\t<li>\n\t\t<img src=\"https://gateway.americas.allianz-assistance.com/images/virgin_check_icon_purple.png\" alt=\"\" width=\"15\" height=\"12\">\n\t\t<div>\n\t\t\tUp to £5k cancellation cover or if you have to cut your trip short (includes if you or a travel companion is diagnosed with COVID-19)\n\t\t</div>\n\t</li>\n\t<li>\n\t\t<img src=\"https://gateway.americas.allianz-assistance.com/images/virgin_check_icon_purple.png\" alt=\"\" width=\"15\" height=\"12\">\n\t\t<div>Up to £2k in the event of loss, theft or damage to your personal possessions</div>\n\t</li>\n</ul>"
						},
