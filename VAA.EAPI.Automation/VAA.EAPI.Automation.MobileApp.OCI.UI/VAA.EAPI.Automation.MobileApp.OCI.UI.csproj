<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VAA.EAPI.Infrastructure">
      <HintPath>..\Assemblies\VAA.EAPI.Infrastructure.dll</HintPath>
    </Reference>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VAA.EAPI.Automation.Core\VAA.EAPI.Automation.Core.csproj" />
    <ProjectReference Include="..\VAA.EAPI.Automation.MobileApp.UI\VAA.EAPI.Automation.MobileApp.UI.csproj" />
    <ProjectReference Include="..\VAA.EAPI.Automation.OCI\VAA.EAPI.Automation.OCI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.example.json" Link="appsettings.json" CopyToOutputDirectory="Always" />
    <None Include="..\VAA.EAPI.Automation.MobileApp.UI\xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Contracts\oci-automation-contract.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\VAA.EAPI.Automation.OCI\Requests\Body\GraphQL\checkInGraphQLQuery.txt" Link="Requests\Body\GraphQL\CheckInGraphQLQuery.txt" CopyToOutputDirectory="Always" />
    <None Include="..\VAA.EAPI.Automation.OCI\Requests\Body\GraphQL\SavePassportGraphQLQuery.txt" Link="Requests\Body\GraphQL\SavePassportGraphQLQuery.txt" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
