<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<StartupObject>VAA.EAPI.Automation.Utility.PNRCreation.Program</StartupObject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Data.Tables" />
		<PackageReference Include="Microsoft.Azure.Cosmos" />
		<PackageReference Include="Microsoft.Azure.Cosmos.Table" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VAA.EAPI.Automation.NDC\VAA.EAPI.Automation.NDC.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="VAA.EAPI.Infrastructure">
			<HintPath>..\Assemblies\VAA.EAPI.Infrastructure.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<None Update="local.settings.local.json">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="PNRScenarios.csv">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
