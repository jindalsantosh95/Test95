    "Build": "Local-QA-Connectivity",
    "Name": "Mobile app connectivity",
    "DisableAnimations": true,
    "ForceAppLaunch": true,
    "AppiumVersion": "3.3.0",
    "CommandTimeoutSeconds": 240,
