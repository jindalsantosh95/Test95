{
  "RunMode": "Remote",
  "PayPal": {
    "Enabled": false,
    "AllowSandboxPayment": false,
    "CredentialSafeLoggingConfirmed": false
  },
  "FaultInjection": {
    "AllowPostHppTestPayment": false,
    "Enabled": false,
    "IsolatedRoutingConfirmed": false,
    "UseProcessCapture": false,
    "Executable": "",
    "AddonPath": "",
    "CertificateDirectory": ""
  },
  "BackendValidation": {
    "Enabled": false,
    "Environment": "SIT",
    "BaseUrl": "https://testresources.virginatlantic.com",
    "TimeoutSeconds": 30
  },
  "Diagnostics": {
    "ErrorControlScreenshotsOnFailure": false,
    "FullScreenScreenshotOnFailure": false,
