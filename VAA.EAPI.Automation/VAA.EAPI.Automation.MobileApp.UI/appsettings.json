{
  "RunMode": "Remote",
  "BackendValidation": {
    "Enabled": false,
    "Environment": "SIT",
    "BaseUrl": "https://testresources.virginatlantic.com",
    "TimeoutSeconds": 30
  },
  "Diagnostics": {
    "ErrorControlScreenshotsOnFailure": false,
    "FullScreenScreenshotOnFailure": false,
    "IosAppLogsOnFailure": true,
    "IosAppProcessName": "vaa-mobile-ios"
  },
  "IOSLaunch": {
    "BuildProfile": "sit_standard",
    "AutomationFeatureFlags": "850100-search-native-entry,850101-search-native-skip-seat-selection"
  },
  "Loyalty": {
    "Password": ""
  },
  "Core": {
    "KeyVaultUrl": "",
    "KeyVaultTenantId": "",
    "KeyVaultClientId": "",
    "KeyVaultClientSecret": ""
  },
  "SelfHealing": {
    "WarningThreshold": 2
  },
  "BrowserStack": {
    "Profile": "Diagnostic",
    "ServerUrl": "https://hub-cloud.browserstack.com/wd/hub",
    "Platform": "iOS",
    "DeviceName": "iPhone 17",
    "PlatformVersion": "26",
    "DeviceFallbacks": [
      { "DeviceName": "iPhone 15", "PlatformVersion": "26" },
      { "DeviceName": "iPhone 14", "PlatformVersion": "26" }
    ],
    "App": "",
    "Project": "Virgin Atlantic Mobile - Search and Book",
    "Build": "Search-and-Book-iOS",
    "Name": "Search and Book | iOS | Launch smoke",
    "DisableAnimations": true,
    "ForceAppLaunch": true,
    "AppiumVersion": "3.3.0",
    "CommandTimeoutSeconds": 240,
    "IdleTimeoutSeconds": 300,
    "SessionCreationAttempts": 3,
    "SessionCreationRetryDelaySeconds": 5,
    "NetworkLogs": true,
    "CaptureNetworkContent": false
  }
}
