                              &lt;CabinType&gt;&#xd;
                                 &lt;CabinTypeCode&gt;2&lt;/CabinTypeCode&gt;&#xd;
                                 &lt;PrefLevel&gt;&#xd;
                                    &lt;PrefLevelCode&gt;Required&lt;/PrefLevelCode&gt;&#xd;
                                 &lt;/PrefLevel&gt;&#xd;
                              &lt;/CabinType&gt;&#xd;
