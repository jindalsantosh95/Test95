			&lt;OrgID&gt;${AgentID}&lt;/OrgID&gt;&#xd;
		&lt;/ParticipatingOrg&gt;&#xd;
		&lt;/DistributionChainLink&gt;&#xd;
	&lt;/DistributionChain&gt;&#xd;
	&lt;Request&gt;&#xd;
		&lt;CreateOrder xmlns=&quot;http://www.iata.org/IATA/2015/EASD/00/IATA_OffersAndOrdersCommonTypes&quot;&gt;&#xd;
