            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// Collect extracted vars
def offerId = vars.get(&quot;offerId&quot;)
def offerItem1 = vars.get(&quot;offerItem1&quot;)
def seatCol1 = vars.get(&quot;seatCol1&quot;)
def seatRow1 = vars.get(&quot;seatRow1&quot;)
def currency = vars.get(&quot;currency&quot;)
def price1 = vars.get(&quot;price1&quot;)

// Log them
log.info(&quot;🛫 Extracted OfferID: &quot; + offerId)
log.info(&quot;🎫 OfferItem1 ID: &quot; + offerItem1)
log.info(&quot;💺 Seat: Row &quot; + seatRow1 + &quot; | Col &quot; + seatCol1)
log.info(&quot;💷 Price1: &quot; + price1 + &quot; &quot; + currency)

// Optionally validate
def errors = []

if (!offerId) errors &lt;&lt; &quot;Missing offerId&quot;
if (!offerItem1) errors &lt;&lt; &quot;Missing offerItem1&quot;
if (!seatCol1 || !seatRow1) errors &lt;&lt; &quot;Seat column/row not found&quot;
if (!price1 || !currency) errors &lt;&lt; &quot;Missing pricing info&quot;

if (errors) {
    log.error(&quot;❌ Extraction errors:\n - &quot; + errors.join(&quot;\n - &quot;))
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;SeatAvailability data extraction failed: &quot; + errors.join(&quot;; &quot;))
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
