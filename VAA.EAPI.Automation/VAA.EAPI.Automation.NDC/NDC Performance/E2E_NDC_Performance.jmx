                                 &lt;PrefLevel&gt;&#xd;
                                    &lt;PrefLevelCode&gt;Required&lt;/PrefLevelCode&gt;&#xd;
                                 &lt;/PrefLevel&gt;&#xd;
                              &lt;/CabinType&gt;&#xd;
                           &lt;/OriginDestCriteria&gt;&#xd;
                        &lt;/FlightRequestOriginDestinationsCriteria&gt;&#xd;
                     &lt;/FlightRequest&gt;&#xd;
                  &lt;/AddOfferItems&gt;&#xd;
                  &lt;DeleteOrderItem&gt;&#xd;
                     &lt;OrderItemRefID&gt;${OrderID}-1&lt;/OrderItemRefID&gt;&#xd;
                  &lt;/DeleteOrderItem&gt;&#xd;
				  &lt;DeleteOrderItem&gt;&#xd;
                     &lt;OrderItemRefID&gt;${OrderID}-2&lt;/OrderItemRefID&gt;&#xd;
                  &lt;/DeleteOrderItem&gt;&#xd;
               &lt;/ServiceOrder&gt;&#xd;
            &lt;/ReshopOrderChoice&gt;&#xd;
         &lt;/ReshopOrder&gt;&#xd;
      &lt;/UpdateOrder&gt;&#xd;
   &lt;/Request&gt;&#xd;
&lt;/IATA_OrderReshopRQ&gt;</stringProp>
