    &lt;Request&gt;&#xd;
        &lt;FlightRequest xmlns=&quot;http://www.iata.org/IATA/2015/EASD/00/IATA_OffersAndOrdersCommonTypes&quot;&gt;&#xd;
            &lt;FlightRequestOriginDestinationsCriteria&gt;&#xd;
                &lt;OriginDestCriteria&gt;&#xd;
                    &lt;CabinType&gt;&#xd;
                        &lt;CabinTypeCode&gt;${cabinCode}&lt;/CabinTypeCode&gt;&#xd;
