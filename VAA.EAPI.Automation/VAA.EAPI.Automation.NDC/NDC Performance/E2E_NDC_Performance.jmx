            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;&#xd;
&lt;IATA_OrderReshopRQ xmlns=&quot;http://www.iata.org/IATA/2015/00/2021.3/OrderReshopRQ&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot;&gt;&#xd;
   &lt;DistributionChain&gt;&#xd;
      &lt;DistributionChainLink&gt;&#xd;
         &lt;Ordinal&gt;0&lt;/Ordinal&gt;&#xd;
         &lt;OrgRole&gt;Seller&lt;/OrgRole&gt;&#xd;
         &lt;ParticipatingOrg&gt;&#xd;
            &lt;Name&gt;Skyscanner&lt;/Name&gt;&#xd;
            &lt;OrgID&gt;SELLER0001&lt;/OrgID&gt;&#xd;
         &lt;/ParticipatingOrg&gt;&#xd;
      &lt;/DistributionChainLink&gt;&#xd;
   &lt;/DistributionChain&gt;&#xd;
   &lt;Request&gt;&#xd;
      &lt;OrderRefID&gt;${OrderID}&lt;/OrderRefID&gt;&#xd;
      &lt;BookingRef&gt;&#xd;
         &lt;BookingID&gt;${PNR}&lt;/BookingID&gt;&#xd;
      &lt;/BookingRef&gt;&#xd;
      &lt;UpdateOrder&gt;&#xd;
         &lt;ReshopOrder&gt;&#xd;
            &lt;ReshopOrderChoice&gt;&#xd;
               &lt;ServiceOrder&gt;&#xd;
                  &lt;AddOfferItems&gt;&#xd;
                     &lt;FlightRequest&gt;&#xd;
                        &lt;FlightRequestOriginDestinationsCriteria&gt;&#xd;
                           &lt;OriginDestCriteria&gt;&#xd;
                              &lt;OriginDepCriteria&gt;&#xd;
                                 &lt;IATA_LocationCode&gt;${origin}&lt;/IATA_LocationCode&gt;&#xd;
                                 &lt;Date&gt;${changeDeparture_date}&lt;/Date&gt;&#xd;
                              &lt;/OriginDepCriteria&gt;&#xd;
                              &lt;DestArrivalCriteria&gt;&#xd;
                                 &lt;IATA_LocationCode&gt;${destination}&lt;/IATA_LocationCode&gt;&#xd;
                              &lt;/DestArrivalCriteria&gt;&#xd;
                              &lt;CabinType&gt;&#xd;
                                 &lt;CabinTypeCode&gt;2&lt;/CabinTypeCode&gt;&#xd;
                                 &lt;PrefLevel&gt;&#xd;
                                    &lt;PrefLevelCode&gt;Required&lt;/PrefLevelCode&gt;&#xd;
                                 &lt;/PrefLevel&gt;&#xd;
                              &lt;/CabinType&gt;&#xd;
							  &lt;CabinType&gt;&#xd;
                                 &lt;CabinTypeCode&gt;4&lt;/CabinTypeCode&gt;&#xd;
                                 &lt;PrefLevel&gt;&#xd;
                                    &lt;PrefLevelCode&gt;Required&lt;/PrefLevelCode&gt;&#xd;
                                 &lt;/PrefLevel&gt;&#xd;
                              &lt;/CabinType&gt;&#xd;
