          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="false">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">// Get number of matched OfferIDs
int matchCount = vars.get(&quot;offerId_matchNr&quot;) as int

if (matchCount &gt; 0) {
    // Generate random index between 1 and matchCount
    int randomIndex = 1 + new Random().nextInt(matchCount)

    // Retrieve the corresponding OfferID
    String selectedOfferId = vars.get(&quot;offerId_&quot; + randomIndex)

    // Store it into a new JMeter variable
    vars.put(&quot;dynamicOfferId&quot;, selectedOfferId)

    log.info(&quot;Selected random OfferID: &quot; + selectedOfferId)
} else {
    // Fallback in case nothing was found
    vars.put(&quot;dynamicOfferId&quot;, &quot;NOT_FOUND&quot;)
    log.warn(&quot;No OfferID found.&quot;)
}
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="true">
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <boolProp name="resetInterpreter">false</boolProp>
            <stringProp name="script">import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.Calendar;
import java.util.Random;

// Set origin to LHR
String origin = &quot;LHR&quot;;
vars.put(&quot;origin&quot;, origin);

// Setup date format
SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyy-MM-dd&quot;);

// Get current date
Date now = new Date();
Calendar calendar = Calendar.getInstance();
calendar.setTime(now);

// Add 300 days to current date
calendar.add(Calendar.DAY_OF_YEAR, 300);
Date futureDate = calendar.getTime();

// Generate random date between now and futureDate
long startMillis = now.getTime();
long endMillis = futureDate.getTime();
long randomMillis = (long)(startMillis + Math.random() * (endMillis - startMillis));
Date randomDate = new Date(randomMillis);
String randomDateStr = sdf.format(randomDate);
vars.put(&quot;randomDate&quot;, randomDateStr);

// Destination airport codes (excluding LHR)
String[] airports = {&quot;JFK&quot;, &quot;LAX&quot;, &quot;DEL&quot;, &quot;ATL&quot;, &quot;BOM&quot;, &quot;TLV&quot;, &quot;BGI&quot;, &quot;YYZ&quot;, &quot;BOS&quot;, &quot;JNB&quot;};
Random rand = new Random();

// Pick a random destination
String destination = airports[rand.nextInt(airports.length)];
vars.put(&quot;destination&quot;, destination);

// Random cabin code (1=Economy, 2=Premium, 3=Business, 4=First)
String[] cabinCodes = {&quot;2&quot;, &quot;4&quot;, &quot;5&quot;};
String cabinCode = cabinCodes[rand.nextInt(cabinCodes.length)];
vars.put(&quot;cabinCode&quot;, cabinCode);

// === RANDOM OFFERID SELECTION ===
int offerCount = Integer.parseInt(vars.get(&quot;dynamicOfferId_matchNr&quot;));

if (offerCount &gt; 0) {
    java.util.Random rand = new java.util.Random();
    int randomIndex = 1 + rand.nextInt(offerCount); // Index starts at 1
    String selectedOfferId = vars.get(&quot;dynamicOfferId_&quot; + randomIndex);
    vars.put(&quot;dynamicOfferId&quot;, selectedOfferId);
    log.info(&quot;Selected OfferID: &quot; + selectedOfferId);
} else {
    vars.put(&quot;dynamicOfferId&quot;, &quot;NOT_FOUND&quot;);
    log.warn(&quot;No OfferID found.&quot;);
}

// === LOG FOR DEBUGGING ===
log.info(&quot;Origin: &quot; + origin + &quot;, Destination: &quot; + destination + &quot;, Cabin: &quot; + cabinCode + &quot;, Date: &quot; + randomDateStr);</stringProp>
          </BeanShellPreProcessor>
