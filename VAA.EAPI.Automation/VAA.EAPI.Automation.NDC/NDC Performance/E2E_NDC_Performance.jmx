              <stringProp name="XPathExtractor.xpathQuery">//*[local-name()=&apos;OfferItem&apos;]/*[local-name()=&apos;UnitPrice&apos;]/*[local-name()=&apos;TotalAmount&apos;]/text()</stringProp>
