          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="AirshoppingRequest" enabled="true">
            <stringProp name="HTTPSampler.domain">TestResources.virginatlantic.com</stringProp>
            <stringProp name="HTTPSampler.protocol">https</stringProp>
            <stringProp name="HTTPSampler.path">/SalesAndRevenueManagement/OrderShopping/OfferManagement/v2/AirShopping</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.BROWSER_COMPATIBLE_MULTIPART">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">&lt;IATA_AirShoppingRQ xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns=&quot;http://www.iata.org/IATA/2015/EASD/00/IATA_OffersAndOrdersMessage&quot;&gt;&#xd;
    &lt;DistributionChain&gt;&#xd;
        &lt;DistributionChainLink xmlns=&quot;http://www.iata.org/IATA/2015/EASD/00/IATA_OffersAndOrdersCommonTypes&quot;&gt;&#xd;
            &lt;Ordinal&gt;1&lt;/Ordinal&gt;&#xd;
            &lt;OrgRole&gt;Seller&lt;/OrgRole&gt;&#xd;
            &lt;ParticipatingOrg&gt;&#xd;
                &lt;Name&gt;${agencyname}&lt;/Name&gt;&#xd;
                &lt;OrgID&gt;${AgentID}&lt;/OrgID&gt;&#xd;
            &lt;/ParticipatingOrg&gt;&#xd;
        &lt;/DistributionChainLink&gt;&#xd;
    &lt;/DistributionChain&gt;&#xd;
    &lt;Request&gt;&#xd;
        &lt;FlightRequest xmlns=&quot;http://www.iata.org/IATA/2015/EASD/00/IATA_OffersAndOrdersCommonTypes&quot;&gt;&#xd;
            &lt;FlightRequestOriginDestinationsCriteria&gt;&#xd;
                &lt;OriginDestCriteria&gt;&#xd;
                    &lt;CabinType&gt;&#xd;
                        &lt;CabinTypeCode&gt;${cabinCode}&lt;/CabinTypeCode&gt;&#xd;
                        &lt;PrefLevel&gt;&#xd;
                            &lt;PrefLevelCode&gt;Required&lt;/PrefLevelCode&gt;&#xd;
                        &lt;/PrefLevel&gt;&#xd;
                    &lt;/CabinType&gt;&#xd;
					&lt;DestArrivalCriteria&gt;&#xd;
                        &lt;IATA_LocationCode&gt;${destination}&lt;/IATA_LocationCode&gt;&#xd;
                    &lt;/DestArrivalCriteria&gt;&#xd;
					&lt;OriginDepCriteria&gt;&#xd;
					&lt;Date&gt;${randomDate}&lt;/Date&gt; &lt;!-- Updated this line --&gt;&#xd;
                        &lt;IATA_LocationCode&gt;${origin}&lt;/IATA_LocationCode&gt;&#xd;
                    &lt;/OriginDepCriteria&gt;&#xd;
                &lt;/OriginDestCriteria&gt;&#xd;
            &lt;/FlightRequestOriginDestinationsCriteria&gt;&#xd;
        &lt;/FlightRequest&gt;&#xd;
        &lt;PaxList xmlns=&quot;http://www.iata.org/IATA/2015/EASD/00/IATA_OffersAndOrdersCommonTypes&quot;&gt;&#xd;
            &lt;Pax&gt;&#xd;
                &lt;PaxID&gt;ADULT_1&lt;/PaxID&gt;&#xd;
                &lt;PTC&gt;ADT&lt;/PTC&gt;&#xd;
            &lt;/Pax&gt;&#xd;
        &lt;/PaxList&gt;&#xd;
    &lt;/Request&gt;&#xd;
&lt;/IATA_AirShoppingRQ&gt;&#xd;
</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
