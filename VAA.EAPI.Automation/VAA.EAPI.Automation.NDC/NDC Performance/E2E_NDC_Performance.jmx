        <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor" enabled="true">
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <boolProp name="resetInterpreter">false</boolProp>
          <stringProp name="script">import java.io.*;

// Get the extracted BookingID from XPath Extractor
String bookingID = vars.get(&quot;PNR&quot;);

// Get the response code to check if the request was successful
int responseCode = Integer.parseInt(prev.getResponseCode());

// Define file path for CSV output
String filePath = &quot;C:\\Users\\320807\\Downloads\\PerformanceTesting\\PerformanceTesting\\PerformanceTesting\\PNRS\\pnr_list.csv&quot;;

// Ensure the directory exists before writing
File file = new File(filePath);
file.getParentFile().mkdirs(); // Create directories if they don&apos;t exist

// Check if the response code is 200 (success) and BookingID is valid (not null or &quot;NA&quot;)
if (responseCode == 200 &amp;&amp; bookingID != null &amp;&amp; !bookingID.isEmpty() &amp;&amp; !bookingID.equals(&quot;NA&quot;)) {
    try {
        // Read the existing file to check for duplicates
        BufferedReader reader = new BufferedReader(new FileReader(filePath));
        String line;
        boolean isDuplicate = false;

        // Check if the BookingID is already in the file
        while ((line = reader.readLine()) != null) {
            if (line.trim().equals(bookingID)) {
                isDuplicate = true;
                break;
            }
        }
        reader.close();

        // If BookingID is not duplicate, append it to the file
        if (!isDuplicate) {
            // Open the file in append mode
            FileWriter fw = new FileWriter(filePath, true); 
            BufferedWriter bw = new BufferedWriter(fw);
            PrintWriter out = new PrintWriter(bw);

            // Write the BookingID to the CSV file
            out.println(bookingID);
            out.close();

            // Log success message
            log.info(&quot;✅ Success! BookingID saved: &quot; + bookingID);
        } else {
            log.warn(&quot;⚠️ BookingID already exists. Skipping save: &quot; + bookingID);
        }
    } catch (IOException e) {
        log.error(&quot;❌ Error reading/writing to CSV: &quot; + e.getMessage());
    }
} else {
    log.warn(&quot;⚠️ Skipping save: Request failed, BookingID not found, or returned &apos;NA&apos;.&quot;);
}
</stringProp>
        </BeanShellPostProcessor>
