          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="OrderChange" enabled="false">
            <stringProp name="HTTPSampler.domain">TestResources.virginatlantic.com</stringProp>
            <stringProp name="HTTPSampler.protocol">https</stringProp>
            <stringProp name="HTTPSampler.path">SalesAndRevenueManagement/OrderShopping/OrderManagement/v1/OrderChange</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">&lt;IATA_OrderChangeRQ xmlns=&quot;http://www.iata.org/IATA/2015/00/2021.3/OrderChangeRQ&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot;&gt;&#xd;
   &lt;DistributionChain&gt;&#xd;
      &lt;DistributionChainLink&gt;&#xd;
         &lt;Ordinal&gt;1&lt;/Ordinal&gt;&#xd;
         &lt;OrgRole&gt;Seller&lt;/OrgRole&gt;&#xd;
         &lt;ParticipatingOrg&gt;&#xd;
            &lt;Name&gt;Skyscanner&lt;/Name&gt;&#xd;
            &lt;OrgID&gt;12345678&lt;/OrgID&gt;&#xd;
         &lt;/ParticipatingOrg&gt;&#xd;
      &lt;/DistributionChainLink&gt;&#xd;
   &lt;/DistributionChain&gt;&#xd;
   &lt;Request&gt;&#xd;
      &lt;BookingRef&gt;&#xd;
         &lt;BookingID&gt;${PNR}&lt;/BookingID&gt;&#xd;
      &lt;/BookingRef&gt;&#xd;
      &lt;ChangeOrderChoice&gt;&#xd;
         &lt;AcceptSelectedQuotedOfferList&gt;&#xd;
            &lt;SelectedPricedOffer&gt;&#xd;
               &lt;OfferRefID&gt;${OrderQuote_OfferID}&lt;/OfferRefID&gt;&#xd;
               &lt;OwnerCode&gt;VS&lt;/OwnerCode&gt;&#xd;
               &lt;SelectedOfferItem&gt;&#xd;
                  &lt;OfferItemRefID&gt;${OrderQuote_OfferID}-1&lt;/OfferItemRefID&gt;&#xd;
                  &lt;PaxRefID&gt;ADULT_1&lt;/PaxRefID&gt;&#xd;
                  &lt;PaxRefID&gt;ADULT_2&lt;/PaxRefID&gt;&#xd;
               &lt;/SelectedOfferItem&gt;&#xd;
            &lt;/SelectedPricedOffer&gt;&#xd;
         &lt;/AcceptSelectedQuotedOfferList&gt;&#xd;
