						&lt;PaxRefID&gt;ADULT_1&lt;/PaxRefID&gt;					&#xd;
						&#xd;
					&lt;/SelectedOfferItem&gt;&#xd;
									&#xd;
				&lt;/SelectedOffer&gt;&#xd;
			&lt;/SelectedOfferList&gt;&#xd;
		&lt;/PricedOffer&gt;&#xd;
	&lt;/Request&gt;&#xd;
