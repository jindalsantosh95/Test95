          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="OrderCreate" enabled="true">
            <stringProp name="HTTPSampler.domain">TestResources.virginatlantic.com</stringProp>
            <stringProp name="HTTPSampler.protocol">https</stringProp>
            <stringProp name="HTTPSampler.path">/UAT/SalesAndRevenueManagement/OrderShopping/OrderManagement/v2/OrderCreate</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&#xd;
&lt;IATA_OrderCreateRQ xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns=&quot;http://www.iata.org/IATA/2015/EASD/00/IATA_OffersAndOrdersMessage&quot;&gt;&#xd;
	&lt;DistributionChain&gt;&#xd;
		&lt;DistributionChainLink xmlns=&quot;http://www.iata.org/IATA/2015/EASD/00/IATA_OffersAndOrdersCommonTypes&quot;&gt;&#xd;
			&lt;ContactInfo&gt;&#xd;
				&lt;ContactInfoID&gt;AgentContactInfoID&lt;/ContactInfoID&gt;&#xd;
				&lt;EmailAddress&gt;&#xd;
					&lt;EmailAddressText&gt;agentemail@gmail.com&lt;/EmailAddressText&gt;&#xd;
				&lt;/EmailAddress&gt;&#xd;
			&lt;/ContactInfo&gt;&#xd;
			&lt;Ordinal&gt;1&lt;/Ordinal&gt;&#xd;
			&lt;OrgRole&gt;Seller&lt;/OrgRole&gt;&#xd;
			&lt;ParticipatingOrg&gt;&#xd;
			&lt;Name&gt;${agencyname}&lt;/Name&gt;&#xd;
			&lt;OrgID&gt;${AgentID}&lt;/OrgID&gt;&#xd;
		&lt;/ParticipatingOrg&gt;&#xd;
		&lt;/DistributionChainLink&gt;&#xd;
	&lt;/DistributionChain&gt;&#xd;
	&lt;Request&gt;&#xd;
		&lt;CreateOrder xmlns=&quot;http://www.iata.org/IATA/2015/EASD/00/IATA_OffersAndOrdersCommonTypes&quot;&gt;&#xd;
			&lt;AcceptSelectedQuotedOfferList&gt;&#xd;
				&lt;SelectedPricedOffer&gt;&#xd;
               &lt;OfferRefID&gt;${OPOfferID}&lt;/OfferRefID&gt;&#xd;
               &lt;OwnerCode&gt;VS&lt;/OwnerCode&gt;&#xd;
               &lt;SelectedOfferItem&gt;&#xd;
                  &lt;OfferItemRefID&gt;${OPOfferID}-1&lt;/OfferItemRefID&gt;&#xd;
                  &lt;PaxRefID&gt;ADULT_1&lt;/PaxRefID&gt;&#xd;
               &lt;/SelectedOfferItem&gt;&#xd;
               &lt;TotalOfferPriceAmount CurCode=&quot;${Currency}&quot;&gt;${Amount}&lt;/TotalOfferPriceAmount&gt;&#xd;
            &lt;/SelectedPricedOffer&gt;&#xd;
			&lt;/AcceptSelectedQuotedOfferList&gt;&#xd;
		&lt;/CreateOrder&gt;&#xd;
		&lt;DataLists xmlns=&quot;http://www.iata.org/IATA/2015/EASD/00/IATA_OffersAndOrdersCommonTypes&quot;&gt;&#xd;
			&lt;ContactInfoList&gt;&#xd;
				&lt;ContactInfo&gt;&#xd;
					&lt;ContactInfoID&gt;CID_1&lt;/ContactInfoID&gt;&#xd;
					&lt;EmailAddress&gt;&#xd;
						&lt;EmailAddressText&gt;test.skyscanner@fly.virgin.com&lt;/EmailAddressText&gt;&#xd;
					&lt;/EmailAddress&gt;&#xd;
					&lt;Phone&gt;&#xd;
						&lt;ContactTypeText&gt;Home&lt;/ContactTypeText&gt;&#xd;
						&lt;CountryDialingCode&gt;+44&lt;/CountryDialingCode&gt;&#xd;
						&lt;PhoneNumber&gt;123456&lt;/PhoneNumber&gt;&#xd;
					&lt;/Phone&gt;&#xd;
				&lt;/ContactInfo&gt;&#xd;
			&lt;/ContactInfoList&gt;&#xd;
			 &lt;PaxList&gt;&#xd;
            &lt;Pax&gt;&#xd;
               &lt;ContactInfoRefID&gt;CID_1&lt;/ContactInfoRefID&gt;&#xd;
               &lt;Individual&gt;&#xd;
                  &lt;Birthdate&gt;1995-05-18&lt;/Birthdate&gt;&#xd;
                  &lt;GenderCode&gt;M&lt;/GenderCode&gt;&#xd;
                  &lt;GivenName&gt;David&lt;/GivenName&gt;&#xd;
                  &lt;Surname&gt;Smith&lt;/Surname&gt;&#xd;
               &lt;/Individual&gt;&#xd;
               &lt;PaxID&gt;ADULT_1&lt;/PaxID&gt;&#xd;
               &lt;PTC&gt;ADT&lt;/PTC&gt;&#xd;
            &lt;/Pax&gt;&#xd;
         &lt;/PaxList&gt;&#xd;
		&lt;/DataLists&gt;&#xd;
		&lt;PaymentFunctions xmlns=&quot;http://www.iata.org/IATA/2015/EASD/00/IATA_OffersAndOrdersCommonTypes&quot;&gt;&#xd;
			&lt;PaymentMethodCriteria&gt;&#xd;
				&lt;PaymentTypeCode&gt;CC&lt;/PaymentTypeCode&gt;&#xd;
			&lt;/PaymentMethodCriteria&gt;&#xd;
			&lt;PaymentProcessingDetails&gt;&#xd;
				&lt;Amount CurCode=&quot;${Currency}&quot;&gt;${Amount}&lt;/Amount&gt;&#xd;
				&lt;Payer&gt;&#xd;
					&lt;PayerName&gt;&#xd;
						&lt;IndividualName&gt;&#xd;
							&lt;GivenName&gt;David&lt;/GivenName&gt;&#xd;
							&lt;Surname&gt;Smith&lt;/Surname&gt;&#xd;
						&lt;/IndividualName&gt;&#xd;
					&lt;/PayerName&gt;&#xd;
				&lt;/Payer&gt;&#xd;
				&lt;PaymentMethod&gt;&#xd;
					&lt;PaymentCard&gt;&#xd;
						&lt;CardholderAddress&gt;&#xd;
							&lt;CityName&gt;Crawley&lt;/CityName&gt;&#xd;
							&lt;CountryCode&gt;GB&lt;/CountryCode&gt;&#xd;
							&lt;PostalCode&gt;RH108HA&lt;/PostalCode&gt;&#xd;
							&lt;StreetText&gt;8&lt;/StreetText&gt;&#xd;
							&lt;StreetText&gt;Cobbles Crescent&lt;/StreetText&gt;&#xd;
						&lt;/CardholderAddress&gt;&#xd;
						&lt;CardNumber&gt;4444333322221111&lt;/CardNumber&gt;&#xd;
						&lt;CardSecurityCode&gt;123&lt;/CardSecurityCode&gt;&#xd;
						&lt;CardTypeText&gt;VI&lt;/CardTypeText&gt;&#xd;
						&lt;ExpirationDate&gt;1226&lt;/ExpirationDate&gt;&#xd;
						&lt;SecurePaymentVersion2&gt;&#xd;
							&lt;AuthenticationValue&gt;ODQzNjgwNjU0ZjM3N2JmYTg0NTM&lt;/AuthenticationValue&gt;&#xd;
							&lt;DirectoryServerTrxID&gt;c272b04f-6e7b-43a2-bb78-90f4fb94aa25&lt;/DirectoryServerTrxID&gt;&#xd;
							&lt;ElectronicCommerceInd&gt;05&lt;/ElectronicCommerceInd&gt;&#xd;
							&lt;TrxStatusText&gt;Y&lt;/TrxStatusText&gt;&#xd;
						&lt;/SecurePaymentVersion2&gt;&#xd;
						&lt;SecureProgram&gt;&#xd;
							&lt;EnrollmentStatusText&gt;CardEnrolled3DS2.1.0&lt;/EnrollmentStatusText&gt;&#xd;
						&lt;/SecureProgram&gt;&#xd;
					&lt;/PaymentCard&gt;&#xd;
				&lt;/PaymentMethod&gt;&#xd;
			&lt;/PaymentProcessingDetails&gt;&#xd;
		&lt;/PaymentFunctions&gt; &#xd;
	&lt;/Request&gt;&#xd;
&lt;/IATA_OrderCreateRQ&gt;</stringProp>
