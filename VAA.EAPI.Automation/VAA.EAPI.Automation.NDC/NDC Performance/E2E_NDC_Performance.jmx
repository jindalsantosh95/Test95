					&lt;OfferRefID&gt;${ParentOfferItem}&lt;/OfferRefID&gt;&#xd;
					&lt;OwnerCode&gt;VS&lt;/OwnerCode&gt;&#xd;
					&lt;SelectedOfferItem&gt;&#xd;
						&lt;OfferItemRefID&gt;${dynamicOfferItemRefID}&lt;/OfferItemRefID&gt;&#xd;
						&lt;PaxRefID&gt;ADULT_1&lt;/PaxRefID&gt;&#xd;
						&lt;SelectedSeat&gt;&#xd;
							&lt;ColumnID&gt;${selectedSeatCol}&lt;/ColumnID&gt;&#xd;
							&lt;SeatRowNumber&gt;${selectedSeatRow}&lt;/SeatRowNumber&gt;&#xd;
						&lt;/SelectedSeat&gt;&#xd;
					&lt;/SelectedOfferItem&gt;&#xd;
					&lt;TotalOfferPriceAmount CurCode=&quot;${Currency}&quot;&gt;${SelectedSeatPrice}&lt;/TotalOfferPriceAmount&gt;&#xd;
				&lt;/SelectedPricedOffer&gt;&#xd;
