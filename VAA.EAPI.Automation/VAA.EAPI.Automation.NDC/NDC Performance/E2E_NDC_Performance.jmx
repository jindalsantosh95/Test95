        <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor" enabled="true">
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <boolProp name="resetInterpreter">false</boolProp>
          <stringProp name="script">import java.io.*;

// Get the extracted BookingID from XPath Extractor
String bookingID = vars.get(&quot;PNR&quot;);

// Get the response code to check if the request was successful
int responseCode = Integer.parseInt(prev.getResponseCode());

// Define file path for CSV output
String filePath = &quot;C:\\Users\\320807\\Downloads\\PerformanceTesting\\PerformanceTesting\\PerformanceTesting\\PNRS\\pnr_list.csv&quot;;

// Ensure the directory exists before writing
File file = new File(filePath);
file.getParentFile().mkdirs(); // Create directories if they don&apos;t exist

// Check if the response code is 200 (success) and BookingID is valid (not null or &quot;NA&quot;)
if (responseCode == 200 &amp;&amp; bookingID != null &amp;&amp; !bookingID.isEmpty() &amp;&amp; !bookingID.equals(&quot;NA&quot;)) {
    try {
        // Read the existing file to check for duplicates
        BufferedReader reader = new BufferedReader(new FileReader(filePath));
        String line;
        boolean isDuplicate = false;

        // Check if the BookingID is already in the file
        while ((line = reader.readLine()) != null) {
            if (line.trim().equals(bookingID)) {
                isDuplicate = true;
                break;
            }
        }
        reader.close();

        // If BookingID is not duplicate, append it to the file
        if (!isDuplicate) {
            // Open the file in append mode
            FileWriter fw = new FileWriter(filePath, true); 
            BufferedWriter bw = new BufferedWriter(fw);
            PrintWriter out = new PrintWriter(bw);

            // Write the BookingID to the CSV file
            out.println(bookingID);
            out.close();

            // Log success message
            log.info(&quot;✅ Success! BookingID saved: &quot; + bookingID);
        } else {
            log.warn(&quot;⚠️ BookingID already exists. Skipping save: &quot; + bookingID);
        }
    } catch (IOException e) {
        log.error(&quot;❌ Error reading/writing to CSV: &quot; + e.getMessage());
    }
} else {
    log.warn(&quot;⚠️ Skipping save: Request failed, BookingID not found, or returned &apos;NA&apos;.&quot;);
}
</stringProp>
        </BeanShellPostProcessor>
        <hashTree/>
        <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="true">
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <boolProp name="resetInterpreter">false</boolProp>
          <stringProp name="script">import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.Calendar;
import java.util.Random;

// === INIT ===
Random rand = new Random();
SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyy-MM-dd&quot;);

// === CONFIG ===
String origin = &quot;LHR&quot;;
vars.put(&quot;origin&quot;, origin);

// === DESTINATION SELECTION ===
String[] airports = {&quot;JFK&quot;, &quot;DEL&quot;, &quot;ATL&quot;, &quot;BOM&quot;, &quot;TLV&quot;, &quot;BGI&quot;, &quot;JNB&quot;};
String destination = airports[rand.nextInt(airports.length)];
vars.put(&quot;destination&quot;, destination);

// === CABIN CODE SELECTION ===
String[] cabinCodes = {&quot;2&quot;, &quot;4&quot;, &quot;5&quot;};
String cabinCode = cabinCodes[rand.nextInt(cabinCodes.length)];
vars.put(&quot;cabinCode&quot;, cabinCode);

// === TRIP TYPE SELECTION ===
String[] tripTypes = {&quot;OW&quot;, &quot;RT&quot;};
String tripType = tripTypes[rand.nextInt(tripTypes.length)];
vars.put(&quot;tripType&quot;, tripType);

// === OUTBOUND DATE (10–40 days from today) ===
Calendar calOutbound = Calendar.getInstance();
calOutbound.add(Calendar.DAY_OF_YEAR, 10 + rand.nextInt(31));
Date outbound = calOutbound.getTime();
String outboundStr = sdf.format(outbound);
vars.put(&quot;randomDate&quot;, outboundStr);

// === RETURN DATE (only if RT) ===
if (&quot;RT&quot;.equalsIgnoreCase(tripType)) {
    Calendar calReturn = (Calendar) calOutbound.clone();
    calReturn.add(Calendar.DAY_OF_YEAR, 1 + rand.nextInt(260)); // 1–260 days after outbound
    Date returnDate = calReturn.getTime();
    String returnStr = sdf.format(returnDate);
    vars.put(&quot;returnDate&quot;, returnStr);
    vars.put(&quot;hasReturn&quot;, &quot;true&quot;);
    log.info(&quot;RT selected. Return date set: &quot; + returnStr);
} else {
    vars.put(&quot;returnDate&quot;, &quot;&quot;);
    vars.put(&quot;hasReturn&quot;, &quot;false&quot;);
    log.info(&quot;OW selected. No return date set.&quot;);
}

// === OFFER ID SELECTION (Optional) ===
try {
    int offerCount = Integer.parseInt(vars.get(&quot;dynamicOfferId_matchNr&quot;));
    if (offerCount &gt; 0) {
        int randomIndex = 1 + rand.nextInt(offerCount);
        String selectedOfferId = vars.get(&quot;dynamicOfferId_&quot; + randomIndex);
        vars.put(&quot;dynamicOfferId&quot;, selectedOfferId);
        log.info(&quot;Selected OfferID: &quot; + selectedOfferId);
    } else {
        vars.put(&quot;dynamicOfferId&quot;, &quot;NOT_FOUND&quot;);
        log.warn(&quot;No OfferID found.&quot;);
    }
} catch (Exception e) {
    vars.put(&quot;dynamicOfferId&quot;, &quot;NOT_AVAILABLE&quot;);
    log.warn(&quot;Offer selection failed: &quot; + e.getMessage());
}

// === DEBUG LOG ===
log.info(&quot;Trip Type: &quot; + tripType + &quot;, Origin: &quot; + origin + &quot;, Destination: &quot; + destination);
log.info(&quot;Cabin Code: &quot; + cabinCode + &quot;, Outbound: &quot; + outboundStr + &quot;, Return: &quot; + vars.get(&quot;returnDate&quot;));
</stringProp>
        </BeanShellPreProcessor>
        <hashTree/>
