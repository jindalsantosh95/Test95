        <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor" enabled="true">
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <boolProp name="resetInterpreter">false</boolProp>
          <stringProp name="script">import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.Calendar;
import java.util.Random;

// === Generate dynamic test inputs ===
String origin = &quot;LHR&quot;;
vars.put(&quot;origin&quot;, origin);

SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyy-MM-dd&quot;);
Date now = new Date();
Calendar calendar = Calendar.getInstance();
calendar.setTime(now);
calendar.add(Calendar.DAY_OF_YEAR, 300);
Date futureDate = calendar.getTime();

long randomMillis = now.getTime() + (long)(Math.random() * (futureDate.getTime() - now.getTime()));
String randomDateStr = sdf.format(new Date(randomMillis));
vars.put(&quot;randomDate&quot;, randomDateStr);

String[] airports = {&quot;JFK&quot;, &quot;LAX&quot;, &quot;DEL&quot;, &quot;ATL&quot;, &quot;BOM&quot;, &quot;TLV&quot;, &quot;BGI&quot;, &quot;YYZ&quot;, &quot;BOS&quot;, &quot;JNB&quot;};
Random rand = new Random();
String destination = airports[rand.nextInt(airports.length)];
vars.put(&quot;destination&quot;, destination);

String[] cabinCodes = {&quot;2&quot;, &quot;4&quot;, &quot;5&quot;};
String cabinCode = cabinCodes[rand.nextInt(cabinCodes.length)];
vars.put(&quot;cabinCode&quot;, cabinCode);

// === Random OfferID selection ===
int offerCount = Integer.parseInt(vars.get(&quot;dynamicOfferId_matchNr&quot;));
if (offerCount &gt; 0) {
    int randomIndex = 1 + rand.nextInt(offerCount); // match index starts at 1
    String selectedOfferId = vars.get(&quot;dynamicOfferId_&quot; + randomIndex);
    vars.put(&quot;dynamicOfferId&quot;, selectedOfferId);
    log.info(&quot;✅ Selected OfferID: &quot; + selectedOfferId);
} else {
    vars.put(&quot;dynamicOfferId&quot;, &quot;NOT_FOUND&quot;);
    log.warn(&quot;⚠️ No OfferID found (matchNr=0)&quot;);
}

// === Log generated values ===
log.info(&quot;🛫 Origin: &quot; + origin + &quot; | 🛬 Destination: &quot; + destination);
log.info(&quot;📅 Random Travel Date: &quot; + randomDateStr);
log.info(&quot;🛋️ Cabin Code: &quot; + cabinCode);

// === Extracted variable validation ===
String offerId = vars.get(&quot;offerId&quot;);
String offerItem1 = vars.get(&quot;offerItem1&quot;);
String seatCol1 = vars.get(&quot;seatCol1&quot;);
String seatRow1 = vars.get(&quot;seatRow1&quot;);
String currency = vars.get(&quot;currency&quot;);
String price1 = vars.get(&quot;price1&quot;);

log.info(&quot;📦 Extracted OfferID: &quot; + offerId);
log.info(&quot;🎫 OfferItem1 ID: &quot; + offerItem1);
log.info(&quot;💺 Seat: Row &quot; + seatRow1 + &quot; | Col &quot; + seatCol1);
log.info(&quot;💷 Price1: &quot; + price1 + &quot; &quot; + currency);

// === Validation of extracted vars ===
ArrayList errors = new ArrayList();

if (offerId == null || offerId.isEmpty()) errors.add(&quot;Missing offerId&quot;);
if (offerItem1 == null || offerItem1.isEmpty()) errors.add(&quot;Missing offerItem1&quot;);
if (seatCol1 == null || seatCol1.isEmpty() || seatRow1 == null || seatRow1.isEmpty()) errors.add(&quot;Seat column/row not found&quot;);
if (price1 == null || price1.isEmpty() || currency == null || currency.isEmpty()) errors.add(&quot;Missing pricing info&quot;);

if (!errors.isEmpty()) {
    StringBuilder errorMsg = new StringBuilder(&quot;❌ Extraction errors:\n&quot;);
    for (int i = 0; i &lt; errors.size(); i++) {
        errorMsg.append(&quot; - &quot;).append(errors.get(i)).append(&quot;\n&quot;);
    }
    log.error(errorMsg.toString());
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(&quot;SeatAvailability data extraction failed: &quot; + errorMsg.toString().replace(&quot;\n&quot;, &quot;; &quot;));
}
</stringProp>
        </BeanShellPostProcessor>
