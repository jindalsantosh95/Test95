<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Behavior harness (harness engineering, Thread 4).
    Offline unit tests for the pure helpers in VAA.EAPI.Automation.Core - no
    environment, secrets, or network. See ..\docs\HARNESS_ENGINEERING.md.

    Nullable / ImplicitUsings are inherited from ..\Directory.Build.props.
    Package versions are resolved from ..\Directory.Packages.props.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include=".mocks\HttpMockExtensions\delete-order-invalid-regex-rule.mock" />
    <None Include=".mocks\HttpMockExtensions\get-orders-content-header-match.mock" />
    <None Include=".mocks\HttpMockExtensions\get-orders-header-match.mock" />
    <None Include=".mocks\HttpMockExtensions\get-ping.mock" />
    <None Include=".mocks\HttpMockExtensions\patch-order-regex-rules.mock" />
    <None Include=".mocks\HttpMockExtensions\post-orders-json-rules.mock" />
    <None Include=".mocks\HttpMockExtensions\put-order-xml-rules.mock" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VAA.EAPI.Automation.Core\VAA.EAPI.Automation.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update=".mocks\**\*.mock">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
