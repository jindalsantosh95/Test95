      <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="script">import java.text.SimpleDateFormat
import java.util.Calendar
import java.util.Random

// Generate a random date starting from a month from now
Calendar calendar = Calendar.getInstance()
calendar.add(Calendar.MONTH, 1) // Start from a month from now
calendar.add(Calendar.DAY_OF_YEAR, new Random().nextInt(30)) // Add random number of days up to 30 days
String randomDate = new SimpleDateFormat(&quot;yyyy-MM-dd&quot;).format(calendar.getTime())

// Generate a random date 2 weeks later
Calendar calendarPlusTwoWeeks = Calendar.getInstance()
calendarPlusTwoWeeks.setTime(calendar.getTime()) // Set to the same date as randomDate
calendarPlusTwoWeeks.add(Calendar.DAY_OF_YEAR, 14) // Add 14 days (2 weeks)
String randomDatePlusTwoWeeks = new SimpleDateFormat(&quot;yyyy-MM-dd&quot;).format(calendarPlusTwoWeeks.getTime())

// Set the generated random dates as JMeter variables
vars.put(&quot;RandomDate&quot;, randomDate)
vars.put(&quot;RandomDatePlusTwoWeeks&quot;, randomDatePlusTwoWeeks)</stringProp>
        <stringProp name="scriptLanguage">groovy</stringProp>
      </JSR223PreProcessor>
