  "unresolvedAiThreads": [
    {
      "threadId": "PRRT_kwDORKRjBc6cASVw",
      "replyToCommentDatabaseId": 3851309235,
      "path": "VAA.EAPI.Deployments/VAA.EAPI.Microservices.Retail.Holidays.Deployment/Template/azuredeploy.json",
      "line": 353,
      "url": "https://github.com/VAAD1ST/eapi/pull/1742#discussion_r3851309235",
      "author": "copilot-pull-request-reviewer",
      "body": "The service also supports `Holidays:DocumentDownloadMaximumBytes` and `Holidays:DocumentDownloadTimeoutSeconds` (with defaults) but the deployment template only wires `Holidays:DocumentDownloadAllowedHosts`. Without surfacing the other two settings here (and in the template parameters + env parameter files), ops can’t configure them through the standard ARM deployment path.",
      "decision": "valid",
      "resolutionComment": "Valid. The service reads and documents both settings, but the standard deployment path did not expose them. Added DocumentDownloadMaximumBytes (5242880) and DocumentDownloadTimeoutSeconds (30) to every environment's Holidays parameter object and mapped both to string-valued app settings in the main ARM template."
    },
    {
      "threadId": "PRRT_kwDORKRjBc6cASWh",
      "replyToCommentDatabaseId": 3851309315,
      "path": "VAA.EAPI.Deployments/VAA.EAPI.Microservices.Retail.Holidays.Deployment/Template/azuredeploy_slot.json",
      "line": 320,
      "url": "https://github.com/VAAD1ST/eapi/pull/1742#discussion_r3851309315",
      "author": "copilot-pull-request-reviewer",
      "body": "Same as the main template: only `Holidays:DocumentDownloadAllowedHosts` is wired, but `DocumentDownloadMaximumBytes` and `DocumentDownloadTimeoutSeconds` are also supported/documented. Consider wiring them through the slot template (and related parameter files) so slot deployments can configure download policy consistently.",
      "decision": "valid",
      "resolutionComment": "Valid. Slot deployments had the same configuration gap as the main template. Added both download-policy app settings to azuredeploy_slot.json, using the values now supplied by all environment parameter files."
    }
  ],
