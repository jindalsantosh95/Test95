  "unresolvedAiThreads": [
    {
      "threadId": "PRRT_kwDORKRjBc6bo75U",
      "replyToCommentDatabaseId": 3842196280,
      "path": "docs/behavior-harness.md",
      "line": 68,
      "url": "https://github.com/VAAD1ST/eapi/pull/1742#discussion_r3842196280",
      "author": "copilot-pull-request-reviewer",
      "body": "This row is in the planned behavior table but its status is set to `Draft` while the associated sequence diagram in this PR marks the flow as `InProgress`. Aligning these avoids conflicting documentation about the goal’s current stage.",
      "decision": "valid",
      "resolutionComment": "Aligned the planned behavior row with the sequence goal by changing its status from Draft to InProgress."
    },
    {
      "threadId": "PRRT_kwDORKRjBc6bo752",
      "replyToCommentDatabaseId": 3842196328,
      "path": "VAA.EAPI.GraphQL/VAA.EAPI.GraphQL.Domain.Trips/Queries/HolidayQuery.cs",
      "line": 446,
      "url": "https://github.com/VAAD1ST/eapi/pull/1742#discussion_r3842196328",
      "author": "copilot-pull-request-reviewer",
      "body": "Even though document URLs are removed from the GraphQL response (DocumentUrl is nulled here), the exception handler for this resolver logs the raw downstream response body (`msError`). Holidays MS responses can contain DMAZE download URLs (e.g., `downloadLink` fields), so logging the full body can leak the otherwise-hidden document URL into telemetry. Prefer logging only correlation + status code (no response body) for this path.",
      "decision": "valid",
      "resolutionComment": "Removed downstream response-body and exception-message logging from the holiday document resolver. Telemetry now records only correlation context, trip resource ID, and downstream status code; the GraphQL developer detail also omits the exception message."
    },
    {
      "threadId": "PRRT_kwDORKRjBc6bpPIV",
      "replyToCommentDatabaseId": 3842311178,
      "path": "VAA.EAPI.Microservices/VAA.EAPI.Microservices.Retail.Holidays/Application/RetrieveDocumentService.cs",
      "line": 233,
      "url": "https://github.com/VAAD1ST/eapi/pull/1742#discussion_r3842311178",
      "author": "copilot-pull-request-reviewer",
      "body": "The documentId/URL consistency check can be bypassed when the URL’s last segment sanitizes to empty (e.g., URL ends with `/` or contains encoded slashes/control chars). `GetSafeFileName` falls back to `{documentId}.pdf`, which makes the equality check pass even though the URL didn’t actually contain that filename, allowing download of an arbitrary PDF on an allowlisted host.",
      "decision": "valid",
      "resolutionComment": "Changed filename sanitization to fail closed when the URL's final segment sanitizes to empty instead of substituting the requested document ID, and added regression tests for trailing-slash and encoded-slash URLs."
    }
  ],
