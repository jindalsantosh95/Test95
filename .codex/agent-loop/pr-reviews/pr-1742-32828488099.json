  "unresolvedAiThreads": [
    {
      "threadId": "PRRT_kwDORKRjBc6b_qkL",
      "replyToCommentDatabaseId": 3851050085,
      "path": "VAA.EAPI.Microservices/VAA.EAPI.Microservices.Retail.Holidays/Application/RetrieveDocumentService.cs",
      "line": 313,
      "url": "https://github.com/VAAD1ST/eapi/pull/1742#discussion_r3851050085",
      "author": "copilot-pull-request-reviewer",
      "body": "`IsAllowedDocumentHost` treats default-port HTTPS URLs as just `Host`, so an allowlist entry like `example.com:443` will never match even though the host/port is effectively the same. This makes the new `Holidays:DocumentDownloadAllowedHosts` setting easy to misconfigure and causes valid downloads to be rejected.",
      "decision": "valid",
      "resolutionComment": "Updated host validation to compare the effective URI host and port even when HTTPS uses its default port, while retaining host-only matching only for default-port URLs. Added regression coverage using an allowlist entry ending in :443."
    },
    {
      "threadId": "PRRT_kwDORKRjBc6b_qk1",
      "replyToCommentDatabaseId": 3851050154,
      "path": "VAA.EAPI.Microservices/VAA.EAPI.Microservices.Retail.Holidays/README.md",
      "line": 52,
      "url": "https://github.com/VAAD1ST/eapi/pull/1742#discussion_r3851050154",
      "author": "copilot-pull-request-reviewer",
      "body": "The implementation supports additional configuration keys (`Holidays:DocumentDownloadMaximumBytes` and `Holidays:DocumentDownloadTimeoutSeconds`) but they are not listed in the configuration table. Adding them here makes the operational contract discoverable and aligns with the new capability’s configurability.",
      "decision": "valid",
      "resolutionComment": "Added Holidays:DocumentDownloadMaximumBytes and Holidays:DocumentDownloadTimeoutSeconds to the service README configuration table, including their defaults."
    }
  ],
