  "unresolvedAiThreads": [
    {
      "threadId": "PRRT_kwDORKRjBc6cBesc",
      "replyToCommentDatabaseId": 3851786834,
      "path": "VAA.EAPI.GraphQL/VAA.EAPI.GraphQL.Domain.Trips/Queries/HolidayQuery.cs",
      "line": 524,
      "url": "https://github.com/VAAD1ST/eapi/pull/1742#discussion_r3851786834",
      "author": "copilot-pull-request-reviewer",
      "body": "When Retail Holidays returns 404, HolidayProvider returns null. This currently becomes a GraphQLException without a code, which makes the NotFound case hard for clients to distinguish from other failures. Map this to a controlled 404-style error code/message (consistent with the downstream contract) instead of an unclassified GraphQL error.",
      "decision": "valid",
      "resolutionComment": "HolidayProvider deliberately maps a downstream 404 response to null, while RetrieveHolidayBookingDocument previously converted that null into an uncoded GraphQLException. Updated the resolver to return a controlled GraphQL error with code 404 and a not-found message, and added an HTTP-mock-backed regression test covering the downstream 404 path."
    }
  ],
