  "unresolvedAiThreads": [
    {
      "threadId": "PRRT_kwDORKRjBc6bpecA",
      "replyToCommentDatabaseId": 3842401841,
      "path": "VAA.EAPI.GraphQL/VAA.EAPI.GraphQL.Domain.Trips/Queries/HolidayQuery.cs",
      "line": 486,
      "url": "https://github.com/VAAD1ST/eapi/pull/1742#discussion_r3842401841",
      "author": "copilot-pull-request-reviewer",
      "body": "`retrieveHolidayBookingDocument` is described (and diagrammed) as an authorized exchange, but the resolver itself does not enforce authentication/authorization. In this codebase, `AuthenticationMiddleware` explicitly allows requests to proceed unauthenticated when no Authorization header is present, so (as implemented) anyone holding a valid short-lived document token could call this query anonymously.\n\nConsider requiring an authenticated principal for this operation (independent of the metadata-only booking-id claim), e.g. by adding HotChocolate `[Authorize]` to the resolver.",
      "decision": "valid",
      "resolutionComment": "Added Hot Chocolate's resolver-level [Authorize] guard so retrieveHolidayBookingDocument requires an authenticated principal in addition to a valid short-lived document token. Added a regression test that verifies the authorization attribute remains on the resolver."
    }
  ],
