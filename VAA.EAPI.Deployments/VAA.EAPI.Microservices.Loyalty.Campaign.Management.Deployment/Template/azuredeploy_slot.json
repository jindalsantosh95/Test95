  "variables": {
    "ResourceLocation": "[resourceGroup().location]",
    "SiteResourceID": "[resourceId('Microsoft.Web/Sites', parameters('FunctionAppName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2018-11-01",
      "name": "[parameters('FunctionAppName')]",
      "location": "[variables('ResourceLocation')]",
      "kind": "functionapp",
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },

      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]"
      },
      "tags": "[parameters('Tags')]"
    },
    {
      "type": "Microsoft.Web/sites/slots",
      "kind": "functionapp",
      "name": "[concat(parameters('FunctionAppName'), '/',parameters('SlotName'))]",
      "apiVersion": "2021-03-01",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [ "[variables('SiteResourceID')]" ],
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },
      "properties": {
        "enabled": true,
        "hostNameSslStates": [
          {
            "name": "[concat(parameters('FunctionAppName'),'-',parameters('SlotName'), '.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Standard"
          },
          {
            "name": "[concat(parameters('FunctionAppName'),'-',parameters('SlotName'),  '.scm.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Repository"
          }
        ],
        "serverFarmId": "[resourceId(parameters('ServerFarmIdRg'), 'Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "appSettings": [
            {
              "name": "LoggingProvider",
              "value": "[parameters('DataDog').LoggingProvider]"
            },
            {
              "name": "DatadogLogsEndpoint",
              "value": "[parameters('DataDog').LogsEndpoint]"
            },
            {
              "name": "DatadogApiKey",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_API_KEY",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_SITE",
              "value": "[parameters('DataDog').Site]"
            },
            {
              "name": "DD_SERVICE",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "DD_ENV",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DD_VERSION",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DD_TRACE_ENABLED",
              "value": "[string(parameters('DataDog').TraceEnabled)]"
            },
            {
              "name": "DD_RUNTIME_METRICS_ENABLED",
              "value": "[string(parameters('DataDog').RuntimeMetricsEnabled)]"
            },
            {
              "name": "DatadogService",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "environment",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DatadogSource",
              "value": "[parameters('DataDog').Source]"
            },
            {
              "name": "DatadogVersion",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DatadogTags",
              "value": "[concat(parameters('DataDog').Tags, if(empty(parameters('DataDog').Tags), '', ','), 'cloud_provider:azure,subscription_id:', subscription().subscriptionId, ',resource_group:', resourceGroup().name, ',name:', parameters('FunctionAppName'), '/', parameters('SlotName'), ',type:microsoft.web/sites/slots,resource_id:', resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName')))]"
            },
            {
              "name": "DatadogBaggageAllowList",
              "value": "[parameters('DataDog').BaggageAllowList]"
            },
            {
              "name": "DatadogMinimumLogLevel",
              "value": "[parameters('DataDog').MinimumLogLevel]"
            },
            {
              "name": "DatadogQueueCapacity",
              "value": "[string(parameters('DataDog').QueueCapacity)]"
            },
            {
              "name": "DatadogBatchSize",
              "value": "[string(parameters('DataDog').BatchSize)]"
            },
            {
              "name": "DatadogFlushIntervalMilliseconds",
              "value": "[string(parameters('DataDog').FlushIntervalMilliseconds)]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "[parameters('Appsetting:FUNCTIONS_EXTENSION_VERSION')]"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "dotnet-isolated"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[parameters('Appsettings:AppInsightsKey')]"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageAccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]"
            },
            {
              "name": "AzureWebJobsSecretStorageType",
              "value": "[parameters('Appsetting:AzureWebJobsSecretStorageType')]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[parameters('Appsetting:APPLICATIONINSIGHTS_CONNECTION_STRING')]"
            },
            {
              "name": "WEBSITE_CONTENTSHARE",
              "value": "[parameters('Appsettings:WEBSITE_CONTENTSHARE')]",
              "slotSetting": false
            },
            {
              "name": "ServiceBusConnectionString",
              "value": "[parameters('Appsetting:ServiceBusConnectionString')]"
            },
            {
              "name": "ServiceBusTopicName",
              "value": "[parameters('Appsetting:ServiceBusTopicName')]"
            },
            {
              "name": "CustomerServiceBusTopicName",
              "value": "[parameters('Appsetting:CustomerServiceBusTopicName')]"
            },
            {
              "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageAccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]"
            },
            {
              "name": "OpenApi__DocTitle",
              "value": "[parameters('Appsettings:OpenApi__DocTitle')]"
            },
            {
              "name": "OpenApi__Description",
              "value": "[parameters('Appsettings:OpenApi__Description')]"
            },
            {
              "name": "MicroServiceDBKey",
              "value": "[parameters('Appsettings:MicroServiceDBKey')]"
            },
            {
              "name": "MicroServiceEventStoreTableName",
              "value": "[parameters('Appsettings:MicroServiceEventStoreTableName')]"
            },
            {
              "name": "SCV:CommonRefDBConnString",
              "value": "[parameters('AppsettingsSCV:CommonRefDBConnString')]"
            },
            {
              "name": "SCV:ReportingDBConnString",
              "value": "[parameters('Appsettings:SCV:ReportingDBConnString')]"
            },
            {
              "name": "DatabaseID",
              "value": "[parameters('Appsettings:DatabaseID')]"
            },
            {
              "name": "AzureADEndpoint",
              "value": "[parameters('Appsettings:AzureADEndpoint')]"
            },
            {
              "name": "AzureAd:Instance",
              "value": "[parameters('AppsettingsAzureAd:Instance')]"
            },
            {
              "name": "CampaignUpdateResponseUrl",
              "value": "[parameters('Appsettings:CampaignUpdateResponseUrl')]"
            },
            {
              "name": "ResponsePollingCount",
              "value": "[parameters('Appsettings:ResponsePollingCount')]"
            },
            {
              "name": "ResponseDelayTimeInMS",
              "value": "[parameters('Appsettings:ResponseDelayTimeInMS')]"
            },
            {
              "name": "OpenApi__HostNames",
              "value": "[parameters('Appsettings:OpenApi__HostNames')]"
            },
            {
              "name": "OpenApi__DocVersion",
              "value": "[parameters('Appsettings:OpenApi__DocVersion')]"
            },
            {
              "name": "OpenApi__Version",
              "value": "[parameters('Appsettings:OpenApi__Version')]"
            },
            {
              "name": "OpenApi__TokenUrl",
              "value": "[parameters('Appsettings:OpenApi__TokenUrl')]"
            },
            {
              "name": "OpenApi__Scope",
              "value": "[parameters('Appsettings:OpenApi__Scope')]"
            },
            {
              "name": "OpenApi__ForceHttps",
              "value": "[parameters('Appsettings:OpenApi__ForceHttps')]"
            },
            {
              "name": "OpenApi__ForceHttp",
              "value": "[parameters('Appsettings:OpenApi__ForceHttp')]"
            },
            {
              "name": "MicroServiceResponseTableName",
              "value": "[parameters('Appsettings:MicroServiceResponseTableName')]"
            },
            {
              "name": "AzureAd:ClientId",
              "value": "[parameters('AppsettingsAzureAd:ClientId')]"
            },
            {
              "name": "AzureAd:TenantId",
              "value": "[parameters('AppsettingsAzureAd:TenantId')]"
            },
            {
              "name": "EmailTriggerTopicName",
              "value": "[parameters('Appsettings:EmailTriggerTopicName')]"
            },
            {
              "name": "CustomerTranscationTopicName",
              "value": "[parameters('Appsettings:CustomerTranscationTopicName')]"
            },
            {
              "name": "CampaignManagement:AppId",
              "value": "[parameters('Appsettings:CampaignManagement:AppId')]"
            },
            {
              "name": "CampaignManagement:ClientSecret",
              "value": "[parameters('Appsettings:CampaignManagement:ClientSecret')]"
            },
            {
              "name": "CustomerTxnMS:ResourceId",
              "value": "[parameters('Appsettings:CustomerTxnMS:ResourceId')]"
            },
            {
              "name": "CampaignManagement:OcpSubID",
              "value": "[parameters('Appsettings:CampaignManagement:OcpSubID')]"
            },
            {
              "name": "CustomerTxnMSDetailsEndpoint",
              "value": "[parameters('Appsettings:CustomerTxnMSDetailsEndpoint')]"
            },
            //Create Campaign
            {
              "name": "CampaignCreateResponseUrl",
              "value": "[parameters('Appsettings:CampaignCreateResponseUrl')]"
            },
            {
              "name": "AzureAd:TokenV1Issuer",
              "value": "[parameters('AppsettingsAzureAd:TokenV1Issuer')]"
            },
            //Campaign Unassign
            {
              "name": "CustomerTransactionMicroServiceDBKey",
              "value": "[parameters('Appsettings:CustomerTransactionMicroServiceDBKey')]"
            },
            {
              "name": "CustomerTransactionMicroServiceEventStoreTableName",
              "value": "[parameters('Appsettings:CustomerTransactionMicroServiceEventStoreTableName')]"
            },
            {
              "name": "CustomerTransactionMicroServiceResponseTableName",
              "value": "[parameters('Appsettings:CustomerTransactionMicroServiceResponseTableName')]"
            },
            {
              "name": "CampaignUnassignResponseUrl",
              "value": "[parameters('Appsettings:CampaignUnassignResponseUrl')]"
            },
            {
              "name": "CampaignManagement:CampaignsListRetrievalUrl",
              "value": "[parameters('Appsettings:CampaignManagement:CampaignsListRetrievalUrl')]"
            },

            // Campaign Linking
            {
              "name": "CampaignPromotionLinkResponseUrl",
              "value": "[parameters('Appsettings:CampaignPromotionLinkResponseUrl')]"
            },
            {
              "name": "ContainerNameForCampaigns",
              "value": "[parameters('Appsettings:ContainerNameForCampaigns')]"
            },

            //Blob Connection

            {
              "name": "BlobConnStringForDownloads",
              "value": "[parameters('Appsettings:BlobConnStringForDownloads')]"
            },
            {
              "name": "ContainerNameForPromotions",
              "value": "[parameters('Appsettings:ContainerNameForPromotions')]"
            },

            //Loyalty Service Bus Topic Name
            {
              "name": "LoyaltyMemberServiceBusTopicName",
              "value": "[parameters('Appsettings:LoyaltyMemberServiceBusTopicName')]"
            },

            //Promotion Update
            {
              "name": "PromotionUpdateResponseUrl",
              "value": "[parameters('Appsettings:PromotionUpdateResponseUrl')]"
            },

            //Promotion Create Response Url

            {
              "name": "PromotionCreateResponseUrl",
              "value": "[parameters('Appsettings:PromotionCreateResponseUrl')]"
            },

            //Promotion Delink
            {
              "name": "CampaignPromotionDelinkResponseUrl",
              "value": "[parameters('Appsettings:CampaignPromotionDelinkResponseUrl')]"
            },
            //Customer settings
            {
              "name": "MaxConcurrentCalls",
              "value": "[parameters('MaxConcurrentCalls')]"
            },
            {
              "name": "Customer:ResourceId",
              "value": "[parameters('Customer:ResourceId')]"
            },
            {
              "name": "Customer:UrlGetbyCustID",
              "value": "[parameters('Customer:UrlGetbyCustID')]"
            },
            {
              "name": "Customer:UrlGetByMemNum",
              "value": "[parameters('Customer:UrlGetByMemNum')]"
            },
            {
              "name": "CommonCachingSlidingExpiration",
