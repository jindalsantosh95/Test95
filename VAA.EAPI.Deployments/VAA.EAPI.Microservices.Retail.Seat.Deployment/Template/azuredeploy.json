{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "DataDog": {
      "type": "secureObject",
      "defaultValue": {
        "LoggingProvider": "AppInsights",
        "LogsEndpoint": "https://http-intake.logs.datadoghq.com/api/v2/logs",
        "ApiKey": "",
        "Site": "datadoghq.com",
        "Environment": "",
        "Source": "csharp",
        "Version": "",
        "TraceEnabled": true,
        "RuntimeMetricsEnabled": true,
        "Tags": "",
        "BaggageAllowList": "",
        "MinimumLogLevel": "Information",
        "QueueCapacity": 5000,
        "BatchSize": 100,
        "FlushIntervalMilliseconds": 2000
      }
    },
    //enrvironmentsettings
    "EnvironmentName": {
      "type": "string"
    },
    "FunctionAppName": {
      "type": "string"
    },
    "ServerFarmIdRg": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "AppInsightsName": {
      "type": "string"
    },
    "storageAccountName": {
      "type": "string"
    },
    "OfferExpiryLimitInMinutes": {
      "type": "string"
    },
    "TestLab": {
      "type": "string"
    },
    "DebugOptions": {
      "type": "string"
    },
    "DeltaCertificateName": {
      "type": "string"
    },
    "vaultName": {
      "type": "string"
    },
    "APPINSIGHTS_INSTRUMENTATIONKEY": {
      "type": "string"
    },
    "ResourceGroupSubscriptionId": {
      "type": "string"
    },
    "AlwaysOn": {
      "type": "bool"
    },
    "AzureWebJobsSecretStorageType": {
      "type": "string"
    },
    /*"AzureWebJobsStorage": {
      "type": "string"
    },*/
    "FUNCTIONS_EXTENSION_VERSION": {
      "type": "string"
    },
    "FUNCTIONS_WORKER_RUNTIME": {
      "type": "string"
    },
    "AppSetting:RedisCacheConnectionString": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_ALT_SERVER": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_SERVER": {
      "type": "string"
    },
    "IPRestriction": {
      "type": "string"
    },
    "WEBSITE_CONTENTSHARE": {
      "type": "string"
    },
    "WEBSITE_RUN_FROM_PACKAGE": {
      "type": "string"
    },
    "WEBSITE_LOAD_USER_PROFILE": {
      "type": "string"
    },
    "ReferenceDataMicroServiceDBKey": {
      "type": "string"
    },
    "CommonCachingSlidingExpirationInDay": {
      "type": "string"
    },
    "CommonCachingAbsoluteExpirationInDay": {
      "type": "string"
    },
    "Air4SeatV8EndPoint": {
      "type": "string"
    },
    "KeyVaultUri": {
      "type": "string"
    },
    //SeatMSSettings
    "Appsetting:KeyVaultClientID": {
      "type": "string"
    },
    "Appsetting:KeyvaultClientSecret": {
      "type": "string"
    },
    "Appsetting:AzureAd:ClientId": {
      "type": "string"
    },
    "Appsetting:AzureAd:Instance": {
      "type": "string"
    },
    "Appsetting:AzureAd:TenantId": {
      "type": "string"
    },
    "Appsetting:AzureAd:TokenV1Issuer": {
      "type": "string"
    },
    "CosmosSqlDBConnectionMode": {
      "type": "string"
    },
    "OfferExpiryTimeLimit": {
      "type": "string"
    },

    // swaggersettings
    "Appsetting:OpenApi__Scope": {
      "type": "string"
    },
    "Appsetting:OpenApi__TokenUrl": {
      "type": "string"
    },
    "Appsetting:OpenApi__DocTitle": {
      "type": "string"
    },
    "Appsetting:OpenApi__Description": {
      "type": "string"
    },
    "Appsetting:OpenApi__HostNames": {
      "type": "string"
    },
    "Appsetting:OpenApi__DocVersion": {
      "type": "string"
    },
    "Appsetting:OpenApi__Version": {
      "type": "string"
    },
    "Appsetting:OpenApi__ForceHttps": {
      "type": "bool"
    },
    "Appsetting:OpenApi__ForceHttp": {
      "type": "bool"
    },
    //vnetsettings
    "Appsetting:WEBSITE_VNET_ROUTE_ALL": {
      "type": "string"
    },
    //slotsettings
    "SlotName": {
      "type": "string"
    },
    "actionGroupsServiceNow": {
      "type": "string"
    },
    "actionGroupsEAPISupport": {
      "type": "string"
    },
    "emailAddressServiceNow": {
      "type": "string"
    },
    "emailAddressEAPISupport": {
      "type": "string"
    },

    //Azure B2C settings
    "AzureAdB2C:ClientId": {
      "type": "string"
    },
    "AzureAdB2C:Instance": {
      "type": "string"
    },
    "AzureAdB2C:SignUpSignInPolicyId": {
      "type": "string"
    },
    "AzureAdB2C:TenantId": {
      "type": "string"
    },
    "AzureAdB2C:TokenV1Issuer": {
      "type": "string"
    },

    "MicroServiceDBKey": {
      "type": "string"
    },
    "MicroServiceEventStoreTableName": {
      "type": "string"
    },
    "MicroServiceResponseTableName": {
      "type": "string"
    },
    "ServiceBusConnectionString": {
      "type": "string"
    },
    "ServiceBusTopicName": {
      "type": "string"
    },
    "SeatFulfilmentResponseUrl": {
      "type": "string"
    },
    "ResponseDelayTimeInMS": {
      "type": "string"
    },
    "ResponsePollingCount": {
      "type": "string"
    },
    "OrderChangeServiceBusConnectionString": {
      "type": "string"
    },
    "OrderSeatServiceBusTopicName": {
      "type": "string"
    },
    "PNRCommonV6EndPoint": {
      "type": "string"
    },
    "ApplicationId": {
      "type": "string"
    },
    "PoolType": {
      "type": "string"
    },
    "AgentCityCode": {
      "type": "string"
    },
    "SecurityId": {
      "type": "string"
    },
    "RoleIndicator": {
      "type": "string"
    },
    "OrderSeatDeleteServiceBusTopicName": {
      "type": "string"
    },
    "Tags": {
      "type": "Object"
    },
    "SeatDeletionServiceBusTopicName": {
      "type": "string"
    },
    "SeatDeletionResponseUrl": {
      "type": "string"
    },
    "EmailServiceBusConnectionString": {
      "type": "string"
    },
    "EmailMSServiceBusTopicName": {
      "type": "string"
    }
  },
  "variables": {
    "ResourceLocation": "[resourceGroup().location]",
    "SiteResourceID": "[resourceId('Microsoft.Web/Sites', parameters('FunctionAppName'))]",
    "ActiveStatus": "[if(equals(parameters('EnvironmentName'),'PROD'),'PROD','NONPROD')]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2021-09-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[variables('ResourceLocation')]",
      "tags": "[parameters('Tags')]",
      "sku": {
        "name": "Standard_RAGRS",
        "tier": "Standard"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "kind": "functionapp",
      "name": "[parameters('FunctionAppName')]",
      "apiVersion": "2021-03-01",
      "location": "[variables('ResourceLocation')]",
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },
      "properties": {
        "enabled": true,
        "hostNameSslStates": [
          {
            "name": "[concat(parameters('FunctionAppName'), '.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Standard"
          },
          {
            "name": "[concat(parameters('FunctionAppName'), '.scm.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Repository"
          }
        ],
        "serverFarmId": "[resourceId('Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "alwaysOn": true,
          "appSettings": [
            {
              "name": "LoggingProvider",
              "value": "[parameters('DataDog').LoggingProvider]"
            },
            {
              "name": "DatadogLogsEndpoint",
              "value": "[parameters('DataDog').LogsEndpoint]"
            },
            {
              "name": "DatadogApiKey",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_API_KEY",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_SITE",
              "value": "[parameters('DataDog').Site]"
            },
            {
              "name": "DD_SERVICE",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "DD_ENV",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DD_VERSION",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DD_TRACE_ENABLED",
              "value": "[string(parameters('DataDog').TraceEnabled)]"
            },
            {
              "name": "DD_RUNTIME_METRICS_ENABLED",
              "value": "[string(parameters('DataDog').RuntimeMetricsEnabled)]"
            },
            {
              "name": "DatadogService",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "environment",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DatadogSource",
              "value": "[parameters('DataDog').Source]"
            },
            {
              "name": "DatadogVersion",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DatadogTags",
              "value": "[concat(parameters('DataDog').Tags, if(empty(parameters('DataDog').Tags), '', ','), 'cloud_provider:azure,subscription_id:', subscription().subscriptionId, ',resource_group:', resourceGroup().name, ',name:', parameters('FunctionAppName'), ',type:microsoft.web/sites,resource_id:', resourceId('Microsoft.Web/sites', parameters('FunctionAppName')))]"
            },
            {
              "name": "DatadogBaggageAllowList",
              "value": "[parameters('DataDog').BaggageAllowList]"
            },
            {
              "name": "DatadogMinimumLogLevel",
              "value": "[parameters('DataDog').MinimumLogLevel]"
            },
            {
              "name": "DatadogQueueCapacity",
              "value": "[string(parameters('DataDog').QueueCapacity)]"
            },
            {
              "name": "DatadogBatchSize",
              "value": "[string(parameters('DataDog').BatchSize)]"
            },
            {
              "name": "DatadogFlushIntervalMilliseconds",
              "value": "[string(parameters('DataDog').FlushIntervalMilliseconds)]"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[parameters('APPINSIGHTS_INSTRUMENTATIONKEY')]"
            },
            {
              "name": "AzureWebJobsSecretStorageType",
              "value": "[parameters('AzureWebJobsSecretStorageType')]"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageAccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "[parameters('FUNCTIONS_EXTENSION_VERSION')]"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "[parameters('FUNCTIONS_WORKER_RUNTIME')]"
            },
            {
              "name": "KeyVaultUri",
              "value": "[parameters('KeyVaultUri')]"
            },
            {
              "name": "RedisConnectionString",
              "value": "[parameters('AppSetting:RedisCacheConnectionString')]"
            },
            {
              "name": "KeyVaultClientID",
              "value": "[parameters('Appsetting:KeyVaultClientID')]"
            },
            {
              "name": "KeyvaultClientSecret",
              "value": "[parameters('Appsetting:KeyVaultClientSecret')]"
            },
            {
              "name": "AzureAd:ClientId",
              "value": "[parameters('Appsetting:AzureAd:ClientId')]"
            },
            {
              "name": "AzureAd:Instance",
              "value": "[parameters('Appsetting:AzureAd:Instance')]"
            },
            {
              "name": "AzureAd:TenantId",
              "value": "[parameters('Appsetting:AzureAd:TenantId')]"
            },
            {
              "name": "AzureAd:TokenV1Issuer",
              "value": "[parameters('Appsetting:AzureAd:TokenV1Issuer')]"
            },
            {
              "name": "OpenApi__Scope",
              "value": "[parameters('Appsetting:OpenApi__Scope')]"
            },
            {
              "name": "OpenApi__TokenUrl",
              "value": "[parameters('Appsetting:OpenApi__TokenUrl')]"
            },
            {
              "name": "OpenApi__DocTitle",
              "value": "[parameters('Appsetting:OpenApi__DocTitle')]"
            },
            {
              "name": "OpenApi__Description",
              "value": "[parameters('Appsetting:OpenApi__Description')]"
            },
            {
              "name": "OpenApi__HostNames",
              "value": "[parameters('Appsetting:OpenApi__HostNames')]"
            },
            {
              "name": "OpenApi__DocVersion",
              "value": "[parameters('Appsetting:OpenApi__DocVersion')]"
            },
            {
              "name": "OpenApi__Version",
              "value": "[parameters('Appsetting:OpenApi__Version')]"
            },
            {
              "name": "OpenApi__ForceHttps",
              "value": "[parameters('Appsetting:OpenApi__ForceHttps')]"
            },
            {
              "name": "OpenApi__ForceHttp",
              "value": "[parameters('Appsetting:OpenApi__ForceHttp')]"
            },
            {
              "name": "OfferExpiryLimitInMinutes",
              "value": "[parameters('OfferExpiryLimitInMinutes')]"
            },
            {
              "name": "WEBSITE_VNET_ROUTE_ALL",
              "value": "[parameters('Appsetting:WEBSITE_VNET_ROUTE_ALL')]"
            },

            {
              "name": "WEBSITE_DNS_ALT_SERVER",
              "value": "[parameters('Appsetting:WEBSITE_DNS_ALT_SERVER')]"
            },
            {
              "name": "WEBSITE_DNS_SERVER",
              "value": "[parameters('Appsetting:WEBSITE_DNS_SERVER')]"
            },
            {
              "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageAccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]"
            },
            {
              "name": "WEBSITE_CONTENTSHARE",
              "value": "[parameters('WEBSITE_CONTENTSHARE')]"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "[parameters('WEBSITE_RUN_FROM_PACKAGE')]"
            },
            {
              "name": "WEBSITE_LOAD_USER_PROFILE",
              "value": "[parameters('WEBSITE_LOAD_USER_PROFILE')]"
            },
            {
              "name": "DeltaCertificateName",
              "value": "[parameters('DeltaCertificateName')]"
            },
            {
              "name": "DebugOptions",
              "value": "[parameters('DebugOptions')]"
            },
            {
              "name": "CommonCachingSlidingExpirationInDay",
              "value": "[parameters('CommonCachingSlidingExpirationInDay')]"
            },
            {
              "name": "CommonCachingAbsoluteExpirationInDay",
              "value": "[parameters('CommonCachingAbsoluteExpirationInDay')]"
            },
            {
              "name": "CosmosSqlDBConnectionMode",
              "value": "[parameters('CosmosSqlDBConnectionMode')]"
            },
            {
              "name": "Air4SeatV8EndPoint",
              "value": "[parameters('Air4SeatV8EndPoint')]"
            },
            {
              "name": "ReferenceDataMicroServiceDBKey",
              "value": "[parameters('ReferenceDataMicroServiceDBKey')]"
            },
            {
              "name": "TestLab",
              "value": "[parameters('TestLab')]"
            },
            //Azure B2C Settings
            {
              "name": "AzureAdB2C:ClientId",
              "value": "[parameters('AzureAdB2C:ClientId')]"
            },
            {
              "name": "AzureAdB2C:Instance",
              "value": "[parameters('AzureAdB2C:Instance')]"
            },
            {
              "name": "AzureAdB2C:SignUpSignInPolicyId",
              "value": "[parameters('AzureAdB2C:SignUpSignInPolicyId')]"
            },
            {
              "name": "AzureAdB2C:TenantId",
              "value": "[parameters('AzureAdB2C:TenantId')]"
            },
            {
              "name": "AzureAdB2C:TokenV1Issuer",
              "value": "[parameters('AzureAdB2C:TokenV1Issuer')]"
            },

            {
              "name": "MicroServiceDBKey",
              "value": "[parameters('MicroServiceDBKey')]"
            },
            {
              "name": "MicroServiceEventStoreTableName",
              "value": "[parameters('MicroServiceEventStoreTableName')]"
            },
            {
              "name": "MicroServiceResponseTableName",
              "value": "[parameters('MicroServiceResponseTableName')]"
            },
            {
              "name": "ServiceBusTopicName",
              "value": "[parameters('ServiceBusTopicName')]"
            },
            {
              "name": "SeatFulfilmentResponseUrl",
              "value": "[parameters('SeatFulfilmentResponseUrl')]"
            },
            {
              "name": "ResponseDelayTimeInMS",
              "value": "[parameters('ResponseDelayTimeInMS')]"
            },
            {
              "name": "ResponsePollingCount",
              "value": "[parameters('ResponsePollingCount')]"
            },
            {
              "name": "OrderChangeServiceBusConnectionString",
              "value": "[parameters('OrderChangeServiceBusConnectionString')]"
            },
            {
              "name": "OrderSeatServiceBusTopicName",
              "value": "[parameters('OrderSeatServiceBusTopicName')]"
            },
            {
              "name": "ServiceBusConnectionString",
              "value": "[parameters('ServiceBusConnectionString')]"
            },
            {
              "name": "PNRCommonV6EndPoint",
              "value": "[parameters('PNRCommonV6EndPoint')]"
            },
            {
              "name": "ApplicationId",
              "value": "[parameters('ApplicationId')]"
            },
            {
              "name": "PoolType",
              "value": "[parameters('PoolType')]"
            },
            {
              "name": "AgentCityCode",
              "value": "[parameters('AgentCityCode')]"
            },
            {
              "name": "SecurityId",
              "value": "[parameters('SecurityId')]"
            },
            {
              "name": "RoleIndicator",
              "value": "[parameters('RoleIndicator')]"
            },
            {
              "name": "OrderSeatDeleteServiceBusTopicName",
              "value": "[parameters('OrderSeatDeleteServiceBusTopicName')]"
            },
            {
              "name": "SeatDeletionServiceBusTopicName",
              "value": "[parameters('SeatDeletionServiceBusTopicName')]"
            },
            {
              "name": "SeatDeletionResponseUrl",
              "value": "[parameters('SeatDeletionResponseUrl')]"
            },
            {
              "name": "EmailMSServiceBusTopicName",
              "value": "[parameters('EmailMSServiceBusTopicName')]"
            },
            {
              "name": "EmailServiceBusConnectionString",
              "value": "[parameters('EmailServiceBusConnectionString')]"
            }
          ]
        },
        "scmSiteAlsoStopped": false,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNamesDisabled": false,
        "containerSize": 1536,
        "dailyMemoryTimeQuota": 0,
        "httpsOnly": true,
        "redundancyMode": "None"
      },
      "tags": "[parameters('Tags')]"
    },
    {
      "type": "Microsoft.Web/sites/config",
      "name": "[concat(parameters('FunctionAppName'), '/web')]",
      "apiVersion": "2021-03-01",
      "location": "North Europe",
      "dependsOn": [ "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]" ],
      "properties": {
        "numberOfWorkers": 1,
        "defaultDocuments": [
          "Default.htm",
          "Default.html",
          "Default.asp",
          "index.htm",
          "index.html",
          "iisstart.htm",
          "default.aspx",
          "index.php"
        ],
        "netFrameworkVersion": "v10.0",
        "phpVersion": "5.6",
        "requestTracingEnabled": false,
        "remoteDebuggingEnabled": false,
        "httpLoggingEnabled": false,
        "logsDirectorySizeLimit": 35,
        "detailedErrorLoggingEnabled": false,
        "publishingUsername": "$[parameters('FunctionAppName')]",
        "azureStorageAccounts": {},
        "scmType": "None",
        "use32BitWorkerProcess": false,
        "webSocketsEnabled": false,
        "alwaysOn": true,
        "managedPipelineMode": "Integrated",
        "virtualApplications": [
          {
            "virtualPath": "/",
            "physicalPath": "site\\wwwroot",
            "preloadEnabled": true
          }
        ],
        "loadBalancing": "LeastRequests",
        "experiments": {
          "rampUpRules": []
        },
        "autoHealEnabled": false,
        "cors": {
          "allowedOrigins": [
            "https://functions.azure.com",
            "https://functions-staging.azure.com",
            "https://functions-next.azure.com"
          ],
          "supportCredentials": false
        },
        "localMySqlEnabled": false,
        "ipSecurityRestrictions": [
          {
            "ipAddress": "[parameters('IPRestriction')]",
            "action": "Allow",
            "priority": 1,
            "name": "Allow_APIM",
            "description": "Allow APIM access"
          }
        ],
        "scmIpSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictionsUseMain": false,
        "http20Enabled": false,
        "minTlsVersion": "1.2",
        "ftpsState": "AllAllowed",
        "PreWarmedInstanceCount": 0
      }
    },
    {
      "type": "Microsoft.Web/sites/hostNameBindings",
      "apiVersion": "2021-03-01",
      "name": "[concat(parameters('FunctionAppName'), '/', parameters('FunctionAppName'), '.azurewebsites.net')]",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [ "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]" ],
      "properties": {
        "siteName": "[parameters('FunctionAppName')]",
        "hostNameType": "Verified"
      }
    },

    {
      "type": "microsoft.insights/components",
      "kind": "web",
      "name": "[parameters('AppInsightsName')]",
      "apiVersion": "2020-02-02",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [ "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]" ],
      "tags": "[parameters('Tags')]",
      "properties": {
        "applicationId": "[variables('SiteResourceID')]",
        "Application_Type": "web"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "name": "[concat(parameters('vaultName'), '/add')]",
      "apiVersion": "2019-09-01",
      "properties": {
        "accessPolicies": [
          {
            "tenantId": "[reference(concat('Microsoft.Web/sites/', parameters('FunctionAppName')), '2018-02-01','Full').identity.tenantId]",
            "objectId": "[reference(concat('Microsoft.Web/sites/', parameters('FunctionAppName')), '2018-02-01','Full').identity.principalId]",
            "permissions": {
              "keys": [ "Get", "List" ],
              "secrets": [ "Get", "List" ],
              "certificates": [ "Get", "List" ],
              "storage": [ "all" ]
            }
          }
        ]
      }
    }
  ]
}
