{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "DataDog": {
      "type": "secureObject",
      "defaultValue": {
        "LoggingProvider": "AppInsights",
        "LogsEndpoint": "https://http-intake.logs.datadoghq.com/api/v2/logs",
        "ApiKey": "",
        "Site": "datadoghq.com",
        "Environment": "",
        "Source": "csharp",
        "Version": "",
        "TraceEnabled": true,
        "RuntimeMetricsEnabled": true,
        "Tags": "",
        "BaggageAllowList": "",
        "MinimumLogLevel": "Information",
        "QueueCapacity": 5000,
        "BatchSize": 100,
        "FlushIntervalMilliseconds": 2000
      }
    },
    "environment": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "appName": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "aseRg": {
      "type": "string"
    },
    "aseName": {
      "type": "string"
    },
    "keyVaultName": {
      "type": "string"
    },
    "tags": {
      "type": "object"
    },
    "appinsightname": {
      "type": "string"
    },
    "appinsightkey": {
      "type": "string"
    },
    "appinsight_string": {
      "type": "string"
    },
    "storageaccountName": {
      "type": "string"
    },
    //App Settings
    "AgentCityCode": {
      "type": "string"
    },
    "Air4PassengerV4EndPoint": {
      "type": "string"
    },
    "Air4PnrCommonEndPoint": {
      "type": "string"
    },
    "AirCraftDataTableName": {
      "type": "string"
    },

    "AppChannelName": {
      "type": "string"
    },
    "ApplicationId": {
      "type": "string"
    },
    "AzureAd:ClientId": {
      "type": "string"
    },
    "AzureAd:Instance": {
      "type": "string"
    },
    "AzureAd:TenantId": {
      "type": "string"
    },
    "AzureAd:TokenV1Issuer": {
      "type": "string"
    },
    "CabinTypeTableName": {
      "type": "string"
    },
    "CommonCachingAbsoluteExpirationInDay": {
      "type": "string"
    },
    "CommonCachingAbsoluteExpirationTime": {
      "type": "string"
    },
    "CommonCachingSlidingExpirationInDay": {
      "type": "string"
    },

    "CommonCachingSlidingExpirationTime": {
      "type": "string"
    },
    "CosmosSqlDBConnectionMode": {
      "type": "string"
    },
    "AzureWebJobsStorage": {
      "type": "string"
    },
    "AzureWebJobsSecretStorageType": {
      "type": "string"
    },
    "DatabaseName": {
      "type": "string"
    },
    "DebugOptions": {
      "type": "string"
    },
    "DeltaCertificateName": {
      "type": "string"
    },
    "DurationFormat": {
      "type": "string"
    },
    "HistoryOnFlag": {
      "type": "string"
    },
    "IPRestriction": {
      "type": "string"
    },
    "MockOrderSearchResponse": {
      "type": "bool"
    },
    "OpenApi__Description": {
      "type": "string"
    },
    "OpenApi__DocTitle": {
      "type": "string"
    },
    "OpenApi__DocVersion": {
      "type": "string"
    },
    "OpenApi__ForceHttp": {
      "type": "bool"
    },
    "OpenApi__ForceHttps": {
      "type": "bool"
    },
    "OpenApi__Scope": {
      "type": "string"
    },
    "OpenApi__TokenUrl": {
      "type": "string"
    },
    "OpenApi__Version": {
      "type": "string"
    },
    "OptionNumberForDisplayRequest": {
      "type": "string"
    },
    "OrderDBEndpoint": {
      "type": "string"
    },
    "OrdersCollection": {
      "type": "string"
    },
    "PoolType": {
      "type": "string"
    },
    "PrinterData": {
      "type": "string"
    },
    "ProductCodeTableName": {
      "type": "string"
    },
    "ServiceBusConnectionString": {
      "type": "string"
    },
    "skuName": {
      "type": "string"
    },
    "actionGroupsServiceNow": {
      "type": "string"
    },
    "actionGroupsEAPISupport": {
      "type": "string"
    },
    "emailAddressServiceNow": {
      "type": "string"
    },
    "emailAddressEAPISupport": {
      "type": "string"
    },
    "ProvideResidualValue": {
      "type": "string"
    },
    "RefDatabaseID": {
      "type": "string"
    },
    "ReferenceDataMicroServiceDBKey": {
      "type": "string"
    },
    "ReferenceDataTableName": {
      "type": "string"
    },
    "ResourceGroupSubscriptionId": {
      "type": "string"
    },
    "RFICTableName": {
      "type": "string"
    },
    "AmenitiesTableName": {
      "type": "string"
    },
    "BrandAPIUrl": {
      "type": "string"
    },
    "BrandAPITokenUrl": {
      "type": "string"
    },
    "BrandAPITokenClientId": {
      "type": "string"
    },
    "BrandAPITokenClientSecret": {
      "type": "string"
    },
    "RoleIndicator": {
      "type": "string"
    },
    "SCVRefDBConnString": {
      "type": "string"
    },
    "SecurityId": {
      "type": "string"
    },
    "StatusCodeTableName": {
      "type": "string"
    },
    "TestLab": {
      "type": "string"
    },
    "TicketingProcessV3EndPoint": {
      "type": "string"
    },
    "TrustedSource": {
      "type": "string"
    },

    "WEBSITE_LOAD_USER_PROFILE": {
      "type": "string"
    },
    "KeyVaulturi": {
      "type": "string"
    }

  },
  "variables": {
    "azurewebjobstorage": "[concat('@Microsoft.KeyVault(SecretUri=https://',parameters('keyVaultName'),'.vault.azure.net/secrets/',parameters('storageaccountName'),'-connectionstring)')]"


  },
  "resources": [
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2018-11-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "functionapp",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "enabled": true,
        "serverFarmId": "[resourceId(parameters('aseRg'), 'Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "hostingEnvironmentProfile": "[resourceId(parameters('aseRg'), 'Microsoft.Web/hostingEnvironments', parameters('aseName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "appSettings": [
            {
              "name": "LoggingProvider",
              "value": "[parameters('DataDog').LoggingProvider]"
            },
            {
              "name": "DatadogLogsEndpoint",
              "value": "[parameters('DataDog').LogsEndpoint]"
            },
            {
              "name": "DatadogApiKey",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_API_KEY",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_SITE",
              "value": "[parameters('DataDog').Site]"
            },
            {
              "name": "DD_SERVICE",
              "value": "[parameters('appName')]"
            },
            {
              "name": "DD_ENV",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DD_VERSION",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DD_TRACE_ENABLED",
              "value": "[string(parameters('DataDog').TraceEnabled)]"
            },
            {
              "name": "DD_RUNTIME_METRICS_ENABLED",
              "value": "[string(parameters('DataDog').RuntimeMetricsEnabled)]"
            },
            {
              "name": "DatadogService",
              "value": "[parameters('appName')]"
            },
            {
              "name": "environment",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DatadogSource",
              "value": "[parameters('DataDog').Source]"
            },
            {
              "name": "DatadogVersion",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DatadogTags",
              "value": "[concat(parameters('DataDog').Tags, if(empty(parameters('DataDog').Tags), '', ','), 'cloud_provider:azure,subscription_id:', subscription().subscriptionId, ',resource_group:', resourceGroup().name, ',name:', parameters('appName'), ',type:microsoft.web/sites,resource_id:', resourceId('Microsoft.Web/sites', parameters('appName')))]"
            },
            {
              "name": "DatadogBaggageAllowList",
              "value": "[parameters('DataDog').BaggageAllowList]"
            },
            {
              "name": "DatadogMinimumLogLevel",
              "value": "[parameters('DataDog').MinimumLogLevel]"
            },
            {
              "name": "DatadogQueueCapacity",
              "value": "[string(parameters('DataDog').QueueCapacity)]"
            },
            {
              "name": "DatadogBatchSize",
              "value": "[string(parameters('DataDog').BatchSize)]"
            },
            {
              "name": "DatadogFlushIntervalMilliseconds",
              "value": "[string(parameters('DataDog').FlushIntervalMilliseconds)]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', parameters('storageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value)]"
            }

          ]
        },
        "scmSiteAlsoStopped": false,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNamesDisabled": false,
        "containerSize": 1536,
        "dailyMemoryTimeQuota": 0,
        "httpsOnly": true,
        "redundancyMode": "None"
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2018-11-01",
      "name": "[concat(parameters('appName'), '/web')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]"
      ],
      "properties": {
        "numberOfWorkers": 1,
        "defaultDocuments": [
          "Default.htm",
          "Default.html",
          "Default.asp",
          "index.htm",
          "index.html",
          "iisstart.htm",
          "default.aspx",
          "index.php"
        ],
        "netFrameworkVersion": "v10.0",
        "phpVersion": "5.6",
        "requestTracingEnabled": false,
        "remoteDebuggingEnabled": false,
        "httpLoggingEnabled": false,
        "logsDirectorySizeLimit": 35,
        "detailedErrorLoggingEnabled": false,
        "publishingUsername": "$[parameters('appName')]",
        "azureStorageAccounts": {},
        "scmType": "None",
        "use32BitWorkerProcess": true,
        "webSocketsEnabled": false,
        "alwaysOn": true,
        "managedPipelineMode": "Integrated",
        "virtualApplications": [
          {
            "virtualPath": "/",
            "physicalPath": "site\\wwwroot",
            "preloadEnabled": false
          }
        ],
        "loadBalancing": "LeastRequests",
        "experiments": {
          "rampUpRules": []
        },
        "autoHealEnabled": false,
        "cors": {
          "allowedOrigins": [
            "https://functions.azure.com",
            "https://functions-staging.azure.com",
            "https://functions-next.azure.com"
          ],
          "supportCredentials": false
        },
        "localMySqlEnabled": false,
        "ipSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictionsUseMain": false,
        "http20Enabled": false,
        "minTlsVersion": "1.2",
        "ftpsState": "FtpsOnly",
        "reservedInstanceCount": 0
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2021-03-01",
      "name": "[concat(parameters('appName'),'/','appsettings')]",
      "kind": "functionapp,workflowapp",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/accessPolicies', parameters('keyVaultName'),'add')]"
      ],
      "properties": {
        /*App Settings */
        "FUNCTIONS_EXTENSION_VERSION": "~4",
        "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
        "WEBSITE_CONTENTOVERVNET": "1",
        "WEBSITE_VNET_ROUTE_ALL": "1",
        "APPINSIGHTS_INSTRUMENTATIONKEY": "[parameters('appinsightkey')]",
        "APPLICATIONINSIGHTS_CONNECTION_STRING": "[parameters('appinsight_string')]",
        "AzureWebJobsStorage": "[variables('azurewebjobstorage')]",
        "AzureAd:ClientId": "[parameters('AzureAd:ClientId')]",
        "AzureAd:TenantId": "[parameters('AzureAd:TenantId')]",
        "AzureWebJobsSecretStorageType": "[parameters('AzureWebJobsSecretStorageType')]",
        "AzureAd:Instance": "[parameters('AzureAd:Instance')]",
        "AzureAd:TokenV1Issuer": "[parameters('AzureAd:TokenV1Issuer')]",
        "OpenApi__Scope": "[parameters('OpenApi__Scope')]",
        "OpenApi__TokenUrl": "[parameters('OpenApi__TokenUrl')]",
        "OpenApi__DocTitle": "[parameters('OpenApi__DocTitle')]",
        "OpenApi__Description": "[parameters('OpenApi__Description')]",
        "OpenApi__DocVersion": "[parameters('OpenApi__DocVersion')]",
        "OpenApi__Version": "[parameters('OpenApi__Version')]",
        "OpenApi__ForceHttps": "[parameters('OpenApi__ForceHttps')]",
        "OpenApi__ForceHttp": "[parameters('OpenApi__ForceHttp')]",
        "MockOrderSearchResponse": "[parameters('MockOrderSearchResponse')]",
        "AgentCityCode": "[parameters('AgentCityCode')]",
        "Air4PnrCommonEndPoint": "[parameters('Air4PnrCommonEndPoint')]",
        "TicketingProcessV3EndPoint": "[parameters('TicketingProcessV3EndPoint')]",
        "Air4PassengerV4EndPoint": "[parameters('Air4PassengerV4EndPoint')]",
        "ApplicationId": "[parameters('ApplicationId')]",
        "DeltaCertificateName": "[parameters('DeltaCertificateName')]",
        "PoolType": "[parameters('PoolType')]",
        "RoleIndicator": "[parameters('RoleIndicator')]",
        "SecurityId": "[parameters('SecurityId')]",
        "TestLab": "[parameters('TestLab')]",
        "OptionNumberForDisplayRequest": "[parameters('OptionNumberForDisplayRequest')]",
        "ProvideResidualValue": "[parameters('ProvideResidualValue')]",
        "TrustedSource": "[parameters('TrustedSource')]",
        /*WEBSITE_CONTENTAZUREFILECONNECTIONSTRING and WEBSITE_CONTENTSHARE does not required for Isolated ASE
        "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING" : "[parameters('WEBSITE_CONTENTAZUREFILECONNECTIONSTRING')]",
        "WEBSITE_CONTENTSHARE" : "[parameters('WEBSITE_CONTENTSHARE')]",*/
        "WEBSITE_LOAD_USER_PROFILE": "[parameters('WEBSITE_LOAD_USER_PROFILE')]",
        "ReferenceDataMicroServiceDBKey": "[variables('azurewebjobstorage')]",
        "ServiceBusConnectionString": "[parameters('ServiceBusConnectionString')]",
        "ReferenceDataTableName": "[parameters('ReferenceDataTableName')]",
        "AirCraftDataTableName": "[parameters('AirCraftDataTableName')]",
        "ProductCodeTableName": "[parameters('ProductCodeTableName')]",
        "StatusCodeTableName": "[parameters('StatusCodeTableName')]",
        "CommonCachingSlidingExpirationInDay": "[parameters('CommonCachingSlidingExpirationInDay')]",
        "CommonCachingAbsoluteExpirationInDay": "[parameters('CommonCachingAbsoluteExpirationInDay')]",
        "CommonCachingSlidingExpirationTime": "[parameters('CommonCachingSlidingExpirationTime')]",
        "CommonCachingAbsoluteExpirationTime": "[parameters('CommonCachingAbsoluteExpirationTime')]",
        "RefDatabaseID": "[parameters('RefDatabaseID')]",
        "OrderDBEndpoint": "[parameters('OrderDBEndpoint')]",
        "DatabaseName": "[parameters('DatabaseName')]",
        "OrdersCollection": "[parameters('OrdersCollection')]",
        "SCVRefDBConnString": "[parameters('SCVRefDBConnString')]",
        "DurationFormat": "[parameters('DurationFormat')]",
        "CosmosSqlDBConnectionMode": "[parameters('CosmosSqlDBConnectionMode')]",
        "RFICTableName": "[parameters('RFICTableName')]",
        "CabinTypeTableName": "[parameters('CabinTypeTableName')]",
        "AmenitiesTableName": "[parameters('AmenitiesTableName')]",
        "BrandAPIUrl": "[parameters('BrandAPIUrl')]",
        "BrandAPITokenUrl": "[parameters('BrandAPITokenUrl')]",
        "BrandAPITokenClientId": "[parameters('BrandAPITokenClientId')]",
        "BrandAPITokenClientSecret": "[parameters('BrandAPITokenClientSecret')]",
        "AppChannelName": "[parameters('AppChannelName')]",
        "DebugOptions": "[parameters('DebugOptions')]",
        "HistoryOnFlag": "[parameters('HistoryOnFlag')]",
        "PrinterData": "[parameters('PrinterData')]",
        "KeyVaulturi": "[parameters('KeyVaulturi')]"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "apiVersion": "2015-06-01",
      "name": "[concat(parameters('keyvaultName'),'/add')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]"

      ],
      "properties": {
        "accessPolicies": [
          {
            "objectId": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2019-08-01', 'full').identity.principalId]",
            "tenantId": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2019-08-01', 'full').identity.tenantId]",
            "permissions": {
              "secrets": [ "Get", "List", "Set" ]
            }
          }
        ]
      }
    }

  ]
}
