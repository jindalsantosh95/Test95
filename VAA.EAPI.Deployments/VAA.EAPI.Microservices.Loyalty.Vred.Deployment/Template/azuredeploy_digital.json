{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "DataDog": {
      "type": "secureObject",
      "defaultValue": {
        "LoggingProvider": "AppInsights",
        "LogsEndpoint": "https://http-intake.logs.datadoghq.com/api/v2/logs",
        "ApiKey": "",
        "Site": "datadoghq.com",
        "Environment": "",
        "Source": "csharp",
        "Version": "",
        "TraceEnabled": true,
        "RuntimeMetricsEnabled": true,
        "Tags": "",
        "BaggageAllowList": "",
        "MinimumLogLevel": "Information",
        "QueueCapacity": 5000,
        "BatchSize": 100,
        "FlushIntervalMilliseconds": 2000
      }
    },
    "environment": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "functionappName": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "AppInsightsName": {
      "type": "string"
    },
    "aseRg": {
      "type": "string"
    },
    "aseName": {
      "type": "string"
    },
    "keyVaultName": {
      "type": "string"
    },
    "tags": {
      "type": "object"
    },
    "WEBSITE_DNS_SERVER": {
      "type": "string"
    },
    "WEBSITE_DNS_ALT_SERVER": {
      "type": "string"
    },
    "WEBSITE_LOAD_USER_PROFILE": {
      "type": "string"
    },
    "WEBSITE_RUN_FROM_PACKAGE": {
      "type": "string"
    },
    "OpenApi__Scope": {
      "type": "string"
    },
    "OpenApi__TokenUrl": {
      "type": "string"
    },
    "OpenApi__DocTitle": {
      "type": "string"
    },
    "OpenApi__Description": {
      "type": "string"
    },
    "OpenApi__DocVersion": {
      "type": "string"
    },
    "OpenApi__Version": {
      "type": "string"
    },
    "OpenApi__ForceHttps": {
      "type": "bool"
    },
    "OpenApi__ForceHttp": {
      "type": "bool"
    },
    "storageaccountName": {
      "type": "string"
    },
    "LAW_RESOURCE_GROUP_NAME": {
      "type": "string"
    },
    "WORKSPACE_NAME": {
      "type": "string"
    },
    "workspaceResourceId": {
      "type": "string"
    },
    "KeyVaultUri": {
      "type": "string"
    },
    "SlotName": {
      "type": "string"
    },
    //Vred ms appsettings
    "Appsetting:MemberMetaDataSchema": {
      "type": "string"
    },
    "Appsetting:VRedEnrolmentAPI": {
      "type": "string"
    },
    "AzureAd:ClientId": {
      "type": "string"
    },
    "AzureAd:Instance": {
      "type": "string"
    },
    "AzureAd:TenantId": {
      "type": "string"
    },
    "AzureAd:TokenV1Issuer": {
      "type": "string"
    },
    "Appsetting:VRedAuthUrl": {
      "type": "string"
    },
    "Appsetting:AuthAudience": {
      "type": "string"
    },
    "Appsetting:AuthClientId": {
      "type": "string"
    },
    "Appsetting:UpdateVRedAuthUrl": {
      "type": "string"
    },
    "AppsettingsEventGridUrl": {
      "type": "string"
    },
    "AppsettingsEventGridTopicKey": {
      "type": "string"
    },
    "Appsetting:AuthClientSecret": {
      "type": "string"
    },
    "Appsetting:VRed-Ocp-Apim-Subscription-Key": {
      "type": "string"
    },
    "AppSetting:VredEnableSignDate": {
      "type": "bool"
    },
    "Appsetting:KeyVaultToken": {
      "type": "string"
    },
    "Appsetting:KeyVaultTokenPeriod": {
      "type": "string"
    },
    "Appsetting:ServiceBusConnectionString": {
      "type": "string"
    },
    "Appsetting:ServiceBusTopicName": {
      "type": "string"
    },
    "Appsetting:KeyVaultExpireTokenValue": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_ALT_SERVER": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_SERVER": {
      "type": "string"
    },
    "Appsetting:MicroServiceDBKey": {
      "type": "string"
    },
    "Appsetting:MicroServiceEventStoreTableName": {
      "type": "string"
    },
    "Appsetting:VRedEndpointUrl": {
      "type": "string"
    },
    "Appsetting:VRedStatementEndpointUrl": {
      "type": "string"
    },
    "Appsetting:VRedConsentEndpointUrl": {
      "type": "string"
    },
    "Appsetting:VRedConsentRequestToken": {
      "type": "string"
    },
    "Appsetting:VRedConsentRequestKey1": {
      "type": "string"
    },
    "Appsetting:VRedConsentRequestKey2": {
      "type": "string"
    },
    "Appsetting:UrlVersion": {
      "type": "string"
    },
    "IPRestriction": {
      "type": "string"
    },
    "Appsetting:VGLCDBConnString": {
      "type": "string"
    },
    //Azure B2C settings
    "AzureAdB2C:ClientId": {
      "type": "string"
    },
    "AzureAdB2C:Instance": {
      "type": "string"
    },
    "AzureAdB2C:SignUpSignInPolicyId": {
      "type": "string"
    },
    "AzureAdB2C:TenantId": {
      "type": "string"
    },
    "AzureAdB2C:TokenV1Issuer": {
      "type": "string"
    },
    //Retail Therapy App settings
    "Appsetting:CreateTransactionResponseUrl": {
      "type": "string"
    },
    "Appsetting:CancelTransactionResponseUrl": {
      "type": "string"
    },
    "Appsetting:CreditMetaDataSchema": {
      "type": "string"
    },
    "Appsetting:DebitMetaDataSchema": {
      "type": "string"
    },
    "Appsetting:VredTransactionAPICallbackUrl": {
      "type": "string"
    },
    "Appsetting:VredTransactionAPIV2": {
      "type": "string"
    },
    "Appsetting:ResponsePollingCount": {
      "type": "string"
    },
    "Appsetting:ResponseDelayTimeInMS": {
      "type": "string"
    },
    "Appsetting:MicroServiceResponseTableName": {
      "type": "string"
    },
    "Appsetting:DatabaseID": {
      "type": "string"
    }

  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2021-09-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('Tags')]",
      "sku": {
        "name": "Standard_RAGRS",
        "tier": "Standard"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[parameters('AppInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[parameters('workspaceResourceId')]"
      },
      "dependsOn": []
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2018-11-01",
      "name": "[parameters('functionappName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "functionapp",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "enabled": true,
        "serverFarmId": "[resourceId(parameters('aseRg'), 'Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "hostingEnvironmentProfile": "[resourceId(parameters('aseRg'), 'Microsoft.Web/hostingEnvironments', parameters('aseName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "appSettings": [
            {
              "name": "LoggingProvider",
              "value": "[parameters('DataDog').LoggingProvider]"
            },
            {
              "name": "DatadogLogsEndpoint",
              "value": "[parameters('DataDog').LogsEndpoint]"
            },
            {
              "name": "DatadogApiKey",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_API_KEY",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_SITE",
              "value": "[parameters('DataDog').Site]"
            },
            {
              "name": "DD_SERVICE",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "DD_ENV",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DD_VERSION",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DD_TRACE_ENABLED",
              "value": "[string(parameters('DataDog').TraceEnabled)]"
            },
            {
              "name": "DD_RUNTIME_METRICS_ENABLED",
              "value": "[string(parameters('DataDog').RuntimeMetricsEnabled)]"
            },
            {
              "name": "DatadogService",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "environment",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DatadogSource",
              "value": "[parameters('DataDog').Source]"
            },
            {
              "name": "DatadogVersion",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DatadogTags",
              "value": "[concat(parameters('DataDog').Tags, if(empty(parameters('DataDog').Tags), '', ','), 'cloud_provider:azure,subscription_id:', subscription().subscriptionId, ',resource_group:', resourceGroup().name, ',name:', parameters('functionappName'), ',type:microsoft.web/sites,resource_id:', resourceId('Microsoft.Web/sites', parameters('functionappName')))]"
            },
            {
              "name": "DatadogBaggageAllowList",
              "value": "[parameters('DataDog').BaggageAllowList]"
            },
            {
              "name": "DatadogMinimumLogLevel",
              "value": "[parameters('DataDog').MinimumLogLevel]"
            },
            {
              "name": "DatadogQueueCapacity",
              "value": "[string(parameters('DataDog').QueueCapacity)]"
            },
            {
              "name": "DatadogBatchSize",
              "value": "[string(parameters('DataDog').BatchSize)]"
            },
            {
              "name": "DatadogFlushIntervalMilliseconds",
              "value": "[string(parameters('DataDog').FlushIntervalMilliseconds)]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', parameters('storageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value)]"
            }
          ]
        },
        "scmSiteAlsoStopped": false,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNamesDisabled": false,
        "containerSize": 1536,
        "dailyMemoryTimeQuota": 0,
        "httpsOnly": true,
        "redundancyMode": "None"
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2018-11-01",
      "name": "[concat(parameters('functionappName'), '/web')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionappName'))]"
      ],
      "properties": {
        "numberOfWorkers": 1,
        "defaultDocuments": [
          "Default.htm",
          "Default.html",
          "Default.asp",
          "index.htm",
          "index.html",
          "iisstart.htm",
          "default.aspx",
          "index.php"
        ],
        "netFrameworkVersion": "v10.0",
        "phpVersion": "5.6",
        "requestTracingEnabled": false,
        "remoteDebuggingEnabled": false,
        "httpLoggingEnabled": false,
        "logsDirectorySizeLimit": 35,
        "detailedErrorLoggingEnabled": false,
        "publishingUsername": "$[parameters('functionappName')]",
        "azureStorageAccounts": {},
        "scmType": "None",
        "use32BitWorkerProcess": false,
        "webSocketsEnabled": false,
        "alwaysOn": true,
        "managedPipelineMode": "Integrated",
        "virtualApplications": [
          {
            "virtualPath": "/",
            "physicalPath": "site\\wwwroot",
            "preloadEnabled": false
          }
        ],
        "loadBalancing": "LeastRequests",
        "experiments": {
          "rampUpRules": []
        },
        "autoHealEnabled": false,
        "cors": {
          "allowedOrigins": [
            "https://functions.azure.com",
            "https://functions-staging.azure.com",
            "https://functions-next.azure.com"
          ],
          "supportCredentials": false
        },
        "localMySqlEnabled": false,
        "ipSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictionsUseMain": false,
        "http20Enabled": false,
        "minTlsVersion": "1.2",
        "ftpsState": "FtpsOnly",
        "reservedInstanceCount": 0
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2021-03-01",
      "name": "[concat(parameters('functionappName'),'/','appsettings')]",
      "kind": "functionapp,workflowapp",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionappName'))]"
      ],
      "properties": {
        "FUNCTIONS_EXTENSION_VERSION": "~4",
        "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
        "WEBSITE_CONTENTOVERVNET": "1",
        "WEBSITE_VNET_ROUTE_ALL": "1",
        "APPINSIGHTS_INSTRUMENTATIONKEY": "[reference(resourceId('Microsoft.Insights/components', parameters('AppInsightsName')), '2014-04-01').InstrumentationKey]",
        "APPLICATIONINSIGHTS_CONNECTION_STRING": "[reference(resourceId('Microsoft.Insights/components', parameters('AppInsightsName')), '2020-02-02').ConnectionString]",
        "AzureWebJobsStorage": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageAccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]",
        "WEBSITE_DNS_SERVER": "[parameters('WEBSITE_DNS_SERVER')]",
        "WEBSITE_DNS_ALT_SERVER": "[parameters('WEBSITE_DNS_ALT_SERVER')]",
        "WEBSITE_RUN_FROM_PACKAGE": "[parameters('WEBSITE_RUN_FROM_PACKAGE')]",
        "WEBSITE_LOAD_USER_PROFILE": "[parameters('WEBSITE_LOAD_USER_PROFILE')]",
        "AzureWebJobsSecretStorageType": "Files",
        "OpenApi__Scope": "[parameters('OpenApi__Scope')]",
        "OpenApi__TokenUrl": "[parameters('OpenApi__TokenUrl')]",
        "OpenApi__DocTitle": "[parameters('OpenApi__DocTitle')]",
        "OpenApi__Description": "[parameters('OpenApi__Description')]",
        "OpenApi__DocVersion": "[parameters('OpenApi__DocVersion')]",
        "OpenApi__Version": "[parameters('OpenApi__Version')]",
        "OpenApi__ForceHttps": "[parameters('OpenApi__ForceHttps')]",
        "OpenApi__ForceHttp": "[parameters('OpenApi__ForceHttp')]",
        "KeyVaultUri": "[parameters('KeyVaultUri')]",
        //Vred Ms appsettings
        "MemberMetaDataSchema": "[parameters('Appsetting:MemberMetaDataSchema')]",
        "VRedEnrolmentAPI": "[parameters('Appsetting:VRedEnrolmentAPI')]",
        "VRedAuthUrl": "[parameters('Appsetting:VRedAuthUrl')]",
        "AuthAudience": "[parameters('Appsetting:AuthAudience')]",
        "AuthClientId": "[parameters('Appsetting:AuthClientId')]",
        "UpdateVRedAuthUrl": "[parameters('Appsetting:UpdateVRedAuthUrl')]",
        "AuthClientSecret": "[parameters('Appsetting:AuthClientSecret')]",
        "EventGridUrl": "[parameters('AppsettingsEventGridUrl')]",
        "EventGridTopicKey": "[parameters('AppsettingsEventGridTopicKey')]",
        "VRed-Ocp-Apim-Subscription-Key": "[parameters('Appsetting:VRed-Ocp-Apim-Subscription-Key')]",
        "VredEnableSignDate": "[parameters('Appsetting:VredEnableSignDate')]",
        "KeyVaultToken": "[parameters('Appsetting:KeyVaultToken')]",
        "ServiceBusConnectionString": "[parameters('Appsetting:ServiceBusConnectionString')]",
        "ServiceBusTopicName": "[parameters('Appsetting:ServiceBusTopicName')]",
        "KeyVaultTokenPeriod": "[parameters('Appsetting:KeyVaultTokenPeriod')]",
        "KeyVaultExpireTokenValue": "[parameters('Appsetting:KeyVaultExpireTokenValue')]",
        "MicroServiceDBKey": "[parameters('Appsetting:MicroServiceDBKey')]",
        "MicroServiceEventStoreTableName": "[parameters('Appsetting:MicroServiceEventStoreTableName')]",
        "VRedEndpointUrl": "[parameters('Appsetting:VRedEndpointUrl')]",
        "VRedStatementEndpointUrl": "[parameters('Appsetting:VRedStatementEndpointUrl')]",
        "VRedConsentEndpointUrl": "[parameters('Appsetting:VRedConsentEndpointUrl')]",
        "VRedConsentRequestToken": "[parameters('Appsetting:VRedConsentRequestToken')]",
        "VRedConsentRequestKey1": "[parameters('Appsetting:VRedConsentRequestKey1')]",
        "VRedConsentRequestKey2": "[parameters('Appsetting:VRedConsentRequestKey2')]",
        "UrlVersion": "[parameters('Appsetting:UrlVersion')]",
        "AzureAd:ClientId": "[parameters('AzureAd:ClientId')]",
        "AzureAd:Instance": "[parameters('AzureAd:Instance')]",
        "AzureAd:TenantId": "[parameters('AzureAd:TenantId')]",
        "AzureAd:TokenV1Issuer": "[parameters('AzureAd:TokenV1Issuer')]",
        "VGLCDBConnString": "[parameters('Appsetting:VGLCDBConnString')]",
        "AzureAdB2C:ClientId": "[parameters('AzureAdB2C:ClientId')]",
        "AzureAdB2C:Instance": "[parameters('AzureAdB2C:Instance')]",
        "AzureAdB2C:SignUpSignInPolicyId": "[parameters('AzureAdB2C:SignUpSignInPolicyId')]",
        "AzureAdB2C:TenantId": "[parameters('AzureAdB2C:TenantId')]",
        "AzureAdB2C:TokenV1Issuer": "[parameters('AzureAdB2C:TokenV1Issuer')]",
        "CreateTransactionResponseUrl": "[parameters('Appsetting:CreateTransactionResponseUrl')]",
        "CancelTransactionResponseUrl": "[parameters('Appsetting:CancelTransactionResponseUrl')]",
        "CreditMetaDataSchema": "[parameters('Appsetting:CreditMetaDataSchema')]",
        "DebitMetaDataSchema": "[parameters('Appsetting:DebitMetaDataSchema')]",
        "VredTransactionAPICallbackUrl": "[parameters('Appsetting:VredTransactionAPICallbackUrl')]",
        "VredTransactionAPIV2": "[parameters('Appsetting:VredTransactionAPIV2')]",
        "ResponsePollingCount": "[parameters('Appsetting:ResponsePollingCount')]",
        "ResponseDelayTimeInMS": "[parameters('Appsetting:ResponseDelayTimeInMS')]",
        "MicroServiceResponseTableName": "[parameters('Appsetting:MicroServiceResponseTableName')]",
        "DatabaseID": "[parameters('Appsetting:DatabaseID')]"

      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "apiVersion": "2015-06-01",
      "name": "[concat(parameters('keyvaultName'),'/add')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionappName'))]"
      ],
      "properties": {
        "accessPolicies": [
          {
            "objectId": "[reference(resourceId('Microsoft.Web/sites', parameters('functionappName')), '2019-08-01', 'full').identity.principalId]",
            "tenantId": "[reference(resourceId('Microsoft.Web/sites', parameters('functionappName')), '2019-08-01', 'full').identity.tenantId]",
            "permissions": {
              "secrets": [ "Get", "List" ]
            }
          }
        ]
      }
    }
  ]
}
