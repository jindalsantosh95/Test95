{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "DataDog": {
      "type": "secureObject",
      "defaultValue": {
        "LoggingProvider": "AppInsights",
        "LogsEndpoint": "https://http-intake.logs.datadoghq.com/api/v2/logs",
        "ApiKey": "",
        "Site": "datadoghq.com",
        "Environment": "",
        "Source": "csharp",
        "Version": "",
        "TraceEnabled": true,
        "RuntimeMetricsEnabled": true,
        "Tags": "",
        "BaggageAllowList": "",
        "MinimumLogLevel": "Information",
        "QueueCapacity": 5000,
        "BatchSize": 100,
        "FlushIntervalMilliseconds": 2000
      }
    },
    "FunctionAppName": {
      "type": "string"
    },
    "EnvironmentName": {
      "type": "string"
    },
    "ServerFarmIdRg": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "AppInsightsName": {
      "type": "string"
    },
    "Appsetting:FUNCTIONS_EXTENSION_VERSION": {
      "type": "string"
    },
    /*"AppsettingAppInsightsKey": {
      "type": "string"
    },*/
    "AppsettingAzureWebJobsStorage": {
      "type": "string"
    },
    "Appsetting:FUNCTIONS_WORKER_RUNTIME": {
      "type": "string"
    },
    "Appsetting:MemberMetaDataSchema": {
      "type": "string"
    },
    "Appsetting:VRedEnrolmentAPI": {
      "type": "string"
    },
    "AzureAd:ClientId": {
      "type": "string"
    },
    "AzureAd:Instance": {
      "type": "string"
    },
    "AzureAd:TenantId": {
      "type": "string"
    },
    "AzureAd:TokenV1Issuer": {
      "type": "string"
    },
    "Appsetting:VRedAuthUrl": {
      "type": "string"
    },
    "Appsetting:AuthAudience": {
      "type": "string"
    },
    "Appsetting:AuthClientId": {
      "type": "string"
    },
    "Appsetting:UpdateVRedAuthUrl": {
      "type": "string"
    },
    "AppsettingsEventGridUrl": {
      "type": "string"
    },
    "AppsettingsEventGridTopicKey": {
      "type": "string"
    },
    "Appsetting:AuthClientSecret": {
      "type": "string"
    },
    "Appsetting:VRed-Ocp-Apim-Subscription-Key": {
      "type": "string"
    },
    "AppSetting:VredEnableSignDate": {
      "type": "bool"
    },
    "Appsetting:KeyVaultToken": {
      "type": "string"
    },
    "Appsetting:KeyVaultTokenPeriod": {
      "type": "string"
    },
    "Appsetting:ServiceBusConnectionString": {
      "type": "string"
    },
    "Appsetting:ServiceBusTopicName": {
      "type": "string"
    },
    "Appsetting:KeyVaultExpireTokenValue": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_ALT_SERVER": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_SERVER": {
      "type": "string"
    },
    "Appsetting:MicroServiceDBKey": {
      "type": "string"
    },
    "Appsetting:MicroServiceEventStoreTableName": {
      "type": "string"
    },
    "Appsetting:VRedEndpointUrl": {
      "type": "string"
    },
    "Appsetting:VRedStatementEndpointUrl": {
      "type": "string"
    },
    "Appsetting:VRedConsentEndpointUrl": {
      "type": "string"
    },
    "Appsetting:VRedConsentRequestToken": {
      "type": "string"
    },
    "Appsetting:VRedConsentRequestKey1": {
      "type": "string"
    },
    "Appsetting:VRedConsentRequestKey2": {
      "type": "string"
    },
    "Appsetting:UrlVersion": {
      "type": "string"
    },
    "IPRestriction": {
      "type": "string"
    },
    "Appsetting:VGLCDBConnString": {
      "type": "string"
    },
    //Azure B2C settings
    "AzureAdB2C:ClientId": {
      "type": "string"
    },
    "AzureAdB2C:Instance": {
      "type": "string"
    },
    "AzureAdB2C:SignUpSignInPolicyId": {
      "type": "string"
    },
    "AzureAdB2C:TenantId": {
      "type": "string"
    },
    "AzureAdB2C:TokenV1Issuer": {
      "type": "string"
    },
    "tags": {
      "type": "Object"
    },

    //Retail Therapy App settings
    "Appsetting:CreateTransactionResponseUrl": {
      "type": "string"
    },
    "Appsetting:CancelTransactionResponseUrl": {
      "type": "string"
    },
    "Appsetting:CreditMetaDataSchema": {
      "type": "string"
    },
    "Appsetting:DebitMetaDataSchema": {
      "type": "string"
    },
    "Appsetting:VredTransactionAPICallbackUrl": {
      "type": "string"
    },
    "Appsetting:VredTransactionAPIV2": {
      "type": "string"
    },
    "Appsetting:ResponsePollingCount": {
      "type": "string"
    },
    "Appsetting:ResponseDelayTimeInMS": {
      "type": "string"
    },
    "Appsetting:MicroServiceResponseTableName": {
      "type": "string"
    },
    "Appsetting:DatabaseID": {
      "type": "string"
    },
    "SlotName": {
      "type": "string"
    },
    "vaultName": {
      "type": "string"
    },

    //swagger settings

    "OpenApi__Description": {
      "type": "string"
    },
    "OpenApi__DocTitle": {
      "type": "string"
    },
    "OpenApi__DocVersion": {
      "type": "string"
    },
    "OpenApi__ForceHttp": {
      "type": "bool"
    },
    "OpenApi__ForceHttps": {
      "type": "bool"
    },
    "OpenApi__Scope": {
      "type": "string"
    },
    "OpenApi__TokenUrl": {
      "type": "string"
    },
    "OpenApi__Version": {
      "type": "string"
    }
  },
  "variables": {
    "ResourceLocation": "[resourceGroup().location]",
    "SiteResourceID": "[resourceId('Microsoft.Web/Sites', parameters('FunctionAppName'))]"
  },
  "resources": [
    {
      "type": "microsoft.insights/components",
      "kind": "web",
      "name": "[parameters('AppInsightsName')]",
      "apiVersion": "2015-05-01",
      "location": "[Variables('ResourceLocation')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "applicationId": "[variables('SiteResourceID')]",
        "Application_Type": "web"
      }

    },
    {
      "type": "Microsoft.Web/sites",
      "kind": "functionapp",
      "name": "[parameters('FunctionAppName')]",
      "apiVersion": "2021-03-01",
      "location": "[variables('ResourceLocation')]",
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]"
      },
      "tags": "[parameters('Tags')]"
    },
    {
      "type": "Microsoft.Web/sites/slots",
      "kind": "functionapp",
      "name": "[concat(parameters('FunctionAppName'), '/',parameters('SlotName'))]",
      "apiVersion": "2021-03-01",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [ "[variables('SiteResourceID')]" ],
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },
      "properties": {
        "enabled": true,
        "hostNameSslStates": [
          {
            "name": "[concat(parameters('FunctionAppName'), '-',parameters('SlotName'), '.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Standard"
          },
          {
            "name": "[concat(parameters('FunctionAppName'), '-',parameters('SlotName'), '.scm.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Repository"
          }
        ],
        "serverFarmId": "[resourceId('Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "alwaysOn": true,
          "appSettings": [
            {
              "name": "LoggingProvider",
              "value": "[parameters('DataDog').LoggingProvider]"
            },
            {
              "name": "DatadogLogsEndpoint",
              "value": "[parameters('DataDog').LogsEndpoint]"
            },
            {
              "name": "DatadogApiKey",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_API_KEY",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_SITE",
              "value": "[parameters('DataDog').Site]"
            },
            {
              "name": "DD_SERVICE",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "DD_ENV",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DD_VERSION",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DD_TRACE_ENABLED",
              "value": "[string(parameters('DataDog').TraceEnabled)]"
            },
            {
              "name": "DD_RUNTIME_METRICS_ENABLED",
              "value": "[string(parameters('DataDog').RuntimeMetricsEnabled)]"
            },
            {
              "name": "DatadogService",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "environment",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DatadogSource",
              "value": "[parameters('DataDog').Source]"
            },
            {
              "name": "DatadogVersion",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DatadogTags",
              "value": "[concat(parameters('DataDog').Tags, if(empty(parameters('DataDog').Tags), '', ','), 'cloud_provider:azure,subscription_id:', subscription().subscriptionId, ',resource_group:', resourceGroup().name, ',name:', parameters('FunctionAppName'), '/', parameters('SlotName'), ',type:microsoft.web/sites/slots,resource_id:', resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName')))]"
            },
            {
              "name": "DatadogBaggageAllowList",
              "value": "[parameters('DataDog').BaggageAllowList]"
            },
            {
              "name": "DatadogMinimumLogLevel",
              "value": "[parameters('DataDog').MinimumLogLevel]"
            },
            {
              "name": "DatadogQueueCapacity",
              "value": "[string(parameters('DataDog').QueueCapacity)]"
            },
            {
              "name": "DatadogBatchSize",
              "value": "[string(parameters('DataDog').BatchSize)]"
            },
            {
              "name": "DatadogFlushIntervalMilliseconds",
              "value": "[string(parameters('DataDog').FlushIntervalMilliseconds)]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "[parameters('Appsetting:FUNCTIONS_EXTENSION_VERSION')]"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "1"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "dotnet-isolated"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[reference(resourceId('Microsoft.Insights/components', parameters('AppInsightsName')), '2014-04-01').InstrumentationKey]"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[parameters('AppsettingAzureWebJobsStorage')]"
            },
            {
              "name": "MemberMetaDataSchema",
              "value": "[parameters('Appsetting:MemberMetaDataSchema')]"
            },
            {
              "name": "VRedEnrolmentAPI",
              "value": "[parameters('Appsetting:VRedEnrolmentAPI')]"
            },
            {
              "name": "VRedAuthUrl",
              "value": "[parameters('Appsetting:VRedAuthUrl')]"
            },
            {
              "name": "AuthAudience",
              "value": "[parameters('Appsetting:AuthAudience')]"
            },
            {
              "name": "AuthClientId",

              "value": "[parameters('Appsetting:AuthClientId')]"
            },
            {
              "name": "UpdateVRedAuthUrl",
              "value": "[parameters('Appsetting:UpdateVRedAuthUrl')]"
            },
            {
              "name": "AuthClientSecret",
              "value": "[parameters('Appsetting:AuthClientSecret')]"
            },
            {
              "name": "EventGridUrl",
              "value": "[parameters('AppsettingsEventGridUrl')]"
            },
            {
              "name": "EventGridTopicKey",
              "value": "[parameters('AppsettingsEventGridTopicKey')]"
            },
            {
              "name": "VRed-Ocp-Apim-Subscription-Key",
              "value": "[parameters('Appsetting:VRed-Ocp-Apim-Subscription-Key')]"
            },
            {
              "name": "VredEnableSignDate",
              "value": "[parameters('Appsetting:VredEnableSignDate')]"
            },
            {
              "name": "KeyVaultToken",
              "value": "[parameters('Appsetting:KeyVaultToken')]"
            },

            {
              "name": "ServiceBusConnectionString",
              "value": "[parameters('Appsetting:ServiceBusConnectionString')]"
            },
            {
              "name": "ServiceBusTopicName",
              "value": "[parameters('Appsetting:ServiceBusTopicName')]"
            },

            {
              "name": "KeyVaultTokenPeriod",
              "value": "[parameters('Appsetting:KeyVaultTokenPeriod')]"
            },
            {
              "name": "KeyVaultExpireTokenValue",
              "value": "[parameters('Appsetting:KeyVaultExpireTokenValue')]"
            },
            {
              "name": "MicroServiceDBKey",
              "value": "[parameters('Appsetting:MicroServiceDBKey')]"
            },
            {
              "name": "MicroServiceEventStoreTableName",
              "value": "[parameters('Appsetting:MicroServiceEventStoreTableName')]"
            },
            {
              "name": "VRedEndpointUrl",
              "value": "[parameters('Appsetting:VRedEndpointUrl')]"
            },
            {
              "name": "VRedStatementEndpointUrl",
              "value": "[parameters('Appsetting:VRedStatementEndpointUrl')]"
            },
            {
              "name": "VRedConsentEndpointUrl",
              "value": "[parameters('Appsetting:VRedConsentEndpointUrl')]"
            },
            {
              "name": "VRedConsentRequestToken",
              "value": "[parameters('Appsetting:VRedConsentRequestToken')]"
            },
            {
              "name": "VRedConsentRequestKey1",
              "value": "[parameters('Appsetting:VRedConsentRequestKey1')]"
            },
            {
              "name": "VRedConsentRequestKey2",
              "value": "[parameters('Appsetting:VRedConsentRequestKey2')]"
            },

            {
              "name": "UrlVersion",
              "value": "[parameters('Appsetting:UrlVersion')]"
            },
            {
              "name": "AzureAd:ClientId",
              "value": "[parameters('AzureAd:ClientId')]"
            },
            {
              "name": "AzureAd:Instance",
              "value": "[parameters('AzureAd:Instance')]"
            },
            {
              "name": "AzureAd:TenantId",
              "value": "[parameters('AzureAd:TenantId')]"
            },
            {
              "name": "AzureAd:TokenV1Issuer",
              "value": "[parameters('AzureAd:TokenV1Issuer')]"
            },
            {
              "name": "VGLCDBConnString",
              "value": "[parameters('Appsetting:VGLCDBConnString')]"
            },
            //Azure B2C Settings
            {
              "name": "AzureAdB2C:ClientId",
              "value": "[parameters('AzureAdB2C:ClientId')]"
            },
            {
              "name": "AzureAdB2C:Instance",
              "value": "[parameters('AzureAdB2C:Instance')]"
            },
            {
              "name": "AzureAdB2C:SignUpSignInPolicyId",
              "value": "[parameters('AzureAdB2C:SignUpSignInPolicyId')]"
            },
            {
              "name": "AzureAdB2C:TenantId",
              "value": "[parameters('AzureAdB2C:TenantId')]"
            },
            {
              "name": "AzureAdB2C:TokenV1Issuer",
              "value": "[parameters('AzureAdB2C:TokenV1Issuer')]"
            },

            //Retail Therapy app settings
            {
              "name": "CreateTransactionResponseUrl",
              "value": "[parameters('Appsetting:CreateTransactionResponseUrl')]"
            },
            {
              "name": "CancelTransactionResponseUrl",
              "value": "[parameters('Appsetting:CancelTransactionResponseUrl')]"
            },
            {
              "name": "CreditMetaDataSchema",
              "value": "[parameters('Appsetting:CreditMetaDataSchema')]"
            },
            {
              "name": "DebitMetaDataSchema",
              "value": "[parameters('Appsetting:DebitMetaDataSchema')]"
            },
            {
              "name": "VredTransactionAPICallbackUrl",
              "value": "[parameters('Appsetting:VredTransactionAPICallbackUrl')]"
            },
            {
              "name": "VredTransactionAPIV2",
              "value": "[parameters('Appsetting:VredTransactionAPIV2')]"
            },
            {
              "name": "ResponsePollingCount",
              "value": "[parameters('Appsetting:ResponsePollingCount')]"
            },
            {
              "name": "ResponseDelayTimeInMS",
              "value": "[parameters('Appsetting:ResponseDelayTimeInMS')]"
            },
            {
              "name": "MicroServiceResponseTableName",
              "value": "[parameters('Appsetting:MicroServiceResponseTableName')]"
            },
            {
              "name": "DatabaseID",
              "value": "[parameters('Appsetting:DatabaseID')]"
            },

            //swagger settings
            {
              "name": "OpenApi__Scope",
              "value": "[parameters('OpenApi__Scope')]"
            },
            {
              "name": "OpenApi__TokenUrl",
              "value": "[parameters('OpenApi__TokenUrl')]"
            },
            {
              "name": "OpenApi__DocTitle",
              "value": "[parameters('OpenApi__DocTitle')]"
            },
            {
              "name": "OpenApi__Description",
              "value": "[parameters('OpenApi__Description')]"
            },
            {
              "name": "OpenApi__DocVersion",
              "value": "[parameters('OpenApi__DocVersion')]"
            },
            {
              "name": "OpenApi__Version",
              "value": "[parameters('OpenApi__Version')]"
            },
            {
              "name": "OpenApi__ForceHttps",
              "value": "[parameters('OpenApi__ForceHttps')]"
            },
            {
              "name": "OpenApi__ForceHttp",
              "value": "[parameters('OpenApi__ForceHttp')]"
            }
          ]
        },
        "scmSiteAlsoStopped": false,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNamesDisabled": false,
        "containerSize": 1536,
        "dailyMemoryTimeQuota": 0,
        "httpsOnly": true,
        "redundancyMode": "None"
      },
      "tags": "[parameters('Tags')]"
    },
    {
      "type": "Microsoft.Web/sites/slots/config",
      "apiVersion": "2021-03-01",
      "name": "[concat(parameters('FunctionAppName'), '/',parameters('SlotName'),'/web')]",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName'))]",
        "[variables('SiteResourceID')]"
      ],
      "properties": {
        "numberOfWorkers": 1,
        "defaultDocuments": [
          "Default.htm",
          "Default.html",
          "Default.asp",
          "index.htm",
          "index.html",
          "iisstart.htm",
          "default.aspx",
          "index.php"
        ],
        "netFrameworkVersion": "v10.0",
        "phpVersion": "5.6",
        "requestTracingEnabled": false,
        "remoteDebuggingEnabled": false,
        "httpLoggingEnabled": false,
        "logsDirectorySizeLimit": 35,
        "detailedErrorLoggingEnabled": false,
        "publishingUsername": "$[parameters('FunctionAppName')]__[parameters('SlotName')]",
        "azureStorageAccounts": {},
        "scmType": "None",
        "use32BitWorkerProcess": false,
        "webSocketsEnabled": false,
        "alwaysOn": true,
        "managedPipelineMode": "Integrated",
        "virtualApplications": [
          {
            "virtualPath": "/",
            "physicalPath": "site\\wwwroot",
            "preloadEnabled": true
          }
        ],
        "loadBalancing": "LeastRequests",
        "experiments": {
          "rampUpRules": []
        },
        "autoHealEnabled": false,
        "cors": {
          "allowedOrigins": [
            "https://functions.azure.com",
            "https://functions-staging.azure.com",
            "https://functions-next.azure.com"
          ],
          "supportCredentials": false
        },
        "localMySqlEnabled": false,
        "ipSecurityRestrictions": [
          {
            "ipAddress": "[parameters('IPRestriction')]",
            "action": "Allow",
            "priority": 1,
            "name": "Allow_APIM",
            "description": "Allow APIM access"
          }
        ],
        "scmIpSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictionsUseMain": false,
        "http20Enabled": false,
        "minTlsVersion": "1.2",
        "ftpsState": "AllAllowed",
        "PreWarmedInstanceCount": 0
      }
    },
    {
      "type": "Microsoft.Web/sites/slots/hostNameBindings",
      "apiVersion": "2022-03-01",
      "name": "[concat(parameters('FunctionAppName'), '/', parameters('SlotName'),'/', parameters('FunctionAppName'), '-',parameters('SlotName'),'.azurewebsites.net')]",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName'))]",
        "[variables('SiteResourceID')]"
      ],
      "properties": {
        "siteName": "[concat(parameters('FunctionAppName'),'(',parameters('SlotName'),')')]",
        "hostNameType": "Verified"
      }
    },



    {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "name": "[concat(parameters('vaultName'), '/add')]",
      "apiVersion": "2019-09-01",
      "properties": {
        "accessPolicies": [
          {
            "tenantId": "[reference(concat('Microsoft.Web/sites/', parameters('FunctionAppName')), '2018-02-01','Full').identity.tenantId]",
            "objectId": "[reference(concat('Microsoft.Web/sites/', parameters('FunctionAppName')), '2018-02-01','Full').identity.principalId]",
            "permissions": {
              "keys": [ "Get", "List" ],
              "secrets": [ "Get", "List" ],
              "certificates": [ "Get", "List" ],
              "storage": [ "all" ]
            }
          }
        ]
      }
    }
  ]
}
