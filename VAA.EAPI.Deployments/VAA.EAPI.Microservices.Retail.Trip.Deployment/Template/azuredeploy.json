{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "DataDog": {
      "type": "secureObject",
      "defaultValue": {
        "LoggingProvider": "AppInsights",
        "LogsEndpoint": "https://http-intake.logs.datadoghq.com/api/v2/logs",
        "ApiKey": "",
        "Site": "datadoghq.com",
        "Environment": "",
        "Source": "csharp",
        "Version": "",
        "TraceEnabled": true,
        "RuntimeMetricsEnabled": true,
        "Tags": "",
        "BaggageAllowList": "",
        "MinimumLogLevel": "Information",
        "QueueCapacity": 5000,
        "BatchSize": 100,
        "FlushIntervalMilliseconds": 2000
      }
    },
    "EnvironmentName": {
      "type": "string"
    },
    "FunctionAppName": {
      "type": "string"
    },
    "ServerFarmIdRg": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "AppInsightsName": {
      "type": "string"
    },
    "workspacename": {
      "type": "string"
    },
    "WEBSITE_RUN_FROM_PACKAGE": {
      "type": "string"
    },
    "storageAccountName": {
      "type": "string"
    },
    "vaultName": {
      "type": "string"
    },
    "WEBSITE_LOAD_USER_PROFILE": {
      "type": "string"
    },
    "ResourceGroupSubscriptionId": {
      "type": "string"
    },
    "AlwaysOn": {
      "type": "bool"
    },
    "AzureWebJobsSecretStorageType": {
      "type": "string"
    },
    "FUNCTIONS_EXTENSION_VERSION": {
      "type": "string"
    },
    "FUNCTIONS_WORKER_RUNTIME": {
      "type": "string"
    },
    "KeyVaultUri": {
      "type": "string"
    },
    "Appsetting:WEBSITE_VNET_ROUTE_ALL": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_ALT_SERVER": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_SERVER": {
      "type": "string"
    },
    "IPRestriction": {
      "type": "string"
    },
    "SlotName": {
      "type": "string"
    },
    "actionGroupsServiceNow": {
      "type": "string"
    },
    "actionGroupsEAPISupport": {
      "type": "string"
    },
    "emailAddressServiceNow": {
      "type": "string"
    },
    "emailAddressEAPISupport": {
      "type": "string"
    },
    "Tags": {
      "type": "Object"
    },
    //TRIP MS Settings
    "Appsetting:x-air4_mytrips_test": {
      "type": "string"
    },
    "Appsetting:DlMyTripsUri": {
      "type": "string"
    },
    "Appsetting:DlMessageCentreUri": {
      "type": "string"
    },
    "Appsetting:DlPassengerInfoUri": {
      "type": "string"
    },
    "Appsetting:DlUpsellOfffersUri": {
      "type": "string"
    },
    "Appsetting:BookingIdJwtKey": {
      "type": "string"
    },
    "Appsetting:DeltaClientIdValue": {
      "type": "string"
    },
    "Appsetting:DeltaClientSecret": {
      "type": "string"
    },
    "Appsetting:DeltaAir4TokenEndpoint": {
      "type": "string"
    },
    "Appsetting:DlMyTripsPrivateUri": {
      "type": "string"
    },
    "Appsetting:SwitchToPrivateEndpoints": {
      "type": "bool"
    },
    "Appsetting:DlMessageCentrePrivateUri": {
      "type": "string"
    },
    "Appsetting:DlUpsellOfffersPrivateUri": {
      "type": "string"
    },
    "Appsetting:DlPassengerInfoPrivateUri": {
      "type": "string"
    },
    "Appsetting:TravelInsuranceDeeplinkUrl_GB": {
      "type": "string"
    },
    "Appsetting:TravelInsuranceDeeplinkUrl_US": {
      "type": "string"
    },
    "Appsetting:ManageMyBookingUrl": {
      "type": "string"
    },
    "Appsetting:ManageMyHolidayUrl": {
      "type": "string"
    },
    "Appsetting:IROP_FAFURL": {
      "type": "string"
    },
    "Appsetting:ProxyDeeplinkURL": {
      "type": "string"
    },
    "Appsetting:RedisConnectionString": {
      "type": "string"
    },
    "Appsetting:DeeplinkExpiryLimitInMinutes": {
      "type": "string"
    },
    "Appsetting:POPSMealUrl": {
      "type": "string"
    },
    "Appsetting:POPSTokenKey": {
      "type": "string"
    },
    "Appsetting:DlEncryptionServiceUri": {
      "type": "string"
    },
    "Appsetting:DlEncryptionServicePrivateUri": {
      "type": "string"
    },
    "Appsetting:FlightCancelUrl": {
      "type": "string"
    },
    "Appsetting:PlusGradeApiKey": {
      "type": "string"
    },
    "Appsetting:PlusGradeApiUri": {
      "type": "string"
    },
    "Appsetting:PlusGradePartnerId": {
      "type": "string"
    },
    "Appsetting:FlightDisruptionUrl": {
      "type": "string"
    },
    "Appsetting:BaggageAllowanceUrl": {
      "type": "string"
    },
    // Swagger / OpenApi
    "Appsetting:OpenApi__Scope": {
      "type": "string"
    },
    "Appsetting:OpenApi__TokenUrl": {
      "type": "string"
    },
    "Appsetting:OpenApi__DocTitle": {
      "type": "string"
    },
    "Appsetting:OpenApi__Description": {
      "type": "string"
    },
    "Appsetting:OpenApi__DocVersion": {
      "type": "string"
    },
    "Appsetting:OpenApi__HostNames": {
      "type": "string"
    },
    "Appsetting:OpenApi__Version": {
      "type": "string"
    },
    "Appsetting:OpenApi__ForceHttps": {
      "type": "string"
    },
    "Appsetting:OpenApi__ForceHttp": {
      "type": "string"
    }

  },
  "variables": {
    "ResourceLocation": "[resourceGroup().location]",
    "SiteResourceID": "[resourceId('Microsoft.Web/Sites', parameters('FunctionAppName'))]",
    "ActiveStatus": "[if(equals(parameters('EnvironmentName'),'PROD'),'PROD','NONPROD')]"

  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2021-09-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[variables('ResourceLocation')]",
      "tags": "[parameters('Tags')]",
      "sku": {
        "name": "Standard_RAGRS",
        "tier": "Standard"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2021-06-01",
      "name": "[parameters('workspacename')]",
      "location": "[variables('ResourceLocation')]",
      "properties": {}
    },
    {
      "type": "Microsoft.Insights/components",
      "kind": "web",
      "apiVersion": "2020-02-02",
      "name": "[parameters('AppInsightsName')]",
      "location": "[Variables('ResourceLocation')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspacename'))]"
      ],
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "kind": "functionapp",
      "name": "[parameters('FunctionAppName')]",
      "apiVersion": "2021-03-01",
      "location": "[variables('ResourceLocation')]",
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },
      "properties": {
        "enabled": true,
        "hostNameSslStates": [
          {
            "name": "[concat(parameters('FunctionAppName'), '.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Standard"
          },
          {
            "name": "[concat(parameters('FunctionAppName'), '.scm.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Repository"
          }
        ],
        "serverFarmId": "[resourceId('Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "alwaysOn": true,
          "appSettings": [
            {
              "name": "LoggingProvider",
              "value": "[parameters('DataDog').LoggingProvider]"
            },
            {
              "name": "DatadogLogsEndpoint",
              "value": "[parameters('DataDog').LogsEndpoint]"
            },
            {
              "name": "DatadogApiKey",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_API_KEY",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_SITE",
              "value": "[parameters('DataDog').Site]"
            },
            {
              "name": "DD_SERVICE",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "DD_ENV",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DD_VERSION",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DD_TRACE_ENABLED",
              "value": "[string(parameters('DataDog').TraceEnabled)]"
            },
            {
              "name": "DD_RUNTIME_METRICS_ENABLED",
              "value": "[string(parameters('DataDog').RuntimeMetricsEnabled)]"
            },
            {
              "name": "DatadogService",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "environment",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DatadogSource",
              "value": "[parameters('DataDog').Source]"
            },
            {
              "name": "DatadogVersion",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DatadogTags",
              "value": "[concat(parameters('DataDog').Tags, if(empty(parameters('DataDog').Tags), '', ','), 'cloud_provider:azure,subscription_id:', subscription().subscriptionId, ',resource_group:', resourceGroup().name, ',name:', parameters('FunctionAppName'), ',type:microsoft.web/sites,resource_id:', resourceId('Microsoft.Web/sites', parameters('FunctionAppName')))]"
            },
            {
              "name": "DatadogBaggageAllowList",
              "value": "[parameters('DataDog').BaggageAllowList]"
            },
            {
              "name": "DatadogMinimumLogLevel",
              "value": "[parameters('DataDog').MinimumLogLevel]"
            },
            {
              "name": "DatadogQueueCapacity",
              "value": "[string(parameters('DataDog').QueueCapacity)]"
            },
            {
              "name": "DatadogBatchSize",
              "value": "[string(parameters('DataDog').BatchSize)]"
            },
            {
              "name": "DatadogFlushIntervalMilliseconds",
              "value": "[string(parameters('DataDog').FlushIntervalMilliseconds)]"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[reference(resourceId('Microsoft.Insights/components', parameters('AppInsightsName')), '2014-04-01').InstrumentationKey]"
            },

            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', parameters('AppInsightsName')), '2020-02-02').ConnectionString]"
            },
            {
              "name": "AzureWebJobsSecretStorageType",
              "value": "[parameters('AzureWebJobsSecretStorageType')]"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageAccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]"
            },
            {
              "name": "WEBSITE_LOAD_USER_PROFILE",
              "value": "[parameters('WEBSITE_LOAD_USER_PROFILE')]"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "[parameters('WEBSITE_RUN_FROM_PACKAGE')]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "[parameters('FUNCTIONS_EXTENSION_VERSION')]"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "[parameters('FUNCTIONS_WORKER_RUNTIME')]"
            },
            {
              "name": "KeyVaultUri",
              "value": "[parameters('KeyVaultUri')]"
            },
            {
              "name": "WEBSITE_VNET_ROUTE_ALL",
              "value": "[parameters('Appsetting:WEBSITE_VNET_ROUTE_ALL')]"
            },
            {
              "name": "WEBSITE_DNS_ALT_SERVER",
              "value": "[parameters('Appsetting:WEBSITE_DNS_ALT_SERVER')]"
            },
            {
              "name": "WEBSITE_DNS_SERVER",
              "value": "[parameters('Appsetting:WEBSITE_DNS_SERVER')]"
            },
            {
              "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageAccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]"
            },
            //TRIP MS Settings
            {
              "name": "x-air4_mytrips_test",
              "value": "[parameters('Appsetting:x-air4_mytrips_test')]"
            },
            {
              "name": "DlMyTripsUri",
              "value": "[parameters('Appsetting:DlMyTripsUri')]"
            },
            {
              "name": "DlMessageCentreUri",
              "value": "[parameters('Appsetting:DlMessageCentreUri')]"
            },
            {
              "name": "DlPassengerInfoUri",
              "value": "[parameters('Appsetting:DlPassengerInfoUri')]"
            },
            {
              "name": "DlUpsellOfffersUri",
              "value": "[parameters('Appsetting:DlUpsellOfffersUri')]"
            },
            {
              "name": "BookingIdJwtKey",
              "value": "[parameters('Appsetting:BookingIdJwtKey')]"
            },
            {
              "name": "DeltaClientIdValue",
              "value": "[parameters('Appsetting:DeltaClientIdValue')]"
            },
            {
              "name": "DeltaClientSecret",
              "value": "[parameters('Appsetting:DeltaClientSecret')]"
            },
            {
              "name": "DeltaAir4TokenEndpoint",
              "value": "[parameters('Appsetting:DeltaAir4TokenEndpoint')]"
            },
            {
              "name": "DlMyTripsPrivateUri",
              "value": "[parameters('Appsetting:DlMyTripsPrivateUri')]"
            },
            {
              "name": "SwitchToPrivateEndpoints",
              "value": "[parameters('Appsetting:SwitchToPrivateEndpoints')]"
            },
            {
              "name": "DlMessageCentrePrivateUri",
              "value": "[parameters('Appsetting:DlMessageCentrePrivateUri')]"
            },
            {
              "name": "DlUpsellOfffersPrivateUri",
              "value": "[parameters('Appsetting:DlUpsellOfffersPrivateUri')]"
            },
            {
              "name": "DlPassengerInfoPrivateUri",
              "value": "[parameters('Appsetting:DlPassengerInfoPrivateUri')]"
            },
            {
              "name": "TravelInsuranceDeeplinkUrl_GB",
              "value": "[parameters('Appsetting:TravelInsuranceDeeplinkUrl_GB')]"
            },
            {
              "name": "TravelInsuranceDeeplinkUrl_US",
              "value": "[parameters('Appsetting:TravelInsuranceDeeplinkUrl_US')]"
            },
            {
              "name": "ManageMyBookingUrl",
              "value": "[parameters('Appsetting:ManageMyBookingUrl')]"
            },
            {
              "name": "ManageMyHolidayUrl",
              "value": "[parameters('Appsetting:ManageMyHolidayUrl')]"
            },
            {
              "name": "IROP_FAFURL",
              "value": "[parameters('Appsetting:IROP_FAFURL')]"
            },
            {
              "name": "ProxyDeeplinkURL",
              "value": "[parameters('Appsetting:ProxyDeeplinkURL')]"
            },
            {
              "name": "RedisConnectionString",
              "value": "[parameters('Appsetting:RedisConnectionString')]"
            },
            {
              "name": "DeeplinkExpiryLimitInMinutes",
              "value": "[parameters('Appsetting:DeeplinkExpiryLimitInMinutes')]"
            },
            {
              "name": "POPSMealUrl",
              "value": "[parameters('Appsetting:POPSMealUrl')]"
            },
            {
              "name": "POPSTokenKey",
              "value": "[parameters('Appsetting:POPSTokenKey')]"
            },
            {
              "name": "DlEncryptionServiceUri",
              "value": "[parameters('Appsetting:DlEncryptionServiceUri')]"
            },
            {
              "name": "DlEncryptionServicePrivateUri",
              "value": "[parameters('Appsetting:DlEncryptionServicePrivateUri')]"
            },
            {
              "name": "FlightCancelUrl",
              "value": "[parameters('Appsetting:FlightCancelUrl')]"
            },
            {
              "name": "PlusGradeApiUri",
              "value": "[parameters('Appsetting:PlusGradeApiUri')]"
            },
            {
              "name": "PlusGradeApiKey",
              "value": "[parameters('Appsetting:PlusGradeApiKey')]"
            },
            {
              "name": "PlusGradePartnerId",
              "value": "[parameters('Appsetting:PlusGradePartnerId')]"
            },
            {
              "name": "FlightDisruptionUrl",
              "value": "[parameters('Appsetting:FlightDisruptionUrl')]"
            },
            {
              "name": "BaggageAllowanceUrl",
              "value": "[parameters('Appsetting:BaggageAllowanceUrl')]"
            },
            //swagger settings
            {
              "name": "OpenApi__Scope",
              "value": "[parameters('Appsetting:OpenApi__Scope')]"
            },
            {
              "name": "OpenApi__TokenUrl",
              "value": "[parameters('Appsetting:OpenApi__TokenUrl')]"
            },
            {
              "name": "OpenApi__DocTitle",
              "value": "[parameters('Appsetting:OpenApi__DocTitle')]"
            },
            {
              "name": "OpenApi__Description",
              "value": "[parameters('Appsetting:OpenApi__Description')]"
            },
            {
              "name": "OpenApi__DocVersion",
              "value": "[parameters('Appsetting:OpenApi__DocVersion')]"
            },
            {
              "name": "OpenApi__Version",
              "value": "[parameters('Appsetting:OpenApi__Version')]"
            },
            {
              "name": "OpenApi__ForceHttps",
              "value": "[parameters('Appsetting:OpenApi__ForceHttps')]"
            },
            {
              "name": "OpenApi__ForceHttp",
              "value": "[parameters('Appsetting:OpenApi__ForceHttp')]"
            }
          ]
        },
        "scmSiteAlsoStopped": false,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNamesDisabled": false,
        "containerSize": 1536,
        "dailyMemoryTimeQuota": 0,
        "httpsOnly": true,
        "redundancyMode": "None"
      },
      "tags": "[parameters('Tags')]"
    },
    {
      "type": "Microsoft.Web/sites/config",
      "name": "[concat(parameters('FunctionAppName'), '/web')]",
      "apiVersion": "2021-03-01",
      "location": "North Europe",
      "dependsOn": [ "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]" ],
      "properties": {
        "numberOfWorkers": 1,
        "defaultDocuments": [
          "Default.htm",
          "Default.html",
          "Default.asp",
          "index.htm",
          "index.html",
          "iisstart.htm",
          "default.aspx",
          "index.php"
        ],
        "netFrameworkVersion": "v10.0",
        "phpVersion": "5.6",
        "requestTracingEnabled": false,
        "remoteDebuggingEnabled": false,
        "httpLoggingEnabled": false,
        "logsDirectorySizeLimit": 35,
        "detailedErrorLoggingEnabled": false,
        "publishingUsername": "$[parameters('FunctionAppName')]",
        "azureStorageAccounts": {},
        "scmType": "None",
        "use32BitWorkerProcess": false,
        "webSocketsEnabled": false,
        "alwaysOn": true,
        "managedPipelineMode": "Integrated",
        "virtualApplications": [
          {
            "virtualPath": "/",
            "physicalPath": "site\\wwwroot",
            "preloadEnabled": true
          }
        ],
        "loadBalancing": "LeastRequests",
        "experiments": {
          "rampUpRules": []
        },
        "autoHealEnabled": false,
        "cors": {
          "allowedOrigins": [
            "https://functions.azure.com",
            "https://functions-staging.azure.com",
            "https://functions-next.azure.com"
          ],
          "supportCredentials": false
        },
        "localMySqlEnabled": false,
        "ipSecurityRestrictions": [
          {
            "ipAddress": "[parameters('IPRestriction')]",
            "action": "Allow",
            "priority": 1,
            "name": "Allow_APIM",
            "description": "Allow APIM access"
          }
        ],
        "scmIpSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictionsUseMain": false,
        "http20Enabled": false,
        "minTlsVersion": "1.2",
        "ftpsState": "AllAllowed",
        "PreWarmedInstanceCount": 0
      }
    },
    {
      "type": "Microsoft.Web/sites/hostNameBindings",
      "apiVersion": "2021-03-01",
      "name": "[concat(parameters('FunctionAppName'), '/', parameters('FunctionAppName'), '.azurewebsites.net')]",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [ "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]" ],
      "properties": {
        "siteName": "[parameters('FunctionAppName')]",
        "hostNameType": "Verified"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "name": "[concat(parameters('vaultName'), '/add')]",
      "apiVersion": "2019-09-01",
      "properties": {
        "accessPolicies": [
          {
            "tenantId": "[reference(concat('Microsoft.Web/sites/', parameters('FunctionAppName')), '2018-02-01','Full').identity.tenantId]",
            "objectId": "[reference(concat('Microsoft.Web/sites/', parameters('FunctionAppName')), '2018-02-01','Full').identity.principalId]",
            "permissions": {
              "keys": [ "Get", "List" ],
              "secrets": [ "Get", "List" ],
              "certificates": [ "Get", "List" ],
              "storage": [ "all" ]
            }
          }
        ]
      }
    }
  ]
}
