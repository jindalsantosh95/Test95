{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "DataDog": {
      "type": "secureObject",
      "defaultValue": {
        "LoggingProvider": "AppInsights",
        "LogsEndpoint": "https://http-intake.logs.datadoghq.com/api/v2/logs",
        "ApiKey": "",
        "Site": "datadoghq.com",
        "Environment": "",
        "Source": "csharp",
        "Version": "",
        "TraceEnabled": true,
        "RuntimeMetricsEnabled": true,
        "Tags": "",
        "BaggageAllowList": "",
        "MinimumLogLevel": "Information",
        "QueueCapacity": 5000,
        "BatchSize": 100,
        "FlushIntervalMilliseconds": 2000
      }
    },
    "Appsetting:AzureAd:ClientId": {
      "type": "string"
    },
    "Appsetting:AzureAd:Instance": {
      "type": "string"
    },
    "Appsetting:AzureAd:TenantId": {
      "type": "string"
    },
    "Appsetting:AzureAd:TokenV1Issuer": {
      "type": "string"
    },

    // ATPCO
    "Appsetting:ATPCO:TokenUrl": {
      "type": "string"
    },
    "Appsetting:ATPCO:ClientId": {
      "type": "string"
    },
    "Appsetting:ATPCO:ClientSecret": {
      "type": "string"
    },
    "Appsetting:ATPCO:Url": {
      "type": "string"
    },
    "Appsetting:ATPCO:APIKey": {
      "type": "string"
    },

    // Swagger / OpenApi
    "Appsetting:OpenApi__Scope": {
      "type": "string"
    },
    "Appsetting:OpenApi__TokenUrl": {
      "type": "string"
    },
    "Appsetting:OpenApi__DocTitle": {
      "type": "string"
    },
    "Appsetting:OpenApi__Description": {
      "type": "string"
    },
    "Appsetting:OpenApi__DocVersion": {
      "type": "string"
    },
    "Appsetting:OpenApi__HostNames": {
      "type": "string"
    },
    "Appsetting:OpenApi__Version": {
      "type": "string"
    },
    "Appsetting:OpenApi__ForceHttps": {
      "type": "string"
    },
    "Appsetting:OpenApi__ForceHttp": {
      "type": "string"
    },

    //********** Function Deployment Settings ***************//
    "EnvironmentName": {
      "type": "string"
    },
    "FunctionAppName": {
      "type": "string"
    },
    "ServerFarmIdRg": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "Appsetting:APPLICATIONINSIGHTS_CONNECTION_STRING": {
      "type": "string"
    },
    "AppInsightsName": {
      "type": "string"
    },
    "WEBSITE_RUN_FROM_PACKAGE": {
      "type": "string"
    },
    "storageAccountName": {
      "type": "string"
    },
    "vaultName": {
      "type": "string"
    },
    "WEBSITE_LOAD_USER_PROFILE": {
      "type": "string"
    },
    "APPINSIGHTS_INSTRUMENTATIONKEY": {
      "type": "string"
    },
    "ResourceGroupSubscriptionId": {
      "type": "string"
    },
    "AlwaysOn": {
      "type": "bool"
    },
    "AzureWebJobsSecretStorageType": {
      "type": "string"
    },
    "AzureWebJobsStorage": {
      "type": "string"
    },
    "FUNCTIONS_EXTENSION_VERSION": {
      "type": "string"
    },
    "FUNCTIONS_WORKER_RUNTIME": {
      "type": "string"
    },
    "KeyVaultUri": {
      "type": "string"
    },
    /*"Appsetting:WEBSITE_DNS_ALT_SERVER": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_SERVER": {
      "type": "string"
    },*/
    "IPRestriction": {
      "type": "string"
    },
    "SlotName": {
      "type": "string"
    },
    "actionGroupsServiceNow": {
      "type": "string"
    },
    "actionGroupsEAPISupport": {
      "type": "string"
    },
    "emailAddressServiceNow": {
      "type": "string"
    },
    "emailAddressEAPISupport": {
      "type": "string"
    },
    //Azure B2C settings
    "AzureAdB2C:ClientId":{
      "type": "string"
    },
    "AzureAdB2C:Instance": {
      "type": "string"
    },
    "AzureAdB2C:SignUpSignInPolicyId": {
      "type": "string"
    },
    "AzureAdB2C:TenantId": {
      "type": "string"
    },
    "AzureAdB2C:TokenV1Issuer": {
      "type": "string"
    },
    "Tags": {
      "type": "Object"
    }
  },
  "variables": {
    "ResourceLocation": "[resourceGroup().location]",
    "SiteResourceID": "[resourceId('Microsoft.Web/Sites', parameters('FunctionAppName'))]",
    "ActiveStatus": "[if(equals(parameters('EnvironmentName'),'PROD'),'PROD','NONPROD')]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2021-09-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[variables('ResourceLocation')]",
      "tags": "[parameters('Tags')]",
      "sku": {
        "name": "Standard_RAGRS",
        "tier": "Standard"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false
      }
    },
    {
      "apiVersion": "2018-11-01",
      "identity": {
        "type": "SystemAssigned"
      },
      "kind": "functionapp",
      "location": "[variables('ResourceLocation')]",
      "name": "[parameters('FunctionAppName')]",
      "properties": {
        "enabled": true,
        "serverFarmId": "[resourceId(parameters('ServerFarmIdRg'), 'Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "hostingEnvironmentProfile": "[resourceId(parameters('ServerFarmIdRg'), 'Microsoft.Web/hostingEnvironments', parameters('AppServicePlanName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "appSettings": [
            {
              "name": "LoggingProvider",
              "value": "[parameters('DataDog').LoggingProvider]"
            },
            {
              "name": "DatadogLogsEndpoint",
              "value": "[parameters('DataDog').LogsEndpoint]"
            },
            {
              "name": "DatadogApiKey",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_API_KEY",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_SITE",
              "value": "[parameters('DataDog').Site]"
            },
            {
              "name": "DD_SERVICE",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "DD_ENV",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DD_VERSION",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DD_TRACE_ENABLED",
              "value": "[string(parameters('DataDog').TraceEnabled)]"
            },
            {
              "name": "DD_RUNTIME_METRICS_ENABLED",
              "value": "[string(parameters('DataDog').RuntimeMetricsEnabled)]"
            },
            {
              "name": "DatadogService",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "environment",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DatadogSource",
              "value": "[parameters('DataDog').Source]"
            },
            {
              "name": "DatadogVersion",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DatadogTags",
              "value": "[concat(parameters('DataDog').Tags, if(empty(parameters('DataDog').Tags), '', ','), 'cloud_provider:azure,subscription_id:', subscription().subscriptionId, ',resource_group:', resourceGroup().name, ',name:', parameters('FunctionAppName'), ',type:microsoft.web/sites,resource_id:', resourceId('Microsoft.Web/sites', parameters('FunctionAppName')))]"
            },
            {
              "name": "DatadogBaggageAllowList",
              "value": "[parameters('DataDog').BaggageAllowList]"
            },
            {
              "name": "DatadogMinimumLogLevel",
              "value": "[parameters('DataDog').MinimumLogLevel]"
            },
            {
              "name": "DatadogQueueCapacity",
              "value": "[string(parameters('DataDog').QueueCapacity)]"
            },
            {
              "name": "DatadogBatchSize",
              "value": "[string(parameters('DataDog').BatchSize)]"
            },
            {
              "name": "DatadogFlushIntervalMilliseconds",
              "value": "[string(parameters('DataDog').FlushIntervalMilliseconds)]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', parameters('storageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value)]"
            }

          ]
        },
        "scmSiteAlsoStopped": false,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNamesDisabled": false,
        "containerSize": 1536,
        "dailyMemoryTimeQuota": 0,
        "httpsOnly": true,
        "redundancyMode": "None"
      },
      "tags": "[parameters('tags')]",
      "type": "Microsoft.Web/sites"
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2018-11-01",
      "name": "[concat(parameters('FunctionAppName'), '/web')]",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]"
      ],
      "properties": {
        "numberOfWorkers": 1,
        "defaultDocuments": [
          "Default.htm",
          "Default.html",
          "Default.asp",
          "index.htm",
          "index.html",
          "iisstart.htm",
          "default.aspx",
          "index.php"
        ],
        "netFrameworkVersion": "v10.0",
        "phpVersion": "5.6",
        "requestTracingEnabled": false,
        "remoteDebuggingEnabled": false,
        "httpLoggingEnabled": false,
        "logsDirectorySizeLimit": 35,
        "detailedErrorLoggingEnabled": false,
        "publishingUsername": "$[parameters('appName')]",
        "azureStorageAccounts": {},
        "scmType": "None",
        "use32BitWorkerProcess": true,
        "webSocketsEnabled": false,
        "alwaysOn": true,
        "managedPipelineMode": "Integrated",
        "virtualApplications": [
          {
            "virtualPath": "/",
            "physicalPath": "site\\wwwroot",
            "preloadEnabled": false
          }
        ],
        "loadBalancing": "LeastRequests",
        "experiments": {
          "rampUpRules": []
        },
        "autoHealEnabled": false,
        "cors": {
          "allowedOrigins": [
            "https://functions.azure.com",
            "https://functions-staging.azure.com",
            "https://functions-next.azure.com"
          ],
          "supportCredentials": false
        },
        "localMySqlEnabled": false,
        "ipSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictionsUseMain": false,
        "http20Enabled": false,
        "minTlsVersion": "1.2",
        "ftpsState": "FtpsOnly",
        "reservedInstanceCount": 0
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2021-03-01",
      "name": "[concat(parameters('FunctionAppName'),'/','appsettings')]",
      "kind": "functionapp,workflowapp",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/accessPolicies', parameters('vaultName'),'add')]"
      ],
      "properties": {
        /*App Settings */
        "WEBSITE_CONTENTOVERVNET": "1",
        "WEBSITE_VNET_ROUTE_ALL": "1",
        "APPINSIGHTS_INSTRUMENTATIONKEY": "[parameters('APPINSIGHTS_INSTRUMENTATIONKEY')]",
        "APPLICATIONINSIGHTS_CONNECTION_STRING": "[parameters('Appsetting:APPLICATIONINSIGHTS_CONNECTION_STRING')]",
        "AzureWebJobsSecretStorageType": "[parameters('AzureWebJobsSecretStorageType')]",
        "WEBSITE_LOAD_USER_PROFILE": "[parameters('WEBSITE_LOAD_USER_PROFILE')]",
        "WEBSITE_RUN_FROM_PACKAGE": "[parameters('WEBSITE_RUN_FROM_PACKAGE')]",
        "FUNCTIONS_EXTENSION_VERSION": "[parameters('FUNCTIONS_EXTENSION_VERSION')]",
        "FUNCTIONS_WORKER_RUNTIME": "[parameters('FUNCTIONS_WORKER_RUNTIME')]",
        "KeyVaultUri": "[parameters('KeyVaultUri')]",
        "AzureAd:ClientId": "[parameters('Appsetting:AzureAd:ClientId')]",
        "AzureAd:Instance": "[parameters('Appsetting:AzureAd:Instance')]",
        "AzureAd:TenantId": "[parameters('Appsetting:AzureAd:TenantId')]",
        "zureAd:TokenV1Issuer": "[parameters('Appsetting:AzureAd:TokenV1Issuer')]",
        "ATPCO:TokenUrl": "[parameters('Appsetting:ATPCO:TokenUrl')]",
        "ATPCO:ClientSecret": "[parameters('Appsetting:ATPCO:ClientSecret')]",
        "ATPCO:Url": "[parameters('Appsetting:ATPCO:Url')]",
        "ATPCO:APIKey": "[parameters('Appsetting:ATPCO:APIKey')]",

        //swagger settings

        "OpenApi__Scope": "[parameters('Appsetting:OpenApi__Scope')]",
        "OpenApi__TokenUrl": "[parameters('Appsetting:OpenApi__TokenUrl')]",
        "OpenApi__DocTitle": "[parameters('Appsetting:OpenApi__DocTitle')]",
        "OpenApi__Description": "[parameters('Appsetting:OpenApi__Description')]",
        "OpenApi__DocVersion": "[parameters('Appsetting:OpenApi__DocVersion')]",
        "OpenApi__Version": "[parameters('Appsetting:OpenApi__Version')]",
        "OpenApi__ForceHttps": "[parameters('Appsetting:OpenApi__ForceHttps')]",
        "OpenApi__ForceHttp": "[parameters('Appsetting:OpenApi__ForceHttp')]",

        //Azure B2C Settings

        "AzureAdB2C:ClientId": "[parameters('AzureAdB2C:ClientId')]",
        "AzureAdB2C:Instance": "[parameters('AzureAdB2C:Instance')]",
        "AzureAdB2C:SignUpSignInPolicyId": "[parameters('AzureAdB2C:SignUpSignInPolicyId')]",
        "AzureAdB2C:TenantId": "[parameters('AzureAdB2C:TenantId')]",
        "AzureAdB2C:TokenV1Issuer": "[parameters('AzureAdB2C:TokenV1Issuer')]"
      }
    },
    {
      "type": "Microsoft.Web/sites/hostNameBindings",
      "apiVersion": "2021-03-01",
      "name": "[concat(parameters('FunctionAppName'), '/', parameters('FunctionAppName'), '.azurewebsites.net')]",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [ "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]" ],
      "properties": {
        "siteName": "[parameters('FunctionAppName')]",
        "hostNameType": "Verified"
      }
    },
    {
      "type": "microsoft.insights/components",
      "kind": "web",
      "name": "[parameters('AppInsightsName')]",
      "apiVersion": "2020-02-02",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [ "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]" ],
      "tags": "[parameters('Tags')]",
      "properties": {
        "applicationId": "[variables('SiteResourceID')]",
        "Application_Type": "web"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "name": "[concat(parameters('vaultName'), '/add')]",
      "apiVersion": "2019-09-01",
      "properties": {
        "accessPolicies": [
          {
            "tenantId": "[reference(concat('Microsoft.Web/sites/', parameters('FunctionAppName')), '2018-02-01','Full').identity.tenantId]",
            "objectId": "[reference(concat('Microsoft.Web/sites/', parameters('FunctionAppName')), '2018-02-01','Full').identity.principalId]",
            "permissions": {
              "keys": [ "Get", "List" ],
              "secrets": [ "Get", "List" ],
              "certificates": [ "Get", "List" ],
              "storage": [ "all" ]
            }
          }
        ]
      }
    }
  ]
}
