{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "DataDog": {
      "type": "secureObject",
      "defaultValue": {
        "LoggingProvider": "AppInsights",
        "LogsEndpoint": "https://http-intake.logs.datadoghq.com/api/v2/logs",
        "ApiKey": "",
        "Site": "datadoghq.com",
        "Environment": "",
        "Source": "csharp",
        "Version": "",
        "TraceEnabled": true,
        "RuntimeMetricsEnabled": true,
        "Tags": "",
        "BaggageAllowList": "",
        "MinimumLogLevel": "Information",
        "QueueCapacity": 5000,
        "BatchSize": 100,
        "FlushIntervalMilliseconds": 2000
      }
    },
    "FunctionAppName": {
      "type": "string"
    },
    "ServerFarmIdRg": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "AppInsightsName": {
      "type": "string"
    },
    "storageAccountName": {
      "type": "string"
    },
    "APPINSIGHTS_INSTRUMENTATIONKEY": {
      "type": "string"
    },
    "ResourceGroupSubscriptionId": {
      "type": "string"
    },
    "AlwaysOn": {
      "type": "bool"
    },
    "AzureWebJobsSecretStorageType": {
      "type": "string"
    },
    "AzureWebJobsStorage": {
      "type": "string"
    },
    "FUNCTIONS_EXTENSION_VERSION": {
      "type": "string"
    },
    "FUNCTIONS_WORKER_RUNTIME": {
      "type": "string"
    },
    "KeyVaultUri": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_ALT_SERVER": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_SERVER": {
      "type": "string"
    },
    "IPRestriction": {
      "type": "string"
    },
    "WEBSITE_CONTENTSHARE": {
      "type": "string"
    },
    "WEBSITE_RUN_FROM_PACKAGE": {
      "type": "string"
    },
    "WEBSITE_LOAD_USER_PROFILE": {
      "type": "string"
    },
    "SlotName": {
      "type": "string"
    },
    "OpenApi__DocTitle": {
        "type": "string"
    },
    "OpenApi__Description": {
        "type": "string"
    },
    "OpenApi__HostNames": {
        "type": "string"
    },
    "OpenApi__DocVersion": {
        "type": "string"
    },
    "OpenApi__Version": {
        "type": "string"
    },
    "OpenApi__TokenUrl": {
        "type": "string"
    },
    "OpenApi__Scope": {
        "type": "string"
    },
    "OpenApi__ForceHttps": {
        "type": "bool"
    },
    "OpenApi__ForceHttp": {
        "type": "bool"
    },
    "CRMPaymentEventHandlerTopicName": {
        "type": "string"
    },
    "CRMPaymentEventSubscriptionName": {
        "type": "string"
    },
    "ServiceBusConnectionString": {
        "type": "string"
    },
    "AzureAd:Instance": {
        "type": "string"
    },
    "AzureAd:TenantId": {
        "type": "string"
    },
    "AzureAd:TokenV1Issuer": {
        "type": "string"
    },
    "CRMWebApi:Endpoint": {
        "type": "string"
    },
    "CRMWebApi:PaymentFilterParams": {
        "type": "string"
    },
    "CRMWebApi:CallCRMAPIMUrl": {
        "type": "string"
    },
    "CRMWebApi:CountryFilterParams": {
        "type": "string"
    },
    "CRMWebApi:Version": {
        "type": "string"
    },
    "AzureAd:ClientId": {
        "type": "string"
    },
    "AzureAd:ClientSecret": {
        "type": "string"
    },
    "MicroServiceDBKey": {
        "type": "string"
    },
    "MicroServiceEventStoreTableName": {
        "type": "string"
    },
    "MicroServiceResponseTableName": {
        "type": "string"
    },
    "AppSetting:CRMWebApi:GetEndpointAPIM": {
        "type": "string"
    },
    "AppSetting:CRMWebApi:PatchEndpointAPIM": {
        "type": "string"
    },
    "AppSetting:CRMWebApi:OcpSubKey": {
        "type": "string"
    },
    "AppSetting:ResponsePollingCount": {
        "type": "string"
    },
    "AppSetting:ResponseDelayTimeInMS": {
        "type": "string"
    },
    "AppSetting:CRMWebApi:PaymentUpdateResponseUrl": {
        "type": "string"
    },
    "AppSetting:CRMWebApi:ResponsiveFeature": {
        "type": "bool"
    },
    "actionGroupsServiceNow": {
        "type": "string"
    },
    "actionGroupsEAPISupport": {
        "type": "string"
    },
    "emailAddressServiceNow": {
        "type": "string"
    },
    "emailAddressEAPISupport": {
        "type": "string"
    },
    //Azure B2C settings
    "AzureAdB2C:ClientId":{
      "type": "string"
    },
    "AzureAdB2C:Instance": {
      "type": "string"
    },
    "AzureAdB2C:SignUpSignInPolicyId": {
      "type": "string"
    },
    "AzureAdB2C:TenantId": {
      "type": "string"
    },
    "AzureAdB2C:TokenV1Issuer": {
      "type": "string"
    },
    "Tags": {
      "type": "Object"
    }
  },
  "variables": {
    "ResourceLocation": "[resourceGroup().location]",
    "SiteResourceID": "[resourceId('Microsoft.Web/Sites', parameters('FunctionAppName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/sites",
      "kind": "functionapp",
      "name": "[parameters('FunctionAppName')]",
      "apiVersion": "2021-03-01",
      "location": "[variables('ResourceLocation')]",
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]"
      },
      "tags": "[parameters('Tags')]"
    },
    {
      "type": "Microsoft.Web/sites/slots",
      "kind": "functionapp",
      "name": "[concat(parameters('FunctionAppName'), '/',parameters('SlotName'))]",
      "apiVersion": "2021-03-01",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [ "[variables('SiteResourceID')]" ],
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },
      "properties": {
        "enabled": true,
        "hostNameSslStates": [
          {
            "name": "[concat(parameters('FunctionAppName'), '-',parameters('SlotName'), '.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Standard"
          },
          {
            "name": "[concat(parameters('FunctionAppName'), '-',parameters('SlotName'), '.scm.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Repository"
          }
        ],
        "serverFarmId": "[resourceId('Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "alwaysOn": true,
          "appSettings": [
            {
              "name": "LoggingProvider",
              "value": "[parameters('DataDog').LoggingProvider]"
            },
            {
              "name": "DatadogLogsEndpoint",
              "value": "[parameters('DataDog').LogsEndpoint]"
            },
            {
              "name": "DatadogApiKey",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_API_KEY",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_SITE",
              "value": "[parameters('DataDog').Site]"
            },
            {
              "name": "DD_SERVICE",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "DD_ENV",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DD_VERSION",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DD_TRACE_ENABLED",
              "value": "[string(parameters('DataDog').TraceEnabled)]"
            },
            {
              "name": "DD_RUNTIME_METRICS_ENABLED",
              "value": "[string(parameters('DataDog').RuntimeMetricsEnabled)]"
            },
            {
              "name": "DatadogService",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "environment",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DatadogSource",
              "value": "[parameters('DataDog').Source]"
            },
            {
              "name": "DatadogVersion",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DatadogTags",
              "value": "[concat(parameters('DataDog').Tags, if(empty(parameters('DataDog').Tags), '', ','), 'cloud_provider:azure,subscription_id:', subscription().subscriptionId, ',resource_group:', resourceGroup().name, ',name:', parameters('FunctionAppName'), '/', parameters('SlotName'), ',type:microsoft.web/sites/slots,resource_id:', resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName')))]"
            },
            {
              "name": "DatadogBaggageAllowList",
              "value": "[parameters('DataDog').BaggageAllowList]"
            },
            {
              "name": "DatadogMinimumLogLevel",
              "value": "[parameters('DataDog').MinimumLogLevel]"
            },
            {
              "name": "DatadogQueueCapacity",
              "value": "[string(parameters('DataDog').QueueCapacity)]"
            },
            {
              "name": "DatadogBatchSize",
              "value": "[string(parameters('DataDog').BatchSize)]"
            },
            {
              "name": "DatadogFlushIntervalMilliseconds",
              "value": "[string(parameters('DataDog').FlushIntervalMilliseconds)]"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[parameters('APPINSIGHTS_INSTRUMENTATIONKEY')]"
            },
            {
              "name": "AzureWebJobsSecretStorageType",
              "value": "[parameters('AzureWebJobsSecretStorageType')]"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[parameters('AzureWebJobsStorage')]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "[parameters('FUNCTIONS_EXTENSION_VERSION')]"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "[parameters('FUNCTIONS_WORKER_RUNTIME')]"
            },
            {
              "name": "KeyVaultUri",
              "value": "[parameters('KeyVaultUri')]"
            },
            {
              "name": "WEBSITE_DNS_ALT_SERVER",
              "value": "[parameters('Appsetting:WEBSITE_DNS_ALT_SERVER')]"
            },
            {
              "name": "WEBSITE_DNS_SERVER",
              "value": "[parameters('Appsetting:WEBSITE_DNS_SERVER')]"
            },
            {
              "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
              "value": "[parameters('AzureWebJobsStorage')]"
            },
            {
              "name": "WEBSITE_CONTENTSHARE",
              "value": "[parameters('WEBSITE_CONTENTSHARE')]"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "[parameters('WEBSITE_RUN_FROM_PACKAGE')]"
            },
            {
              "name": "WEBSITE_LOAD_USER_PROFILE",
              "value": "[parameters('WEBSITE_LOAD_USER_PROFILE')]"
            },
            {
                "name": "OpenApi__DocTitle",
                "value": "[parameters('OpenApi__DocTitle')]"
            },
            {
                "name": "OpenApi__Description",
                "value": "[parameters('OpenApi__Description')]"
            },
            {
                "name": "OpenApi__HostNames",
                "value": "[parameters('OpenApi__HostNames')]"
            },
            {
                "name": "OpenApi__DocVersion",
                "value": "[parameters('OpenApi__DocVersion')]"
            },
            {
                "name": "OpenApi__Version",
                "value": "[parameters('OpenApi__Version')]"
            },
            {
                "name": "OpenApi__TokenUrl",
                "value": "[parameters('OpenApi__TokenUrl')]"
            },
            {
                "name": "OpenApi__Scope",
                "value": "[parameters('OpenApi__Scope')]"
            },
            {
                "name": "OpenApi__ForceHttps",
                "value": "[parameters('OpenApi__ForceHttps')]"
            },
            {
                "name": "OpenApi__ForceHttp",
                "value": "[parameters('OpenApi__ForceHttp')]"
            },
            {
                "name": "CRMPaymentEventHandlerTopicName",
                "value": "[parameters('CRMPaymentEventHandlerTopicName')]"
            },
            {
                "name": "CRMPaymentEventSubscriptionName",
                "value": "[parameters('CRMPaymentEventSubscriptionName')]"
            },
            {
                "name": "ServiceBusConnectionString",
                "value": "[parameters('ServiceBusConnectionString')]"
            },
            {
                "name": "AzureAd:Instance",
                "value": "[parameters('AzureAd:Instance')]"
            },
            {
                "name": "AzureAd:TenantId",
                "value": "[parameters('AzureAd:TenantId')]"
            },
            {
                "name": "AzureAd:TokenV1Issuer",
                "value": "[parameters('AzureAd:TokenV1Issuer')]"
            },
            {
                "name": "CRMWebApi:Endpoint",
                "value": "[parameters('CRMWebApi:Endpoint')]"
            },
            {
                "name": "CRMWebApi:PaymentFilterParams",
                "value": "[parameters('CRMWebApi:PaymentFilterParams')]"
            },
            {
                "name": "CRMWebApi:CallCRMAPIMUrl",
                "value": "[parameters('CRMWebApi:CallCRMAPIMUrl')]"
            },
            {
                "name": "CRMWebApi:CountryFilterParams",
                "value": "[parameters('CRMWebApi:CountryFilterParams')]"
            },
            {
                "name": "CRMWebApi:Version",
                "value": "[parameters('CRMWebApi:Version')]"
            },
            {
                "name": "AzureAd:ClientId",
                "value": "[parameters('AzureAd:ClientId')]"
            },
            {
                "name": "AzureAd:ClientSecret",
                "value": "[parameters('AzureAd:ClientSecret')]"
            },
            {
                "name": "MicroServiceDBKey",
                "value": "[parameters('MicroServiceDBKey')]"
            },
            {
                "name": "MicroServiceEventStoreTableName",
                "value": "[parameters('MicroServiceEventStoreTableName')]"
            },
            {
                "name": "MicroServiceResponseTableName",
                "value": "[parameters('MicroServiceResponseTableName')]"
            },
            {
              "name": "CRMWebApi:GetEndpointAPIM",
              "value": "[parameters('AppSetting:CRMWebApi:GetEndpointAPIM')]"
            },
            {
              "name": "CRMWebApi:PatchEndpointAPIM",
              "value": "[parameters('AppSetting:CRMWebApi:PatchEndpointAPIM')]"
            },
            {
              "name": "CRMWebApi:OcpSubKey",
              "value": "[parameters('AppSetting:CRMWebApi:OcpSubKey')]"
            },
            {
              "name": "ResponsePollingCount",
              "value": "[parameters('AppSetting:ResponsePollingCount')]"
            },
            {
              "name": "ResponseDelayTimeInMS",
              "value": "[parameters('AppSetting:ResponseDelayTimeInMS')]"
            },
            {
              "name": "CRMWebApi:PaymentUpdateResponseUrl",
              "value": "[parameters('AppSetting:CRMWebApi:PaymentUpdateResponseUrl')]"
            },
            {
              "name": "CRMWebApi:ResponsiveFeature",
              "value": "[parameters('AppSetting:CRMWebApi:ResponsiveFeature')]"
            },
            //Azure B2C Settings
            {
              "name": "AzureAdB2C:ClientId",
              "value": "[parameters('AzureAdB2C:ClientId')]"
            },
            {
              "name": "AzureAdB2C:Instance",
              "value": "[parameters('AzureAdB2C:Instance')]"
            },
            {
              "name": "AzureAdB2C:SignUpSignInPolicyId",
              "value": "[parameters('AzureAdB2C:SignUpSignInPolicyId')]"
            },
            {
              "name": "AzureAdB2C:TenantId",
              "value": "[parameters('AzureAdB2C:TenantId')]"
            },
            {
              "name": "AzureAdB2C:TokenV1Issuer",
              "value": "[parameters('AzureAdB2C:TokenV1Issuer')]"
            }

          ]
        },
        "scmSiteAlsoStopped": false,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNamesDisabled": false,
        "containerSize": 1536,
        "dailyMemoryTimeQuota": 0,
        "httpsOnly": true,
        "redundancyMode": "None"
        //"virtualNetworkSubnetId": "[concat('/subscriptions/', parameters('ResourceGroupSubscriptionId'), '/resourceGroups/', parameters('vNetResourceGroupName'), '/providers/Microsoft.Network/virtualNetworks/', parameters('vNetName'), '/subnets/', parameters('vNetSubnetName'))]"
      },
      "tags": "[parameters('Tags')]"
    },
    {
      "type": "Microsoft.Web/sites/slots/config",
      "apiVersion": "2021-03-01",
      "name": "[concat(parameters('FunctionAppName'), '/',parameters('SlotName'),'/web')]",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName'))]",
        "[variables('SiteResourceID')]"
      ],
      "properties": {
        "numberOfWorkers": 1,
        "defaultDocuments": [
          "Default.htm",
          "Default.html",
          "Default.asp",
          "index.htm",
          "index.html",
          "iisstart.htm",
          "default.aspx",
          "index.php"
        ],
        "netFrameworkVersion": "v10.0",
        "phpVersion": "5.6",
        "requestTracingEnabled": false,
        "remoteDebuggingEnabled": false,
        "httpLoggingEnabled": false,
        "logsDirectorySizeLimit": 35,
        "detailedErrorLoggingEnabled": false,
        "publishingUsername": "$[parameters('FunctionAppName')]__[parameters('SlotName')]",
        "azureStorageAccounts": {},
        "scmType": "None",
        "use32BitWorkerProcess": false,
        "webSocketsEnabled": false,
        "alwaysOn": true,
        "managedPipelineMode": "Integrated",
        "virtualApplications": [
          {
            "virtualPath": "/",
            "physicalPath": "site\\wwwroot",
            "preloadEnabled": true
          }
        ],
        "loadBalancing": "LeastRequests",
        "experiments": {
          "rampUpRules": []
        },
        "autoHealEnabled": false,
        "cors": {
          "allowedOrigins": [
            "https://functions.azure.com",
            "https://functions-staging.azure.com",
            "https://functions-next.azure.com"
          ],
          "supportCredentials": false
        },
        "localMySqlEnabled": false,
        "ipSecurityRestrictions": [
          {
            "ipAddress": "[parameters('IPRestriction')]",
            "action": "Allow",
            "priority": 1,
            "name": "Allow_APIM",
            "description": "Allow APIM access"
          }
        ],
        "scmIpSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictionsUseMain": false,
        "http20Enabled": false,
        "minTlsVersion": "1.2",
        "ftpsState": "AllAllowed",
        "PreWarmedInstanceCount": 0
      }
    },
    {
      "type": "Microsoft.Web/sites/slots/hostNameBindings",
      "apiVersion": "2022-03-01",
      "name": "[concat(parameters('FunctionAppName'), '/', parameters('SlotName'),'/', parameters('FunctionAppName'), '-',parameters('SlotName'),'.azurewebsites.net')]",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName'))]",
        "[variables('SiteResourceID')]"
      ],
      "properties": {
        "siteName": "[concat(parameters('FunctionAppName'),'(',parameters('SlotName'),')')]",
        "hostNameType": "Verified"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2021-09-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[Variables('ResourceLocation')]",
      "sku": {
        "name": "Standard_RAGRS",
        "tier": "Standard"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false
      }
    },

    {
      "type": "microsoft.insights/components",
      "kind": "web",
      "name": "[parameters('AppInsightsName')]",
      "apiVersion": "2020-02-02",
      "location": "[Variables('ResourceLocation')]",
      "dependsOn": [ "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]" ],
      "tags": "[parameters('Tags')]",
      "properties": {
        "applicationId": "[variables('SiteResourceID')]",
        "Application_Type": "web"
      }
    }
  ]
}
