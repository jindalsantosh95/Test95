{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "DataDog": {
      "value": {
        "LoggingProvider": "AppInsights",
        "LogsEndpoint": "https://http-intake.logs.datadoghq.com/api/v2/logs",
        "ApiKey": "@Microsoft.KeyVault(SecretUri=https://avateunkvems.vault.azure.net/secrets/Common-Config-Datadog-ApiKey/)",
        "Site": "datadoghq.com",
        "Environment": "sit",
        "Source": "csharp",
        "Version": "",
        "TraceEnabled": true,
        "RuntimeMetricsEnabled": true,
        "Tags": "",
        "BaggageAllowList": "api-session-id,api-operation-id,api-correlation-id,api-channel",
        "MinimumLogLevel": "Information",
        "QueueCapacity": 5000,
        "BatchSize": 100,
        "FlushIntervalMilliseconds": 2000
      }
    }
  }
}
