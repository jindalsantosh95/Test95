        "OpenApi__ForceHttp": "[parameters('Appsetting:OpenApi__ForceHttp')]",
        "KeyVaultUri": "[parameters('KeyVaultUri')]",
        //Datadog settings
        "LoggingProvider": "[parameters('DataDog').LoggingProvider]",
        "DatadogLogsEndpoint": "[parameters('DataDog').LogsEndpoint]",
        "DatadogApiKey": "[parameters('DataDog').ApiKey]",
