        "DatadogVersion": "[parameters('DataDog').Version]",
        "DatadogTags": "[concat(parameters('DataDog').Tags, if(empty(parameters('DataDog').Tags), '', ','), 'cloud_provider:azure,subscription_id:', subscription().subscriptionId, ',resource_group:', resourceGroup().name, ',name:', parameters('functionappName'), ',type:microsoft.web/sites,resource_id:', resourceId('Microsoft.Web/sites', parameters('functionappName')))]",
        "DatadogBaggageAllowList": "[parameters('DataDog').BaggageAllowList]",
        "DatadogMinimumLogLevel": "[parameters('DataDog').MinimumLogLevel]",
        "DatadogQueueCapacity": "[string(parameters('DataDog').QueueCapacity)]",
        "DatadogBatchSize": "[string(parameters('DataDog').BatchSize)]",
        "DatadogFlushIntervalMilliseconds": "[string(parameters('DataDog').FlushIntervalMilliseconds)]",
        //Offer Ms Appsettings
        "AzureAd:ClientId": "[parameters('AzureAd:ClientId')]",
        "AzureAd:ClientSecret": "[parameters('AzureAd:ClientSecret')]",
        "RedisConnectionString": "[parameters('AppSetting:RedisCacheConnectionString')]",
        "AzureAd:Instance": "[parameters('Appsetting:AzureAd:Instance')]",
        "AzureAd:TenantId": "[parameters('Appsetting:AzureAd:TenantId')]",
        "AzureAd:TokenV1Issuer": "[parameters('Appsetting:AzureAd:TokenV1Issuer')]",
        "ItaServiceKey": "[parameters('Appsetting:ItaServiceKey')]",
        "ItaServiceUrl": "[parameters('Appsetting:ItaServiceUrl')]",
        "ItaServiceVersion": "[parameters('Appsetting:ItaServiceVersion')]",
        "ItaServiceAPIMSubKey": "[parameters('Appsetting:ItaServiceAPIMSubKey')]",
        "ItaServiceApi": "[parameters('Appsetting:ItaServiceApi')]",
        "ItaReshopApi": "[parameters('Appsetting:ItaReshopApi')]",
        "ItaReshopApiVersion": "[parameters('Appsetting:ItaReshopApiVersion')]",
        "ItaReshopApiKey": "[parameters('Appsetting:ItaReshopApiKey')]",
        "ReferenceDataMicroServiceDBKey": "[parameters('ReferenceDataMicroServiceDBKey')]",
        "CommonCachingSlidingExpirationInDay": "[parameters('CommonCachingSlidingExpirationInDay')]",
