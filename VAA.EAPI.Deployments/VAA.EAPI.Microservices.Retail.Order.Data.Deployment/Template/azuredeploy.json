{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "DataDog": {
      "type": "secureObject",
      "defaultValue": {
        "LoggingProvider": "AppInsights",
        "LogsEndpoint": "https://http-intake.logs.datadoghq.com/api/v2/logs",
        "ApiKey": "",
        "Site": "datadoghq.com",
        "Environment": "",
        "Source": "csharp",
        "Version": "",
        "TraceEnabled": true,
        "RuntimeMetricsEnabled": true,
        "Tags": "",
        "BaggageAllowList": "",
        "MinimumLogLevel": "Information",
        "QueueCapacity": 5000,
        "BatchSize": 100,
        "FlushIntervalMilliseconds": 2000
      }
    },
    "EnvironmentName": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "ServerFarmIdRg": {
      "type": "string"
    },
    "Appsetting:FUNCTIONS_EXTENSION_VERSION": {
      "type": "string"
    },
    "FunctionAppName": {
      "type": "string"
    },
    "AppInsightsName": {
      "type": "string"
    },
    "appsettingsAppInsightsKey": {
      "type": "string"
    },
    "AppSettingAzureWebJobsStorage": {
      "type": "string"
    },
    "AppsettingAzureWebJobsSecretStorageType": {
      "type": "string"
    },
    "appsettingsWEBSITE_CONTENTSHARE": {
      "type": "string"
    },
    "Appsetting:ServiceBusConnectionString": {
      "type": "string"
    },
    "Appsetting:ServiceBusTopicName": {
      "type": "string"
    },
    "Appsetting:MicroServiceEventStoreTableName": {
      "type": "string"
    },
    "Appsetting:PaymentUpdateSubscriberTopicName": {
      "type": "string"
    },
    "Appsetting:PaymentUpdateSubscriptionName": {
      "type": "string"
    },
    "Appsetting:OrderCreateEventHandlerTopicName": {
      "type": "string"
    },
    "Appsetting:OrderCreateSubscriptionName": {
      "type": "string"
    },
    "Appsetting:OrderDBEndpoint": {
      "type": "string"
    },
    "Appsetting:OrderCollection": {
      "type": "string"
    },
    "Appsetting:DatabaseName": {
      "type": "string"
    },
    "Appsetting:CosmosSqlDBConnectionMode": {
      "type": "string"
    },
    "Appsetting:OrderCreateResponseEventType": {
      "type": "string"
    },
    "Appsetting:ServiceBusTopicNameTicket": {
      "type": "string"
    },
    "Appsetting:RefundUpdateSubscriberTopicName": {
      "type": "string"
    },
    "Appsetting:RefundUpdateSubscriptionName": {
      "type": "string"
    },
    "Appsetting:RefundReason": {
      "type": "string"
    },
    "Appsetting:WEBSITE_VNET_ROUTE_ALL": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_ALT_SERVER": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_SERVER": {
      "type": "string"
    },
    "IPRestriction": {
      "type": "string"
    },
    "OrderServiceBusConnectionString": {
      "type": "string"
    },
    "ServiceBusTopicNameOrder": {
      "type": "string"
    },
    "NDCOrderCollection": {
      "type": "string"
    },
    "OrderSCVDBEndpoint": {
      "type": "string"
    },
    "OrderDB": {
      "type": "string"
    },
    "OrdersCollection": {
      "type": "string"
    },
    "EnableMockView": {
      "type": "string"
    },
    "CustomerOrderAssociation": {
      "type": "string"
    },

    //slot settings
    "SlotName": {
      "type": "string"
    },
    "actionGroupsServiceNow": {
      "type": "string"
    },
    "actionGroupsEAPISupport": {
      "type": "string"
    },
    "emailAddressServiceNow": {
      "type": "string"
    },
    "emailAddressEAPISupport": {
      "type": "string"
    },
    "ResourceGroupSubscriptionId": {
      "type": "string"
    },
    "storageAccountName": {
      "type": "string"
    },
    "vaultName": {
      "type": "string"
    },
    //Azure B2C settings
    "AzureAdB2C:ClientId": {
      "type": "string"
    },
    "AzureAdB2C:Instance": {
      "type": "string"
    },
    "AzureAdB2C:SignUpSignInPolicyId": {
      "type": "string"
    },
    "AzureAdB2C:TenantId": {
      "type": "string"
    },
    "AzureAdB2C:TokenV1Issuer": {
      "type": "string"
    },
    //Notification settings
    "FlightCollection": {
      "type": "string"
    },
    "NotificationOrderReadBatchSize": {
      "type": "string"
    },
    "NotificationServiceBusConnectionString": {
      "type": "string"
    },

    //swagger settings
    "OpenApi__Description": {
      "type": "string"
    },
    "OpenApi__DocTitle": {
      "type": "string"
    },
    "OpenApi__DocVersion": {
      "type": "string"
    },
    "OpenApi__ForceHttp": {
      "type": "bool"
    },
    "OpenApi__ForceHttps": {
      "type": "bool"
    },
    "OpenApi__Scope": {
      "type": "string"
    },
    "OpenApi__TokenUrl": {
      "type": "string"
    },
    "OpenApi__Version": {
      "type": "string"
    }
  },
  "variables": {
    "ResourceLocation": "[resourceGroup().location]",
    "InitialProjectCode": "414",
    "InitialProjectName": "Order API",
    "InitialBudgetCode": "9054",
    "ActiveStatus": "[if(equals(parameters('EnvironmentName'),'PROD'),'PROD','NONPROD')]",
    "Purpose": "Support functions for the Order API AFN",
    "ApplicationUsageIdList": "AVADEUNAFNORDERDATAMICROSERV",
    "subnetName": "",
    "SiteResourceID": "[resourceId('Microsoft.Web/Sites', parameters('FunctionAppName'))]",
    "netFrameworkVersion": "v10.0"
  },
  "resources": [
    {
      "apiVersion": "2018-11-01",
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },
      "kind": "functionapp",
      "location": "[variables('ResourceLocation')]",
      "name": "[parameters('FunctionAppName')]",
      "properties": {
        "enabled": true,
        "hostNameSslStates": [
          {
            "name": "[concat(parameters('FunctionAppName'), '.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Standard"
          },
          {
            "name": "[concat(parameters('FunctionAppName'), '.scm.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Repository"
          }
        ],
        "serverFarmId": "[resourceId('Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "alwaysOn": true,
          "appSettings": [
            {
              "name": "LoggingProvider",
              "value": "[parameters('DataDog').LoggingProvider]"
            },
            {
              "name": "DatadogLogsEndpoint",
              "value": "[parameters('DataDog').LogsEndpoint]"
            },
            {
              "name": "DatadogApiKey",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_API_KEY",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_SITE",
              "value": "[parameters('DataDog').Site]"
            },
            {
              "name": "DD_SERVICE",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "DD_ENV",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DD_VERSION",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DD_TRACE_ENABLED",
              "value": "[string(parameters('DataDog').TraceEnabled)]"
            },
            {
              "name": "DD_RUNTIME_METRICS_ENABLED",
              "value": "[string(parameters('DataDog').RuntimeMetricsEnabled)]"
            },
            {
              "name": "DatadogService",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "environment",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DatadogSource",
              "value": "[parameters('DataDog').Source]"
            },
            {
              "name": "DatadogVersion",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DatadogTags",
              "value": "[concat(parameters('DataDog').Tags, if(empty(parameters('DataDog').Tags), '', ','), 'cloud_provider:azure,subscription_id:', subscription().subscriptionId, ',resource_group:', resourceGroup().name, ',name:', parameters('FunctionAppName'), ',type:microsoft.web/sites,resource_id:', resourceId('Microsoft.Web/sites', parameters('FunctionAppName')))]"
            },
            {
              "name": "DatadogBaggageAllowList",
              "value": "[parameters('DataDog').BaggageAllowList]"
            },
            {
              "name": "DatadogMinimumLogLevel",
              "value": "[parameters('DataDog').MinimumLogLevel]"
            },
            {
              "name": "DatadogQueueCapacity",
              "value": "[string(parameters('DataDog').QueueCapacity)]"
            },
            {
              "name": "DatadogBatchSize",
              "value": "[string(parameters('DataDog').BatchSize)]"
            },
            {
              "name": "DatadogFlushIntervalMilliseconds",
              "value": "[string(parameters('DataDog').FlushIntervalMilliseconds)]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "[parameters('Appsetting:FUNCTIONS_EXTENSION_VERSION')]"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "1"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "dotnet-isolated"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[parameters('appsettingsAppInsightsKey')]"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[parameters('AppSettingAzureWebJobsStorage')]"
            },
            {
              "name": "AzureWebJobsSecretStorageType",
              "value": "[parameters('AppsettingAzureWebJobsSecretStorageType')]"
            },
            //Vnet settings
            {
              "name": "WEBSITE_VNET_ROUTE_ALL",
              "value": "[parameters('Appsetting:WEBSITE_VNET_ROUTE_ALL')]"
            },
            {
              "name": "WEBSITE_DNS_ALT_SERVER",
              "value": "[parameters('Appsetting:WEBSITE_DNS_ALT_SERVER')]"
            },
            {
              "name": "WEBSITE_DNS_SERVER",
              "value": "[parameters('Appsetting:WEBSITE_DNS_SERVER')]"
            },

            {
              "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
              "value": "[parameters('AppSettingAzureWebJobsStorage')]"
            },
            {
              "name": "WEBSITE_CONTENTSHARE",
              "value": "[parameters('appsettingsWEBSITE_CONTENTSHARE')]"
            },
            {
              "name": "ServiceBusConnectionString",
              "value": "[parameters('Appsetting:ServiceBusConnectionString')]"
            },
            {
              "name": "MicroServiceDBKey",
              "value": "[parameters('AppSettingAzureWebJobsStorage')]"
            },
            {
              "name": "ServiceBusTopicName",
              "value": "[parameters('Appsetting:ServiceBusTopicName')]"
            },
            {
              "name": "MicroServiceEventStoreTableName",
              "value": "[parameters('Appsetting:MicroServiceEventStoreTableName')]"
            },
            {
              "name": "PaymentUpdateSubscriberTopicName",
              "value": "[parameters('Appsetting:PaymentUpdateSubscriberTopicName')]"
            },
            {
              "name": "PaymentUpdateSubscriptionName",
              "value": "[parameters('Appsetting:PaymentUpdateSubscriptionName')]"
            },
            {
              "name": "OrderCreateEventHandlerTopicName",
              "value": "[parameters('Appsetting:OrderCreateEventHandlerTopicName')]"
            },
            {
              "name": "OrderCreateSubscriptionName",
              "value": "[parameters('Appsetting:OrderCreateSubscriptionName')]"
            },
            {
              "name": "OrderDBEndpoint",
              "value": "[parameters('Appsetting:OrderDBEndpoint')]"
            },
            {
              "name": "OrderCollection",
              "value": "[parameters('Appsetting:OrderCollection')]"
            },
            {
              "name": "DatabaseName",
              "value": "[parameters('Appsetting:DatabaseName')]"
            },
            {
              "name": "CosmosSqlDBConnectionMode",
              "value": "[parameters('Appsetting:CosmosSqlDBConnectionMode')]"
            },
            {
              "name": "OrderCreateResponseEventType",
              "value": "[parameters('Appsetting:OrderCreateResponseEventType')]"
            },
            {
              "name": "ServiceBusTopicNameTicket",
              "value": "[parameters('Appsetting:ServiceBusTopicNameTicket')]"
            },
            {
              "name": "RefundUpdateSubscriberTopicName",
              "value": "[parameters('Appsetting:RefundUpdateSubscriberTopicName')]"
            },
            {
              "name": "RefundUpdateSubscriptionName",
              "value": "[parameters('Appsetting:RefundUpdateSubscriptionName')]"
            },
            {
              "name": "RefundReason",
              "value": "[parameters('Appsetting:RefundReason')]"
            },
            {
              "name": "OrderServiceBusConnectionString",
              "value": "[parameters('OrderServiceBusConnectionString')]"
            },
            {
              "name": "ServiceBusTopicNameOrder",
              "value": "[parameters('ServiceBusTopicNameOrder')]"
            },
            {
              "name": "NDCOrderCollection",
              "value": "[parameters('NDCOrderCollection')]"
            },
            {
              "name": "OrderSCVDBEndpoint",
              "value": "[parameters('OrderSCVDBEndpoint')]"
            },
            {
              "name": "OrderDB",
              "value": "[parameters('OrderDB')]"
            },
            {
              "name": "OrdersCollection",
              "value": "[parameters('OrdersCollection')]"
            },
            {
              "name": "EnableMockView",
              "value": "[parameters('EnableMockView')]"
            },
            {
              "name": "CustomerOrderAssociation",
              "value": "[parameters('CustomerOrderAssociation')]"
            },
            //Azure B2C Settings
            {
              "name": "AzureAdB2C:ClientId",
              "value": "[parameters('AzureAdB2C:ClientId')]"
            },
            {
              "name": "AzureAdB2C:Instance",
              "value": "[parameters('AzureAdB2C:Instance')]"
            },
            {
              "name": "AzureAdB2C:SignUpSignInPolicyId",
              "value": "[parameters('AzureAdB2C:SignUpSignInPolicyId')]"
            },
            {
              "name": "AzureAdB2C:TenantId",
              "value": "[parameters('AzureAdB2C:TenantId')]"
            },
            {
              "name": "AzureAdB2C:TokenV1Issuer",
              "value": "[parameters('AzureAdB2C:TokenV1Issuer')]"
            },
            {
              "name": "FlightCollection",
              "value": "[parameters('FlightCollection')]"
            },
            {
              "name": "NotificationOrderReadBatchSize",
              "value": "[parameters('NotificationOrderReadBatchSize')]"
            },
            {
              "name": "NotificationServiceBusConnectionString",
              "value": "[parameters('NotificationServiceBusConnectionString')]"
            },
            //swagger settings
            {
              "name": "OpenApi__Scope",
              "value": "[parameters('OpenApi__Scope')]"
            },
            {
              "name": "OpenApi__TokenUrl",
              "value": "[parameters('OpenApi__TokenUrl')]"
            },
            {
              "name": "OpenApi__DocTitle",
              "value": "[parameters('OpenApi__DocTitle')]"
            },
            {
              "name": "OpenApi__Description",
              "value": "[parameters('OpenApi__Description')]"
            },
            {
              "name": "OpenApi__DocVersion",
              "value": "[parameters('OpenApi__DocVersion')]"
            },
            {
              "name": "OpenApi__Version",
              "value": "[parameters('OpenApi__Version')]"
            },
            {
              "name": "OpenApi__ForceHttps",
              "value": "[parameters('OpenApi__ForceHttps')]"
            }

          ]
        },
        "scmSiteAlsoStopped": false,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNamesDisabled": false,
        "containerSize": 1536,
        "dailyMemoryTimeQuota": 0,
        "httpsOnly": true,
        "redundancyMode": "None"
      },
      "tags": {
        "ApplicationUsageIdList": "[variables('ApplicationUsageIdList')]",
        "InitialProjectCode": "[variables('InitialProjectCode')]",
        "InitialProjectName": "[variables('InitialProjectName')]",
        "InitialBudgetCode": "[variables('InitialBudgetCode')]",
        "ActiveStatus": "[variables('ActiveStatus')]",
        "displayName": "[variables('InitialProjectName')]"
      },
      "type": "Microsoft.Web/sites"
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2018-11-01",
      "name": "[concat(parameters('FunctionAppName'), '/web')]",
      "location": "North Europe",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]"
      ],
      "properties": {
        "numberOfWorkers": 1,
        "defaultDocuments": [
          "Default.htm",
          "Default.html",
          "Default.asp",
          "index.htm",
          "index.html",
          "iisstart.htm",
          "default.aspx",
          "index.php"
        ],
        "netFrameworkVersion": "v10.0",
        "phpVersion": "5.6",
        "requestTracingEnabled": false,
        "remoteDebuggingEnabled": false,
        "httpLoggingEnabled": false,
        "logsDirectorySizeLimit": 35,
        "detailedErrorLoggingEnabled": false,
        "publishingUsername": "$[parameters('FunctionAppName')]",
        "azureStorageAccounts": {},
        "scmType": "None",
        "use32BitWorkerProcess": false,
        "webSocketsEnabled": false,
        "alwaysOn": true,
        "managedPipelineMode": "Integrated",
        "virtualApplications": [
          {
            "virtualPath": "/",
            "physicalPath": "site\\wwwroot",
            "preloadEnabled": true
          }
        ],
        "loadBalancing": "LeastRequests",
        "experiments": {
          "rampUpRules": []
        },
        "autoHealEnabled": false,
        "cors": {
          "allowedOrigins": [
            "https://functions.azure.com",
            "https://functions-staging.azure.com",
            "https://functions-next.azure.com"
          ],
          "supportCredentials": false
        },
        "localMySqlEnabled": false,
        "ipSecurityRestrictions": [
          {
            "ipAddress": "[parameters('IPRestriction')]",
            "action": "Allow",
            "priority": 1,
            "name": "Allow_APIM",
            "description": "Allow APIM access"
          }
        ],
        "scmIpSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictionsUseMain": false,
        "http20Enabled": false,
        "minTlsVersion": "1.2",
        "ftpsState": "AllAllowed",
        "reservedInstanceCount": 0
      }
    },
    {
      "type": "Microsoft.Web/sites/hostNameBindings",
      "apiVersion": "2018-11-01",
      "name": "[concat(parameters('FunctionAppName'), '/', parameters('FunctionAppName'), '.azurewebsites.net')]",
      "location": "North Europe",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]"
      ],
      "properties": {
        "siteName": "[parameters('FunctionAppName')]",
        "hostNameType": "Verified"
      }
    },
    {
      "type": "microsoft.insights/components",
      "kind": "web",
      "name": "[parameters('AppInsightsName')]",
      "apiVersion": "2015-05-01",
      "location": "[Variables('ResourceLocation')]",
      "tags": {
        "ApplicationUsageIdList": "[variables('ApplicationUsageIdList')]",
        "InitialProjectCode": "[variables('InitialProjectCode')]",
        "InitialProjectName": "[variables('InitialProjectName')]",
        "InitialBudgetCode": "[variables('InitialBudgetCode')]",
        "ActiveStatus": "[variables('ActiveStatus')]",
        "displayName": "[variables('InitialProjectName')]"
      },
      "properties": {
        "applicationId": "[variables('SiteResourceID')]",
        "Application_Type": "web"
      },
      "dependsOn": [ "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]" ]
    }
  ]
}
