      "type": "string"
    },
    "Appsetting:CampaignEnrolmentEventSubject": {
      "type": "string"
    },

    "Appsetting:MembershipChangeDocType": {
      "type": "string"
    },

    "Appsetting:FlyingClubMemberDocType": {
      "type": "string"
