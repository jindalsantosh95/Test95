{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "functionAppName": {
      "type": "string"
    },  
    "apimEnv": {
      "type": "string"
    },
    "apiEnv": {
      "type": "string"
    }, 
    "apisEnv": {
      "type": "string"
    }, 
    "apimurlname": {
      "type": "string"
    },  
    "APIMName": {
      "type": "string"
    },
    "applicationName": {
      "type": "string"
    }, 
    "productId": {
      "type": "string"
    },        
    "tag": {
      "type": "string",
      "defaultValue": "Microservices"
    }
  },
  "variables": {
      "apiName": "[concat('EAPI_', parameters('applicationName'), '_Microservice', parameters('apiEnv'))]"
  },
  "resources": [
    {
      "type": "Microsoft.ApiManagement/service/apis",
      "apiVersion": "2021-12-01-preview",
      "name": "[concat(parameters('APIMName'), '/', variables('apiName'))]",      
      "properties": {
        "displayName": "[variables('apiName')]",
        "apiRevision": "1",
        "description": "[variables('apiName')]",
        "subscriptionRequired": true,
        "serviceUrl": "[concat('https://', parameters('functionAppName'), '.azurewebsites.net/api')]",
        "path": "[concat(parameters('apimEnv'), parameters('apimurlname'))]",  
        "value": "[concat('https://', parameters('functionAppName'), '.azurewebsites.net/api/swagger.json')]",
        "format": "openapi-link",            
        "protocols": ["https"],
        "isCurrent": true
      }
    },
    {
      "type": "Microsoft.ApiManagement/service/products/apis",
      "apiVersion": "2021-12-01-preview",
      "name": "[concat(parameters('APIMName'), '/', parameters('productId'), '/', variables('apiName'))]", 
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service/apis', parameters('APIMName'), variables('apiName'))]"
      ]
    },             
    {
      "type": "Microsoft.ApiManagement/service/apis/tags",
      "apiVersion": "2021-12-01-preview",
      "name": "[concat(parameters('APIMName'), '/', variables('apiName'), '/', parameters('tag'))]",
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service/apis', parameters('APIMName'), variables('apiName'))]"
      ]
    },
    {
      "type": "Microsoft.ApiManagement/service/apis/tags",
      "apiVersion": "2021-12-01-preview",
      "name": "[concat(parameters('APIMName'), '/', variables('apiName'), '/', 'Digital-First')]",
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service/apis', parameters('APIMName'), variables('apiName'))]"
      ]
    },
    {
      "type": "Microsoft.ApiManagement/service/apis/tags",
      "apiVersion": "2021-12-01-preview",
      "name": "[concat(parameters('APIMName'), '/', variables('apiName'), '/', 'Epic345')]",
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service/apis', parameters('APIMName'), variables('apiName'))]"
      ]
    }
  ]
}