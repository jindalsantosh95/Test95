{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "DataDog": {
      "type": "secureObject",
      "defaultValue": {
        "LoggingProvider": "AppInsights",
        "LogsEndpoint": "https://http-intake.logs.datadoghq.com/api/v2/logs",
        "ApiKey": "",
        "Site": "datadoghq.com",
        "Environment": "",
        "Source": "csharp",
        "Version": "",
        "TraceEnabled": true,
        "RuntimeMetricsEnabled": true,
        "Tags": "",
        "BaggageAllowList": "",
        "MinimumLogLevel": "Information",
        "QueueCapacity": 5000,
        "BatchSize": 100,
        "FlushIntervalMilliseconds": 2000
      }
    },
    //********** Function Deployment Settings ***************//
    "EnvironmentName": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "ServerFarmIdRg": {
      "type": "string"
    },
    "FunctionAppName": {
      "type": "string"
    },
    "AzureAd:ClientId": {
      "type": "string"
    },
    "AzureAd:Instance": {
      "type": "string"
    },
    "AzureAd:TenantId": {
      "type": "string"
    },
    "AzureAd:TokenV1Issuer": {
      "type": "string"
    },
    "AppInsightsName": {
      "type": "string"
    },
    "Appsetting:FUNCTIONS_EXTENSION_VERSION": {
      "type": "string"
    },
    "appsettingsAppInsightsKey": {
      "type": "string"
    },
    "AppSettingAzureWebJobsStorage": {
      "type": "string"
    },
    "AppsettingAzureWebJobsSecretStorageType": {
      "type": "string"
    },
    "appsettingsWEBSITE_CONTENTSHARE": {
      "type": "string"
    },
    "Appsetting:MicroServiceEventStoreTableName": {
      "type": "string"
    },
    "Appsetting:OrderTicketVoidEventHandlerTopicName": {
      "type": "string"
    },
    "Appsetting:OrderPaymentServiceBusTopicName": {
      "type": "string"
    },
    "Appsetting:OrderTicketVoidEventSubscriptionName": {
      "type": "string"
    },
    "Appsetting:ServiceBusConnectionString": {
      "type": "string"
    },
    "Appsetting:ServiceBusTopicName": {
      "type": "string"
    },
    "Appsetting:RefundWindowInHours": {
      "type": "string"
    },
    "Appsetting:VoidOrderDetailSubscriptionName": {
      "type": "string"
    },
    //Vnet Settings
    "Appsetting:WEBSITE_VNET_ROUTE_ALL": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_ALT_SERVER": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_SERVER": {
      "type": "string"
    },
    "DeltaCertificateName": {
      "type": "string"
    },
    "ApplicationId": {
      "type": "string"
    },
    "RoleIndicator": {
      "type": "string"
    },
    "SecurityId": {
      "type": "string"
    },
    "TestLab": {
      "type": "string"
    },
    "PoolType": {
      "type": "string"
    },
    "PrinterData": {
      "type": "string"
    },
    "AgentCityCode": {
      "type": "string"
    },
    "DebugOptions": {
      "type": "string"
    },
    "PnrCommonV6EndPoint": {
      "type": "string"
    },
    "TicketingProcessV3EndPoint": {
      "type": "string"
    },
    "CreditCardV2EndPoint": {
      "type": "string"
    },
    "RemarksV3EndPoint": {
      "type": "string"
    },
    "TicketCosmosDBEndPoint": {
      "type": "string"
    },
    "TicketCosmosDBName": {
      "type": "string"
    },
    "TicketCosmosDBCollection": {
      "type": "string"
    },
    "CosmosSqlDBConnectionMode": {
      "type": "string"
    },
    "ticket-ms-queue": {
      "type": "string"
    },
    "TtlForTicketDocumentAfterCappEvent": {
      "type": "string"
    },
    //Vnet Settings
    "vNetName": {
      "type": "string"
    },
    "vNetResourceGroupName": {
      "type": "string"
    },
    "vNetSubnetName": {
      "type": "string"
    },
    "ResourceGroupSubscriptionId": {
      "type": "string"
    },
    "KeyVaultUri": {
      "type": "string"
    },
    "IPRestriction": {
      "type": "string"
    },
    "SlotName": {
      "type": "string"
    },
    "vaultName": {
      "type": "string"
    },

    "WEBSITE_LOAD_USER_PROFILE": {
      "type": "string"
    },
    "storageaccountName":{
      "type": "string"
    },
    "AzureAdB2C:ClientId": {
      "type": "string"
    },
    "AzureAdB2C:Instance": {
      "type": "string"
    },
    "AzureAdB2C:SignUpSignInPolicyId": {
      "type": "string"
    },
    "AzureAdB2C:TenantId": {
      "type": "string"
    },
    "AzureAdB2C:TokenV1Issuer": {
      "type": "string"
    },
    "TicketCosmosDBConnectionString":{
      "type": "string"
    },

    //swagger settings
    "OpenApi__Description": {
      "type": "string"
    },
    "OpenApi__DocTitle": {
      "type": "string"
    },
    "OpenApi__DocVersion": {
      "type": "string"
    },
    "OpenApi__ForceHttp": {
      "type": "bool"
    },
    "OpenApi__ForceHttps": {
      "type": "bool"
    },
    "OpenApi__Scope": {
      "type": "string"
    },
    "OpenApi__TokenUrl": {
      "type": "string"
    },
    "OpenApi__Version": {
      "type": "string"
    }
  },
  "variables": {
    "ResourceLocation": "[resourceGroup().location]",
    "InitialProjectCode": "414",
    "InitialProjectName": "Order API",
    "InitialBudgetCode": "9054",
    "ActiveStatus": "[if(equals(parameters('EnvironmentName'),'PROD'),'PROD','NONPROD')]",
    "Purpose": "Support functions for the Order API AFN",
    "ApplicationUsageIdList": "AVADEUNAFNORDERTICKETMICROSERV",
    "subnetName": "",
    "SiteResourceID": "[resourceId('Microsoft.Web/Sites', parameters('FunctionAppName'))]",
    "netFrameworkVersion": "v10.0"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2021-09-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[variables('ResourceLocation')]",
      "tags": {
        "ApplicationUsageIdList": "[variables('ApplicationUsageIdList')]",
        "InitialProjectCode": "[variables('InitialProjectCode')]",
        "InitialProjectName": "[variables('InitialProjectName')]",
        "InitialBudgetCode": "[variables('InitialBudgetCode')]",
        "ActiveStatus": "[variables('ActiveStatus')]",
        "displayName": "[variables('InitialProjectName')]"
    },
      "sku": {
        "name": "Standard_RAGRS",
        "tier": "Standard"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "kind": "functionapp",
      "name": "[parameters('FunctionAppName')]",
      "apiVersion": "2021-03-01",
      "location": "[variables('ResourceLocation')]",
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]"
      },
      "tags": {
        "ApplicationUsageIdList": "[variables('ApplicationUsageIdList')]",
        "InitialProjectCode": "[variables('InitialProjectCode')]",
        "InitialProjectName": "[variables('InitialProjectName')]",
        "InitialBudgetCode": "[variables('InitialBudgetCode')]",
        "ActiveStatus": "[variables('ActiveStatus')]",
        "displayName": "[variables('InitialProjectName')]"
    }
    },
    {
      "type": "Microsoft.Web/sites/slots",
      "kind": "functionapp",
      "name": "[concat(parameters('FunctionAppName'), '/',parameters('SlotName'))]",
      "apiVersion": "2021-03-01",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [ "[variables('SiteResourceID')]" ],
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },
      "properties": {
        "enabled": true,
        "hostNameSslStates": [
          {
            "name": "[concat(parameters('FunctionAppName'), '-',parameters('SlotName'), '.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Standard"
          },
          {
            "name": "[concat(parameters('FunctionAppName'), '-',parameters('SlotName'), '.scm.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Repository"
          }
        ],
        "serverFarmId": "[resourceId('Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "alwaysOn": true,
          "appSettings": [
            {
              "name": "LoggingProvider",
              "value": "[parameters('DataDog').LoggingProvider]"
            },
            {
              "name": "DatadogLogsEndpoint",
              "value": "[parameters('DataDog').LogsEndpoint]"
            },
            {
              "name": "DatadogApiKey",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_API_KEY",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_SITE",
              "value": "[parameters('DataDog').Site]"
            },
            {
              "name": "DD_SERVICE",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "DD_ENV",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DD_VERSION",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DD_TRACE_ENABLED",
              "value": "[string(parameters('DataDog').TraceEnabled)]"
            },
            {
              "name": "DD_RUNTIME_METRICS_ENABLED",
              "value": "[string(parameters('DataDog').RuntimeMetricsEnabled)]"
            },
            {
              "name": "DatadogService",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "environment",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DatadogSource",
              "value": "[parameters('DataDog').Source]"
            },
            {
              "name": "DatadogVersion",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DatadogTags",
              "value": "[concat(parameters('DataDog').Tags, if(empty(parameters('DataDog').Tags), '', ','), 'cloud_provider:azure,subscription_id:', subscription().subscriptionId, ',resource_group:', resourceGroup().name, ',name:', parameters('FunctionAppName'), '/', parameters('SlotName'), ',type:microsoft.web/sites/slots,resource_id:', resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName')))]"
            },
            {
              "name": "DatadogBaggageAllowList",
              "value": "[parameters('DataDog').BaggageAllowList]"
            },
            {
              "name": "DatadogMinimumLogLevel",
              "value": "[parameters('DataDog').MinimumLogLevel]"
            },
            {
              "name": "DatadogQueueCapacity",
              "value": "[string(parameters('DataDog').QueueCapacity)]"
            },
            {
              "name": "DatadogBatchSize",
              "value": "[string(parameters('DataDog').BatchSize)]"
            },
            {
              "name": "DatadogFlushIntervalMilliseconds",
              "value": "[string(parameters('DataDog').FlushIntervalMilliseconds)]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "[parameters('Appsetting:FUNCTIONS_EXTENSION_VERSION')]"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "1"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "dotnet-isolated"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[parameters('appsettingsAppInsightsKey')]"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageAccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]"
            },
            {
              "name": "AzureWebJobsSecretStorageType",
              "value": "[parameters('AppsettingAzureWebJobsSecretStorageType')]"
            },
            {
              "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageAccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]"
            },
            {
              "name": "WEBSITE_CONTENTSHARE",
              "value": "[parameters('appsettingsWEBSITE_CONTENTSHARE')]"
            },
            {
              "name": "WEBSITE_VNET_ROUTE_ALL",
              "value": "[parameters('Appsetting:WEBSITE_VNET_ROUTE_ALL')]"
            },
            {
              "name": "WEBSITE_DNS_ALT_SERVER",
              "value": "[parameters('Appsetting:WEBSITE_DNS_ALT_SERVER')]"
            },
            {
              "name": "WEBSITE_DNS_SERVER",
              "value": "[parameters('Appsetting:WEBSITE_DNS_SERVER')]"
            },

            {
              "name": "MicroServiceDBKey",
              "value": "[parameters('AppSettingAzureWebJobsStorage')]"
            },
            {
              "name": "MicroServiceEventStoreTableName",
              "value": "[parameters('Appsetting:MicroServiceEventStoreTableName')]"
            },
            {
              "name": "OrderTicketVoidEventHandlerTopicName",
              "value": "[parameters('Appsetting:OrderTicketVoidEventHandlerTopicName')]"
            },
            {
              "name": "OrderPaymentServiceBusTopicName",
              "value": "[parameters('Appsetting:OrderPaymentServiceBusTopicName')]"
            },
            {
              "name": "OrderTicketVoidEventSubscriptionName",
              "value": "[parameters('Appsetting:OrderTicketVoidEventSubscriptionName')]"
            },
            {
              "name": "ServiceBusConnectionString",
              "value": "[parameters('Appsetting:ServiceBusConnectionString')]"
            },
            {
              "name": "ServiceBusTopicName",
              "value": "[parameters('Appsetting:ServiceBusTopicName')]"
            },
            {
              "name": "RefundWindowInHours",
              "value": "[parameters('Appsetting:RefundWindowInHours')]"
            },
            {
              "name": "VoidOrderDetailSubscriptionName",
              "value": "[parameters('Appsetting:VoidOrderDetailSubscriptionName')]"
            },
            {
              "name": "DeltaCertificateName",
              "value": "[parameters('DeltaCertificateName')]"
            },
            {
              "name": "ApplicationId",
              "value": "[parameters('ApplicationId')]"
            },
            {
              "name": "RoleIndicator",
              "value": "[parameters('RoleIndicator')]"
            },
            {
              "name": "SecurityId",
              "value": "[parameters('SecurityId')]"
            },
            {
              "name": "TestLab",
              "value": "[parameters('TestLab')]"
            },
            {
              "name": "PoolType",
              "value": "[parameters('PoolType')]"
            },
            {
              "name": "PrinterData",
              "value": "[parameters('PrinterData')]"
            },
            {
              "name": "AgentCityCode",
              "value": "[parameters('AgentCityCode')]"
            },
            {
              "name": "DebugOptions",
              "value": "[parameters('DebugOptions')]"
            },
            {
              "name": "PnrCommonV6EndPoint",
              "value": "[parameters('PnrCommonV6EndPoint')]"
            },
            {
              "name": "TicketingProcessV3EndPoint",
              "value": "[parameters('TicketingProcessV3EndPoint')]"
            },
            {
              "name": "CreditCardV2EndPoint",
              "value": "[parameters('CreditCardV2EndPoint')]"
            },
            {
              "name": "RemarksV3EndPoint",
              "value": "[parameters('RemarksV3EndPoint')]"
            },
            {
              "name": "TicketCosmosDBEndPoint",
              "value": "[parameters('TicketCosmosDBEndPoint')]"
            },
            {
              "name": "TicketCosmosDBName",
              "value": "[parameters('TicketCosmosDBName')]"
            },
            {
              "name": "TicketCosmosDBCollection",
              "value": "[parameters('TicketCosmosDBCollection')]"
            },
            {
              "name": "CosmosSqlDBConnectionMode",
              "value": "[parameters('CosmosSqlDBConnectionMode')]"
            },
            {
              "name": "ticket-ms-queue",
              "value": "[parameters('ticket-ms-queue')]"
            },
            {
              "name": "TtlForTicketDocumentAfterCappEvent",
              "value": "[parameters('TtlForTicketDocumentAfterCappEvent')]"
            },
            {
              "name": "KeyVaultUri",
              "value": "[parameters('KeyVaultUri')]"
            },
            {
              "name": "WEBSITE_LOAD_USER_PROFILE",
              "value": "[parameters('WEBSITE_LOAD_USER_PROFILE')]"
            },
            {
              "name": "AzureAd:ClientId",
              "value": "[parameters('AzureAd:ClientId')]"
            },
            {
              "name": "AzureAd:Instance",
              "value": "[parameters('AzureAd:Instance')]"
            },
            {
              "name": "AzureAd:TenantId",
              "value": "[parameters('AzureAd:TenantId')]"
            },
            {
              "name": "AzureAd:TokenV1Issuer",
              "value": "[parameters('AzureAd:TokenV1Issuer')]"
            },
            {
              "name": "AzureAdB2C:ClientId",
              "value": "[parameters('AzureAdB2C:ClientId')]"
            },
            {
              "name": "AzureAdB2C:Instance",
              "value": "[parameters('AzureAdB2C:Instance')]"
            },
            {
              "name": "AzureAdB2C:SignUpSignInPolicyId",
              "value": "[parameters('AzureAdB2C:SignUpSignInPolicyId')]"
            },
            {
              "name": "AzureAdB2C:TenantId",
              "value": "[parameters('AzureAdB2C:TenantId')]"
            },
            {
              "name": "AzureAdB2C:TokenV1Issuer",
              "value": "[parameters('AzureAdB2C:TokenV1Issuer')]"
            },
            {
              "name": "TicketCosmosDBConnectionString",
              "value": "[parameters('TicketCosmosDBConnectionString')]"
            },

            //swagger settings
            {
              "name": "OpenApi__Scope",
              "value": "[parameters('OpenApi__Scope')]"
            },
            {
              "name": "OpenApi__TokenUrl",
              "value": "[parameters('OpenApi__TokenUrl')]"
            },
            {
              "name": "OpenApi__DocTitle",
              "value": "[parameters('OpenApi__DocTitle')]"
            },
            {
              "name": "OpenApi__Description",
              "value": "[parameters('OpenApi__Description')]"
            },
            {
              "name": "OpenApi__DocVersion",
              "value": "[parameters('OpenApi__DocVersion')]"
            },
            {
              "name": "OpenApi__Version",
              "value": "[parameters('OpenApi__Version')]"
            },
            {
              "name": "OpenApi__ForceHttps",
              "value": "[parameters('OpenApi__ForceHttps')]"
            },
            {
              "name": "OpenApi__ForceHttp",
              "value": "[parameters('OpenApi__ForceHttp')]"
            }
          ]
        },
        "scmSiteAlsoStopped": false,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNamesDisabled": false,
        "containerSize": 1536,
        "dailyMemoryTimeQuota": 0,
        "httpsOnly": true,
        "redundancyMode": "None"
      },
      "tags": {
        "ApplicationUsageIdList": "[variables('ApplicationUsageIdList')]",
        "InitialProjectCode": "[variables('InitialProjectCode')]",
        "InitialProjectName": "[variables('InitialProjectName')]",
        "InitialBudgetCode": "[variables('InitialBudgetCode')]",
        "ActiveStatus": "[variables('ActiveStatus')]",
        "displayName": "[variables('InitialProjectName')]"
    }
    },
    {
      "type": "Microsoft.Web/sites/slots/config",
      "apiVersion": "2021-03-01",
      "name": "[concat(parameters('FunctionAppName'), '/',parameters('SlotName'),'/web')]",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName'))]",
        "[variables('SiteResourceID')]"
      ],
      "properties": {
        "numberOfWorkers": 1,
        "defaultDocuments": [
          "Default.htm",
          "Default.html",
          "Default.asp",
          "index.htm",
          "index.html",
          "iisstart.htm",
          "default.aspx",
          "index.php"
        ],
        "netFrameworkVersion": "v10.0",
        "phpVersion": "5.6",
        "requestTracingEnabled": false,
        "remoteDebuggingEnabled": false,
        "httpLoggingEnabled": false,
        "logsDirectorySizeLimit": 35,
        "detailedErrorLoggingEnabled": false,
        "publishingUsername": "$[parameters('FunctionAppName')]__[parameters('SlotName')]",
        "azureStorageAccounts": {},
        "scmType": "None",
        "use32BitWorkerProcess": false,
        "webSocketsEnabled": false,
        "alwaysOn": true,
        "managedPipelineMode": "Integrated",
        "virtualApplications": [
          {
            "virtualPath": "/",
            "physicalPath": "site\\wwwroot",
            "preloadEnabled": true
          }
        ],
        "loadBalancing": "LeastRequests",
        "experiments": {
          "rampUpRules": []
        },
        "autoHealEnabled": false,
        "cors": {
          "allowedOrigins": [
            "https://functions.azure.com",
            "https://functions-staging.azure.com",
            "https://functions-next.azure.com"
          ],
          "supportCredentials": false
        },
        "localMySqlEnabled": false,
        "ipSecurityRestrictions": [
          {
            "ipAddress": "[parameters('IPRestriction')]",
            "action": "Allow",
            "priority": 1,
            "name": "Allow_APIM",
            "description": "Allow APIM access"
          }
        ],
        "scmIpSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictionsUseMain": false,
        "http20Enabled": false,
        "minTlsVersion": "1.2",
        "ftpsState": "AllAllowed",
        "PreWarmedInstanceCount": 0
      }
    },
    {
      "type": "Microsoft.Web/sites/slots/hostNameBindings",
      "apiVersion": "2022-03-01",
      "name": "[concat(parameters('FunctionAppName'), '/', parameters('SlotName'),'/', parameters('FunctionAppName'), '-',parameters('SlotName'),'.azurewebsites.net')]",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName'))]",
        "[variables('SiteResourceID')]"
      ],
      "properties": {
        "siteName": "[concat(parameters('FunctionAppName'),'(',parameters('SlotName'),')')]",
        "hostNameType": "Verified"
      }
    },

    {
      "type": "microsoft.insights/components",
      "kind": "web",
      "name": "[parameters('AppInsightsName')]",
      "apiVersion": "2020-02-02",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [ "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]" ],
      "tags": {
        "ApplicationUsageIdList": "[variables('ApplicationUsageIdList')]",
        "InitialProjectCode": "[variables('InitialProjectCode')]",
        "InitialProjectName": "[variables('InitialProjectName')]",
        "InitialBudgetCode": "[variables('InitialBudgetCode')]",
        "ActiveStatus": "[variables('ActiveStatus')]",
        "displayName": "[variables('InitialProjectName')]"
      },
      "properties": {
        "applicationId": "[variables('SiteResourceID')]",
        "Application_Type": "web"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "name": "[concat(parameters('vaultName'), '/add')]",
      "apiVersion": "2019-09-01",
      "properties": {
        "accessPolicies": [
          {
            "tenantId": "[reference(concat('Microsoft.Web/sites/', parameters('FunctionAppName')), '2018-02-01','Full').identity.tenantId]",
            "objectId": "[reference(concat('Microsoft.Web/sites/', parameters('FunctionAppName')), '2018-02-01','Full').identity.principalId]",
            "permissions": {
              "keys": [ "Get", "List" ],
              "secrets": [ "Get", "List" ],
              "certificates": [ "Get", "List" ],
              "storage": [ "all" ]
            }
          }
        ]
      }
    }
  ]
}
