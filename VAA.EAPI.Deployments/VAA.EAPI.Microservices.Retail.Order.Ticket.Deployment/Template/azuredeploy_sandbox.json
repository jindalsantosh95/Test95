{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "DataDog": {
      "type": "secureObject",
      "defaultValue": {
        "LoggingProvider": "AppInsights",
        "LogsEndpoint": "https://http-intake.logs.datadoghq.com/api/v2/logs",
        "ApiKey": "",
        "Site": "datadoghq.com",
        "Environment": "",
        "Source": "csharp",
        "Version": "",
        "TraceEnabled": true,
        "RuntimeMetricsEnabled": true,
        "Tags": "",
        "BaggageAllowList": "",
        "MinimumLogLevel": "Information",
        "QueueCapacity": 5000,
        "BatchSize": 100,
        "FlushIntervalMilliseconds": 2000
      }
    },
    "environment": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "appName": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "aseRg": {
      "type": "string"
    },
    "aseName": {
      "type": "string"
    },
    "keyVaultName": {
      "type": "string"
    },
    "tags": {
      "type": "object"
    },
    "appinsightname": {
      "type": "string"
    },
    "WEBSITE_DNS_SERVER": {
      "type": "string"
    },
    "WEBSITE_DNS_ALT_SERVER": {
      "type": "string"
    },
    "storageaccountName": {
      "type": "string"
    },
    "appinsightkey": {
      "type": "string"
    },
    "appinsight_string": {
      "type": "string"
    },
    "WEBSITE_RUN_FROM_PACKAGE": {
      "type": "string"
    },
    "WEBSITE_LOAD_USER_PROFILE": {
      "type": "string"
    },
    "AzureWebJobsSecretStorageType": {
      "type": "string"
    },
    "Appsetting:MicroServiceEventStoreTableName": {
      "type": "string"
    },
    "Appsetting:OrderTicketVoidEventHandlerTopicName": {
      "type": "string"
    },
    "Appsetting:OrderPaymentServiceBusTopicName": {
      "type": "string"
    },
    "Appsetting:OrderTicketVoidEventSubscriptionName": {
      "type": "string"
    },
    "Appsetting:ServiceBusConnectionString": {
      "type": "string"
    },
    "Appsetting:ServiceBusTopicName": {
      "type": "string"
    },
    "Appsetting:RefundWindowInHours": {
      "type": "string"
    },
    "Appsetting:VoidOrderDetailSubscriptionName": {
      "type": "string"
    },
    "DeltaCertificateName": {
      "type": "string"
    },
    "ApplicationId": {
      "type": "string"
    },
    "RoleIndicator": {
      "type": "string"
    },
    "SecurityId": {
      "type": "string"
    },
    "TestLab": {
      "type": "string"
    },
    "PoolType": {
      "type": "string"
    },
    "PrinterData": {
      "type": "string"
    },
    "AgentCityCode": {
      "type": "string"
    },
    "DebugOptions": {
      "type": "string"
    },
    "PnrCommonV6EndPoint": {
      "type": "string"
    },
    "TicketingProcessV3EndPoint": {
      "type": "string"
    },
    "CreditCardV2EndPoint": {
      "type": "string"
    },
    "RemarksV3EndPoint": {
      "type": "string"
    },
    "TicketCosmosDBEndPoint": {
      "type": "string"
    },
    "TicketCosmosDBName": {
      "type": "string"
    },
    "TicketCosmosDBCollection": {
      "type": "string"
    },
    "CosmosSqlDBConnectionMode": {
      "type": "string"
    },
    "ticket-ms-queue": {
      "type": "string"
    },
    "TtlForTicketDocumentAfterCappEvent": {
      "type": "string"
    },
    "ResourceGroupSubscriptionId": {
      "type": "string"
    },
    "KeyVaultUri": {
      "type": "string"
    },
    "AzureAd:ClientId": {
      "type": "string"
    },
    "AzureAd:Instance": {
      "type": "string"
    },
    "AzureAd:TenantId": {
      "type": "string"
    },
    "AzureAd:TokenV1Issuer": {
      "type": "string"
    },
    "TicketCosmosDBConnectionString": {
      "type": "string"
    },

    "IPRestriction": {
      "type": "string"
    }

  },
  "variables": {
    "azurewebjobstorage": "[concat('@Microsoft.KeyVault(SecretUri=https://',parameters('keyVaultName'),'.vault.azure.net/secrets/',parameters('storageaccountName'),'-connectionstring)')]"


  },
  "resources": [
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2018-11-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "functionapp",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "enabled": true,
        "serverFarmId": "[resourceId(parameters('aseRg'), 'Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "hostingEnvironmentProfile": "[resourceId(parameters('aseRg'), 'Microsoft.Web/hostingEnvironments', parameters('aseName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "appSettings": [
            {
              "name": "LoggingProvider",
              "value": "[parameters('DataDog').LoggingProvider]"
            },
            {
              "name": "DatadogLogsEndpoint",
              "value": "[parameters('DataDog').LogsEndpoint]"
            },
            {
              "name": "DatadogApiKey",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_API_KEY",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_SITE",
              "value": "[parameters('DataDog').Site]"
            },
            {
              "name": "DD_SERVICE",
              "value": "[parameters('appName')]"
            },
            {
              "name": "DD_ENV",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DD_VERSION",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DD_TRACE_ENABLED",
              "value": "[string(parameters('DataDog').TraceEnabled)]"
            },
            {
              "name": "DD_RUNTIME_METRICS_ENABLED",
              "value": "[string(parameters('DataDog').RuntimeMetricsEnabled)]"
            },
            {
              "name": "DatadogService",
              "value": "[parameters('appName')]"
            },
            {
              "name": "environment",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DatadogSource",
              "value": "[parameters('DataDog').Source]"
            },
            {
              "name": "DatadogVersion",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DatadogTags",
              "value": "[concat(parameters('DataDog').Tags, if(empty(parameters('DataDog').Tags), '', ','), 'cloud_provider:azure,subscription_id:', subscription().subscriptionId, ',resource_group:', resourceGroup().name, ',name:', parameters('appName'), ',type:microsoft.web/sites,resource_id:', resourceId('Microsoft.Web/sites', parameters('appName')))]"
            },
            {
              "name": "DatadogBaggageAllowList",
              "value": "[parameters('DataDog').BaggageAllowList]"
            },
            {
              "name": "DatadogMinimumLogLevel",
              "value": "[parameters('DataDog').MinimumLogLevel]"
            },
            {
              "name": "DatadogQueueCapacity",
              "value": "[string(parameters('DataDog').QueueCapacity)]"
            },
            {
              "name": "DatadogBatchSize",
              "value": "[string(parameters('DataDog').BatchSize)]"
            },
            {
              "name": "DatadogFlushIntervalMilliseconds",
              "value": "[string(parameters('DataDog').FlushIntervalMilliseconds)]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', parameters('storageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value)]"
            }
          ]
        },
        "scmSiteAlsoStopped": false,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNamesDisabled": false,
        "containerSize": 1536,
        "dailyMemoryTimeQuota": 0,
        "httpsOnly": true,
        "redundancyMode": "None"
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2018-11-01",
      "name": "[concat(parameters('appName'), '/web')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]"
      ],
      "properties": {
        "numberOfWorkers": 1,
        "defaultDocuments": [
          "Default.htm",
          "Default.html",
          "Default.asp",
          "index.htm",
          "index.html",
          "iisstart.htm",
          "default.aspx",
          "index.php"
        ],
        "netFrameworkVersion": "v10.0",
        "phpVersion": "5.6",
        "requestTracingEnabled": false,
        "remoteDebuggingEnabled": false,
        "httpLoggingEnabled": false,
        "logsDirectorySizeLimit": 35,
        "detailedErrorLoggingEnabled": false,
        "publishingUsername": "$[parameters('appName')]",
        "azureStorageAccounts": {},
        "scmType": "None",
        "use32BitWorkerProcess": true,
        "webSocketsEnabled": false,
        "alwaysOn": true,
        "managedPipelineMode": "Integrated",
        "virtualApplications": [
          {
            "virtualPath": "/",
            "physicalPath": "site\\wwwroot",
            "preloadEnabled": false
          }
        ],
        "loadBalancing": "LeastRequests",
        "experiments": {
          "rampUpRules": []
        },
        "autoHealEnabled": false,
        "cors": {
          "allowedOrigins": [
            "https://functions.azure.com",
            "https://functions-staging.azure.com",
            "https://functions-next.azure.com"
          ],
          "supportCredentials": false
        },
        "localMySqlEnabled": false,
        "ipSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictionsUseMain": false,
        "http20Enabled": false,
        "minTlsVersion": "1.2",
        "ftpsState": "FtpsOnly",
        "reservedInstanceCount": 0
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2021-03-01",
      "name": "[concat(parameters('appName'),'/','appsettings')]",
      "kind": "functionapp,workflowapp",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/accessPolicies', parameters('keyVaultName'),'add')]"
      ],
      "properties": {
        /*App Settings */
        "FUNCTIONS_EXTENSION_VERSION": "~4",
        "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
        "WEBSITE_CONTENTOVERVNET": "1",
        "WEBSITE_VNET_ROUTE_ALL": "1",
        "APPINSIGHTS_INSTRUMENTATIONKEY": "[parameters('appinsightkey')]",
        "APPLICATIONINSIGHTS_CONNECTION_STRING": "[parameters('appinsight_string')]",
        "AzureWebJobsStorage": "[variables('azurewebjobstorage')]",
        "WEBSITE_DNS_SERVER": "[parameters('WEBSITE_DNS_SERVER')]",
        "WEBSITE_DNS_ALT_SERVER": "[parameters('WEBSITE_DNS_ALT_SERVER')]",
        "AzureWebJobsSecretStorageType": "[parameters('AzureWebJobsSecretStorageType')]",
        "WEBSITE_LOAD_USER_PROFILE": "[parameters('WEBSITE_LOAD_USER_PROFILE')]",
        "AzureAd:ClientId": "[parameters('AzureAd:ClientId')]",
        "AzureAd:Instance": "[parameters('AzureAd:Instance')]",
        "AzureAd:TenantId": "[parameters('AzureAd:TenantId')]",
        "AzureAd:TokenV1Issuer": "[parameters('AzureAd:TokenV1Issuer')]",
        "MicroServiceEventStoreTableName": "[parameters('Appsetting:MicroServiceEventStoreTableName')]",
        "OrderTicketVoidEventHandlerTopicName": "[parameters('Appsetting:OrderTicketVoidEventHandlerTopicName')]",
        "OrderPaymentServiceBusTopicName": "[parameters('Appsetting:OrderPaymentServiceBusTopicName')]",
        "OrderTicketVoidEventSubscriptionName": "[parameters('Appsetting:OrderTicketVoidEventSubscriptionName')]",
        "ServiceBusConnectionString": "[parameters('Appsetting:ServiceBusConnectionString')]",
        "ServiceBusTopicName": "[parameters('Appsetting:ServiceBusTopicName')]",
        "RefundWindowInHours": "[parameters('Appsetting:RefundWindowInHours')]",
        "VoidOrderDetailSubscriptionName": "[parameters('Appsetting:VoidOrderDetailSubscriptionName')]",
        "DeltaCertificateName": "[parameters('DeltaCertificateName')]",
        "ApplicationId": "[parameters('ApplicationId')]",
        "RoleIndicator": "[parameters('RoleIndicator')]",
        "SecurityId": "[parameters('SecurityId')]",
        "TestLab": "[parameters('TestLab')]",
        "PoolType": "[parameters('PoolType')]",
        "PrinterData": "[parameters('PrinterData')]",
        "AgentCityCode": "[parameters('AgentCityCode')]",
        "DebugOptions": "[parameters('DebugOptions')]",
        "PnrCommonV6EndPoint": "[parameters('PnrCommonV6EndPoint')]",
        "TicketingProcessV3EndPoint": "[parameters('TicketingProcessV3EndPoint')]",
        "CreditCardV2EndPoint": "[parameters('CreditCardV2EndPoint')]",
        "RemarksV3EndPoint": "[parameters('RemarksV3EndPoint')]",
        "TicketCosmosDBEndPoint": "[parameters('TicketCosmosDBEndPoint')]",
        "TicketCosmosDBName": "[parameters('TicketCosmosDBName')]",
        "TicketCosmosDBCollection": "[parameters('TicketCosmosDBCollection')]",
        "CosmosSqlDBConnectionMode": "[parameters('CosmosSqlDBConnectionMode')]",
        "ticket-ms-queue": "[parameters('ticket-ms-queue')]",
        "TtlForTicketDocumentAfterCappEvent": "[parameters('TtlForTicketDocumentAfterCappEvent')]",
        "ResourceGroupSubscriptionId": "[parameters('ResourceGroupSubscriptionId')]",
        "KeyVaultUri": "[parameters('KeyVaultUri')]",
        "IPRestriction": "[parameters('IPRestriction')]",
        "TicketCosmosDBConnectionString": "[parameters('TicketCosmosDBConnectionString')]"

      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "apiVersion": "2015-06-01",
      "name": "[concat(parameters('keyvaultName'),'/add')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]"

      ],
      "properties": {
        "accessPolicies": [
          {
            "objectId": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2019-08-01', 'full').identity.principalId]",
            "tenantId": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2019-08-01', 'full').identity.tenantId]",
            "permissions": {
              "secrets": [ "Get", "List", "Set" ]
            }
          }
        ]
      }
    }


  ]
}
