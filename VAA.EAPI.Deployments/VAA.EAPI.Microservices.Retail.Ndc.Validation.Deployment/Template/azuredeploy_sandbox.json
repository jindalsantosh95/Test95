{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "DataDog": {
      "type": "secureObject",
      "defaultValue": {
        "LoggingProvider": "AppInsights",
        "LogsEndpoint": "https://http-intake.logs.datadoghq.com/api/v2/logs",
        "ApiKey": "",
        "Site": "datadoghq.com",
        "Environment": "",
        "Source": "csharp",
        "Version": "",
        "TraceEnabled": true,
        "RuntimeMetricsEnabled": true,
        "Tags": "",
        "BaggageAllowList": "",
        "MinimumLogLevel": "Information",
        "QueueCapacity": 5000,
        "BatchSize": 100,
        "FlushIntervalMilliseconds": 2000
      }
    },
    "environment": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "appName": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "aseRg": {
      "type": "string"
    },
    "aseName": {
      "type": "string"
    },
    "keyVaultName": {
      "type": "string"
    },
    "tags": {
      "type": "object"
    },
    "appinsightname": {
      "type": "string"
    },
    "storageaccountName": {
      "type": "string"
    },
    "appinsightkey": {
      "type": "string"
    },
    "appinsight_string": {
      "type": "string"
    },



    "AzureAd:TenantId": {
      "type": "string"
    },
    "AzureWebJobsSecretStorageType": {
      "type": "string"
    },

    "Tags": {
      "type": "Object"
    },

    "WEBSITE_LOAD_USER_PROFILE": {
      "type": "string"
    },
    "WEBSITE_RUN_FROM_PACKAGE": {
      "type": "string"
    },
    "storageAccountName": {
      "type": "string"
    },
    "redisName": {
      "type": "string"
    },
    /*"AppSetting:RedisCacheConnectionString": {
      "type": "string"
    },*/
    "AppSetting:SecuritySvcOCPKey": {
      "type": "string"
    },
    "AppSetting:SecuritySvcEndPoint": {
      "type": "string"
    },
    "AppSetting:OpenApi__Description": {
      "type": "string"
    },
    "AppSetting:OpenApi__HostNames": {
      "type": "string"
    },
    "AppSetting:OpenApi__DocVersion": {
      "type": "string"
    },
    "AppSetting:OpenApi__Version": {
      "type": "string"
    },
    "AppSetting:OpenApi__ForceHttps": {
      "type": "string"
    },
    "AppSetting:OpenApi__ForceHttp": {
      "type": "string"
    },
    "AppSetting:OpenApi__Scope": {
      "type": "string"
    },
    "AppSetting:OpenApi__TokenUrl": {
      "type": "string"
    },
    "AppSetting:AzureAd:ClientId": {
      "type": "string"
    },
    "AppSetting:AzureAd:Instance": {
      "type": "string"
    },
    "AppSetting:AzureAd:TokenV1Issuer": {
      "type": "string"
    },
    "AppSetting:NDCConnectStoredProc": {
      "type": "string"
    },
    "AppSetting:NDCConnectAgencyOCNStoredProc": {
      "type": "string"
    },
    "AppSetting:NDCConnectDBConnectionString": {
      "type": "string"
    },
    "vaultName": {
      "type": "string"
    },
    "storageaccountName2": {
      "type": "string"
    },
    "tablename": {
      "type": "string"
    },
    "IFGAgentFopLookupPassword": {
      "type": "string"
    },
    "IFGAgentFopLookupUrl": {
      "type": "string"
    },
    "IFGAgentFopLookupUsername": {
      "type": "string"
    },
    "Appsetting:AgencySlidingExpirationInDay": {
      "type": "string"
    },
    "AppSetting:AgencyAbsoluteExpirationInDay": {
      "type": "string"
    },
    "AppSetting:SubscriptionCachingSlidingExpirationInDay": {
      "type": "string"
    },
    "AppSetting:SubscriptionCachingAbsoluteExpirationInDay": {
      "type": "string"
    },
    "AppSetting:AgentTktAuthorityEndpointGet": {
      "type": "string"
    },
    "AppSetting:AgentTktAuthorityEndpointUpdate": {
      "type": "string"
    },
    "AppSetting:AgentTktAuthorityEnv": {
      "type": "string"
    },
    "AppSetting:AgentTktAuthorityClientId": {
      "type": "string"
    },
    "AppSetting:AgentTktAuthoritySecretKey": {
      "type": "string"
    },
    "AppSetting:AgentTktAuthorityCacheExpiryDuration": {
      "type": "string"
    },
    "SecurityMSHeartBeatUrl": {
      "type": "string"
    }
  },
  "variables": {
    "azurewebjobstorage": "[concat('@Microsoft.KeyVault(SecretUri=https://',parameters('keyVaultName'),'.vault.azure.net/secrets/',parameters('storageaccountName'),'-connectionstring)')]"


  },
  "resources": [
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2018-11-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "functionapp",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "enabled": true,
        "serverFarmId": "[resourceId(parameters('aseRg'), 'Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "hostingEnvironmentProfile": "[resourceId(parameters('aseRg'), 'Microsoft.Web/hostingEnvironments', parameters('aseName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "appSettings": [
            {
              "name": "LoggingProvider",
              "value": "[parameters('DataDog').LoggingProvider]"
            },
            {
              "name": "DatadogLogsEndpoint",
              "value": "[parameters('DataDog').LogsEndpoint]"
            },
            {
              "name": "DatadogApiKey",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_API_KEY",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_SITE",
              "value": "[parameters('DataDog').Site]"
            },
            {
              "name": "DD_SERVICE",
              "value": "[parameters('appName')]"
            },
            {
              "name": "DD_ENV",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DD_VERSION",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DD_TRACE_ENABLED",
              "value": "[string(parameters('DataDog').TraceEnabled)]"
            },
            {
              "name": "DD_RUNTIME_METRICS_ENABLED",
              "value": "[string(parameters('DataDog').RuntimeMetricsEnabled)]"
            },
            {
              "name": "DatadogService",
              "value": "[parameters('appName')]"
            },
            {
              "name": "environment",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DatadogSource",
              "value": "[parameters('DataDog').Source]"
            },
            {
              "name": "DatadogVersion",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DatadogTags",
              "value": "[concat(parameters('DataDog').Tags, if(empty(parameters('DataDog').Tags), '', ','), 'cloud_provider:azure,subscription_id:', subscription().subscriptionId, ',resource_group:', resourceGroup().name, ',name:', parameters('appName'), ',type:microsoft.web/sites,resource_id:', resourceId('Microsoft.Web/sites', parameters('appName')))]"
            },
            {
              "name": "DatadogBaggageAllowList",
              "value": "[parameters('DataDog').BaggageAllowList]"
            },
            {
              "name": "DatadogMinimumLogLevel",
              "value": "[parameters('DataDog').MinimumLogLevel]"
            },
            {
              "name": "DatadogQueueCapacity",
              "value": "[string(parameters('DataDog').QueueCapacity)]"
            },
            {
              "name": "DatadogBatchSize",
              "value": "[string(parameters('DataDog').BatchSize)]"
            },
            {
              "name": "DatadogFlushIntervalMilliseconds",
              "value": "[string(parameters('DataDog').FlushIntervalMilliseconds)]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', parameters('storageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value)]"
            }
          ]
        },
        "scmSiteAlsoStopped": false,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNamesDisabled": false,
        "containerSize": 1536,
        "dailyMemoryTimeQuota": 0,
        "httpsOnly": true,
        "redundancyMode": "None"
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2018-11-01",
      "name": "[concat(parameters('appName'), '/web')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]"
      ],
      "properties": {
        "numberOfWorkers": 1,
        "defaultDocuments": [
          "Default.htm",
          "Default.html",
          "Default.asp",
          "index.htm",
          "index.html",
          "iisstart.htm",
          "default.aspx",
          "index.php"
        ],
        "netFrameworkVersion": "v10.0",
        "phpVersion": "5.6",
        "requestTracingEnabled": false,
        "remoteDebuggingEnabled": false,
        "httpLoggingEnabled": false,
        "logsDirectorySizeLimit": 35,
        "detailedErrorLoggingEnabled": false,
        "publishingUsername": "$[parameters('appName')]",
        "azureStorageAccounts": {},
        "scmType": "None",
        "use32BitWorkerProcess": true,
        "webSocketsEnabled": false,
        "alwaysOn": true,
        "managedPipelineMode": "Integrated",
        "virtualApplications": [
          {
            "virtualPath": "/",
            "physicalPath": "site\\wwwroot",
            "preloadEnabled": false
          }
        ],
        "loadBalancing": "LeastRequests",
        "experiments": {
          "rampUpRules": []
        },
        "autoHealEnabled": false,
        "cors": {
          "allowedOrigins": [
            "https://functions.azure.com",
            "https://functions-staging.azure.com",
            "https://functions-next.azure.com"
          ],
          "supportCredentials": false
        },
        "localMySqlEnabled": false,
        "ipSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictionsUseMain": false,
        "http20Enabled": false,
        "minTlsVersion": "1.2",
        "ftpsState": "FtpsOnly",
        "reservedInstanceCount": 0
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2021-03-01",
      "name": "[concat(parameters('appName'),'/','appsettings')]",
      "kind": "functionapp,workflowapp",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/accessPolicies', parameters('keyVaultName'),'add')]"
      ],
      "properties": {
        /*App Settings */
        "FUNCTIONS_EXTENSION_VERSION": "~4",
        "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
        "WEBSITE_CONTENTOVERVNET": "1",
        "WEBSITE_VNET_ROUTE_ALL": "1",
        "APPINSIGHTS_INSTRUMENTATIONKEY": "[parameters('appinsightkey')]",
        "APPLICATIONINSIGHTS_CONNECTION_STRING": "[parameters('appinsight_string')]",
        "AzureWebJobsStorage": "[variables('azurewebjobstorage')]",
        "WEBSITE_RUN_FROM_PACKAGE": "[parameters('WEBSITE_RUN_FROM_PACKAGE')]",
        "WEBSITE_LOAD_USER_PROFILE": "[parameters('WEBSITE_LOAD_USER_PROFILE')]",
        "AzureWebJobsSecretStorageType": "[parameters('AzureWebJobsSecretStorageType')]",
        "AzureAd:TenantId": "[parameters('AzureAd:TenantId')]",
        "RedisConnectionString": "[concat(parameters('RedisName'),'.redis.cache.windows.net:6380,password=',listKeys(resourceId('Microsoft.Cache/Redis', parameters('RedisName')), '2016-04-01').primaryKey,',ssl=True,abortConnect=False')]",
        "AgencySlidingExpirationInDay": "[parameters('Appsetting:AgencySlidingExpirationInDay')]",
        "AgencyAbsoluteExpirationInDay": "[parameters('Appsetting:AgencyAbsoluteExpirationInDay')]",
        "SubscriptionCachingSlidingExpirationInDay": "[parameters('Appsetting:SubscriptionCachingSlidingExpirationInDay')]",
        "SubscriptionCachingAbsoluteExpirationInDay": "[parameters('Appsetting:SubscriptionCachingAbsoluteExpirationInDay')]",
        "SecuritySvcOCPKey": "[parameters('AppSetting:SecuritySvcOCPKey')]",
        "SecuritySvcEndPoint": "[parameters('AppSetting:SecuritySvcEndPoint')]",
        "OpenApi__Description": "[parameters('AppSetting:OpenApi__Description')]",
        "OpenApi__HostNames": "[parameters('AppSetting:OpenApi__HostNames')]",
        "OpenApi__DocVersion": "[parameters('AppSetting:OpenApi__DocVersion')]",
        "OpenApi__Version": "[parameters('AppSetting:OpenApi__Version')]",
        "OpenApi__ForceHttps": "[parameters('AppSetting:OpenApi__ForceHttps')]",
        "OpenApi__ForceHttp": "[parameters('AppSetting:OpenApi__ForceHttp')]",
        "OpenApi__Scope": "[parameters('AppSetting:OpenApi__Scope')]",
        "OpenApi__TokenUrl": "[parameters('AppSetting:OpenApi__TokenUrl')]",
        "AzureAd:ClientId": "[parameters('AppSetting:AzureAd:ClientId')]",
        "AzureAd:Instance": "[parameters('AppSetting:AzureAd:Instance')]",
        "AzureAd:TokenV1Issuer": "[parameters('AppSetting:AzureAd:TokenV1Issuer')]",
        "NDCConnectStoredProc": "[parameters('AppSetting:NDCConnectStoredProc')]",
        "NDCConnectAgencyOCNStoredProc": "[parameters('AppSetting:NDCConnectAgencyOCNStoredProc')]",
        "NDCConnectDBConnectionString": "[parameters('AppSetting:NDCConnectDBConnectionString')]",
        "CallSecuritySvcFlag": "true",
        "AgentTktAuthorityEndpointGet": "[parameters('AppSetting:AgentTktAuthorityEndpointGet')]",
        "AgentTktAuthorityEndpointUpdate": "[parameters('AppSetting:AgentTktAuthorityEndpointUpdate')]",
        "AgentTktAuthorityEnv": "[parameters('AppSetting:AgentTktAuthorityEnv')]",
        "AgentTktAuthorityClientId": "[parameters('AppSetting:AgentTktAuthorityClientId')]",
        "AgentTktAuthoritySecretKey": "[parameters('AppSetting:AgentTktAuthoritySecretKey')]",
        "AgentTktAuthorityCacheExpiryDuration": "[parameters('AppSetting:AgentTktAuthorityCacheExpiryDuration')]",
        "SecurityMSHeartBeatUrl": "[parameters('SecurityMSHeartBeatUrl')]",
        "IFGAgentFopLookupUsername": "[parameters('IFGAgentFopLookupUsername')]",
        "IFGAgentFopLookupPassword": "[parameters('IFGAgentFopLookupPassword')]",
        "IFGAgentFopLookupUrl": "[parameters('IFGAgentFopLookupUrl')]"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "apiVersion": "2015-06-01",
      "name": "[concat(parameters('keyvaultName'),'/add')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]"

      ],
      "properties": {
        "accessPolicies": [
          {
            "objectId": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2019-08-01', 'full').identity.principalId]",
            "tenantId": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2019-08-01', 'full').identity.tenantId]",
            "permissions": {
              "secrets": [ "Get", "List", "Set" ]
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Cache/Redis",
      "apiVersion": "2022-06-01",
      "name": "[parameters('redisName')]",
      "location": "northeurope",
      "tags": "[parameters('Tags')]",
      "properties": {
        "redisVersion": "6.0",
        "sku": {
          "name": "Standard",
          "family": "C",
          "capacity": 0
          },
        "enableNonSslPort": false,
        "minimumTlsVersion": "1.2",
        "publicNetworkAccess": "Enabled",
        "redisConfiguration": {
          "maxmemory-reserved": "0",
          "maxfragmentationmemory-reserved": "0",
          "maxmemory-policy": "volatile-lru",
          "maxmemory-delta": "0"
        }
      }
    },

    {
            "type": "Microsoft.Storage/storageAccounts",
            "apiVersion": "2022-09-01",
            "name": "[parameters('storageaccountName2')]",
            "location": "northeurope",
            "sku": {
                "name": "Standard_RAGRS",
                "tier": "Standard"
            },
            "kind": "StorageV2",
            "properties": {
              "allowBlobPublicAccess": false

            }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/tableServices",
      "apiVersion": "2022-09-01",
      "name": "[concat(parameters('storageaccountName2'), '/default')]",
      "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageaccountName2'))]"
            ],
            "properties": {
                "cors": {
                    "corsRules": []
                }
            }
    },
    {
            "type": "Microsoft.Storage/storageAccounts/tableServices/tables",
            "apiVersion": "2022-09-01",
            "name": "[concat(parameters('storageaccountName2'), '/default/', parameters('tablename'))]",
            "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts/tableServices', parameters('storageaccountName2'), 'default')]",
                "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageaccountName2'))]"
            ],
            "properties": {}
        }

  ]
}
