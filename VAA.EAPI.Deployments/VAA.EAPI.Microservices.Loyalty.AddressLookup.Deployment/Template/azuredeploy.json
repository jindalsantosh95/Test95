        "ApiKey": "",
        "Site": "datadoghq.com",
        "Environment": "",
        "Source": "csharp",
        "Version": "",
        "TraceEnabled": true,
        "RuntimeMetricsEnabled": true,
        "Tags": "",
        "BaggageAllowList": "",
        "MinimumLogLevel": "Information",
        "QueueCapacity": 5000,
        "BatchSize": 100,
        "FlushIntervalMilliseconds": 2000
      }
    },
    "AppInsightsName": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "Appsetting:APPLICATIONINSIGHTS_CONNECTION_STRING": {
      "type": "string"
    },
    "Appsetting:EventTopicKey": {
      "type": "string"
    },
    "Appsetting:EventTopicType": {
      "type": "string"
    },
    "Appsetting:EventTopicUrl": {
      "type": "string"
    },
    "Appsetting:FUNCTIONS_EXTENSION_VERSION": {
      "type": "string"
