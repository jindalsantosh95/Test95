        "DeltaMpiApiAuthority": "[parameters('Appsetting:DeltaMpiApiAuthority')]",
        "DeltaMPIApiClientId": "[parameters('Appsetting:DeltaMPIApiClientId')]",
        "DeltaMPIApiClientSecret": "[parameters('Appsetting:DeltaMPIApiClientSecret')]",
        "DeltaMpiApiUrl": "[parameters('Appsetting:DeltaMpiApiUrl')]",
        "OpenApi__DocTitle": "[parameters('Appsetting:OpenApi__DocTitle')]",
        "OpenApi__Description": "[parameters('Appsetting:OpenApi__Description')]",
        "OpenApi__HostNames": "[parameters('Appsetting:OpenApi__HostNames')]",
        "OpenApi__TokenUrl": "[parameters('Appsetting:OpenApi__TokenUrl')]",
        "OpenApi__Scope": "[parameters('Appsetting:OpenApi__Scope')]",
        "OpenApi__DocVersion": "[parameters('Appsetting:OpenApi__DocVersion')]",
        "OpenApi__Version": "[parameters('Appsetting:OpenApi__Version')]",
        "OpenApi__ForceHttps": "[parameters('Appsetting:OpenApi__ForceHttps')]",
        "OpenApi__ForceHttp": "[parameters('Appsetting:OpenApi__ForceHttp')]",
        "MockOrderPaymentService": "[parameters('Appsetting:MockOrderPaymentService')]",
        "EnableMultiplePayment": "[parameters('Appsetting:EnableMultiplePayment')]",
        "PaymentStatusRetryAfterValue": "[parameters('Appsetting:PaymentStatusRetryAfterValue')]",
        "VoidTransactionSubscriptionName": "[parameters('Appsetting:VoidTransactionSubscriptionName')]",
        "Air4PaymentStagingEnvPar": "[parameters('Appsetting:Air4PaymentStagingEnvPar')]",
        "IPRestriction": "[parameters('IPRestriction')]",
        "DlPaymentAuthenticationUrl": "[parameters('DlPaymentAuthenticationUrl')]",
        "DlPaymentApiApplicationId": "[parameters('DlPaymentApiApplicationId')]",
        "DlPaymentApiChannelId": "[parameters('DlPaymentApiChannelId')]",
        "DlPaymentApiGenerateRefIdUri": "[parameters('DlPaymentApiGenerateRefIdUri')]",
        "DlPaymentClientId": "[parameters('DlPaymentClientId')]",
        "DlPaymentClientSecret": "[parameters('DlPaymentClientSecret')]",
        "PRIMockEnabled": "[parameters('PRIMockEnabled')]",
        "DlPaymentobjectName": "[parameters('DlPaymentobjectName')]",
        "DlPaymentApiGetPaymentDetailsUrl": "[parameters('DlPaymentApiGetPaymentDetailsUrl')]",
        "DlPaymentDetailMockEnabled": "[parameters('DlPaymentDetailMockEnabled')]",
        "DlPaymentPurchasePath": "[parameters('DlPaymentPurchasePath')]",
        "DlPaymentApiFormsOfPaymentsUrl": "[parameters('DlPaymentApiFormsOfPaymentsUrl')]",
        "DlPaymentApiVoidUrl": "[parameters('DlPaymentApiVoidUrl')]",
        "MockVoidPaymentService": "[parameters('MockVoidPaymentService')]",
        "DlPaymentApiCaptureUrl": "[parameters('DlPaymentApiCaptureUrl')]",
        "MspFinancialInstAccountHolderName": "[parameters('MspFinancialInstAccountHolderName')]",
        "MspFinancialInstProviderId": "[parameters('MspFinancialInstProviderId')]",
        "MspFinancialInstReturnUrl": "[parameters('MspFinancialInstReturnUrl')]",
        "MspFinancialInstcountryCode": "[parameters('MspFinancialInstcountryCode')]",
        "DlGooglePay": "[parameters('DlGooglePay')]",
        "DlformsOfPaymentsGooglePay": "[parameters('DlformsOfPaymentsGooglePay')]",
        "DlPaymentApiPurchaseInsuranceUri": "[parameters('DlPaymentApiPurchaseInsuranceUri')]",
        "DlPurchaseInsuranceUsername": "[parameters('DlPurchaseInsuranceUsername')]",
        "DlPurchaseInsurancePassword": "[parameters('DlPurchaseInsurancePassword')]",
        "AllianzProviderName": "[parameters('AllianzProviderName')]",
        "DlPaymentClearDetailsUrl": "[parameters('DlPaymentClearDetailsUrl')]",
        "ServiceBusTopicClearPaymentDetails": "[parameters('ServiceBusTopicClearPaymentDetails')]",
        "EnableClearCVV": "[parameters('EnableClearCVV')]",
        "SynchronyAuthenticationUrl": "[parameters('SynchronyAuthenticationUrl')]",
