        "CPDAccount": "[parameters('CPDAccount')]",
        "CPDMotoAccount": "[parameters('CPDMotoAccount')]",
        "CPDClientId": "[parameters('CPDClientId')]",
        "PaymentCollection": "[parameters('PaymentCollection')]",
        "PaymentDatabaseName": "[parameters('PaymentDatabaseName')]",
        "PaymentDBEndpoint": "[parameters('PaymentDBEndpoint')]",
        "CPDRefundRequestUrl": "[parameters('CPDRefundRequestUrl')]",
        "CpdBlobStorageUri": "[parameters('CpdBlobStorageUri')]",
        "CpdContainerName": "[parameters('CpdContainerName')]",
        "CpdCountryBlob": "[parameters('CpdCountryBlob')]",
        "CpdBlobStorageSaSKey": "[parameters('CpdBlobStorageSaSKey')]",
        "RetryCount": "[parameters('RetryCount')]",
