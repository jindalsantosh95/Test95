{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "DataDog": {
      "type": "secureObject",
      "defaultValue": {
        "LoggingProvider": "AppInsights",
        "LogsEndpoint": "https://http-intake.logs.datadoghq.com/api/v2/logs",
        "ApiKey": "",
        "Site": "datadoghq.com",
        "Environment": "",
        "Source": "csharp",
        "Version": "",
        "TraceEnabled": true,
        "RuntimeMetricsEnabled": true,
        "Tags": "",
        "BaggageAllowList": "",
        "MinimumLogLevel": "Information",
        "QueueCapacity": 5000,
        "BatchSize": 100,
        "FlushIntervalMilliseconds": 2000
      }
    },
    "AppInsightsName": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "EnvironmentName": {
      "type": "string"
    },
    "FunctionAppName": {
      "type": "String"
    },
    "IPRestriction": {
      "type": "string"
    },
    "ServerFarmIdRg": {
      "type": "string"
    },
    "Appsetting:FUNCTIONS_EXTENSION_VERSION": {
      "type": "string"
    },
    "Appsetting:FUNCTIONS_WORKER_RUNTIME": {
      "type": "string"
    },
    "Appsettings:AppInsightsKey": {
      "type": "string"
    },
    "Appsetting:AzureWebJobsSecretStorageType": {
      "type": "string"
    },
    "Appsetting:APPLICATIONINSIGHTS_CONNECTION_STRING": {
      "type": "string"
    },
    "Appsettings:WEBSITE_CONTENTSHARE": {
      "type": "string"
    },
    "vaultName": {
      "type": "string"
    },
    "AzureWebJobsStorage": {
      "type": "string"
    },


    "SlotName": {
      "type": "string"
    },
    "actionGroupsServiceNow": {
      "type": "string"
    },
    "actionGroupsEAPISupport": {
      "type": "string"
    },
    "emailAddressServiceNow": {
      "type": "string"
    },
    "emailAddressEAPISupport": {
      "type": "string"
    },
    "ResourceGroupSubscriptionId": {
      "type": "string"
    },


    //Microservice Storage Account
    "Appsettings:MicroServiceDBKey": {
      "type": "string"
    },
    "Appsettings:MicroServiceEventStoreTableName": {
      "type": "string"
    },
    "Appsettings:MicroServiceResponseTableName": {
      "type": "string"
    },
    "storageAccountName": {
      "type": "string"
    },

    // Service Bus
    "Appsetting:ServiceBusConnectionString": {
      "type": "string"
    },

    //Azure Active Directory
    "AzureAd:ClientId": {
      "type": "string"
    },
    "AzureAd:Instance": {
      "type": "string"
    },
    "AzureAd:TenantId": {
      "type": "string"
    },
    "AzureAd:TokenV1Issuer": {
      "type": "string"
    },

    //Azure B2C settings
    "AzureAdB2C:ClientId": {
      "type": "string"
    },
    "AzureAdB2C:Instance": {
      "type": "string"
    },
    "AzureAdB2C:SignUpSignInPolicyId": {
      "type": "string"
    },
    "AzureAdB2C:TenantId": {
      "type": "string"
    },
    "AzureAdB2C:TokenV1Issuer": {
      "type": "string"
    },

    // Enviromental settings
    "Appsetting:ApimSubscriptionApiClientId": {
      "type": "string"
    },
    "Appsetting:ApimSubscriptionApiClientSecret": {
      "type": "string"
    },
    "Appsetting:ApimSubscriptionApiResource": {
      "type": "string"
    },
    "Appsetting:ApimSubscriptionCreateResponseUrl": {
      "type": "string"
    },
    "Appsetting:ApimSubscriptionUpdateResponseUrl": {
      "type": "string"
    },
    "Appsetting:ApimSubscriptionDeleteResponseUrl": {
      "type": "string"
    },
    "Appsettings:ShopsAwayAESSecret": {
      "type": "string"
    },

    //Command Status
    "Appsetting:ResponseDelayTimeInMS": {
      "type": "string"
    },
    "Appsetting:ResponsePollingCount": {
      "type": "string"
    },
    "Appsetting:WEBSITE_VNET_ROUTE_ALL": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_ALT_SERVER": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_SERVER": {
      "type": "string"
    },
    "tags": {
      "type": "Object"
    },

    //swagger settings
    "OpenApi__Description": {
      "type": "string"
    },
    "OpenApi__DocTitle": {
      "type": "string"
    },
    "OpenApi__DocVersion": {
      "type": "string"
    },
    "OpenApi__ForceHttp": {
      "type": "bool"
    },
    "OpenApi__ForceHttps": {
      "type": "bool"
    },
    "OpenApi__Scope": {
      "type": "string"
    },
    "OpenApi__TokenUrl": {
      "type": "string"
    },
    "OpenApi__Version": {
      "type": "string"
    }
  },
  "variables": {
    "ResourceLocation": "[resourceGroup().location]",
    "SiteResourceID": "[resourceId('Microsoft.Web/Sites', parameters('FunctionAppName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2018-11-01",
      "name": "[parameters('FunctionAppName')]",
      "location": "[variables('ResourceLocation')]",
      "kind": "functionapp",
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },
      "tags": "[parameters('tags')]",
      "properties": {
        "enabled": true,
        "hostNameSslStates": [
          {
            "name": "[concat(parameters('FunctionAppName'), '.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Standard"
          },
          {
            "name": "[concat(parameters('FunctionAppName'), '.scm.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Repository"
          }
        ],
        "serverFarmId": "[resourceId(parameters('ServerFarmIdRg'), 'Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "appSettings": [
            {
              "name": "LoggingProvider",
              "value": "[parameters('DataDog').LoggingProvider]"
            },
            {
              "name": "DatadogLogsEndpoint",
              "value": "[parameters('DataDog').LogsEndpoint]"
            },
            {
              "name": "DatadogApiKey",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_API_KEY",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_SITE",
              "value": "[parameters('DataDog').Site]"
            },
            {
              "name": "DD_SERVICE",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "DD_ENV",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DD_VERSION",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DD_TRACE_ENABLED",
              "value": "[string(parameters('DataDog').TraceEnabled)]"
            },
            {
              "name": "DD_RUNTIME_METRICS_ENABLED",
              "value": "[string(parameters('DataDog').RuntimeMetricsEnabled)]"
            },
            {
              "name": "DatadogService",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "environment",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DatadogSource",
              "value": "[parameters('DataDog').Source]"
            },
            {
              "name": "DatadogVersion",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DatadogTags",
              "value": "[concat(parameters('DataDog').Tags, if(empty(parameters('DataDog').Tags), '', ','), 'cloud_provider:azure,subscription_id:', subscription().subscriptionId, ',resource_group:', resourceGroup().name, ',name:', parameters('FunctionAppName'), ',type:microsoft.web/sites,resource_id:', resourceId('Microsoft.Web/sites', parameters('FunctionAppName')))]"
            },
            {
              "name": "DatadogBaggageAllowList",
              "value": "[parameters('DataDog').BaggageAllowList]"
            },
            {
              "name": "DatadogMinimumLogLevel",
              "value": "[parameters('DataDog').MinimumLogLevel]"
            },
            {
              "name": "DatadogQueueCapacity",
              "value": "[string(parameters('DataDog').QueueCapacity)]"
            },
            {
              "name": "DatadogBatchSize",
              "value": "[string(parameters('DataDog').BatchSize)]"
            },
            {
              "name": "DatadogFlushIntervalMilliseconds",
              "value": "[string(parameters('DataDog').FlushIntervalMilliseconds)]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "[parameters('Appsetting:FUNCTIONS_EXTENSION_VERSION')]"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "dotnet-isolated"
            },
            {
              "name": "ShopsAwayAESSecret",
              "value": "[parameters('Appsettings:ShopsAwayAESSecret')]"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[parameters('Appsettings:AppInsightsKey')]"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageAccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]"
            },
            {
              "name": "AzureWebJobsSecretStorageType",
              "value": "[parameters('Appsetting:AzureWebJobsSecretStorageType')]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[parameters('Appsetting:APPLICATIONINSIGHTS_CONNECTION_STRING')]"
            },
            {
              "name": "WEBSITE_CONTENTSHARE",
              "value": "[parameters('Appsettings:WEBSITE_CONTENTSHARE')]"
            },
            //Microservice Storage Account
            {
              "name": "MicroServiceDBKey",
              "value": "[parameters('Appsettings:MicroServiceDBKey')]"
            },
            {
              "name": "MicroServiceEventStoreTableName",
              "value": "[parameters('Appsettings:MicroServiceEventStoreTableName')]"
            },
            {
              "name": "MicroServiceResponseTableName",
              "value": "[parameters('Appsettings:MicroServiceResponseTableName')]"
            },
            //Service Bus
            {
              "name": "ServiceBusConnectionString",
              "value": "[parameters('Appsetting:ServiceBusConnectionString')]"
            },
            //Azure Active Directory
            {
              "name": "AzureAd:ClientId",
              "value": "[parameters('AzureAd:ClientId')]"
            },
            {
              "name": "AzureAd:Instance",
              "value": "[parameters('AzureAd:Instance')]"
            },
            {
              "name": "AzureAd:TenantId",
              "value": "[parameters('AzureAd:TenantId')]"
            },
            {
              "name": "AzureAd:TokenV1Issuer",
              "value": "[parameters('AzureAd:TokenV1Issuer')]"
            },
            //Azure B2C Settings
            {
              "name": "AzureAdB2C:ClientId",
              "value": "[parameters('AzureAdB2C:ClientId')]"
            },
            {
              "name": "AzureAdB2C:Instance",
              "value": "[parameters('AzureAdB2C:Instance')]"
            },
            {
              "name": "AzureAdB2C:SignUpSignInPolicyId",
              "value": "[parameters('AzureAdB2C:SignUpSignInPolicyId')]"
            },
            {
              "name": "AzureAdB2C:TenantId",
              "value": "[parameters('AzureAdB2C:TenantId')]"
            },
            {
              "name": "AzureAdB2C:TokenV1Issuer",
              "value": "[parameters('AzureAdB2C:TokenV1Issuer')]"
            },
            // Enviromental settings
            {
              "name": "ApimSubscriptionApiClientId",
              "value": "[parameters('Appsetting:ApimSubscriptionApiClientId')]"
            },
            {
              "name": "ApimSubscriptionApiClientSecret",
              "value": "[parameters('Appsetting:ApimSubscriptionApiClientSecret')]"
            },
            {
              "name": "ApimSubscriptionApiResource",
              "value": "[parameters('Appsetting:ApimSubscriptionApiResource')]"
            },
            {
              "name": "ApimSubscriptionCreateResponseUrl",
              "value": "[parameters('Appsetting:ApimSubscriptionCreateResponseUrl')]"
            },
            {
              "name": "ApimSubscriptionUpdateResponseUrl",
              "value": "[parameters('Appsetting:ApimSubscriptionUpdateResponseUrl')]"
            },
            {
              "name": "ApimSubscriptionDeleteResponseUrl",
              "value": "[parameters('Appsetting:ApimSubscriptionDeleteResponseUrl')]"
            },
            //Command Status
            {
              "name": "ResponseDelayTimeInMS",
              "value": "[parameters('Appsetting:ResponseDelayTimeInMS')]"
            },
            {
              "name": "ResponsePollingCount",
              "value": "[parameters('Appsetting:ResponsePollingCount')]"
            },
            {
              "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageAccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]"
            },
            {
              "name": "WEBSITE_VNET_ROUTE_ALL",
              "value": "[parameters('Appsetting:WEBSITE_VNET_ROUTE_ALL')]"
            },
            {
              "name": "WEBSITE_DNS_ALT_SERVER",
              "value": "[parameters('Appsetting:WEBSITE_DNS_ALT_SERVER')]"
            },
            {
              "name": "WEBSITE_DNS_SERVER",
              "value": "[parameters('Appsetting:WEBSITE_DNS_SERVER')]"
            },
            //swagger settings
            {
              "name": "OpenApi__Scope",
              "value": "[parameters('OpenApi__Scope')]"
            },
            {
              "name": "OpenApi__TokenUrl",
              "value": "[parameters('OpenApi__TokenUrl')]"
            },
            {
              "name": "OpenApi__DocTitle",
              "value": "[parameters('OpenApi__DocTitle')]"
            },
            {
              "name": "OpenApi__Description",
              "value": "[parameters('OpenApi__Description')]"
            },
            {
              "name": "OpenApi__DocVersion",
              "value": "[parameters('OpenApi__DocVersion')]"
            },
            {
              "name": "OpenApi__Version",
              "value": "[parameters('OpenApi__Version')]"
            },
            {
              "name": "OpenApi__ForceHttps",
              "value": "[parameters('OpenApi__ForceHttps')]"
            },
            {
              "name": "OpenApi__ForceHttp",
              "value": "[parameters('OpenApi__ForceHttp')]"
            }
          ]
        },
        "scmSiteAlsoStopped": false,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNamesDisabled": false,
        "containerSize": 1536,
        "dailyMemoryTimeQuota": 0,
        "httpsOnly": true,
        "redundancyMode": "None"
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2018-11-01",
      "name": "[concat(parameters('FunctionAppName'), '/web')]",
      "location": "North Europe",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]"
      ],
      "properties": {
        "numberOfWorkers": 1,
        "defaultDocuments": [
          "Default.htm",
          "Default.html",
          "Default.asp",
          "index.htm",
          "index.html",
          "iisstart.htm",
          "default.aspx",
          "index.php"
        ],
        "netFrameworkVersion": "v10.0",
        "phpVersion": "5.6",
        "requestTracingEnabled": false,
        "remoteDebuggingEnabled": false,
        "httpLoggingEnabled": false,
        "logsDirectorySizeLimit": 35,
        "detailedErrorLoggingEnabled": false,
        "publishingUsername": "$[parameters('FunctionAppName')]",
        "azureStorageAccounts": {},
        "scmType": "None",
        "use32BitWorkerProcess": false,
        "webSocketsEnabled": false,
        "alwaysOn": true,
        "managedPipelineMode": "Integrated",
        "virtualApplications": [
          {
            "virtualPath": "/",
            "physicalPath": "site\\wwwroot",
            "preloadEnabled": true
          }
        ],
        "loadBalancing": "LeastRequests",
        "experiments": {
          "rampUpRules": []
        },
        "autoHealEnabled": false,
        "cors": {
          "allowedOrigins": [
            "https://functions.azure.com",
            "https://functions-staging.azure.com",
            "https://functions-next.azure.com"
          ],
          "supportCredentials": false
        },
        "localMySqlEnabled": false,
        "ipSecurityRestrictions": [
          {
            "ipAddress": "[parameters('IPRestriction')]",
            "action": "Allow",
            "priority": 1,
            "name": "Allow_APIM",
            "description": "Allow APIM access"
          }
        ],
        "scmIpSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictionsUseMain": false,
        "http20Enabled": false,
        "minTlsVersion": "1.2",
        "ftpsState": "AllAllowed",
        "reservedInstanceCount": 0
      }
    },
    {
      "type": "Microsoft.Web/sites/hostNameBindings",
      "apiVersion": "2018-11-01",
      "name": "[concat(parameters('FunctionAppName'), '/', parameters('FunctionAppName'), '.azurewebsites.net')]",
      "location": "North Europe",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]"
      ],
      "properties": {
        "siteName": "[parameters('FunctionAppName')]",
        "hostNameType": "Verified"
      }
    },
    {
      "type": "microsoft.insights/components",
      "kind": "web",
      "name": "[parameters('AppInsightsName')]",
      "apiVersion": "2015-05-01",
      "location": "[Variables('ResourceLocation')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "applicationId": "[variables('SiteResourceID')]",
        "Application_Type": "web"
      },
      "dependsOn": [ "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]" ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "name": "[concat(parameters('vaultName'), '/add')]",
      "apiVersion": "2019-09-01",
      "properties": {
        "accessPolicies": [
          {
            "tenantId": "[reference(concat('Microsoft.Web/sites/', parameters('FunctionAppName')), '2018-02-01','Full').identity.tenantId]",
            "objectId": "[reference(concat('Microsoft.Web/sites/', parameters('FunctionAppName')), '2018-02-01','Full').identity.principalId]",
            "permissions": {
              "keys": [ "Get", "List" ],
              "secrets": [ "Get", "List" ],
              "certificates": [ "Get", "List" ],
              "storage": [ "all" ]
            }
          }
        ]
      }
    }
  ]
}
