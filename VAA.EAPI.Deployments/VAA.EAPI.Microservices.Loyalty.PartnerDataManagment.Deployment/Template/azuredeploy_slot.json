{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "DataDog": {
      "type": "secureObject",
      "defaultValue": {
        "LoggingProvider": "AppInsights",
        "LogsEndpoint": "https://http-intake.logs.datadoghq.com/api/v2/logs",
        "ApiKey": "",
        "Site": "datadoghq.com",
        "Service": "",
        "Environment": "",
        "Source": "csharp",
        "Version": "",
        "TraceEnabled": true,
        "RuntimeMetricsEnabled": true,
        "Tags": "",
        "BaggageAllowList": "",
        "MinimumLogLevel": "Information",
        "QueueCapacity": 5000,
        "BatchSize": 100,
        "FlushIntervalMilliseconds": 2000
      }
    },
    // Deployment Settings
    "FunctionAppName": {
      "type": "String"
    },
    "EnvironmentName": {
      "type": "string"
    },
    "ServerFarmIdRg": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "storageAccountName": {
      "type": "string"
    },
    "vaultName": {
      "type": "string"
    },
    "AppInsightsName": {
      "type": "string"
    },
    "ResourceGroupSubscriptionId": {
      "type": "string"
    },
    "tags": {
      "type": "Object"
    },
    "SlotName": {
      "type": "string"
    },
    "IPRestriction": {
      "type": "string"
    },
    "actionGroupsServiceNow": {
      "type": "string"
    },
    "actionGroupsEAPISupport": {
      "type": "string"
    },
    "emailAddressServiceNow": {
      "type": "string"
    },
    "emailAddressEAPISupport": {
      "type": "string"
    },
    // Azure Function Settings
    "AppSetting:AzureWebJobsStorage": {
      "type": "string"
    },
    "AppSetting:AzureWebJobsSecretStorageType": {
      "type": "string"
    },
    "AppSetting:WEBSITE_CONTENTSHARE": {
      "type": "string"
    },
    "AppSetting:FUNCTIONS_EXTENSION_VERSION": {
      "type": "string"
    },
    "AppSetting:FUNCTIONS_WORKER_RUNTIME": {
      "type": "string"
    },
    // Swagger / OpenApi
    "Appsetting:OpenApi__Scope": {
      "type": "string"
    },
    "Appsetting:OpenApi__TokenUrl": {
      "type": "string"
    },
    "Appsetting:OpenApi__DocTitle": {
      "type": "string"
    },
    "Appsetting:OpenApi__Description": {
      "type": "string"
    },
    "Appsetting:OpenApi__DocVersion": {
      "type": "string"
    },
    "Appsetting:OpenApi__HostNames": {
      "type": "string"
    },
    "Appsetting:OpenApi__Version": {
      "type": "string"
    },
    "Appsetting:OpenApi__ForceHttps": {
      "type": "string"
    },
    "Appsetting:OpenApi__ForceHttp": {
      "type": "string"
    },
    //PDM settings

    "Appsetting:AutoRetroResetDuration": {
      "type": "string"
    },
    "Appsetting:AutoRetroTimerChrone": {
      "type": "string"
    },
    "Appsetting:ClientIDFlightAPI": {
      "type": "string"
    },
    "Appsetting:ClientSecrectFlightAPI": {
      "type": "string"
    },
    "Appsetting:CodeShareFlightApiUrl": {
      "type": "string"
    },
    "Appsetting:ResourceIDMemberApi": {
      "type": "string"
    },
    "Appsetting:subscriptionKeyMemberApi": {
      "type": "string"
    },
    "Appsetting:authUrlApi": {
      "type": "string"
    },
    "Appsetting:tenantNameApi": {
      "type": "string"
    },
    "Appsetting:FlownSQLDBConnString": {
      "type": "string"
    },
    "Appsetting:ExcludeEnvironmentCredential": {
      "type": "string"
    },
    "Appsetting:ExcludeManagedIdentityCredential": {
      "type": "string"
    },
    "Appsetting:ExcludeVisualStudioCredential": {
      "type": "string"
    },
    "Appsetting:RetroDurationinDays": {
      "type": "string"
    },
    "Appsetting:AzureAd:ClientId": {
      "type": "string"
    },
    "Appsetting:AzureAd:Instance": {
      "type": "string"
    },
    "Appsetting:AzureAd:TenantId": {
      "type": "string"
    },
    "Appsetting:AzureAd:TokenV1Issuer": {
      "type": "string"
    },

    //Azure B2C settings
    "Appsetting:AzureAdB2C:ClientId": {
      "type": "string"
    },
    "Appsetting:AzureAdB2C:Instance": {
      "type": "string"
    },
    "Appsetting:AzureAdB2C:SignUpSignInPolicyId": {
      "type": "string"
    },
    "Appsetting:AzureAdB2C:TenantId": {
      "type": "string"
    },
    "Appsetting:AzureAdB2C:TokenV1Issuer": {
      "type": "string"
    },
    "Appsetting:NonAccrualVSClasses": {
      "type": "string"
    },
    "Appsetting:ServiceBusConnectionString": {
      "type": "string"
    },
    "Appsetting:MicroServiceDBKey": {
      "type": "string"
    },
    "Appsetting:MicroServiceEventStoreTableName": {
      "type": "string"
    },
    "Appsetting:OrderMSServiceBusConnectionString": {
      "type": "string"
    },
    "Appsetting:ReferenceMicroServiceDBKey": {
      "type": "string"
    },
    "Appsetting:AutoAccrualFallbackSchedule": {
      "type": "string"
    },
    "Appsetting:AutoAccrualFallbackDepartureThresholdDays": {
      "type": "string"
    },
    "Appsetting:SkyTeamPartnerCacheExpiryHours": {
      "type": "string"
    },
    "Appsetting:SkyTeamKafkaBootstrapServers": {
      "type": "string"
    },
    "Appsetting:AccrualOutboundKafkaTopic": {
      "type": "string"
    },
    "Appsetting:AccrualInboundKafkaTopic": {
      "type": "string"
    },
    "Appsetting:AutoAccrualFeedbackOutboundKafkaTopic": {
      "type": "string"
    },
    "Appsetting:SkyTeamPgpPublicKey": {
      "type": "string"
    },
    "Appsetting:VsPgpPrivateKey": {
      "type": "string"
    },
    "Appsetting:SkyTeamKafkaConsumerGroup": {
      "type": "string"
    },
    "Appsetting:AutoAccrualFeedbackOutboundKafkaConsumerGroup": {
      "type": "string"
    },
    "Appsetting:AccrualPgpEncryptionKeyId": {
      "type": "string"
    },
    "Appsetting:SkyTeamInboundDataTableName": {
      "type": "string"
    },
    "Appsetting:VSClaimInputValidationBlobStorageUri": {
      "type": "string"
    },
    "Appsetting:VSClaimInputValidationBlobSasKey": {
      "type": "string"
    },
    "Appsetting:VSClaimInputValidationBlobContainerName": {
      "type": "string"
    },
    "Appsetting:SkyTeamInboundAccrualMessageLookupTableName": {
      "type": "string"
    },
    "Appsetting:LoyaltyMemberManagementTopicName": {
      "type": "string"
    }
  },
  "variables": {
    "AppInsightsName": "[parameters('AppInsightsName')]",
    "ResourceLocation": "[resourceGroup().location]",
    "SiteResourceID": "[resourceId('Microsoft.Web/Sites', parameters('FunctionAppName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2021-09-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[variables('ResourceLocation')]",
      "tags": "[parameters('Tags')]",
      "sku": {
        "name": "Standard_RAGRS",
        "tier": "Standard"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false
      }
    },
    {
      "type": "microsoft.insights/components",
      "kind": "web",
      "name": "[parameters('AppInsightsName')]",
      "apiVersion": "2015-05-01",
      "location": "[Variables('ResourceLocation')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "applicationId": "[variables('SiteResourceID')]",
        "Application_Type": "web"
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "kind": "functionapp",
      "name": "[parameters('FunctionAppName')]",
      "apiVersion": "2021-03-01",
      "location": "[variables('ResourceLocation')]",
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]"
      },
      "tags": "[parameters('Tags')]"
    },      
    {
      "type": "Microsoft.Web/sites/slots",
      "kind": "functionapp",
      "name": "[concat(parameters('FunctionAppName'), '/',parameters('SlotName'))]",
      "apiVersion": "2021-03-01",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [ "[variables('SiteResourceID')]" ],
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },
      "properties": {
        "enabled": true,
        "hostNameSslStates": [
          {
            "name": "[concat(parameters('FunctionAppName'), '-',parameters('SlotName'), '.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Standard"
          },
          {
            "name": "[concat(parameters('FunctionAppName'), '-',parameters('SlotName'), '.scm.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Repository"
          }
        ],
        "serverFarmId": "[resourceId('Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "alwaysOn": true,
          "appSettings": [
            {
              "name": "LoggingProvider",
              "value": "[parameters('DataDog').LoggingProvider]"
            },
            {
              "name": "DatadogLogsEndpoint",
              "value": "[parameters('DataDog').LogsEndpoint]"
            },
            {
              "name": "DatadogApiKey",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_API_KEY",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_SITE",
              "value": "[parameters('DataDog').Site]"
            },
            {
              "name": "DD_SERVICE",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "DD_ENV",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DD_VERSION",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DD_TRACE_ENABLED",
              "value": "[string(parameters('DataDog').TraceEnabled)]"
            },
            {
              "name": "DD_RUNTIME_METRICS_ENABLED",
              "value": "[string(parameters('DataDog').RuntimeMetricsEnabled)]"
            },
            {
              "name": "DatadogService",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "environment",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DatadogSource",
              "value": "[parameters('DataDog').Source]"
            },
            {
              "name": "DatadogVersion",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DatadogTags",
              "value": "[concat(parameters('DataDog').Tags, if(empty(parameters('DataDog').Tags), '', ','), 'cloud_provider:azure,subscription_id:', subscription().subscriptionId, ',resource_group:', resourceGroup().name, ',name:', parameters('FunctionAppName'), '/', parameters('SlotName'), ',type:microsoft.web/sites/slots,resource_id:', resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName')))]"
            },
            {
              "name": "DatadogBaggageAllowList",
              "value": "[parameters('DataDog').BaggageAllowList]"
            },
            {
              "name": "DatadogMinimumLogLevel",
              "value": "[parameters('DataDog').MinimumLogLevel]"
            },
            {
              "name": "DatadogQueueCapacity",
              "value": "[string(parameters('DataDog').QueueCapacity)]"
            },
            {
              "name": "DatadogBatchSize",
              "value": "[string(parameters('DataDog').BatchSize)]"
            },
            {
              "name": "DatadogFlushIntervalMilliseconds",
              "value": "[string(parameters('DataDog').FlushIntervalMilliseconds)]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "1"
            },
            {
              "name": "WEBSITE_LOAD_USER_PROFILE",
              "value": "1"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "dotnet-isolated"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('AppInsightsName')), '2014-04-01').InstrumentationKey]"
            },
            {
              "name": "AzureWebJobsSecretStorageType",
              "value": "[parameters('AppSetting:AzureWebJobsSecretStorageType')]"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageAccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]"
            },
            {
              "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageAccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]"
            },
            {
              "name": "WEBSITE_CONTENTSHARE",
              "value": "[parameters('AppSetting:WEBSITE_CONTENTSHARE')]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('AppInsightsName')), '2020-02-02').ConnectionString]"
            },
            //swagger settings
            {
              "name": "OpenApi__DocTitle",
              "value": "[parameters('Appsetting:OpenApi__DocTitle')]"
            },
            {
              "name": "OpenApi__Description",
              "value": "[parameters('Appsetting:OpenApi__Description')]"
            },
            {
              "name": "OpenApi__DocVersion",
              "value": "[parameters('Appsetting:OpenApi__DocVersion')]"
            },
            {
              "name": "OpenApi__Version",
              "value": "[parameters('Appsetting:OpenApi__Version')]"
            },
            {
              "name": "OpenApi__TokenUrl",
              "value": "[parameters('Appsetting:OpenApi__TokenUrl')]"
            },
            {
              "name": "OpenApi__Scope",
              "value": "[parameters('Appsetting:OpenApi__Scope')]"
            },
            {
              "name": "OpenApi__ForceHttps",
              "value": "[parameters('Appsetting:OpenApi__ForceHttps')]"
            },
            {
              "name": "OpenApi__ForceHttp",
              "value": "[parameters('Appsetting:OpenApi__ForceHttp')]"
            },
            //pdm settings

            {
              "name": "AutoRetroResetDuration",
              "value": "[parameters('Appsetting:AutoRetroResetDuration')]"
            },
            {
              "name": "AutoRetroTimerChrone",
              "value": "[parameters('Appsetting:AutoRetroTimerChrone')]"
            },
            {
              "name": "ClientIDFlightAPI",
              "value": "[parameters('Appsetting:ClientIDFlightAPI')]"
            },
            {
              "name": "ClientSecrectFlightAPI",
              "value": "[parameters('Appsetting:ClientSecrectFlightAPI')]"
            },
            {
              "name": "CodeShareFlightApiUrl",
              "value": "[parameters('Appsetting:CodeShareFlightApiUrl')]"
            },
            {
              "name": "ResourceIDMemberApi",
              "value": "[parameters('Appsetting:ResourceIDMemberApi')]"
            },
            {
              "name": "subscriptionKeyMemberApi",
              "value": "[parameters('Appsetting:subscriptionKeyMemberApi')]"
            },
            {
              "name": "authUrlApi",
              "value": "[parameters('Appsetting:authUrlApi')]"
            },
            {
              "name": "tenantNameApi",
              "value": "[parameters('Appsetting:tenantNameApi')]"
            },
            {
              "name": "FlownSQLDBConnString",
              "value": "[parameters('Appsetting:FlownSQLDBConnString')]"
            },
            {
              "name": "ExcludeEnvironmentCredential",
              "value": "[parameters('Appsetting:ExcludeEnvironmentCredential')]"
            },
            {
              "name": "ExcludeManagedIdentityCredential",
              "value": "[parameters('Appsetting:ExcludeManagedIdentityCredential')]"
            },
            {
              "name": "ExcludeVisualStudioCredential",
              "value": "[parameters('Appsetting:ExcludeVisualStudioCredential')]"
            },
            {
              "name": "RetroDurationinDays",
              "value": "[parameters('Appsetting:RetroDurationinDays')]"
            },
            {
              "name": "AzureAd:ClientId",
              "value": "[parameters('Appsetting:AzureAd:ClientId')]"
            },
            {
              "name": "AzureAd:Instance",
              "value": "[parameters('Appsetting:AzureAd:Instance')]"
            },
            {
              "name": "AzureAd:TenantId",
              "value": "[parameters('Appsetting:AzureAd:TenantId')]"
            },
            {
              "name": "AzureAd:TokenV1Issuer",
              "value": "[parameters('Appsetting:AzureAd:TokenV1Issuer')]"
            },

            //Azure B2C settings 

            {
              "name": "AzureAdB2C:ClientId",
              "value": "[parameters('Appsetting:AzureAdB2C:ClientId')]"
            },
            {
              "name": "AzureAdB2C:Instance",
              "value": "[parameters('Appsetting:AzureAdB2C:Instance')]"
            },
            {
              "name": "AzureAdB2C:SignUpSignInPolicyId",
              "value": "[parameters('Appsetting:AzureAdB2C:SignUpSignInPolicyId')]"
            },
            {
              "name": "AzureAdB2C:TenantId",
              "value": "[parameters('Appsetting:AzureAdB2C:TenantId')]"
            },
            {
              "name": "AzureAdB2C:TokenV1Issuer",
              "value": "[parameters('Appsetting:AzureAdB2C:TokenV1Issuer')]"
            },
            {
              "name": "NonAccrualVSClasses",
              "value": "[parameters('Appsetting:NonAccrualVSClasses')]"
            },
            {
              "name": "ServiceBusConnectionString",
              "value": "[parameters('Appsetting:ServiceBusConnectionString')]"
            },
            {
              "name": "MicroServiceDBKey",
              "value": "[parameters('Appsetting:MicroServiceDBKey')]"
            },
            {
              "name": "MicroServiceEventStoreTableName",
              "value": "[parameters('Appsetting:MicroServiceEventStoreTableName')]"
            },
            {
              "name": "OrderMSServiceBusConnectionString",
              "value": "[parameters('Appsetting:OrderMSServiceBusConnectionString')]"
            },
            {
              "name": "ReferenceMicroServiceDBKey",
              "value": "[parameters('Appsetting:ReferenceMicroServiceDBKey')]"
            },
            {
              "name": "AutoAccrualFallbackSchedule",
              "value": "[parameters('Appsetting:AutoAccrualFallbackSchedule')]"
            },
            {
              "name": "AutoAccrualFallbackDepartureThresholdDays",
              "value": "[parameters('Appsetting:AutoAccrualFallbackDepartureThresholdDays')]"
            },
            {
              "name": "SkyTeamPartnerCacheExpiryHours",
              "value": "[parameters('Appsetting:SkyTeamPartnerCacheExpiryHours')]"
            },
            {
              "name": "SkyTeamKafkaBootstrapServers",
              "value": "[parameters('Appsetting:SkyTeamKafkaBootstrapServers')]"
            },
            {
              "name": "AccrualOutboundKafkaTopic",
              "value": "[parameters('Appsetting:AccrualOutboundKafkaTopic')]"
            },
            {
              "name": "AccrualInboundKafkaTopic",
              "value": "[parameters('Appsetting:AccrualInboundKafkaTopic')]"
            },
            {
              "name": "AutoAccrualFeedbackOutboundKafkaTopic",
              "value": "[parameters('Appsetting:AutoAccrualFeedbackOutboundKafkaTopic')]"
            },
            {
              "name": "SkyTeamPgpPublicKey",
              "value": "[parameters('Appsetting:SkyTeamPgpPublicKey')]"
            },
            {
              "name": "VsPgpPrivateKey",
              "value": "[parameters('Appsetting:VsPgpPrivateKey')]"
            },
            {
              "name": "SkyTeamKafkaConsumerGroup",
              "value": "[parameters('Appsetting:SkyTeamKafkaConsumerGroup')]"
            },
            {
              "name": "AutoAccrualFeedbackOutboundKafkaConsumerGroup",
              "value": "[parameters('Appsetting:AutoAccrualFeedbackOutboundKafkaConsumerGroup')]"
            },
            {
              "name": "AccrualPgpEncryptionKeyId",
              "value": "[parameters('Appsetting:AccrualPgpEncryptionKeyId')]"
            },
            {
              "name": "SkyTeamInboundDataTableName",
              "value": "[parameters('Appsetting:SkyTeamInboundDataTableName')]"
            },
            {
              "name": "VSClaimInputValidationBlobStorageUri",
              "value": "[parameters('Appsetting:VSClaimInputValidationBlobStorageUri')]"
            },
            {
              "name": "VSClaimInputValidationBlobSasKey",
              "value": "[parameters('Appsetting:VSClaimInputValidationBlobSasKey')]"
            },
            {
              "name": "VSClaimInputValidationBlobContainerName",
              "value": "[parameters('Appsetting:VSClaimInputValidationBlobContainerName')]"
            },
            {
              "name": "SkyTeamInboundAccrualMessageLookupTableName",
              "value": "[parameters('Appsetting:SkyTeamInboundAccrualMessageLookupTableName')]"
            },
            {
              "name": "LoyaltyMemberManagementTopicName",
              "value": "[parameters('Appsetting:LoyaltyMemberManagementTopicName')]"
            }
          ]
        },
        "scmSiteAlsoStopped": false,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNamesDisabled": false,
        "containerSize": 1536,
        "dailyMemoryTimeQuota": 0,
        "httpsOnly": true,
        "redundancyMode": "None"
       
      },
      "tags": "[parameters('Tags')]"
    },
    {
      "type": "Microsoft.Web/sites/slots/config",
      "apiVersion": "2021-03-01",
      "name": "[concat(parameters('FunctionAppName'), '/',parameters('SlotName'),'/web')]",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName'))]",
        "[variables('SiteResourceID')]"
      ],
      "properties": {
        "numberOfWorkers": 1,
        "defaultDocuments": [
          "Default.htm",
          "Default.html",
          "Default.asp",
          "index.htm",
          "index.html",
          "iisstart.htm",
          "default.aspx",
          "index.php"
        ],
        "netFrameworkVersion": "v10.0",
        "phpVersion": "5.6",
        "requestTracingEnabled": false,
        "remoteDebuggingEnabled": false,
        "httpLoggingEnabled": false,
        "logsDirectorySizeLimit": 35,
        "detailedErrorLoggingEnabled": false,
        "publishingUsername": "$[parameters('FunctionAppName')]__[parameters('SlotName')]",
        "azureStorageAccounts": {},
        "scmType": "None",
        "use32BitWorkerProcess": false,
        "webSocketsEnabled": false,
        "alwaysOn": true,
        "managedPipelineMode": "Integrated",
        "virtualApplications": [
          {
            "virtualPath": "/",
            "physicalPath": "site\\wwwroot",
            "preloadEnabled": true
          }
        ],
        "loadBalancing": "LeastRequests",
        "experiments": {
          "rampUpRules": []
        },
        "autoHealEnabled": false,
        "cors": {
          "allowedOrigins": [
            "https://functions.azure.com",
            "https://functions-staging.azure.com",
            "https://functions-next.azure.com"
          ],
          "supportCredentials": false
        },
        "localMySqlEnabled": false,
        "ipSecurityRestrictions": [
          {
            "ipAddress": "[parameters('IPRestriction')]",
            "action": "Allow",
            "priority": 1,
            "name": "Allow_APIM",
            "description": "Allow APIM access"
          }
        ],
        "scmIpSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictionsUseMain": false,
        "http20Enabled": false,
        "minTlsVersion": "1.2",
        "ftpsState": "AllAllowed",
        "PreWarmedInstanceCount": 0
      }
    },
    {
      "type": "Microsoft.Web/sites/slots/hostNameBindings",
      "apiVersion": "2022-03-01",
      "name": "[concat(parameters('FunctionAppName'), '/', parameters('SlotName'),'/', parameters('FunctionAppName'), '-',parameters('SlotName'),'.azurewebsites.net')]",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName'))]",
        "[variables('SiteResourceID')]"
      ],
      "properties": {
        "siteName": "[concat(parameters('FunctionAppName'),'(',parameters('SlotName'),')')]",
        "hostNameType": "Verified"
      }
    }
  ]
}
