{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "DataDog": {
      "type": "secureObject",
      "defaultValue": {
        "LoggingProvider": "AppInsights",
        "LogsEndpoint": "https://http-intake.logs.datadoghq.com/api/v2/logs",
        "ApiKey": "",
        "Site": "datadoghq.com",
        "Environment": "",
        "Source": "csharp",
        "Version": "",
        "TraceEnabled": true,
        "RuntimeMetricsEnabled": true,
        "Tags": "",
        "BaggageAllowList": "",
        "MinimumLogLevel": "Information",
        "QueueCapacity": 5000,
        "BatchSize": 100,
        "FlushIntervalMilliseconds": 2000
      }
    },
    "AppInsightsName": {
      "type": "string"
    },
    "AppServicePlanName": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_ALT_SERVER": {
      "type": "string"
    },
    "Appsetting:WEBSITE_DNS_SERVER": {
      "type": "string"
    },
    "Appsetting:APPLICATIONINSIGHTS_CONNECTION_STRING": {
      "type": "string"
    },
    "Appsetting:FUNCTIONS_EXTENSION_VERSION": {
      "type": "string"
    },
    "Appsetting:FUNCTIONS_WORKER_RUNTIME": {
      "type": "string"
    },
    "Appsetting:AzureWebJobsSecretStorageType": {
      "type": "string"
    },
    "AzureWebJobsStorage": {
      "type": "string"
    },
    "Appsettings:AppInsightsKey": {
      "type": "string"
    },
    // Azure AD
    "Appsettings:AzureAd:ClientId": {
      "type": "string"
    },
    "Appsettings:AzureAd:Instance": {
      "type": "string"
    },
    "Appsettings:AzureAd:TenantId": {
      "type": "string"
    },
    "Appsettings:AzureAd:TokenV1Issuer": {
      "type": "string"
    },
    // Service bus
    "Appsettings:ServiceBusTopicName": {
      "type": "string"
    },
    "Appsettings:CustomerTransactionEventTopicName": {
      "type": "string"
    },
    //Microservice DB Key
    "Appsettings:MicroServiceDBKey": {
      "type": "string"
    },
    "Appsettings:MicroServiceEventStoreTableName": {
      "type": "string"
    },
    "Appsettings:MicroServiceResponseTableName": {
      "type": "string"
    },

    // Birthday Bonus

    "Appsettings:CombinedRuleApplicationName": {
      "type": "string"
    },

    "Appsettings:CombinedRuleRequestEntityName": {
      "type": "string"
    },


    //In Rule
    "Appsettings:TierRuleSetApplicationName": {
      "type": "string"
    },
    "Appsettings:TierRuleSetEntityName": {
      "type": "string"
    },
    "Appsettings:RuleAppPassword": {
      "type": "string"
    },
    "Appsettings:RuleAppUserName": {
      "type": "string"
    },
    "Appsettings:RuleAppRepositoryServiceUri": {
      "type": "string"
    },
    "Appsettings:InRuleAPIURL": {
      "type": "string"
    },
    "Appsettings:InRuleAPIHeader": {
      "type": "string"
    },
    "Appsettings:InRuleDisruptionAPIURL": {
      "type": "string"
    },
    "Appsettings:InRuleDisruptionAPIKey": {
      "type": "string"
    },

    //Environmental Settings and Expiration

    "Appsettings:DatabaseID": {
      "type": "string"
    },
    "Appsettings:SCV:CommonRefDBConnString": {
      "type": "string"
    },

    "Appsettings:CommonCachingSlidingExpiration": {
      "type": "string"
    },

    "Appsettings:CommonCachingAbsoluteExpiration": {
      "type": "string"
    },
    "Appsettings:EconomyClasses": {
      "type": "string"
    },
    "Appsettings:PremEconomyClasses": {
      "type": "string"
    },
    "Appsettings:UpperClasses": {
      "type": "string"
    },
    "EnvironmentName": {
      "type": "string"
    },
    "FunctionAppName": {
      "type": "String"
    },
    "IPRestriction": {
      "type": "string"
    },
    "ServerFarmIdRg": {
      "type": "string"
    },
    "Appsetting:ServiceBusConnectionString": {
      "type": "string"
    },
    "Appsettings:WEBSITE_CONTENTAZUREFILECONNECTIONSTRING": {
      "type": "string"
    },
    "Appsettings:WEBSITE_CONTENTSHARE": {
      "type": "string"
    },

    //Slot settings
    "SlotName": {
      "type": "string"
    },
    "storageAccountName": {
      "type": "String"
    },
    "vaultName": {
      "type": "string"
    },
    "ResourceGroupSubscriptionId": {
      "type": "string"
    },
    "actionGroupsServiceNow": {
      "type": "string"
    },
    "actionGroupsEAPISupport": {
      "type": "string"
    },
    "emailAddressServiceNow": {
      "type": "string"
    },
    "emailAddressEAPISupport": {
      "type": "string"
    },
    "tags": {
      "type": "Object"
    },

    //Azure B2C settings
    "AzureAdB2C:ClientId": {
      "type": "string"
    },
    "AzureAdB2C:Instance": {
      "type": "string"
    },
    "AzureAdB2C:SignUpSignInPolicyId": {
      "type": "string"
    },
    "AzureAdB2C:TenantId": {
      "type": "string"
    },
    "AzureAdB2C:TokenV1Issuer": {
      "type": "string"
    },

    //swagger

    "Appsettings:OpenApi__DocTitle": {
      "type": "string"
    },
    "Appsettings:OpenApi__Description": {
      "type": "string"
    },
    "Appsettings:OpenApi__HostNames": {
      "type": "string"
    },
    "Appsettings:OpenApi__DocVersion": {
      "type": "string"
    },
    "Appsettings:OpenApi__Version": {
      "type": "string"
    },
    "Appsettings:OpenApi__TokenUrl": {
      "type": "string"
    },
    "Appsettings:OpenApi__Scope": {
      "type": "string"
    },
    "Appsettings:OpenApi__ForceHttps": {
      "type": "string"
    },
    "Appsettings:OpenApi__ForceHttp": {
      "type": "string"
    }
  },
  "variables": {
    "ResourceLocation": "[resourceGroup().location]",
    "SiteResourceID": "[resourceId('Microsoft.Web/Sites', parameters('FunctionAppName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2018-11-01",
      "name": "[parameters('FunctionAppName')]",
      "location": "[variables('ResourceLocation')]",
      "kind": "functionapp",
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]"
      },

      "tags": "[parameters('Tags')]"
     },
    {
      "type": "Microsoft.Web/sites/slots",
      "kind": "functionapp",
      "name": "[concat(parameters('FunctionAppName'), '/',parameters('SlotName'))]",
      "apiVersion": "2021-03-01",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [ "[variables('SiteResourceID')]" ],
      "identity": {
        "principalId": "",
        "tenantId": "",
        "type": "SystemAssigned"
      },

      "properties": {
        "enabled": true,
        "hostNameSslStates": [
          {
            "name": "[concat(parameters('FunctionAppName'),'-',parameters('SlotName'), '.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Standard"
          },
          {
            "name": "[concat(parameters('FunctionAppName'),'-',parameters('SlotName'),  '.scm.azurewebsites.net')]",
            "sslState": "Disabled",
            "hostType": "Repository"
          }
        ],
        "serverFarmId": "[resourceId(parameters('ServerFarmIdRg'), 'Microsoft.Web/serverFarms', parameters('AppServicePlanName'))]",
        "reserved": false,
        "isXenon": false,
        "hyperV": false,
        "siteConfig": {
          "appSettings": [
            {
              "name": "LoggingProvider",
              "value": "[parameters('DataDog').LoggingProvider]"
            },
            {
              "name": "DatadogLogsEndpoint",
              "value": "[parameters('DataDog').LogsEndpoint]"
            },
            {
              "name": "DatadogApiKey",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_API_KEY",
              "value": "[parameters('DataDog').ApiKey]"
            },
            {
              "name": "DD_SITE",
              "value": "[parameters('DataDog').Site]"
            },
            {
              "name": "DD_SERVICE",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "DD_ENV",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DD_VERSION",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DD_TRACE_ENABLED",
              "value": "[string(parameters('DataDog').TraceEnabled)]"
            },
            {
              "name": "DD_RUNTIME_METRICS_ENABLED",
              "value": "[string(parameters('DataDog').RuntimeMetricsEnabled)]"
            },
            {
              "name": "DatadogService",
              "value": "[parameters('FunctionAppName')]"
            },
            {
              "name": "environment",
              "value": "[parameters('DataDog').Environment]"
            },
            {
              "name": "DatadogSource",
              "value": "[parameters('DataDog').Source]"
            },
            {
              "name": "DatadogVersion",
              "value": "[parameters('DataDog').Version]"
            },
            {
              "name": "DatadogTags",
              "value": "[concat(parameters('DataDog').Tags, if(empty(parameters('DataDog').Tags), '', ','), 'cloud_provider:azure,subscription_id:', subscription().subscriptionId, ',resource_group:', resourceGroup().name, ',name:', parameters('FunctionAppName'), '/', parameters('SlotName'), ',type:microsoft.web/sites/slots,resource_id:', resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName')))]"
            },
            {
              "name": "DatadogBaggageAllowList",
              "value": "[parameters('DataDog').BaggageAllowList]"
            },
            {
              "name": "DatadogMinimumLogLevel",
              "value": "[parameters('DataDog').MinimumLogLevel]"
            },
            {
              "name": "DatadogQueueCapacity",
              "value": "[string(parameters('DataDog').QueueCapacity)]"
            },
            {
              "name": "DatadogBatchSize",
              "value": "[string(parameters('DataDog').BatchSize)]"
            },
            {
              "name": "DatadogFlushIntervalMilliseconds",
              "value": "[string(parameters('DataDog').FlushIntervalMilliseconds)]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "[parameters('Appsetting:FUNCTIONS_EXTENSION_VERSION')]"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "dotnet-isolated"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[parameters('Appsettings:AppInsightsKey')]"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageAccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]"
            },
            {
              "name": "AzureWebJobsSecretStorageType",
              "value": "[parameters('Appsetting:AzureWebJobsSecretStorageType')]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[parameters('Appsetting:APPLICATIONINSIGHTS_CONNECTION_STRING')]"
            },
            {
              "name": "WEBSITE_CONTENTSHARE",
              "value": "[parameters('Appsettings:WEBSITE_CONTENTSHARE')]"
            },
            {
              "name": "ServiceBusConnectionString",
              "value": "[parameters('Appsetting:ServiceBusConnectionString')]"
            },
            {
              "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('storageAccountName'),';AccountKey=',listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2019-06-01').keys[0].value,';EndpointSuffix=','core.windows.net')]"
            },
            // Azure AD
            {
              "name": "AzureAd:ClientId",
              "value": "[parameters('Appsettings:AzureAd:ClientId')]"
            },
            {
              "name": "AzureAd:Instance",
              "value": "[parameters('Appsettings:AzureAd:Instance')]"
            },
            {
              "name": "AzureAd:TenantId",
              "value": "[parameters('Appsettings:AzureAd:TenantId')]"
            },
            {
              "name": "AzureAd:TokenV1Issuer",
              "value": "[parameters('Appsettings:AzureAd:TokenV1Issuer')]"
            },
            //ServiceBus Topic Name
            {
              "name": "ServiceBusTopicName",
              "value": "[parameters('Appsettings:ServiceBusTopicName')]"
            },
            {
              "name": "CustomerTransactionEventTopicName",
              "value": "[parameters('Appsettings:CustomerTransactionEventTopicName')]"
            },

            //Microservice DB key
            {
              "name": "MicroServiceDBKey",
              "value": "[parameters('Appsettings:MicroServiceDBKey')]"
            },
            {
              "name": "MicroServiceEventStoreTableName",
              "value": "[parameters('Appsettings:MicroServiceEventStoreTableName')]"
            },
            {
              "name": "MicroServiceResponseTableName",
              "value": "[parameters('Appsettings:MicroServiceResponseTableName')]"
            },

            //Birthday Bonus
            {
              "name": "CombinedRuleApplicationName",
              "value": "[parameters('Appsettings:CombinedRuleApplicationName')]"
            },

            {
              "name": "CombinedRuleRequestEntityName",
              "value": "[parameters('Appsettings:CombinedRuleRequestEntityName')]"
            },

            // Environmental settings and Expiration

            {
              "name": "DatabaseID",
              "value": "[parameters('Appsettings:DatabaseID')]"
            },
            {
              "name": "SCV:CommonRefDBConnString",
              "value": "[parameters('Appsettings:SCV:CommonRefDBConnString')]"
            },
            {
              "name": "CommonCachingSlidingExpiration",
              "value": "[parameters('Appsettings:CommonCachingSlidingExpiration')]"
            },

            {
              "name": "CommonCachingAbsoluteExpiration",
              "value": "[parameters('Appsettings:CommonCachingAbsoluteExpiration')]"
            },
            {
              "name": "EconomyClasses",
              "value": "[parameters('Appsettings:EconomyClasses')]"
            },
            {
              "name": "PremEconomyClasses",
              "value": "[parameters('Appsettings:PremEconomyClasses')]"
            },
            {
              "name": "UpperClasses",
              "value": "[parameters('Appsettings:UpperClasses')]"
            },



            //In Rule
            {
              "name": "TierRuleSetApplicationName",
              "value": "[parameters('Appsettings:TierRuleSetApplicationName')]"
            },
            {
              "name": "TierRuleSetEntityName",
              "value": "[parameters('Appsettings:TierRuleSetEntityName')]"
            },
            {
              "name": "RuleAppPassword",
              "value": "[parameters('Appsettings:RuleAppPassword')]"
            },
            {
              "name": "RuleAppUserName",
              "value": "[parameters('Appsettings:RuleAppUserName')]"
            },
            {
              "name": "RuleAppRepositoryServiceUri",
              "value": "[parameters('Appsettings:RuleAppRepositoryServiceUri')]"
            },
            {
              "name": "InRuleAPIURL",
              "value": "[parameters('Appsettings:InRuleAPIURL')]"
            },
            {
              "name": "InRuleAPIHeader",
              "value": "[parameters('Appsettings:InRuleAPIHeader')]"
            },
            {
              "name": "InRuleDisruptionAPIURL",
              "value": "[parameters('Appsettings:InRuleDisruptionAPIURL')]"
            },
            {
              "name": "InRuleDisruptionAPIKey",
              "value": "[parameters('Appsettings:InRuleDisruptionAPIKey')]"
            },
            //Azure B2C Settings
            {
              "name": "AzureAdB2C:ClientId",
              "value": "[parameters('AzureAdB2C:ClientId')]"
            },
            {
              "name": "AzureAdB2C:Instance",
              "value": "[parameters('AzureAdB2C:Instance')]"
            },
            {
              "name": "AzureAdB2C:SignUpSignInPolicyId",
              "value": "[parameters('AzureAdB2C:SignUpSignInPolicyId')]"
            },
            {
              "name": "AzureAdB2C:TenantId",
              "value": "[parameters('AzureAdB2C:TenantId')]"
            },
            {
              "name": "AzureAdB2C:TokenV1Issuer",
              "value": "[parameters('AzureAdB2C:TokenV1Issuer')]"
            },
            //swagger

            {
              "name": "OpenApi__DocTitle",
              "value": "[parameters('Appsettings:OpenApi__DocTitle')]"
            },
            {
              "name": "OpenApi__Description",
              "value": "[parameters('Appsettings:OpenApi__Description')]"
            },
            {
              "name": "OpenApi__HostNames",
              "value": "[parameters('Appsettings:OpenApi__HostNames')]"
            },
            {
              "name": "OpenApi__DocVersion",
              "value": "[parameters('Appsettings:OpenApi__DocVersion')]"
            },
            {
              "name": "OpenApi__Version",
              "value": "[parameters('Appsettings:OpenApi__Version')]"
            },
            {
              "name": "OpenApi__TokenUrl",
              "value": "[parameters('Appsettings:OpenApi__TokenUrl')]"
            },
            {
              "name": "OpenApi__Scope",
              "value": "[parameters('Appsettings:OpenApi__Scope')]"
            },
            {
              "name": "OpenApi__ForceHttps",
              "value": "[parameters('Appsettings:OpenApi__ForceHttps')]"
            },
            {
              "name": "OpenApi__ForceHttp",
              "value": "[parameters('Appsettings:OpenApi__ForceHttp')]"
            }
          ]
        },
        "scmSiteAlsoStopped": false,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNamesDisabled": false,
        "containerSize": 1536,
        "dailyMemoryTimeQuota": 0,
        "httpsOnly": true,
        "redundancyMode": "None"
      }
    },
    {
      "type": "Microsoft.Web/sites/slots/config",
      "apiVersion": "2018-11-01",
      "name": "[concat(parameters('FunctionAppName'), '/',parameters('SlotName'),'/web')]",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName'))]",
        "[variables('SiteResourceID')]"
      ],
      "properties": {
        "numberOfWorkers": 1,
        "defaultDocuments": [
          "Default.htm",
          "Default.html",
          "Default.asp",
          "index.htm",
          "index.html",
          "iisstart.htm",
          "default.aspx",
          "index.php"
        ],
        "netFrameworkVersion": "v10.0",
        "phpVersion": "5.6",
        "requestTracingEnabled": false,
        "remoteDebuggingEnabled": false,
        "httpLoggingEnabled": false,
        "logsDirectorySizeLimit": 35,
        "detailedErrorLoggingEnabled": false,
        "publishingUsername": "$[parameters('FunctionAppName')]__[parameters('SlotName')]",
        "azureStorageAccounts": {},
        "scmType": "None",
        "use32BitWorkerProcess": false,
        "webSocketsEnabled": false,
        "alwaysOn": true,
        "managedPipelineMode": "Integrated",
        "virtualApplications": [
          {
            "virtualPath": "/",
            "physicalPath": "site\\wwwroot",
            "preloadEnabled": true
          }
        ],
        "loadBalancing": "LeastRequests",
        "experiments": {
          "rampUpRules": []
        },
        "autoHealEnabled": false,
        "cors": {
          "allowedOrigins": [
            "https://portal.azure.com", // Not swapped!
            "https://functions.azure.com",
            "https://functions-staging.azure.com",
            "https://functions-next.azure.com"
          ],
          "supportCredentials": false
        },
        "localMySqlEnabled": false,
        "ipSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictions": [
          {
            "ipAddress": "Any",
            "action": "Allow",
            "priority": 1,
            "name": "Allow all",
            "description": "Allow all access"
          }
        ],
        "scmIpSecurityRestrictionsUseMain": false,
        "http20Enabled": false,
        "scmMinTlsVersion": "1.0",
        "minTlsVersion": "1.2",
        "ftpsState": "AllAllowed",
        "reservedInstanceCount": 0
      }
    },
    {

      "type": "Microsoft.Web/sites/slots/hostNameBindings",
      "apiVersion": "2022-03-01",
      "name": "[concat(parameters('FunctionAppName'), '/', parameters('SlotName'),'/', parameters('FunctionAppName'), '-',parameters('SlotName'),'.azurewebsites.net')]",
      "location": "[variables('ResourceLocation')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites/slots', parameters('FunctionAppName'), parameters('SlotName'))]",
        "[variables('SiteResourceID')]"
      ],
      "properties": {
        "siteName": "[concat(parameters('FunctionAppName'),'(',parameters('SlotName'),')')]",
        "hostNameType": "Verified"
      }
    },

    {
      "type": "microsoft.insights/components",
      "kind": "web",
      "name": "[parameters('AppInsightsName')]",
      "apiVersion": "2015-05-01",
      "location": "[Variables('ResourceLocation')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "applicationId": "[variables('SiteResourceID')]",
        "Application_Type": "web"
      },
      "dependsOn": [ "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]" ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "name": "[concat(parameters('vaultName'), '/add')]",
      "apiVersion": "2019-09-01",
      "properties": {
        "accessPolicies": [
          {
            "tenantId": "[reference(concat('Microsoft.Web/sites/', parameters('FunctionAppName')), '2018-02-01','Full').identity.tenantId]",
            "objectId": "[reference(concat('Microsoft.Web/sites/', parameters('FunctionAppName')), '2018-02-01','Full').identity.principalId]",
            "permissions": {
              "keys": [ "Get", "List" ],
              "secrets": [ "Get", "List" ],
              "certificates": [ "Get", "List" ],
              "storage": [ "all" ]
            }
          }
        ]
      }
    }
  ]
}
