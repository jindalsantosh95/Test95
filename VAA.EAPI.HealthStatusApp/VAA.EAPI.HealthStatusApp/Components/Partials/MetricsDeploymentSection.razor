@using VAA.EAPI.HealthStatusApp.Models.ViewModels

@if (Models?.Any() == true)
{
    @foreach (var model in Models)
    {
        <div class="card card-home -body bus g-col-12" style="width:260px;">
            <div class="card-header">
                @model.ServiceName
            </div>
            <div class="card-body d-flex flex-column justify-content-center">
                <div class="d-flex flex-column">
                    <span class="pb-2">
                        Last Deployment: @model.LastDeployment.ToString("dd/MMM/yyyy") (@model.DaysSinceDeployment Days)
                    </span>
                </div>
            </div>
        </div>
    }
}
else
{
    <span class="g-col-12" style="align-self: center;">Fetching Deployment Data ...</span>
}

@code {
    [Parameter] public IEnumerable<DeploymentMetricsModel> Models { get; set; }
    [Parameter] public string TabName { get; set; }
}
