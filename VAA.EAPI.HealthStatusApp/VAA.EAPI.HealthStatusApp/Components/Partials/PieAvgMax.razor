@using VAA.EAPI.HealthStatusApp.Models.ViewModels
<div style="position: relative;
    width: 100%;
    display: flex;
    height: 10rem;
    justify-content: center;
    align-items: center;">
    @if (Scores.SecondScore > 0)
    {
        <div class="piescore piescorema animate" style="--start-deg: 0deg; --p:@Pie2Score; --c: orange;"></div>
    }
    @if (Scores.ThirdScore > 0)
    {
        <div class="piescore animate" style="--start-deg:@Pie1Enddeg; --p:@Pie3Score; --c: red;"></div>
        <div class="piescore piescorema animate" style="--start-deg:@Pie2Enddeg; --p:@Pie1Score; --c: green;"></div>
    }
    else
    {
        <div class="piescore piescorema animate" style="--start-deg:@Pie1Enddeg; --p:@Pie1Score; --c: green;"></div>
    }
</div>

@code {
    [Parameter] public PieScoresModel Scores { get; set; }

    public string Pie1Score => CalculateScore(Scores.FirstScore);
    public string Pie2Score => CalculateScore(Scores.SecondScore);
    public string Pie3Score => CalculateScore(Scores.ThirdScore);

    public string Pie1Enddeg => CalculateEndDeg(Scores.SecondScore);
    public string Pie2Enddeg => CalculateEndDeg(Scores.SecondScore + (Scores.ThirdScore - Scores.SecondScore));

    private string CalculateScore(int scorePart)
    {
        if (Scores.TotalScore == 0) return "0";

        var total = Scores.TotalScore;

        if (Scores.ThirdScore != 0)
            total = 100;

        return ((double)scorePart / total * 100).ToString();
    }

    private string CalculateEndDeg(int cumulativeScore)
    {
        if (Scores.TotalScore == 0) return "0";

        var total = Scores.TotalScore;

        if(Scores.ThirdScore != 0)
            total = 100;

        return ((double)cumulativeScore / total * 360).ToString() + "deg";
    }
}
