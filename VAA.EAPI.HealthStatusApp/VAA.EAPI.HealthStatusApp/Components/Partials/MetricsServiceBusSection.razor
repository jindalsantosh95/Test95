@using VAA.EAPI.HealthStatusApp.Models.ViewModels

@if (Models?.Any() == true)
{
    @foreach (var model in Models)
    {
        <div class="card card-home -body bus g-col-12" style="width:260px;">
            <div class="card-header">
                @model.ServiceBusName
            </div>
            <div class="card-body d-flex flex-column justify-content-center">
                <div class="d-flex flex-column">
                    <span class="pb-2">Messages in Queue: @model.NumberOfMessagesInQueue</span>
                    <span>Dead Letters: @model.NumberOfDeadLetterMessages</span>
                </div>
            </div>
        </div>
    }
}
else
{
    <p>No models available.</p>
}

@code {
    [Parameter] public IEnumerable<ServiceBusMetricsModel> Models { get; set; }
    [Parameter] public string TabName { get; set; }
}
