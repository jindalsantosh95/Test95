@using VAA.EAPI.HealthStatusApp.Models.ViewModels
@inject IJSRuntime JSRuntime

<canvas id="metricsChart" style="width: 100%; height: 100%;"></canvas>

@code {
    [Parameter] public IEnumerable<CosmosDbMetricsData> MetricsData { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (MetricsData != null && MetricsData.Any())
                await InitializeChart();
        }
    }

    private async Task InitializeChart()
    {
        var labels = MetricsData.Select(d => TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.Parse(d.Timestamp), TimeZoneInfo.Local.Id, "GMT Standard Time").ToString("dd/MMM hh:mm:ss")).ToArray();
        var data = MetricsData.Select(d => d.MaxNormalizedRUConsumptionPercentage).ToArray();

        await JSRuntime.InvokeVoidAsync("initializeChart", labels, data);
    }
}



        <script>
    window.initializeChart = (labels, data) => {
        const ctx = document.getElementById('metricsChart').getContext('2d');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels, // X-axis labels (timestamps)
                datasets: [{
                    label: 'Max Normalized RU Consumption (%)',
                    data: data, // Y-axis data (percentages)
                    backgroundColor: 'rgb(51, 102, 204)',
                    borderColor: 'rgb(51, 102, 204)',
                    borderWidth: 1,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                scales: {
                    x: {
                        title: {
                            display: true,
                            text: 'Time'
                        },
                        ticks: {
                            maxTicksLimit: 5 
                        }
                    },
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Percentage'
                        }
                    }
                }
            }
        });
    };


        </script>