
<div class="card">
    <div class="card-header">
        Cosmos Db
    </div>
    <div class="card-body">
        <div class="containerCosmos">
            @foreach (var item in Items)
            {
                <div class="itemCosmos">
                    <i  class="@GetIconClass(item.Key)"></i>
                    <h5>@item.Value</h5>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public Dictionary<string, bool> Services { get; set; }

    private Dictionary<string, string> Items = new Dictionary<string, string>
    {
        { "Order", "SOR" },
        { "Seat", "Seat" },
        { "Offer", "Offer" },
        { "FltSrv", "FltSrv" },
        { "Customer", "Customer" },
        { "CustomerTransaction", "CustTrans" }
    };

    private string GetIconClass(string itemkey)
    {
        if (Services != null)
        {
            foreach (var service in Services)
            {
                if (service.Key.Contains(itemkey, StringComparison.OrdinalIgnoreCase) )
                {
                    if(service.Value){
                        return "bi bi-database-fill-check";
                    }
                    else
                    {
                         return "bi bi-database-fill-exclamation";
                    }
                 }
            }
            return "bi bi-database-fill-check";
        }

        return "bi bi-database-fill-dash";
    }
}