@page "/service-bus-information"
@attribute [Authorize(Policy = "RequireSpecificGroup")]
@using VAA.EAPI.HealthStatusApp.Models.AzureAppSettings
@using VAA.EAPI.HealthStatusApp.Models.AzureServiceBus
@using VAA.EAPI.HealthStatusApp.Services
@inject IAzureAppSettingsService AzureAppSettingsService
@rendermode InteractiveServer

<style>
    .azure-select-wrapper {
        position: relative;
    }
    .azure-select-wrapper .form-select {
        padding-right: 2.5rem;
    }
    .azure-select-spinner {
        position: absolute;
        right: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
        color: #0d6efd;
    }
    .service-bus-panel-list {
        display: grid;
        gap: 1.25rem;
        margin-top: 1.5rem;
        font-size: 0.8rem;
    }
    .service-bus-filter-panel {
        background: #ffffff;
        border: 1px solid #d6deea;
        border-radius: 0.5rem;
        display: grid;
        gap: 1rem;
        grid-template-columns: minmax(16rem, 1fr) auto;
        margin-top: 1.5rem;
        padding: 1rem;
    }
    .service-bus-filter-option {
        align-items: center;
        align-self: end;
        background: #f4f6f9;
        border: 1px solid #b8c8dc;
        border-radius: 0.5rem;
        display: flex;
        gap: 0.5rem;
        min-height: 2.4rem;
        padding: 0.45rem 0.75rem;
        white-space: nowrap;
    }
    .service-bus-filter-option .form-check-input {
        height: 1.15rem;
        margin: 0;
        width: 1.15rem;
    }
    .service-bus-filter-option span {
        color: #1f2933;
        font-weight: 700;
    }
    .service-bus-namespace-panel {
        background: #ffffff;
        border: 1px solid #d6deea;
        border-radius: 0.75rem;
        padding: 1rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    }
    .service-bus-panel-summary {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        background: #b8bec7;
        border-radius: 0.5rem;
        padding: 0.75rem;
        margin-bottom: 0.75rem;
        cursor: pointer;
        list-style: none;
    }
    .service-bus-panel-summary::-webkit-details-marker,
    .service-bus-topic-summary::-webkit-details-marker {
        display: none;
    }
    .service-bus-panel-title,
    .service-bus-topic-title {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        min-width: 0;
    }
    .service-bus-panel-heading {
        align-items: center;
        display: flex;
        gap: 0.55rem;
        min-width: 0;
    }
    .service-bus-dlq-alert-icon {
        color: #c92432;
        flex: 0 0 auto;
        font-size: 1.2em;
    }
    .service-bus-collapse-icon {
        color: #52657a;
        flex: 0 0 auto;
        margin-top: 0.2rem;
        transition: transform 0.15s ease-in-out;
    }
    .service-bus-namespace-panel[open] > .service-bus-panel-summary .service-bus-collapse-icon,
    .service-bus-topic[open] > .service-bus-topic-summary .service-bus-collapse-icon {
        transform: rotate(90deg);
    }
    .service-bus-panel-summary h1,
    .service-bus-topic h2,
    .service-bus-subscription h3 {
        margin: 0;
        overflow-wrap: anywhere;
    }
    .service-bus-panel-summary h1 {
        color: #1f2933;
        font-size: 1.6em;
    }
    .service-bus-topic h2 {
        color: #1f2933;
        font-size: 1.35em;
    }
    .service-bus-subscription h3 {
        font-size: 1.15em;
    }
    .service-bus-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        color: #52657a;
        font-weight: 600;
    }
    .service-bus-summary span {
        white-space: nowrap;
    }
    .service-bus-topic-list {
        display: grid;
        gap: 1.25rem;
    }
    .service-bus-topic {
        margin-left: 1rem;
        border-left: 4px solid #b8c8dc;
        background: #f7f9fc;
        padding: 0.75rem 0.75rem 0.75rem 1rem;
        border-radius: 0.5rem;
    }
    .service-bus-topic-summary,
    .service-bus-subscription-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.5rem;
    }
    .service-bus-topic-summary {
        background: #d9dde3;
        border-radius: 0.4rem;
        cursor: pointer;
        list-style: none;
        padding: 0.55rem 0.65rem;
    }
    .service-bus-subscription-list {
        display: grid;
        gap: 0;
    }
    .service-bus-subscription {
        margin-left: 1.5rem;
        background: #ffffff;
        border: 1px solid #e0e7f0;
        border-radius: 0.5rem;
        padding: 0.65rem 0.75rem;
    }
    .service-bus-subscription + .service-bus-subscription {
        margin-top: 0.65rem;
        border-top: 4px solid #b8c8dc;
    }
    .service-bus-subscription-dead-letter {
        background: #ffe5e5;
        border-color: #f0b8b8;
    }
    .service-bus-empty {
        color: #52657a;
        margin: 0;
    }

    @@media (max-width: 768px) {
        .service-bus-filter-panel {
            grid-template-columns: 1fr;
        }
        .service-bus-panel-summary,
        .service-bus-topic-summary,
        .service-bus-subscription-header {
            flex-direction: column;
            align-items: stretch;
        }
        .service-bus-topic,
        .service-bus-subscription {
            margin-left: 0;
        }
    }
</style>

<PageTitle>Service Bus Information</PageTitle>

<section class="deployment-status-container">
    <h1>Service Bus Information</h1>

    <section class="azure-settings-stepper" aria-label="Azure service bus selector">
        <div class="azure-settings-step">
            <label for="subscriptionSelector"><strong>Subscription</strong></label>
            <div class="azure-select-wrapper">
                <select id="subscriptionSelector" class="form-select" @onchange="OnSubscriptionChanged" value="@SelectedSubscriptionId" disabled="@IsLoadingSubscriptions">
                    <option value="">-- Select a subscription --</option>
                    @foreach (var subscription in Subscriptions)
                    {
                        <option value="@subscription.SubscriptionId">@subscription.DisplayName</option>
                    }
                </select>
                @if (IsLoadingSubscriptions)
                {
                    <span class="spinner-border spinner-border-sm azure-select-spinner" role="status" aria-label="Loading subscriptions"></span>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(SelectedSubscriptionId))
        {
            <div class="azure-settings-step">
                <label for="resourceGroupSelector"><strong>Resource Group</strong></label>
                <div class="azure-select-wrapper">
                    <select id="resourceGroupSelector" class="form-select" @onchange="OnResourceGroupChanged" value="@SelectedResourceGroupName" disabled="@(!CanSelectResourceGroup)">
                        <option value="">-- Select a resource group --</option>
                        @foreach (var resourceGroup in ResourceGroups)
                        {
                            <option value="@resourceGroup.Name">@resourceGroup.Name</option>
                        }
                    </select>
                    @if (IsLoadingResourceGroups)
                    {
                        <span class="spinner-border spinner-border-sm azure-select-spinner" role="status" aria-label="Loading resource groups"></span>
                    }
                </div>
            </div>
        }
    </section>

    @if (CanShowServiceBusInformation)
    {
        <section class="service-bus-filter-panel" aria-label="Service bus filters">
            <div>
                <label for="serviceBusFilterText" class="form-label"><strong>Filter</strong></label>
                <input id="serviceBusFilterText"
                       class="form-control"
                       type="text"
                       placeholder="Filter namespace, topic or subscription"
                       @bind="FilterText"
                       @bind:event="oninput" />
            </div>
            <label class="service-bus-filter-option" for="serviceBusDeadLetterOnly">
                <input id="serviceBusDeadLetterOnly"
                       class="form-check-input"
                       type="checkbox"
                       @bind="ShowDeadLetterOnly" />
                <span>DLQ only</span>
            </label>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger mt-3" role="alert">@ErrorMessage</div>
    }

    @if (IsLoadingServiceBusNamespaces)
    {
        <div class="mt-3" aria-live="polite">
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-label="Loading service bus information"></span>
            Loading Service Bus information...
        </div>
    }
    else if (CanShowServiceBusInformation)
    {
        var filteredServiceBusNamespaces = GetFilteredServiceBusNamespaces();

        <section class="service-bus-panel-list" aria-label="Service bus namespaces">
            @if (!ServiceBusNamespaces.Any())
            {
                <div class="alert alert-info" role="alert">No Service Bus namespaces were found for this resource group.</div>
            }
            else if (!filteredServiceBusNamespaces.Any())
            {
                <div class="alert alert-info" role="alert">No Service Bus namespaces match the selected filters.</div>
            }
            else
            {
                @foreach (var serviceBusNamespaceView in filteredServiceBusNamespaces)
                {
                    var serviceBusNamespace = serviceBusNamespaceView.Namespace;
                    var topics = serviceBusNamespaceView.Topics;
                    var serviceBusNamespaceHasDeadLetters = HasDeadLetterSubscription(serviceBusNamespace);
                    <details class="service-bus-namespace-panel" open="@(OpenServiceBusNamespaceName == serviceBusNamespace.Name)">
                        <summary class="service-bus-panel-summary"
                                 @onclick="() => ToggleServiceBusNamespacePanel(serviceBusNamespace.Name)"
                                 @onclick:preventDefault="true">
                            <div class="service-bus-panel-title">
                                <i class="bi bi-chevron-right service-bus-collapse-icon" aria-hidden="true"></i>
                                <div class="service-bus-panel-heading">
                                    <h1>@serviceBusNamespace.Name</h1>
                                    @if (serviceBusNamespaceHasDeadLetters)
                                    {
                                        <i class="bi bi-exclamation-triangle-fill service-bus-dlq-alert-icon" title="Contains subscriptions with dead letters" aria-label="Contains subscriptions with dead letters"></i>
                                    }
                                </div>
                            </div>
                        </summary>

                        @if (!topics.Any())
                        {
                            <p class="service-bus-empty">No topics were found for this namespace.</p>
                        }
                        else
                        {
                            <div class="service-bus-topic-list">
                                @foreach (var topicView in topics)
                                {
                                    var topic = topicView.Topic;
                                    var subscriptions = topicView.Subscriptions;
                                    var topicHasDeadLetters = HasDeadLetterSubscription(topic);
                                    <details class="service-bus-topic" aria-label="Topic @topic.Name" open>
                                        <summary class="service-bus-topic-summary">
                                            <div class="service-bus-topic-title">
                                                <i class="bi bi-chevron-right service-bus-collapse-icon" aria-hidden="true"></i>
                                                <div class="service-bus-panel-heading">
                                                    <h2>@topic.Name</h2>
                                                    @if (topicHasDeadLetters)
                                                    {
                                                        <i class="bi bi-exclamation-triangle-fill service-bus-dlq-alert-icon" title="Contains subscriptions with dead letters" aria-label="Contains subscriptions with dead letters"></i>
                                                    }
                                                </div>
                                            </div>
                                        </summary>

                                        @if (!subscriptions.Any())
                                        {
                                            <p class="service-bus-empty">No subscriptions were found for this topic.</p>
                                        }
                                        else
                                        {
                                            <div class="service-bus-subscription-list">
                                                @foreach (var subscription in subscriptions)
                                                {
                                                    <section class="service-bus-subscription @(subscription.DeadLetterQueueDepth > 0 ? "service-bus-subscription-dead-letter" : null)" aria-label="Subscription @subscription.Name">
                                                        <header class="service-bus-subscription-header">
                                                            <div>
                                                                <h3>@subscription.Name</h3>
                                                            </div>
                                                            <div class="service-bus-summary" aria-label="Subscription queue depth">
                                                                <span>Active: @subscription.ActiveQueueDepth</span>
                                                                <span>Dead letter: @subscription.DeadLetterQueueDepth</span>
                                                            </div>
                                                        </header>
                                                    </section>
                                                }
                                            </div>
                                        }
                                    </details>
                                }
                            </div>
                        }
                    </details>
                }
            }
        </section>
    }
</section>

@code {
    private List<AzureSubscriptionModel> Subscriptions { get; set; } = [];
    private List<AzureResourceGroupModel> ResourceGroups { get; set; } = [];
    private List<AzureServiceBusNamespace> ServiceBusNamespaces { get; set; } = [];

    private string SelectedSubscriptionId { get; set; } = string.Empty;
    private string SelectedResourceGroupName { get; set; } = string.Empty;
    private string FilterText { get; set; } = string.Empty;
    private string? ErrorMessage { get; set; }

    private bool IsLoadingSubscriptions { get; set; }
    private bool IsLoadingResourceGroups { get; set; }
    private bool IsLoadingServiceBusNamespaces { get; set; }
    private bool ShowDeadLetterOnly { get; set; }
    private string? OpenServiceBusNamespaceName { get; set; }

    private bool CanSelectResourceGroup =>
        !string.IsNullOrWhiteSpace(SelectedSubscriptionId) && !IsLoadingResourceGroups;

    private bool CanShowServiceBusInformation =>
        !string.IsNullOrWhiteSpace(SelectedSubscriptionId)
        && !string.IsNullOrWhiteSpace(SelectedResourceGroupName);

    protected override async Task OnInitializedAsync()
    {
        await LoadSubscriptionsAsync();
    }

    private async Task LoadSubscriptionsAsync()
    {
        try
        {
            IsLoadingSubscriptions = true;
            ErrorMessage = null;

            Subscriptions = (await AzureAppSettingsService.GetSubscriptionsAsync()).ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to load subscriptions. {ex.Message}";
        }
        finally
        {
            IsLoadingSubscriptions = false;
        }
    }

    private async Task OnSubscriptionChanged(ChangeEventArgs args)
    {
        SelectedSubscriptionId = args.Value?.ToString() ?? string.Empty;
        SelectedResourceGroupName = string.Empty;
        ResetFilters();

        ResourceGroups.Clear();
        ServiceBusNamespaces.Clear();
        OpenServiceBusNamespaceName = null;

        if (string.IsNullOrWhiteSpace(SelectedSubscriptionId))
        {
            return;
        }

        try
        {
            IsLoadingResourceGroups = true;
            ErrorMessage = null;

            ResourceGroups = (await AzureAppSettingsService.GetResourceGroupsAsync(SelectedSubscriptionId)).ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to load resource groups. {ex.Message}";
        }
        finally
        {
            IsLoadingResourceGroups = false;
        }
    }

    private async Task OnResourceGroupChanged(ChangeEventArgs args)
    {
        SelectedResourceGroupName = args.Value?.ToString() ?? string.Empty;
        ServiceBusNamespaces.Clear();
        OpenServiceBusNamespaceName = null;
        ResetFilters();

        if (string.IsNullOrWhiteSpace(SelectedSubscriptionId) || string.IsNullOrWhiteSpace(SelectedResourceGroupName))
        {
            return;
        }

        try
        {
            IsLoadingServiceBusNamespaces = true;
            ErrorMessage = null;

            ServiceBusNamespaces = (await AzureAppSettingsService
                .GetServiceBusNamespacesAsync(SelectedSubscriptionId, SelectedResourceGroupName))
                .ToList();
            OpenServiceBusNamespaceName = ServiceBusNamespaces
                .OrderBy(serviceBusNamespace => serviceBusNamespace.Name, StringComparer.OrdinalIgnoreCase)
                .FirstOrDefault()?.Name;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to load Service Bus information. {ex.Message}";
        }
        finally
        {
            IsLoadingServiceBusNamespaces = false;
        }
    }

    private List<ServiceBusNamespaceView> GetFilteredServiceBusNamespaces()
    {
        var filterText = FilterText.Trim();
        var hasTextFilter = !string.IsNullOrWhiteSpace(filterText);

        return ServiceBusNamespaces
            .OrderBy(serviceBusNamespace => serviceBusNamespace.Name, StringComparer.OrdinalIgnoreCase)
            .Select(serviceBusNamespace =>
            {
                var namespaceMatches = MatchesFilter(serviceBusNamespace.Name, filterText);
                var topics = serviceBusNamespace.Topics?
                    .OrderBy(topic => topic.Name, StringComparer.OrdinalIgnoreCase)
                    .Select(topic => GetFilteredTopic(topic, namespaceMatches, hasTextFilter, filterText))
                    .Where(topicView => topicView is not null)
                    .Select(topicView => topicView!)
                    .ToList() ?? [];

                if (!topics.Any() && (!namespaceMatches || ShowDeadLetterOnly))
                {
                    return null;
                }

                return new ServiceBusNamespaceView(serviceBusNamespace, topics);
            })
            .Where(serviceBusNamespaceView => serviceBusNamespaceView is not null)
            .Select(serviceBusNamespaceView => serviceBusNamespaceView!)
            .ToList();
    }

    private ServiceBusTopicView? GetFilteredTopic(AzureServiceBusTopic topic, bool namespaceMatches, bool hasTextFilter, string filterText)
    {
        var topicMatches = MatchesFilter(topic.Name, filterText);
        var includeAllSubscriptionsByText = !hasTextFilter || namespaceMatches || topicMatches;

        var subscriptions = topic.Subscriptions?
            .OrderBy(subscription => subscription.Name, StringComparer.OrdinalIgnoreCase)
            .Where(subscription => !ShowDeadLetterOnly || subscription.DeadLetterQueueDepth > 0)
            .Where(subscription => includeAllSubscriptionsByText || MatchesFilter(subscription.Name, filterText))
            .ToList() ?? [];

        if (!subscriptions.Any() && (!includeAllSubscriptionsByText || ShowDeadLetterOnly))
        {
            return null;
        }

        return new ServiceBusTopicView(topic, subscriptions);
    }

    private static bool MatchesFilter(string? value, string filterText) =>
        string.IsNullOrWhiteSpace(filterText)
        || (!string.IsNullOrWhiteSpace(value)
            && value.Contains(filterText, StringComparison.OrdinalIgnoreCase));

    private static bool HasDeadLetterSubscription(AzureServiceBusNamespace serviceBusNamespace) =>
        serviceBusNamespace.Topics?.Any(HasDeadLetterSubscription) == true;

    private static bool HasDeadLetterSubscription(AzureServiceBusTopic topic) =>
        topic.Subscriptions?.Any(subscription => subscription.DeadLetterQueueDepth > 0) == true;

    private void ResetFilters()
    {
        FilterText = string.Empty;
        ShowDeadLetterOnly = false;
    }

    private void ToggleServiceBusNamespacePanel(string serviceBusNamespaceName)
    {
        OpenServiceBusNamespaceName = OpenServiceBusNamespaceName == serviceBusNamespaceName
            ? null
            : serviceBusNamespaceName;
    }

    private sealed record ServiceBusNamespaceView(
        AzureServiceBusNamespace Namespace,
        List<ServiceBusTopicView> Topics);

    private sealed record ServiceBusTopicView(
        AzureServiceBusTopic Topic,
        List<AzureServiceBusSubscription> Subscriptions);

}
