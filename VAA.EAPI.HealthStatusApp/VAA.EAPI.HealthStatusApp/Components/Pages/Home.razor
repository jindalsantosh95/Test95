@page "/"
@attribute [Authorize(Policy = "RequireSpecificGroup")]
@implements IAsyncDisposable
@inject HttpClient Http
@inject ISignalRService SignalRService
@using Microsoft.Identity.Web
@using Microsoft.AspNetCore.SignalR.Client
@using VAA.EAPI.HealthStatusApp.Components.Layout
@using VAA.EAPI.HealthStatusApp.Components.Partials
@using VAA.EAPI.HealthStatusApp.Models.ViewModels
@using VAA.EAPI.HealthStatusApp.SignalRClasses
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Index> Logger

<div class="service-dashboard">
    @if (bannerText != null)
    {
        <div class="col-12" style="display:flex; justify-content:center;padding:0 2rem;">
                <TopBanner BannerText=@bannerText />
        </div>
    }


        <div class="header__box header-home">

            <a href="external-feeds" class="right-content" style="text-decoration: none; color: inherit; display: flex; align-items: center;">
                <div class="card" style="width: 180px; height: 140px;">
                    <div class="card-header" style="padding: .25rem 1rem;">
                        Msoft Azure Status
                    </div>
                    <div class="card-body" style="padding: 1rem;">
                        <SpeedDial Score=@rssScore></SpeedDial>
                    </div>
                </div>
            </a>
        </div>

    <div class="row" style="padding:20px;padding-bottom:0;">
        <div class="col-md-3">
<a href="api-check" style="text-decoration: none; color: inherit;">
    <div class="card card-home" style="transition: opacity 0.3s;">
        <div class="card-header">
            Function Apps
        </div>

        <div class="card-body card-home-pie-body">
            <Pie Scores="@ApimPie"></Pie>
            @if (ApimPie?.TotalScore != 0)
            {
                <div class="ScoreText-width" >
                    <a style="padding: 0 0 0 1rem;">@ApimPie?.FirstScore Healthy.</a>
                    <a style="padding: 0 0 0 1rem;">@ApimPie?.SecondScore Unhealthy.</a>
                </div>
            }
            else
            {
                <p>Please Check Azure Portal.</p>
            }
        </div>
    </div>
</a>

        </div>
        <div class="col-md-3">
            <a href="api-check" @onclick="@(() => NavigateToApiCheck("graph"))" style="cursor: pointer;text-decoration: none; color: inherit;">
                <div class="card card-home">
                    <div class="card-header">
                    GraphQl
                </div>
                <div class="card-body card-home-pie-body">
                    <Pie Scores="@GraphQlPie"></Pie>
                        @if (GraphQlPie?.TotalScore != 0)
                        {
                        <div class="ScoreText-width" >
                        <a style="padding: 0 0 0 1rem;">@GraphQlPie?.FirstScore Healthy.</a>
                        <a style="padding: 0 0 0 1rem;">@GraphQlPie?.SecondScore Unhealthy.</a>
                    </div>
                        }
                        else
                        {
                        <p>Please Check Azure Portal.</p>
                        }
                </div>
            </div>
            </a>
        </div>
        <div class="col-md-3">
            <div class="card card-home">
                <div class="card-header">
                    Service Bus
                </div>
                <div class="card-body card-home-pie-body">
                    <Pie Scores="@BusPie"></Pie>
                    @if (BusPie?.TotalScore != 0)
                    {
                        <div class="ScoreText-width" >
                        <a style="padding: 0 0 0 1rem;">@BusPie?.FirstScore Healthy.</a>
                        <a style="padding: 0 0 0 1rem;">@BusPie?.SecondScore Unhealthy.</a>
                    </div>
                    }
                    else
                    {
                    <p>Please Check Azure Portal.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card card-home">
                <div class="card-header">
                    Cosmos Db Connections
                </div>
                <div class="card-body card-home-pie-body">
                    <Pie Scores="@CosmosPie"></Pie>

                    @if(CosmosPie?.TotalScore != 0){
                        <div class="ScoreText-width" >
                        <a style="padding: 0 0 0 1rem;">@CosmosPie?.FirstScore Healthy.</a>
                        <a style="padding: 0 0 0 1rem;">@CosmosPie?.SecondScore Unhealthy.</a>
                        </div>
                    }
                    else
                    {
                        <p>Please Check Azure Portal.</p>
                    }
                </div>
            </div>
        </div>
    </div>


    <div class="home-table">
        <div class="card card-home-table">
            <div class="card-header">
                Service Now Incidents
            </div>
            <div class="card-body" style="max-height: calc(6 * 40px); overflow-y: auto;padding:1rem">
                @if (Incidents is null || !Incidents.Any())
                {
                    <p class="col-12" style="text-align: center;">Any detail regarding Issues will appear here</p>
                }
                else
                {
                    <table class="table table-striped" style="margin-bottom:5px;">
                        <thead>
                            <tr>
                                <th class="col-2">Incident</th>
                                <th class="col-6">Description</th>
                                <th class="col-2">Created</th>
                                <th class="col-2">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var incident in Incidents)
                            {
                                <tr class="issue-row_home" @onclick="@(() => NavigateToServiceNow())" style="cursor: pointer;">
                                    <td class="col-2">@incident.IncidentNumber</td>
                                    <td class="col-6">@incident.Shortdescription</td>
                                    <td class="col-2">@incident.Created.ToString("dd/MMM/yyyy HH:mm:ss")</td>
                                    <td class="col-2">@incident.State</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="card card-home-table">
            <div class="card-header">
                Service Issues
            </div>
            <div class="card-body" style="max-height: calc(6 * 40px); overflow-y: auto;padding:1rem">
                @if (Issues is null || !Issues.Any())
                {
                    <p class="col-12" style="text-align: center;">Any detail regarding Issues will appear here</p>
                }
                else{
                    <table class="table table-striped" style="margin-bottom:5px;">
                <thead>
                    <tr>
                        <th class="col-10">Service</th>
                        <th class="col-2">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var issue in Issues)
                    {
                        <tr class="issue-row_home" @onclick="@(() => NavigateToApiCheck(issue.Service))" style="cursor: pointer;">
                            <td class="col-5">@issue.Service</td>
                            <td class="col-1">
                                @issue.StatusCode
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            }
            </div>
        </div>
    </div>
</div>


@code {
    private HubConnection? hubConnection;
    private Header HeaderComponent;
    private string bannerText;
    private string rssScore;
    private PieScoresModel ApimPie;
    private PieScoresModel BusPie;
    private PieScoresModel CosmosPie;
    private PieScoresModel GraphQlPie;
    private IEnumerable<DashboardIssue> Issues;
    private IEnumerable<ServiceNowViewModel> Incidents;
    private string InsightsHeartStyle = "Connecting...";
    private string InsightsText = "bi-heart";
    private bool isHandlerRegistered = false;
    private bool _isSignalRInitialized = false;
    private bool isLoading = true;
    private bool IsPageVisible = false;

    protected override void OnInitialized()
    {
        IsPageVisible = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await StartSignalRConnectionAsync();
            _isSignalRInitialized = true;
            await UpdateHeader("Service Dashboard", TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.Now, TimeZoneInfo.Local.Id, "GMT Standard Time").ToString("dd/MMM/yyyy HH:mm:ss"), InsightsText, InsightsHeartStyle);

        }
    }

    private async Task StartSignalRConnectionAsync()
    {
        try
        {
            if (_isSignalRInitialized) return;

            hubConnection = SignalRService.GetConnection();


            if (!SignalRService.IsConnected)
                await SignalRService.StartConnectionAsync();

            _isSignalRInitialized = true;

            if (!isHandlerRegistered)
            {
                RegisterSignalREvents();
                isHandlerRegistered = true;
            }

            if (SignalRService.IsConnected)
            {
                await hubConnection.InvokeAsync("GetHomeDashboadStatus");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during SignalR setup");
        }
        finally
        {
            isLoading = false;
            var Title = "Service Dashboard Home";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void RegisterSignalREvents()
    {
        hubConnection.On<HomeModel>("ReceiveHomeDashboadStatus", async (model) =>
        {
            try
            {
                await UpdateInsightsEl(model.IsInsightsHealthy);
                bannerText = model.BannerText == null ? "" : "Issue with " + model.BannerText;
                rssScore = model.AzureRssScore.ToString();
                ApimPie = model.ApimPie;
                GraphQlPie = model.GraphQlPie;
                CosmosPie = model.CosmosPie;
                BusPie = model.ServiceBusPie;
                Issues = model.DashboardIssues;
                Incidents = model.ServiceNowViewModels;

                if (IsPageVisible)
                    await UpdateHeader("Service Dashboard", TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.Now, TimeZoneInfo.Local.Id, "GMT Standard Time").ToString("dd/MMM/yyyy HH:mm:ss"), InsightsText, InsightsHeartStyle);


                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error handling SignalR event");
            }
        });
    }

    private async Task UpdateHeader(string title, string time, string insightsText, string insightsHeartStyle)
    {
        await JSRuntime.InvokeVoidAsync("updateHeader", title, time, insightsText, insightsHeartStyle);
    }

    private async Task UpdateInsightsEl(bool IsHealthy)
    {
        InsightsHeartStyle = IsHealthy ? "bi-heart-pulse-fill" : "bi-heartbreak-fill";
        InsightsText = IsHealthy ? "Insights App Healthy" : "Insights App Unhealthy";
    }

    private void NavigateToApiCheck(string service)
    {
        Navigation.NavigateTo($"/api-check?service={Uri.EscapeDataString(service)}");
    }

    private void NavigateToServiceNow()
    {
        Navigation.NavigateTo($"/external-feeds");
    }

    public async ValueTask DisposeAsync()
    {
        IsPageVisible = false;
    }
}

<script>
    function updateHeader(title, time, insightsText, insightsHeartStyle) {
        document.querySelector(".header-title").textContent = title;

        if (time) {
            document.querySelector(".header-time").textContent = "Last Checked: " + time;
        }

        if (insightsText) {
            document.querySelector(".header-insights-label").textContent = insightsText;
        }

        if (insightsHeartStyle) {
            const icon = document.querySelector(".insightsHeartStyle");
            if (icon) {
                icon.className = "bi " + insightsHeartStyle;
            }
        }
    }
</script>
